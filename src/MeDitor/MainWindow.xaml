<controls:ChromeWindow x:Class="MeDitor.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:DesignKit.Controls;assembly=DesignKit.Wpf"
        xmlns:local="clr-namespace:MeDitor"
        xmlns:res="clr-namespace:MeDitor.Properties"
        Icon="/MeDitor;component/Assets/meditor.ico"
        Title="{x:Static res:Resources.App_Name}"
        Width="1380" Height="880"
        MinWidth="760" MinHeight="480"
        WindowStartupLocation="CenterScreen"
        AllowDrop="True"
        FontFamily="{DynamicResource AppFont}"
        Foreground="{DynamicResource TextPrimaryBrush}"
        Background="{DynamicResource SurfaceBaseBrush}"
        PreviewKeyDown="Window_PreviewKeyDown"
        Drop="Window_Drop"
        DragOver="Window_DragOver">

    <controls:ChromeWindow.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />

        <!-- Üst çubuktaki menü ve ikon düğmeleri -->
        <Style x:Key="BarButton" TargetType="Button" BasedOn="{StaticResource IconButtonStyle}">
            <Setter Property="Margin" Value="1,0" />
            <Setter Property="Focusable" Value="False" />
        </Style>

        <!-- Sekme: başlık + kapat; seçili sekme zemin rengini alır, alt çizgisi vurgulu -->
        <Style x:Key="TabItemStyle" TargetType="ListBoxItem">
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="0,0,2,0" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Bd" CornerRadius="7,7,0,0" Padding="12,6,6,6" Background="Transparent" BorderThickness="0,0,0,2" BorderBrush="Transparent">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource SurfaceBaseBrush}" />
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource AccentTextFillColorPrimaryBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Kenar çubuğu ağacı: klasör / md dosyası -->
        <HierarchicalDataTemplate x:Key="FolderNodeTemplate" DataType="{x:Type local:FolderNode}" ItemsSource="{Binding Children}">
            <StackPanel Orientation="Horizontal" Margin="0,2" ToolTip="{Binding Path}">
                <local:AppIcon Glyph="{Binding Glyph}" FontSize="13" VerticalAlignment="Center" Foreground="{DynamicResource TextSecondaryBrush}" />
                <TextBlock Margin="7,0,0,0" Text="{Binding Name}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
            </StackPanel>
        </HierarchicalDataTemplate>
    </controls:ChromeWindow.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Üst çubuk: menü, kenar çubuğu düğmesi, sekmeler -->
        <Border Grid.Row="0" Background="{DynamicResource LayerBrush}" BorderBrush="{DynamicResource DividerStrokeColorDefaultBrush}" BorderThickness="0,0,0,1" Padding="8,4,8,0">
            <DockPanel LastChildFill="True">
                <Menu DockPanel.Dock="Left" Background="Transparent" VerticalAlignment="Center" Margin="0,0,0,4">
                    <MenuItem x:Name="FileMenu" Header="{x:Static res:Resources.Main_File}" SubmenuOpened="FileMenu_SubmenuOpened">
                        <MenuItem Header="{x:Static res:Resources.Main_New}" InputGestureText="{x:Static res:Resources.Gesture_New}" Click="New_Click" />
                        <MenuItem Header="{x:Static res:Resources.Main_Open}" InputGestureText="{x:Static res:Resources.Gesture_Open}" Click="Open_Click" />
                        <MenuItem Header="{x:Static res:Resources.Main_OpenFolder}" InputGestureText="{x:Static res:Resources.Gesture_OpenFolder}" Click="OpenFolder_Click" />
                        <MenuItem x:Name="RecentMenu" Header="{x:Static res:Resources.Main_Recent}" />
                        <Separator />
                        <MenuItem Header="{x:Static res:Resources.Main_Save}" InputGestureText="{x:Static res:Resources.Gesture_Save}" Click="Save_Click" />
                        <MenuItem Header="{x:Static res:Resources.Main_SaveAs}" InputGestureText="{x:Static res:Resources.Gesture_SaveAs}" Click="SaveAs_Click" />
                        <MenuItem Header="{x:Static res:Resources.Main_SaveAll}" Click="SaveAll_Click" />
                        <Separator />
                        <MenuItem Header="{x:Static res:Resources.Main_ExportHtml}" Click="ExportHtml_Click" />
                        <MenuItem Header="{x:Static res:Resources.Main_Print}" InputGestureText="{x:Static res:Resources.Gesture_Print}" Click="Print_Click" />
                        <Separator />
                        <MenuItem Header="{x:Static res:Resources.Main_CloseTab}" InputGestureText="{x:Static res:Resources.Gesture_CloseTab}" Click="CloseTab_Click" />
                        <MenuItem Header="{x:Static res:Resources.Main_Exit}" Click="Exit_Click" />
                    </MenuItem>
                    <MenuItem x:Name="ViewMenu" Header="{x:Static res:Resources.Main_View}" SubmenuOpened="ViewMenu_SubmenuOpened">
                        <MenuItem x:Name="SidebarMenuItem" Header="{x:Static res:Resources.Main_Sidebar}" InputGestureText="{x:Static res:Resources.Gesture_Sidebar}" IsCheckable="True" Click="SidebarMenu_Click" />
                        <MenuItem x:Name="ThemeMenu" Header="{x:Static res:Resources.Main_Theme}" />
                    </MenuItem>
                </Menu>
                <Button DockPanel.Dock="Left" Style="{StaticResource BarButton}" Margin="6,0,8,4" VerticalAlignment="Center"
                        Click="SidebarToggle_Click" ToolTip="{x:Static res:Resources.Main_Sidebar}">
                    <local:AppIcon Glyph="&#xE700;" FontSize="14" />
                </Button>
                <Button DockPanel.Dock="Right" Style="{StaticResource BarButton}" Margin="6,0,0,4" VerticalAlignment="Center"
                        Click="New_Click" ToolTip="{x:Static res:Resources.Main_New}">
                    <local:AppIcon Glyph="{x:Static local:AppIcons.Add}" FontSize="14" />
                </Button>
                <ListBox x:Name="TabStrip" ItemContainerStyle="{StaticResource TabItemStyle}" Background="Transparent" BorderThickness="0"
                         VerticalAlignment="Bottom" SelectionChanged="TabStrip_SelectionChanged"
                         ScrollViewer.HorizontalScrollBarVisibility="Hidden" ScrollViewer.VerticalScrollBarVisibility="Disabled">
                    <ListBox.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal" />
                        </ItemsPanelTemplate>
                    </ListBox.ItemsPanel>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal" MaxWidth="240" ToolTip="{Binding Path}" MouseDown="Tab_MouseDown">
                                <local:AppIcon Glyph="{x:Static local:AppIcons.Note}" FontSize="12" VerticalAlignment="Center" Foreground="{DynamicResource TextSecondaryBrush}" />
                                <TextBlock Margin="7,0,6,0" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Text="{Binding TabTitle}" />
                                <Button Style="{StaticResource BarButton}" Padding="4" Click="TabClose_Click" ToolTip="{x:Static res:Resources.Main_CloseTab}">
                                    <local:AppIcon Glyph="&#xE711;" FontSize="9" />
                                </Button>
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>
        </Border>

        <!-- Gövde: kenar çubuğu | ayraç | sekmelerin içeriği -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="SidebarColumn" Width="260" MinWidth="0" />
                <ColumnDefinition x:Name="SidebarSplitterColumn" Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border x:Name="Sidebar" Grid.Column="0" Background="{DynamicResource LayerBrush}">
                <DockPanel>
                    <DockPanel DockPanel.Dock="Top" Margin="12,10,6,6">
                        <Button DockPanel.Dock="Right" Style="{StaticResource BarButton}" Click="CloseFolder_Click" ToolTip="{x:Static res:Resources.Main_CloseFolder}"
                                Visibility="{Binding HasFolder, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVis}}">
                            <local:AppIcon Glyph="&#xE711;" FontSize="11" />
                        </Button>
                        <Button DockPanel.Dock="Right" Style="{StaticResource BarButton}" Click="RefreshFolder_Click" ToolTip="{x:Static res:Resources.Main_RefreshFolder}"
                                Visibility="{Binding HasFolder, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVis}}">
                            <local:AppIcon Glyph="{x:Static local:AppIcons.Refresh}" FontSize="12" />
                        </Button>
                        <TextBlock x:Name="FolderTitle" VerticalAlignment="Center" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" Text="{x:Static res:Resources.Main_NoFolder}" />
                    </DockPanel>
                    <StackPanel x:Name="NoFolderPanel" DockPanel.Dock="Top" Margin="12,4,12,0">
                        <TextBlock TextWrapping="Wrap" Style="{DynamicResource CaptionTextBlockStyle}" Foreground="{DynamicResource TextTertiaryBrush}" Text="{x:Static res:Resources.Main_NoFolderHint}" />
                        <Button Margin="0,10,0,0" HorizontalAlignment="Left" Click="OpenFolder_Click" Content="{x:Static res:Resources.Main_OpenFolder}" />
                    </StackPanel>
                    <TreeView x:Name="FolderTree" BorderThickness="0" Background="Transparent" Padding="4,0,4,8"
                              ItemTemplate="{StaticResource FolderNodeTemplate}"
                              SelectedItemChanged="FolderTree_SelectedItemChanged" />
                </DockPanel>
            </Border>
            <GridSplitter x:Name="SidebarSplitter" Grid.Column="1" Width="4" HorizontalAlignment="Center" VerticalAlignment="Stretch"
                          ResizeBehavior="PreviousAndNext" Background="{DynamicResource DividerStrokeColorDefaultBrush}" DragCompleted="SidebarSplitter_DragCompleted" />

            <!-- Açık notların düzenleyicileri (yalnız seçili olan görünür; diğerleri durumunu korur) -->
            <Grid x:Name="Host" Grid.Column="2" />

            <!-- Hiç sekme yokken -->
            <StackPanel x:Name="EmptyPanel" Grid.Column="2" HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="460">
                <local:AppIcon Glyph="{x:Static local:AppIcons.Note}" FontSize="40" HorizontalAlignment="Center" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" />
                <TextBlock Margin="0,14,0,0" HorizontalAlignment="Center" FontSize="24" FontWeight="SemiBold" Text="{x:Static res:Resources.App_Name}" />
                <TextBlock Margin="0,8,0,0" TextAlignment="Center" TextWrapping="Wrap" Foreground="{DynamicResource TextSecondaryBrush}" Text="{x:Static res:Resources.Main_EmptyText}" />
                <StackPanel Margin="0,18,0,0" Orientation="Horizontal" HorizontalAlignment="Center">
                    <Button Style="{StaticResource AccentButtonStyle}" Click="New_Click" Content="{x:Static res:Resources.Main_New}" />
                    <Button Margin="8,0,0,0" Click="Open_Click" Content="{x:Static res:Resources.Main_Open}" />
                    <Button Margin="8,0,0,0" Click="OpenFolder_Click" Content="{x:Static res:Resources.Main_OpenFolder}" />
                </StackPanel>
                <TextBlock x:Name="EmptyRecentTitle" Margin="0,26,0,6" Style="{DynamicResource CaptionTextBlockStyle}" Foreground="{DynamicResource TextTertiaryBrush}" Text="{x:Static res:Resources.Main_Recent}" />
                <ItemsControl x:Name="EmptyRecent" Focusable="False" HorizontalAlignment="Stretch">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button Style="{DynamicResource SubtleButtonStyle}" Focusable="False" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Padding="10,6" Click="RecentItem_Click" Tag="{Binding}" ToolTip="{Binding}">
                                <StackPanel Orientation="Horizontal">
                                    <local:AppIcon Glyph="{x:Static local:AppIcons.Note}" FontSize="12" VerticalAlignment="Center" Foreground="{DynamicResource TextSecondaryBrush}" />
                                    <TextBlock Margin="8,0,0,0" Text="{Binding Converter={x:Static local:FileNameConverter.Instance}}" />
                                    <TextBlock Margin="10,0,0,0" MaxWidth="280" TextTrimming="CharacterEllipsis" Foreground="{DynamicResource TextTertiaryBrush}"
                                               Text="{Binding Converter={x:Static local:FileNameConverter.FolderInstance}}" />
                                </StackPanel>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </Grid>

        <!-- Kapatırken: kaydedilsin mi -->
        <controls:ContentDialog x:Name="CloseDialog" Grid.RowSpan="2"
                                Title="{x:Static res:Resources.Note_CloseTitle}"
                                PrimaryButtonText="{x:Static res:Resources.Edit_Save}"
                                SecondaryButtonText="{x:Static res:Resources.Note_CloseDiscard}"
                                CloseButtonText="{x:Static res:Resources.Dialog_Cancel}"
                                PrimaryButtonClick="CloseDialog_Save"
                                SecondaryButtonClick="CloseDialog_Discard"
                                CloseButtonClick="CloseDialog_Cancel">
            <TextBlock x:Name="CloseText" Width="320" TextWrapping="Wrap" />
        </controls:ContentDialog>
    </Grid>
</controls:ChromeWindow>
