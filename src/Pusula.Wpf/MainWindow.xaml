            </Viewbox>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding}" Value="mail"><Setter TargetName="Mail" Property="Visibility" Value="Visible" /></DataTrigger>
                <DataTrigger Binding="{Binding}" Value="face"><Setter TargetName="Face" Property="Visibility" Value="Visible" /></DataTrigger>
                <DataTrigger Binding="{Binding}" Value="teams"><Setter TargetName="Teams" Property="Visibility" Value="Visible" /></DataTrigger>
                <DataTrigger Binding="{Binding}" Value="skype"><Setter TargetName="Skype" Property="Visibility" Value="Visible" /></DataTrigger>
                <DataTrigger Binding="{Binding}" Value="zoom"><Setter TargetName="Zoom" Property="Visibility" Value="Visible" /></DataTrigger>
                <DataTrigger Binding="{Binding}" Value="phone"><Setter TargetName="Phone" Property="Visibility" Value="Visible" /></DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>
        <!-- Talep türü ikonu: renkli kutu ve beyaz simge -->
        <DataTemplate x:Key="RequestIconTemplate">
            <Viewbox Stretch="Uniform">
                <Border x:Name="Box" Width="24" Height="24" CornerRadius="6" Background="#525252">
                    <local:AppIcon x:Name="Glyph" Glyph="{x:Static local:AppIcons.More}" FontSize="13" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
            </Viewbox>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding}" Value="mechanic"><Setter TargetName="Box" Property="Background" Value="#B45309" /><Setter TargetName="Glyph" Property="Glyph" Value="&#xE90F;" /></DataTrigger>
                <DataTrigger Binding="{Binding}" Value="cable"><Setter TargetName="Box" Property="Background" Value="#0E7490" /><Setter TargetName="Glyph" Property="Glyph" Value="&#xE71B;" /></DataTrigger>
                <DataTrigger Binding="{Binding}" Value="device"><Setter TargetName="Box" Property="Background" Value="#4338CA" /><Setter TargetName="Glyph" Property="Glyph" Value="&#xE7F4;" /></DataTrigger>
                <DataTrigger Binding="{Binding}" Value="material"><Setter TargetName="Box" Property="Background" Value="#15803D" /><Setter TargetName="Glyph" Property="Glyph" Value="&#xE8F1;" /></DataTrigger>
                <DataTrigger Binding="{Binding}" Value="infra"><Setter TargetName="Box" Property="Background" Value="#BE123C" /><Setter TargetName="Glyph" Property="Glyph" Value="&#xE945;" /></DataTrigger>
                <DataTrigger Binding="{Binding}" Value="support"><Setter TargetName="Box" Property="Background" Value="#7C3AED" /><Setter TargetName="Glyph" Property="Glyph" Value="&#xE77B;" /></DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>
        <DataTemplate x:Key="TimelineCardTemplate">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="22" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <!-- Ray projenin renginde, kesintisiz; nokta işlem renginde (nötr işlemde proje renginde; yapılacakta kesik halka) -->
                <Rectangle Width="2" HorizontalAlignment="Center" Fill="{Binding ProjectColor}" Opacity="0.45" />
                <Ellipse x:Name="Dot" Width="12" Height="12" Margin="0,16,0,0" HorizontalAlignment="Center" VerticalAlignment="Top"
                         Fill="{Binding ProjectColor}" Stroke="{DynamicResource LayerBrush}" StrokeThickness="2" />
                <Grid Grid.Column="1" Margin="6,0,0,8">
                    <Border x:Name="Card" CornerRadius="9" BorderThickness="1" Padding="14,9,12,10" Cursor="Hand"
                            BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" Background="{DynamicResource SubtleFillColorTertiaryBrush}"
                            MouseLeftButtonDown="TimelineCard_MouseLeftButtonDown"
                            ContextMenuOpening="TimelineCard_ContextMenuOpening">
                        <Border.ContextMenu>
                            <ContextMenu />
                        </Border.ContextMenu>
                        <StackPanel>
                            <DockPanel>
                                <Button x:Name="OpenNote" DockPanel.Dock="Right" Margin="8,0,0,0" Padding="9,2" MinWidth="38" VerticalAlignment="Center"
                                        Visibility="Hidden" ToolTip="{x:Static res:Resources.Timeline_OpenNote}" Click="TimelineOpenNote_Click">
                                    <StackPanel Orientation="Horizontal">
                                        <local:AppIcon Glyph="{x:Static local:AppIcons.Note}" FontSize="12" VerticalAlignment="Center" />
                                        <TextBlock Margin="5,0,0,0" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center" Text="{x:Static res:Resources.Timeline_OpenNoteShort}" />
                                    </StackPanel>
                                </Button>
                                <TextBlock x:Name="When" DockPanel.Dock="Right" Margin="10,0,0,0" VerticalAlignment="Center" FontSize="12"
                                           Foreground="{DynamicResource TextTertiaryBrush}" Text="{Binding TimeText}" />
                                <Button DockPanel.Dock="Right" Margin="8,0,0,0" Padding="8,2" VerticalAlignment="Center" ToolTip="{x:Static res:Resources.Timeline_OpenFolder}"
                                        Visibility="{Binding HasFolder, Converter={StaticResource BoolToVis}}" Click="TimelineOpenFolder_Click">
                                    <StackPanel Orientation="Horizontal">
                                        <local:AppIcon Glyph="{x:Static local:AppIcons.Folder}" FontSize="12" VerticalAlignment="Center" Foreground="{DynamicResource SystemFillColorCautionBrush}" />
                                        <TextBlock Margin="5,0,0,0" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center" Text="{Binding FileCount}" />
                                    </StackPanel>
                                </Button>
                                <CheckBox x:Name="Check" DockPanel.Dock="Left" Margin="0,0,8,0" VerticalAlignment="Center" Visibility="Collapsed"
                                          Click="TimelineTask_Click" ToolTip="{x:Static res:Resources.Task_Hint}" />
                                <TextBlock DockPanel.Dock="Left" Margin="0,0,8,0" VerticalAlignment="Center" FontSize="12.5" FontWeight="SemiBold" Text="{Binding Source}" Foreground="{Binding ProjectColor}"
                                           Visibility="{Binding HasSource, Converter={StaticResource BoolToVis}}" />
                                <Border x:Name="KindChip" DockPanel.Dock="Left" Margin="0,0,8,0" Padding="7,2" CornerRadius="6" VerticalAlignment="Center"
                                        Background="{DynamicResource SubtleFillColorSecondaryBrush}">
                                    <StackPanel Orientation="Horizontal">
                                        <local:AppIcon x:Name="KindIcon" Glyph="{Binding Glyph}" FontSize="11" VerticalAlignment="Center" Foreground="{DynamicResource TextSecondaryBrush}" />
                                        <TextBlock x:Name="KindText" Margin="5,0,0,0" FontSize="11.5" VerticalAlignment="Center" Text="{Binding KindLabel}" Foreground="{DynamicResource TextSecondaryBrush}" />
                                    </StackPanel>
                                </Border>
                                <Border DockPanel.Dock="Left" Margin="0,0,8,0" Padding="3,2,8,2" CornerRadius="6" VerticalAlignment="Center"
                                        Background="{DynamicResource SubtleFillColorSecondaryBrush}" Visibility="{Binding HasSetting, Converter={StaticResource BoolToVis}}">
                                    <StackPanel Orientation="Horizontal">
                                        <ContentControl Width="16" Height="16" Focusable="False" Content="{Binding SettingIcon}" ContentTemplate="{StaticResource SettingIconTemplate}" />
                                        <TextBlock Margin="5,0,0,0" FontSize="11.5" VerticalAlignment="Center" Text="{Binding Setting}" />
                                    </StackPanel>
                                </Border>
                                <Border DockPanel.Dock="Left" Margin="0,0,8,0" Padding="3,2,8,2" CornerRadius="6" VerticalAlignment="Center"
                                        Background="{DynamicResource SubtleFillColorSecondaryBrush}" Visibility="{Binding IsRequest, Converter={StaticResource BoolToVis}}">
                                    <StackPanel Orientation="Horizontal">
                                        <ContentControl Width="16" Height="16" Focusable="False" Content="{Binding RequestIcon}" ContentTemplate="{StaticResource RequestIconTemplate}" />
                                        <TextBlock Margin="5,0,0,0" FontSize="11.5" VerticalAlignment="Center" Text="{Binding RequestType}" />
                                    </StackPanel>
                                </Border>
                                <Button DockPanel.Dock="Right" Margin="8,0,0,0" Padding="9,2" VerticalAlignment="Center" Click="TimelineDeliver_Click"
                                        Visibility="{Binding IsRequestOpen, Converter={StaticResource BoolToVis}}">
                                    <StackPanel Orientation="Horizontal">
                                        <local:AppIcon Glyph="{x:Static local:AppIcons.Check}" FontSize="11" VerticalAlignment="Center" Foreground="{DynamicResource SystemFillColorSuccessBrush}" />
                                        <TextBlock Margin="5,0,0,0" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center" Text="{x:Static res:Resources.Request_DeliverButton}" />
                                    </StackPanel>
                                </Button>
                                <Border x:Name="ReqStatus" DockPanel.Dock="Right" Margin="8,0,0,0" Padding="8,1" CornerRadius="6" VerticalAlignment="Center"
                                        Background="{DynamicResource SystemFillColorCautionBackgroundBrush}" Visibility="{Binding IsRequest, Converter={StaticResource BoolToVis}}">
                                    <TextBlock x:Name="ReqStatusText" FontSize="11.5" FontWeight="SemiBold" Text="{Binding RequestStatusText}" Foreground="{DynamicResource SystemFillColorCautionBrush}" />
                                </Border>
                                <Border x:Name="ResultBadge" DockPanel.Dock="Right" Margin="8,0,0,0" Padding="8,1" CornerRadius="6" VerticalAlignment="Center"
                                        Background="{DynamicResource SubtleFillColorSecondaryBrush}" Visibility="{Binding HasResult, Converter={StaticResource BoolToVis}}">
                                    <TextBlock x:Name="ResultLabel" FontSize="11.5" FontWeight="SemiBold" VerticalAlignment="Center" Text="{Binding ResultText}" Foreground="{DynamicResource TextSecondaryBrush}" />
                                </Border>
                                <Border x:Name="ImpBadge" DockPanel.Dock="Right" Margin="8,0,0,0" Padding="7,1" CornerRadius="9" VerticalAlignment="Center"
                                        Background="{DynamicResource SystemFillColorCautionBackgroundBrush}" Visibility="{Binding HasImportance, Converter={StaticResource BoolToVis}}">
                                    <StackPanel Orientation="Horizontal">
                                        <local:AppIcon x:Name="ImpIcon" Glyph="{Binding ImportanceGlyph}" FontSize="10" VerticalAlignment="Center" Foreground="{DynamicResource SystemFillColorCautionBrush}" />
                                        <TextBlock Margin="4,0,0,0" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center" Text="{Binding ImportanceText}" />
                                    </StackPanel>
                                </Border>
                                <TextBlock FontWeight="SemiBold" FontSize="14" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Text="{Binding Title}" ToolTip="{Binding Title}" />
                            </DockPanel>
                            <TextBlock x:Name="Desc" Margin="0,4,0,0" FontSize="13" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" Foreground="{DynamicResource TextSecondaryBrush}" Text="{Binding Description}"
                                       Visibility="{Binding HasDescription, Converter={StaticResource BoolToVis}}" />
                            <TextBlock Margin="0,4,0,0" FontSize="12.5" Foreground="{DynamicResource TextTertiaryBrush}" Text="{Binding RequestMeta}"
                                       Visibility="{Binding HasRequestMeta, Converter={StaticResource BoolToVis}}" />
                            <Border Margin="0,6,0,0" Padding="10,5" CornerRadius="6" Background="{DynamicResource SubtleFillColorSecondaryBrush}"
                                    Visibility="{Binding HasRequestLines, Converter={StaticResource BoolToVis}}">
                                <TextBlock FontSize="12.5" TextWrapping="Wrap" LineHeight="19" Text="{Binding RequestLines}" />
                            </Border>
                            <Border Margin="0,8,0,0" Padding="10,6" CornerRadius="0,6,6,0" BorderThickness="3,0,0,0" BorderBrush="{DynamicResource Pusula.EventPurpleBrush}"
                                    Background="{DynamicResource SubtleFillColorSecondaryBrush}" Visibility="{Binding HasDecisions, Converter={StaticResource BoolToVis}}">
                                <StackPanel>
                                    <TextBlock FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource Pusula.EventPurpleBrush}" Text="{x:Static res:Resources.Timeline_Decisions}" />
                                    <TextBlock x:Name="DecText" Margin="0,3,0,0" FontSize="13" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" Text="{Binding Decisions}" />
                                </StackPanel>
                            </Border>
                            <ItemsControl Margin="0,7,0,0" ItemsSource="{Binding Tags}" Focusable="False" Visibility="{Binding HasTags, Converter={StaticResource BoolToVis}}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border x:Name="Pill" Margin="0,0,6,4" Padding="8,1" CornerRadius="10" BorderThickness="1"
                                                BorderBrush="{DynamicResource AccentFillColorTertiaryBrush}" Background="{DynamicResource SubtleFillColorSecondaryBrush}">
                                            <StackPanel Orientation="Horizontal">
                                                <!-- Kişi: baş harfli yuvarlak (isme göre renk) ve ad soyad -->
                                                <Grid x:Name="Avatar" Width="18" Height="18" Margin="-5,0,6,0" VerticalAlignment="Center" Visibility="Collapsed">
                                                    <Ellipse Fill="{Binding AvatarColor}" />
                                                    <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="8.5" FontWeight="Bold" Foreground="White" Text="{Binding Initials}" />
                                                </Grid>
                                                <TextBlock x:Name="PillText" FontSize="11.5" VerticalAlignment="Center" Text="{Binding Text}" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" />
                                            </StackPanel>
                                        </Border>
                                        <DataTemplate.Triggers>
                                            <DataTrigger Binding="{Binding IsPerson}" Value="True">
                                                <Setter TargetName="PillText" Property="Text" Value="{Binding Name}" />
                                                <Setter TargetName="PillText" Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
                                                <Setter TargetName="Pill" Property="BorderBrush" Value="{DynamicResource ControlStrokeColorSecondaryBrush}" />
                                                <Setter TargetName="Pill" Property="Background" Value="{DynamicResource ControlFillColorDefaultBrush}" />
                                                <Setter TargetName="Pill" Property="Padding" Value="8,2,10,2" />
                                                <Setter TargetName="Avatar" Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </DataTemplate.Triggers>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>
                    <!-- Önem şeridi (önemli sarı, kritik kırmızı) -->
                    <Rectangle x:Name="ImpStrip" Width="3" HorizontalAlignment="Left" Margin="0,6" RadiusX="1.5" RadiusY="1.5" Fill="Transparent" />
                    <!-- Yapılacak: kesik çizgili çerçeve -->
                    <Rectangle x:Name="Dash" RadiusX="9" RadiusY="9" StrokeThickness="1" StrokeDashArray="4 3" Stroke="{DynamicResource TextTertiaryBrush}"
                               Visibility="Collapsed" IsHitTestVisible="False" />
                </Grid>
            </Grid>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding Tone}" Value="active">
                    <Setter TargetName="Dot" Property="Fill" Value="{DynamicResource AccentTextFillColorPrimaryBrush}" />
                    <Setter TargetName="KindIcon" Property="Foreground" Value="{DynamicResource AccentTextFillColorPrimaryBrush}" />
                    <Setter TargetName="KindText" Property="Foreground" Value="{DynamicResource AccentTextFillColorPrimaryBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Tone}" Value="done">
                    <Setter TargetName="Dot" Property="Fill" Value="{DynamicResource SystemFillColorSuccessBrush}" />
                    <Setter TargetName="KindIcon" Property="Foreground" Value="{DynamicResource SystemFillColorSuccessBrush}" />
                    <Setter TargetName="KindText" Property="Foreground" Value="{DynamicResource SystemFillColorSuccessBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Tone}" Value="waiting">
                    <Setter TargetName="Dot" Property="Fill" Value="{DynamicResource SystemFillColorCautionBrush}" />
                    <Setter TargetName="KindIcon" Property="Foreground" Value="{DynamicResource SystemFillColorCautionBrush}" />
                    <Setter TargetName="KindText" Property="Foreground" Value="{DynamicResource SystemFillColorCautionBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Tone}" Value="failed">
                    <Setter TargetName="Dot" Property="Fill" Value="{DynamicResource SystemFillColorCriticalBrush}" />
                    <Setter TargetName="KindIcon" Property="Foreground" Value="{DynamicResource SystemFillColorCriticalBrush}" />
                    <Setter TargetName="KindText" Property="Foreground" Value="{DynamicResource SystemFillColorCriticalBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Tone}" Value="purple">
                    <Setter TargetName="Dot" Property="Fill" Value="{DynamicResource Pusula.EventPurpleBrush}" />
                    <Setter TargetName="KindIcon" Property="Foreground" Value="{DynamicResource Pusula.EventPurpleBrush}" />
                    <Setter TargetName="KindText" Property="Foreground" Value="{DynamicResource Pusula.EventPurpleBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Tone}" Value="orange">
                    <Setter TargetName="Dot" Property="Fill" Value="{DynamicResource Pusula.EventOrangeBrush}" />
                    <Setter TargetName="KindIcon" Property="Foreground" Value="{DynamicResource Pusula.EventOrangeBrush}" />
                    <Setter TargetName="KindText" Property="Foreground" Value="{DynamicResource Pusula.EventOrangeBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding ImportanceRank}" Value="1">
                    <Setter TargetName="ImpStrip" Property="Fill" Value="{DynamicResource SystemFillColorCautionBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding ImportanceRank}" Value="2">
                    <Setter TargetName="ImpStrip" Property="Fill" Value="{DynamicResource SystemFillColorCriticalBrush}" />
                    <Setter TargetName="ImpBadge" Property="Background" Value="{DynamicResource SystemFillColorCriticalBackgroundBrush}" />
                    <Setter TargetName="ImpIcon" Property="Foreground" Value="{DynamicResource SystemFillColorCriticalBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsPlanned}" Value="True">
                    <Setter TargetName="Check" Property="Visibility" Value="Visible" />
                    <Setter TargetName="Dash" Property="Visibility" Value="Visible" />
                    <Setter TargetName="Card" Property="BorderBrush" Value="Transparent" />
                    <Setter TargetName="Card" Property="Background" Value="Transparent" />
                    <Setter TargetName="Dot" Property="Fill" Value="{DynamicResource LayerBrush}" />
                    <Setter TargetName="Dot" Property="Stroke" Value="{DynamicResource TextTertiaryBrush}" />
                    <Setter TargetName="Dot" Property="StrokeDashArray" Value="2 1.5" />
                </DataTrigger>
                <Trigger SourceName="Card" Property="IsMouseOver" Value="True">
                    <Setter TargetName="OpenNote" Property="Visibility" Value="Visible" />
                </Trigger>
                <DataTrigger Binding="{Binding IsExpanded}" Value="True">
                    <Setter TargetName="Desc" Property="Text" Value="{Binding FullDescription}" />
                    <Setter TargetName="Desc" Property="TextWrapping" Value="Wrap" />
                    <Setter TargetName="DecText" Property="TextWrapping" Value="Wrap" />
                    <Setter TargetName="Card" Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsLate}" Value="True">
                    <Setter TargetName="When" Property="Foreground" Value="{DynamicResource SystemFillColorCautionBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding RequestStatusKind}" Value="2">
                    <Setter TargetName="ReqStatus" Property="Background" Value="{DynamicResource SystemFillColorCriticalBackgroundBrush}" />
                    <Setter TargetName="ReqStatusText" Property="Foreground" Value="{DynamicResource SystemFillColorCriticalBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding RequestStatusKind}" Value="3">
                    <Setter TargetName="ReqStatus" Property="Background" Value="{DynamicResource SystemFillColorSuccessBackgroundBrush}" />
                    <Setter TargetName="ReqStatusText" Property="Foreground" Value="{DynamicResource SystemFillColorSuccessBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding ResultKind}" Value="1">
                    <Setter TargetName="ResultBadge" Property="Background" Value="{DynamicResource SystemFillColorSuccessBackgroundBrush}" />
                    <Setter TargetName="ResultLabel" Property="Foreground" Value="{DynamicResource SystemFillColorSuccessBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding ResultKind}" Value="2">
                    <Setter TargetName="ResultBadge" Property="Background" Value="{DynamicResource SystemFillColorCriticalBackgroundBrush}" />
                    <Setter TargetName="ResultLabel" Property="Foreground" Value="{DynamicResource SystemFillColorCriticalBrush}" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <!-- Zaman çizelgesi günü: başlık (rayın sürdüğü satır) ve kartlar; stok sayfası ve ana sayfa Günlük ortak -->
        <DataTemplate x:Key="TimelineDayTemplate">
            <StackPanel>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="22" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Rectangle Width="2" HorizontalAlignment="Center" Fill="{Binding RailColor}" Opacity="0.45" />
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="6,10,0,6">
                        <TextBlock FontSize="12" FontWeight="SemiBold" Text="{Binding Title}" Foreground="{DynamicResource TextSecondaryBrush}" />
                        <TextBlock Margin="6,0,0,0" FontSize="12" Text="{Binding Subtitle}" Foreground="{DynamicResource TextTertiaryBrush}" />
                    </StackPanel>
                </Grid>
                <ItemsControl ItemsSource="{Binding Cards}" ItemTemplate="{StaticResource TimelineCardTemplate}" Focusable="False" />
            </StackPanel>
        </DataTemplate>    </controls:ChromeWindow.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>


        <!-- Gövde: solda ağaç, sağda seçili düğüm -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="320" MinWidth="220" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Win11 düzeni: sağdaki içerik, zeminden ayrılan köşesi yuvarlak bir kart -->
            <Border Grid.Column="1"
                    Background="{DynamicResource LayerBrush}"
                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1,1,0,0"
                    CornerRadius="8,0,0,0" />

            <Border Grid.Column="0" Background="Transparent">
                <Grid x:Name="TreePane" SizeChanged="TreePane_SizeChanged">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" MinHeight="40" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" MinHeight="60" />
                    </Grid.RowDefinitions>

                    <!-- Ağaç başlığı: Ana sayfa satırı; altında Projeler + ekle + yenile + ayarlar, arama -->
                    <StackPanel Grid.Row="0">
                    <Button Margin="8,8,8,4" Padding="12,0" Height="38" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                            Click="HomeButton_Click">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                                <Setter Property="Background" Value="Transparent" />
                                <Setter Property="BorderThickness" Value="0" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasSelection}" Value="False">
                                        <Setter Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                        <StackPanel Orientation="Horizontal" Margin="8,0,0,0">
                            <local:AppIcon Glyph="&#xE80F;" FontSize="16" VerticalAlignment="Center" Foreground="{DynamicResource AccentBrush}" />
                            <TextBlock Margin="12,0,0,0" FontSize="14" Text="{x:Static res:Resources.Home_Button}" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Grid Margin="16,6,8,4">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <!-- Ağaçta ara: numara, ad, tanım -->
                        <controls:SearchBox Grid.Row="1" Grid.ColumnSpan="4" Margin="-4,8,0,0"
                                            PlaceholderText="{x:Static res:Resources.Tree_Search}"
                                            Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                                            Visibility="{Binding HasRoot, Converter={StaticResource BoolToVis}}" />
                        <TextBlock Grid.Column="0"
                                   FontSize="13" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   VerticalAlignment="Center"
                                   Text="{x:Static res:Resources.Tree_Header}" />
                        <Button x:Name="AddButton"
                                Grid.Column="1"
                                Width="34" Height="34"
                                Style="{DynamicResource IconButtonStyle}"
                                Click="AddButton_Click"
                                ToolTip="{x:Static res:Resources.Button_Add}">
                            <local:AppIcon Glyph="{x:Static local:AppIcons.Add}" FontSize="17" Foreground="{DynamicResource AccentBrush}" />
                        </Button>
                        <Button Grid.Column="2"
                                Command="{Binding RefreshCommand}"
                                Width="34" Height="34"
                                Margin="4,0,0,0">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource IconButtonStyle}">
                                    <Setter Property="ToolTip" Value="{x:Static res:Resources.Button_Refresh}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsDiskChanged}" Value="True">
                                            <Setter Property="ToolTip" Value="{x:Static res:Resources.Button_RefreshChanged}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                            <local:AppIcon Glyph="{x:Static local:AppIcons.Refresh}" FontSize="16">
                                <local:AppIcon.Style>
                                    <Style TargetType="local:AppIcon">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsDiskChanged}" Value="True">
                                                <Setter Property="Foreground" Value="{DynamicResource SystemFillColorCautionBrush}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </local:AppIcon.Style>
                            </local:AppIcon>
                        </Button>
                        <Button Grid.Column="3"
                                Width="34" Height="34" Margin="4,0,0,0"
                                Style="{DynamicResource IconButtonStyle}"
                                Click="Settings_Click"
                                ToolTip="{x:Static res:Resources.Button_Settings}">
                            <local:AppIcon Glyph="{x:Static local:AppIcons.Settings}" FontSize="16" />
                        </Button>
                    </Grid>
                    </StackPanel>

                    <TextBlock Grid.Row="1"
                               Margin="16,8"
                               TextWrapping="Wrap"
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               Text="{x:Static res:Resources.Tree_NoRoot}">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource CaptionTextBlockStyle}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasRoot}" Value="True">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>

                    <TreeView x:Name="FolderTree"
                              Grid.Row="1"
                              ItemsSource="{Binding ProjectNodes}"
                              Visibility="{Binding HasRoot, Converter={StaticResource BoolToVis}}"
                              ContextMenu="{StaticResource TreeMenu}"
                              Background="Transparent"
                              BorderThickness="0"
                              Padding="4"
                              SelectedItemChanged="FolderTree_SelectedItemChanged"
                              PreviewMouseRightButtonDown="FolderTree_PreviewMouseRightButtonDown">
                        <TreeView.ItemContainerStyle>
                            <Style TargetType="TreeViewItem" BasedOn="{StaticResource TreeItemStyle}">
                                <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}" />
                                <Setter Property="IsSelected" Value="{Binding IsSelected, Mode=TwoWay}" />
                                <Setter Property="ContextMenu" Value="{StaticResource NodeMenu}" />
                                <Setter Property="Visibility" Value="{Binding IsVisible, Converter={StaticResource BoolToVis}}" />

                            </Style>
                        </TreeView.ItemContainerStyle>
                        <TreeView.ItemTemplate>
                            <HierarchicalDataTemplate ItemsSource="{Binding Children}">
                                <StackPanel>
                                    <StackPanel x:Name="Row" Orientation="Horizontal" Margin="0,1" ToolTip="{Binding RowToolTip}">
                                        <local:AppIcon x:Name="Icon" Glyph="{Binding Glyph}" FontSize="15"
                                                           Style="{StaticResource TreeIconStyle}"
                                                           VerticalAlignment="Center" />
                                        <TextBlock x:Name="Title" Text="{Binding Title}" Margin="9,0,0,0" VerticalAlignment="Center" />
                                        <TextBlock x:Name="Subtitle" Text="{Binding DisplaySubtitle}" Margin="8,0,0,0" VerticalAlignment="Center" MaxWidth="120" TextWrapping="NoWrap"
                                                   TextTrimming="CharacterEllipsis"
                                                   Style="{DynamicResource CaptionTextBlockStyle}" Foreground="{DynamicResource TextTertiaryBrush}" />
                                    </StackPanel>
                                </StackPanel>
                                <HierarchicalDataTemplate.Triggers>
                                    <DataTrigger Binding="{Binding Kind}" Value="{x:Static core:FolderKind.InventoryGroup}">

                                        <Setter TargetName="Title" Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
                                        <Setter TargetName="Title" Property="FontWeight" Value="SemiBold" />
                                        <Setter TargetName="Icon" Property="FontSize" Value="14" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Kind}" Value="{x:Static core:FolderKind.InventoryItem}">
                                        <Setter TargetName="Subtitle" Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding IsUnmarkedInventory}" Value="True">
                                        <Setter TargetName="Subtitle" Property="Visibility" Value="Collapsed" />
                                        <Setter TargetName="Title" Property="Foreground" Value="{DynamicResource TextTertiaryBrush}" />
                                        <Setter TargetName="Title" Property="FontStyle" Value="Italic" />
                                    </DataTrigger>
                                    <!-- Henüz kaydı olmayan tür (Yazılımlar 0): soluk, ama tıklanıp kayıt eklenebilir -->
                                    <MultiDataTrigger>
                                        <MultiDataTrigger.Conditions>
                                            <Condition Binding="{Binding Kind}" Value="{x:Static core:FolderKind.InventoryType}" />
                                            <Condition Binding="{Binding Subtitle}" Value="0" />
                                        </MultiDataTrigger.Conditions>
                                        <Setter TargetName="Row" Property="Opacity" Value="0.55" />
                                    </MultiDataTrigger>
                                </HierarchicalDataTemplate.Triggers>
                            </HierarchicalDataTemplate>
                        </TreeView.ItemTemplate>
                    </TreeView>

                    <!-- Envanter ayrı bölmede; aradaki çizgi sürüklenerek boyutlanır -->
                    <Border Grid.Row="2" Height="1" Margin="12,2" VerticalAlignment="Center" IsHitTestVisible="False"
                            Background="{DynamicResource CardStrokeColorDefaultBrush}"
                            Visibility="{Binding HasInventory, Converter={StaticResource BoolToVis}}" />
                    <GridSplitter Grid.Row="2" Height="6" HorizontalAlignment="Stretch" ResizeDirection="Rows"
                                  Background="Transparent" Focusable="False"
                                  Visibility="{Binding HasInventory, Converter={StaticResource BoolToVis}}" />
                    <TreeView x:Name="InventoryTree"
                              Grid.Row="3"
                              ItemsSource="{Binding InventoryNodes}"
                              Visibility="{Binding HasInventory, Converter={StaticResource BoolToVis}}"
                              ItemContainerStyle="{Binding ItemContainerStyle, ElementName=FolderTree}"
                              ItemTemplate="{Binding ItemTemplate, ElementName=FolderTree}"
                              Background="Transparent"
                              BorderThickness="0"
                              Padding="4"
                              SelectedItemChanged="FolderTree_SelectedItemChanged"
                              PreviewMouseRightButtonDown="FolderTree_PreviewMouseRightButtonDown" />
                </Grid>
            </Border>

            <!-- Hiçbir şey seçili değil: başlangıç sayfası (son açılanlar, geciken işler, bana ait işler) -->
            <!-- Sekmeli sayfa: ana sayfa (kapsam: her şey) ve proje sayfası (kapsam: o proje) -->
            <Grid x:Name="HomePage" Grid.Column="1">
                <Grid.Style>
                    <Style TargetType="Grid">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsHomePageVisible}" Value="False">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Grid.Style>
                <Grid.Resources>
                    <DataTemplate x:Key="HomeTaskTemplate">
                        <Button Margin="0,0,0,6" Padding="12,8" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                                Click="HomeTask_Click" ToolTip="{x:Static res:Resources.Home_TaskHint}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="{Binding Text}" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Margin="0,2,0,0" Text="{Binding Meta}" TextTrimming="CharacterEllipsis"
                                               Style="{DynamicResource CaptionTextBlockStyle}" Foreground="{DynamicResource TextTertiaryBrush}" />
                                </StackPanel>
                                <TextBlock x:Name="Due" Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Top" Text="{Binding DueText}"
                                           Style="{DynamicResource CaptionTextBlockStyle}" Foreground="{DynamicResource TextSecondaryBrush}" />
                            </Grid>
                        </Button>
                        <DataTemplate.Triggers>
                            <DataTrigger Binding="{Binding IsLate}" Value="True">
                                <Setter TargetName="Due" Property="Foreground" Value="{DynamicResource SystemFillColorCriticalBrush}" />
                            </DataTrigger>
                        </DataTemplate.Triggers>
                    </DataTemplate>
                </Grid.Resources>
                <!-- Ana sayfa: yalnız sekmeler, tam genişlik ve yükseklik (her sekme kendi içinde kayar).
                     Proje kartları kaldırıldı (15.11.2026): projeler zaten sol menüde. -->
                <Grid Margin="32,28,32,0" TextElement.FontWeight="Normal">
                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>

                    <!-- Sekmeler (Günlük · Yapılacaklar · Kayıtlar); sağ üstte süzgeç -->
                    <!-- Proje sayfasında üstte proje başlığı: renk, kod, ad, sayılar; sağda Birim bilgisi yok (proje), Klasör ve ⋯ -->
                    <Grid Margin="0,0,0,18" Visibility="{Binding IsProjectScope, Converter={StaticResource BoolToVis}}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Grid Width="48" Height="48" VerticalAlignment="Top">
                            <Border CornerRadius="10" Background="{Binding ScopeProjectColor}" Opacity="0.18" />
                            <local:AppIcon Glyph="{x:Static local:AppIcons.Project}" FontSize="24" Foreground="{Binding ScopeProjectColor}"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Grid>
                        <StackPanel Grid.Column="1" Margin="16,0,0,0" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock FontSize="26" FontWeight="SemiBold" Text="{Binding ScopeProjectCode}" VerticalAlignment="Bottom" />
                                <TextBlock Margin="12,0,0,3" FontSize="18" Foreground="{DynamicResource TextSecondaryBrush}" Text="{Binding ScopeProjectName}" VerticalAlignment="Bottom" />
                            </StackPanel>
                            <TextBlock Margin="0,4,0,0" Text="{Binding ScopeProjectStats}" Style="{DynamicResource CaptionTextBlockStyle}" Foreground="{DynamicResource TextTertiaryBrush}" />
                        </StackPanel>
                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Top">
                            <Button Command="{Binding OpenFolderCommand}" ToolTip="{x:Static res:Resources.Header_FolderHint}">
                                <StackPanel Orientation="Horizontal">
                                    <local:AppIcon Glyph="{x:Static local:AppIcons.OpenFolder}" FontSize="14" VerticalAlignment="Center" />
                                    <TextBlock Text="{x:Static res:Resources.Header_Folder}" Margin="8,0,0,0" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                            <Button Margin="6,0,0,0" Style="{DynamicResource IconButtonStyle}" Click="HeaderMore_Click" ToolTip="{x:Static res:Resources.Header_More}">
                                <local:AppIcon Glyph="{x:Static local:AppIcons.More}" FontSize="16" />
                            </Button>
                        </StackPanel>
                    </Grid>

                    <Grid Grid.Row="1" Margin="0,0,0,20">
                        <Grid.Resources>
                            <!-- Parçalı süzgeç düğmesi: seçili parça dolgulu ve kalın, diğerleri soluk -->
                            <Style TargetType="TabItem" BasedOn="{StaticResource {x:Type TabItem}}">
                                <Setter Property="FontSize" Value="15" />
                            </Style>
                            <Style x:Key="SegmentStyle" TargetType="RadioButton">
                                <Setter Property="FontSize" Value="14" />
                                <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
                                <Setter Property="Cursor" Value="Hand" />
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="RadioButton">
                                            <Border x:Name="Bg" CornerRadius="4" Padding="12,4" Background="Transparent">
                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="Bg" Property="Background" Value="{DynamicResource SubtleFillColorTertiaryBrush}" />
                                                </Trigger>
                                                <Trigger Property="IsChecked" Value="True">
                                                    <Setter TargetName="Bg" Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
                                                    <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
                                                    <Setter Property="FontWeight" Value="SemiBold" />
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                            <Style x:Key="SegmentBox" TargetType="Border">
                                <Setter Property="CornerRadius" Value="6" />
                                <Setter Property="BorderThickness" Value="1" />
                                <Setter Property="BorderBrush" Value="{DynamicResource CardStrokeColorDefaultBrush}" />
                                <Setter Property="Background" Value="{DynamicResource LayerBrush}" />
                                <Setter Property="Padding" Value="2" />
                            </Style>
                        </Grid.Resources>

                        <TabControl SelectedIndex="{Binding HomeTab, Mode=TwoWay}" Background="Transparent">
                            <!-- Günlük: bütün stokların zaman çizelgesi kayıtları, en yeni üstte; kartta stok numarası, ray proje renginde -->
                            <TabItem Header="{x:Static res:Resources.Home_TabJournal}">
                                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,0,14,0">
                                <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" MaxWidth="1100" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                <StackPanel Margin="0,8,0,0">
                                    <ItemsControl ItemsSource="{Binding HomeTimeline}" ItemTemplate="{StaticResource TimelineDayTemplate}" Focusable="False" />
                                    <TextBlock Margin="2,4" Foreground="{DynamicResource TextTertiaryBrush}" Text="{x:Static res:Resources.Home_NoEvents}"
                                               Visibility="{Binding IsHomeTimelineEmpty, Converter={StaticResource BoolToVis}}" />
                                </StackPanel>
                                </Grid>
                                </ScrollViewer>
                            </TabItem>

                            <!-- Yapılacaklar: açık işler, son tarihe göre (gecikenler hep üstte, kırmızı) -->
                            <TabItem>
                                <TabItem.Header>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{x:Static res:Resources.Home_TabTasks}" />
                                        <!-- Bildirim rozeti: açık iş sayısı; geciken varsa kırmızı. Ayrıntı ipucunda ("9 açık · 1 geciken"). -->
                                        <Border Margin="8,0,0,0" MinWidth="20" Height="20" Padding="6,0" CornerRadius="10" VerticalAlignment="Center"
                                                ToolTip="{Binding HomeTaskSummary}"
                                                Visibility="{Binding HasHomeOpen, Converter={StaticResource BoolToVis}}">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding HasHomeLate}" Value="True">
                                                            <Setter Property="Background" Value="{DynamicResource SystemFillColorCriticalBrush}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <TextBlock Text="{Binding HomeOpenCount}" FontSize="11" FontWeight="SemiBold"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding HasHomeLate}" Value="True">
                                                                <Setter Property="Foreground" Value="White" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </Border>
                                    </StackPanel>
                                </TabItem.Header>
                                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,0,14,0">
                                <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" MaxWidth="1100" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                <StackPanel Margin="0,14,0,0">
                                    <Border CornerRadius="8" BorderThickness="1" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                                            Background="{DynamicResource LayerBrush}" Padding="4">
                                        <StackPanel>
                                            <ItemsControl ItemsSource="{Binding HomeTasks}" Focusable="False">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Button Padding="12,8" Margin="0,1" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                                                                Background="Transparent" BorderThickness="0" Click="HomeTask_Click">
                                                            <Grid>
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="Auto" />
                                                                    <ColumnDefinition Width="*" />
                                                                    <ColumnDefinition Width="Auto" />
                                                                </Grid.ColumnDefinitions>
                                                                <Ellipse Width="8" Height="8" VerticalAlignment="Center" Fill="{Binding ProjectColor}" />
                                                                <StackPanel Grid.Column="1" Margin="12,0,12,0">
                                                                    <TextBlock Text="{Binding Text}" TextTrimming="CharacterEllipsis" />
                                                                    <TextBlock Margin="0,2,0,0" Text="{Binding Label}" TextTrimming="CharacterEllipsis" FontSize="11"
                                                                               Foreground="{DynamicResource TextTertiaryBrush}" />
                                                                </StackPanel>
                                                                <TextBlock x:Name="Due" Grid.Column="2" VerticalAlignment="Center" Text="{Binding DueText}"
                                                                           Style="{DynamicResource CaptionTextBlockStyle}" Foreground="{DynamicResource TextSecondaryBrush}" />
                                                            </Grid>
                                                        </Button>
                                                        <DataTemplate.Triggers>
                                                            <DataTrigger Binding="{Binding IsLate}" Value="True">
                                                                <Setter TargetName="Due" Property="Foreground" Value="{DynamicResource SystemFillColorCriticalBrush}" />
                                                            </DataTrigger>
                                                        </DataTemplate.Triggers>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                            <TextBlock Margin="12,10" Foreground="{DynamicResource TextTertiaryBrush}" Text="{x:Static res:Resources.Home_NoTasks}"
                                                       Visibility="{Binding IsHomeTasksEmpty, Converter={StaticResource BoolToVis}}" />
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                                </Grid>
                                </ScrollViewer>
                            </TabItem>

                            <!-- Kayıtlar: üç görünüm (Projeler · Stoklar · Test yardımcı araçları; sağ üstte seçilir) ve ortak kapsam.
                                 Seçilen projeler stok listesini, seçilen stoklar araç listesini daraltır. Satıra tıklayınca kayıt açılır. -->
                            <TabItem Header="{x:Static res:Resources.Home_TabRecords}">
                                <Grid Margin="0,14,0,0">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="*" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <Grid.Resources>
                                        <!-- Çoklu seçim açılır listesi: düğme + altında onay kutulu liste (Tümünü seç · Temizle) -->
                                        <!-- Seçenek: yalnız numara (tanım ipucunda); satırlar aralıklı, üzerine gelince hafif vurgu -->
                                        <DataTemplate x:Key="ScopeOptionTemplate">
                                            <Border x:Name="Row" Padding="8,6" CornerRadius="4" Background="Transparent" ToolTip="{Binding Detail}">
                                                <CheckBox IsChecked="{Binding IsChecked, Mode=TwoWay}" VerticalContentAlignment="Center">
                                                    <StackPanel Orientation="Horizontal">
                                                        <Ellipse Width="8" Height="8" VerticalAlignment="Center" Fill="{Binding Color}" />
                                                        <TextBlock Margin="10,0,0,0" Text="{Binding Label}" VerticalAlignment="Center" />
                                                    </StackPanel>
                                                </CheckBox>
                                            </Border>
                                            <DataTemplate.Triggers>
                                                <Trigger SourceName="Row" Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="Row" Property="Background" Value="{DynamicResource SubtleFillColorTertiaryBrush}" />
                                                </Trigger>
                                            </DataTemplate.Triggers>
                                        </DataTemplate>
                                        <!-- Tablo satırı: düz zemin (zebra yok), ince ayraç, ferah yükseklik; ikincil sütunlar soluk -->
                                        <Style x:Key="RecordItemStyle" TargetType="ListViewItem" BasedOn="{StaticResource {x:Type ListViewItem}}">
                                            <EventSetter Event="MouseLeftButtonUp" Handler="RecordRow_Click" />
                                            <Setter Property="Cursor" Value="Hand" />
                                            <Setter Property="MinHeight" Value="42" />
                                            <Setter Property="Margin" Value="0" />
                                            <Setter Property="Background" Value="Transparent" />
                                            <Setter Property="BorderThickness" Value="0,0,0,1" />
                                            <Setter Property="BorderBrush" Value="{DynamicResource DividerStrokeColorDefaultBrush}" />
                                            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
                                            <Setter Property="FontWeight" Value="Normal" />
                                        </Style>
                                        <!-- Başlık: zeminsiz, küçük ve soluk; altında ince çizgi -->
                                        <Style TargetType="GridViewColumnHeader" BasedOn="{StaticResource {x:Type GridViewColumnHeader}}">
                                            <Setter Property="Background" Value="Transparent" />
                                            <Setter Property="BorderThickness" Value="0,0,0,1" />
                                            <Setter Property="BorderBrush" Value="{DynamicResource CardStrokeColorDefaultBrush}" />
                                            <Setter Property="Foreground" Value="{DynamicResource TextTertiaryBrush}" />
                                            <Setter Property="FontSize" Value="12" />
                                            <Setter Property="FontWeight" Value="Normal" />
                                            <Setter Property="HorizontalContentAlignment" Value="Left" />
                                            <Setter Property="Padding" Value="10,8" />
                                            <Setter Property="Cursor" Value="Hand" />
                                        </Style>
                                        <!-- Numara: kalın, ana renk; Ad: ana renk -->
                                        <DataTemplate x:Key="RecordNumberCell">
                                            <TextBlock Text="{Binding Number}" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" />
                                        </DataTemplate>
                                        <DataTemplate x:Key="RecordNameCell">
                                            <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" Foreground="{DynamicResource TextPrimaryBrush}" />
                                        </DataTemplate>
                                        <DataTemplate x:Key="RecordCodeCell">
                                            <TextBlock Text="{Binding Code}" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" />
                                        </DataTemplate>
                                        <Style x:Key="ScopePopupBox" TargetType="Border">
                                            <Setter Property="Margin" Value="0,4,0,0" />
                                            <Setter Property="Padding" Value="8,10" />
                                            <Setter Property="MinWidth" Value="220" />
                                            <Setter Property="CornerRadius" Value="8" />
                                            <Setter Property="BorderThickness" Value="1" />
                                            <Setter Property="BorderBrush" Value="{DynamicResource CardStrokeColorDefaultBrush}" />
                                            <Setter Property="Background" Value="{DynamicResource SurfaceBaseBrush}" />
                                        </Style>
                                    </Grid.Resources>

                                    <!-- Süzgeç satırı: Proje, Stok (Projeler görünümünde yok), araç türü ve alt tür (yalnız araçlarda), arama -->
                                    <Grid Margin="0,0,0,14">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <!-- İlk satır: kapsam (Proje, Stok) -->
                                            <StackPanel Orientation="Horizontal">
                                            <StackPanel Orientation="Horizontal" Visibility="{Binding IsProjectScope, Converter={StaticResource InverseBoolToVis}}">
                                            <TextBlock Margin="0,0,8,0" VerticalAlignment="Center" Foreground="{DynamicResource TextSecondaryBrush}" Text="{x:Static res:Resources.Col_Project}" />
                                            <ToggleButton x:Name="ProjectScopeButton" Padding="10,4" Margin="0,0,16,0">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="{Binding ScopeProjectText}" />
                                                    <TextBlock Margin="8,0,0,0" Text="▾" Foreground="{DynamicResource TextTertiaryBrush}" />
                                                </StackPanel>
                                            </ToggleButton>
                                            <Popup PlacementTarget="{Binding ElementName=ProjectScopeButton}" Placement="Bottom" StaysOpen="False" AllowsTransparency="True"
                                                   IsOpen="{Binding IsChecked, ElementName=ProjectScopeButton, Mode=TwoWay}">
                                                <Border Style="{StaticResource ScopePopupBox}">
                                                    <StackPanel>
                                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                                            <Button Style="{DynamicResource HyperlinkButtonStyle}" Padding="0" Content="{x:Static res:Resources.Scope_SelectAll}" Click="ScopeProjectsAll_Click" />
                                                            <TextBlock Margin="8,0" Text="·" Foreground="{DynamicResource TextTertiaryBrush}" />
                                                            <Button Style="{DynamicResource HyperlinkButtonStyle}" Padding="0" Content="{x:Static res:Resources.Scope_Clear}" Click="ScopeProjectsClear_Click" />
                                                        </StackPanel>
                                                        <ScrollViewer MaxHeight="320" VerticalScrollBarVisibility="Auto">
                                                            <ItemsControl ItemsSource="{Binding ProjectOptions}" ItemTemplate="{StaticResource ScopeOptionTemplate}" />
                                                        </ScrollViewer>
                                                    </StackPanel>
                                                </Border>
                                            </Popup>
                                            </StackPanel>

                                            <StackPanel Orientation="Horizontal" Visibility="{Binding IsViewProjects, Converter={StaticResource InverseBoolToVis}}">
                                                <TextBlock Margin="0,0,8,0" VerticalAlignment="Center" Foreground="{DynamicResource TextSecondaryBrush}" Text="{x:Static res:Resources.Col_Stock}" />
                                                <ToggleButton x:Name="StockScopeButton" Padding="10,4" Margin="0,0,16,0">
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Text="{Binding ScopeStockText}" />
                                                        <TextBlock Margin="8,0,0,0" Text="▾" Foreground="{DynamicResource TextTertiaryBrush}" />
                                                    </StackPanel>
                                                </ToggleButton>
                                                <Popup PlacementTarget="{Binding ElementName=StockScopeButton}" Placement="Bottom" StaysOpen="False" AllowsTransparency="True"
                                                       IsOpen="{Binding IsChecked, ElementName=StockScopeButton, Mode=TwoWay}">
                                                    <Border Style="{StaticResource ScopePopupBox}">
                                                        <StackPanel>
                                                            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                                                <Button Style="{DynamicResource HyperlinkButtonStyle}" Padding="0" Content="{x:Static res:Resources.Scope_SelectAll}" Click="ScopeStocksAll_Click" />
                                                                <TextBlock Margin="8,0" Text="·" Foreground="{DynamicResource TextTertiaryBrush}" />
                                                                <Button Style="{DynamicResource HyperlinkButtonStyle}" Padding="0" Content="{x:Static res:Resources.Scope_Clear}" Click="ScopeStocksClear_Click" />
                                                            </StackPanel>
                                                            <ScrollViewer MaxHeight="320" VerticalScrollBarVisibility="Auto">
                                                                <ItemsControl ItemsSource="{Binding StockOptions}" ItemTemplate="{StaticResource ScopeOptionTemplate}" />
                                                            </ScrollViewer>
                                                        </StackPanel>
                                                    </Border>
                                                </Popup>
                                            </StackPanel>

                                            </StackPanel>
                                            <!-- İkinci satır (yalnız araçlarda): Tür (tek seçim) ve Alt tür (ayrı süzgeç) -->
                                            <StackPanel Orientation="Horizontal" Margin="0,12,0,0" Visibility="{Binding IsViewTools, Converter={StaticResource BoolToVis}}">
                                                <TextBlock Margin="0,0,10,0" VerticalAlignment="Center" Foreground="{DynamicResource TextSecondaryBrush}" Text="{x:Static res:Resources.Col_Type}" />
                                                <Border Style="{StaticResource SegmentBox}" Margin="0,0,10,0">
                                                    <ItemsControl ItemsSource="{Binding ToolKindFilters}" Focusable="False">
                                                        <ItemsControl.ItemsPanel>
                                                            <ItemsPanelTemplate>
                                                                <StackPanel Orientation="Horizontal" />
                                                            </ItemsPanelTemplate>
                                                        </ItemsControl.ItemsPanel>
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate>
                                                                <RadioButton Style="{StaticResource SegmentStyle}" GroupName="ToolKind" IsChecked="{Binding IsSelected, Mode=TwoWay}">
                                                                    <StackPanel Orientation="Horizontal">
                                                                        <TextBlock Text="{Binding Label}" />
                                                                        <TextBlock Margin="6,0,0,0" Text="{Binding Count}" Foreground="{DynamicResource TextTertiaryBrush}" FontWeight="Normal" />
                                                                    </StackPanel>
                                                                </RadioButton>
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>
                                                </Border>
                                                <ComboBox MinWidth="150" VerticalAlignment="Center" ItemsSource="{Binding ToolSubTypes}" SelectedItem="{Binding ToolSubType, Mode=TwoWay}"
                                                          Visibility="{Binding HasToolSubTypes, Converter={StaticResource BoolToVis}}">
                                                    <ComboBox.ItemTemplate>
                                                        <DataTemplate>
                                                            <TextBlock x:Name="Text" Text="{Binding}" />
                                                            <DataTemplate.Triggers>
                                                                <DataTrigger Binding="{Binding}" Value="">
                                                                    <Setter TargetName="Text" Property="Text" Value="{x:Static res:Resources.Records_SubTypeAll}" />
                                                                </DataTrigger>
                                                            </DataTemplate.Triggers>
                                                        </DataTemplate>
                                                    </ComboBox.ItemTemplate>
                                                </ComboBox>
                                            </StackPanel>
                                        </StackPanel>
                                        <controls:SearchBox Grid.Column="1" Width="360" Margin="16,0,0,0" VerticalAlignment="Top" PlaceholderText="{x:Static res:Resources.Records_Search}"
                                                            Text="{Binding RecordSearch, UpdateSourceTrigger=PropertyChanged}" />
                                    </Grid>

                                    <!-- Projeler: istatistikler (dosya sayısı ve boyut arka planda gelir) -->
                                    <ListView x:Name="ProjectRecordsList" Grid.Row="1" ItemsSource="{Binding ProjectRows}"
                                              Visibility="{Binding IsViewProjects, Converter={StaticResource BoolToVis}}"
                                              GridViewColumnHeader.Click="RecordHeader_Click" SelectionChanged="RecordList_SelectionChanged" AlternationCount="0" BorderThickness="0" Background="Transparent">
                                        <ListView.ItemContainerStyle>
                                            <StaticResource ResourceKey="RecordItemStyle" />
                                        </ListView.ItemContainerStyle>
                                        <ListView.View>
                                            <GridView>
                                                <GridViewColumn Width="34">
                                                    <GridViewColumn.CellTemplate>
                                                        <DataTemplate><Ellipse Width="9" Height="9" Fill="{Binding Color}" /></DataTemplate>
                                                    </GridViewColumn.CellTemplate>
                                                </GridViewColumn>
                                                <GridViewColumn Width="90" CellTemplate="{StaticResource RecordCodeCell}"><GridViewColumnHeader Tag="Code" Content="{x:Static res:Resources.Col_Code}" /></GridViewColumn>
                                                <GridViewColumn Width="220" CellTemplate="{StaticResource RecordNameCell}"><GridViewColumnHeader Tag="Name" Content="{x:Static res:Resources.Col_Name}" /></GridViewColumn>
                                                <GridViewColumn Width="70" DisplayMemberBinding="{Binding Stocks}"><GridViewColumnHeader Tag="Stocks" Content="{x:Static res:Resources.Col_Stock}" /></GridViewColumn>
                                                <GridViewColumn Width="70" DisplayMemberBinding="{Binding Tools}"><GridViewColumnHeader Tag="Tools" Content="{x:Static res:Resources.Col_Tools}" /></GridViewColumn>
                                                <GridViewColumn Width="80" DisplayMemberBinding="{Binding OpenTasks}"><GridViewColumnHeader Tag="OpenTasks" Content="{x:Static res:Resources.Col_OpenTasks}" /></GridViewColumn>
                                                <GridViewColumn Width="90" DisplayMemberBinding="{Binding FilesText}"><GridViewColumnHeader Tag="Files" Content="{x:Static res:Resources.Col_Files}" /></GridViewColumn>
                                                <GridViewColumn Width="90" DisplayMemberBinding="{Binding SizeText}"><GridViewColumnHeader Tag="Bytes" Content="{x:Static res:Resources.Col_Size}" /></GridViewColumn>
                                                <GridViewColumn Width="110" DisplayMemberBinding="{Binding LastChangeText}"><GridViewColumnHeader Tag="LastChange" Content="{x:Static res:Resources.Col_LastChange}" /></GridViewColumn>
                                            </GridView>
                                        </ListView.View>
                                    </ListView>

                                    <!-- Stoklar: projeden bağımsız; kapsamdaki projelerin (ve seçilen stokların) hepsi -->
                                    <ListView x:Name="StockRecordsList" Grid.Row="1" ItemsSource="{Binding StockRows}"
                                              Visibility="{Binding IsViewStocks, Converter={StaticResource BoolToVis}}"
                                              GridViewColumnHeader.Click="RecordHeader_Click" SelectionChanged="RecordList_SelectionChanged" AlternationCount="0" BorderThickness="0" Background="Transparent">
                                        <ListView.ItemContainerStyle>
                                            <StaticResource ResourceKey="RecordItemStyle" />
                                        </ListView.ItemContainerStyle>
                                        <ListView.View>
                                            <GridView>
                                                <GridViewColumn Width="34">
                                                    <GridViewColumn.CellTemplate>
                                                        <DataTemplate><Ellipse Width="9" Height="9" Fill="{Binding Color}" /></DataTemplate>
                                                    </GridViewColumn.CellTemplate>
                                                </GridViewColumn>
                                                <GridViewColumn Width="120" CellTemplate="{StaticResource RecordNumberCell}"><GridViewColumnHeader Tag="Number" Content="{x:Static res:Resources.Col_Number}" /></GridViewColumn>
                                                <GridViewColumn Width="200" CellTemplate="{StaticResource RecordNameCell}"><GridViewColumnHeader Tag="Name" Content="{x:Static res:Resources.Col_Description}" /></GridViewColumn>
                                                <GridViewColumn Width="70" DisplayMemberBinding="{Binding Project}"><GridViewColumnHeader Tag="Project" Content="{x:Static res:Resources.Col_Project}" /></GridViewColumn>
                                                <GridViewColumn Width="110" DisplayMemberBinding="{Binding Template}"><GridViewColumnHeader Tag="Template" Content="{x:Static res:Resources.Col_Template}" /></GridViewColumn>
                                                <GridViewColumn Width="120" DisplayMemberBinding="{Binding Status}"><GridViewColumnHeader Tag="Status" Content="{x:Static res:Resources.Col_Status}" /></GridViewColumn>
                                                <GridViewColumn Width="70" DisplayMemberBinding="{Binding Tools}"><GridViewColumnHeader Tag="Tools" Content="{x:Static res:Resources.Col_Tools}" /></GridViewColumn>
                                                <GridViewColumn Width="80" DisplayMemberBinding="{Binding OpenTasks}"><GridViewColumnHeader Tag="OpenTasks" Content="{x:Static res:Resources.Col_OpenTasks}" /></GridViewColumn>
                                                <GridViewColumn Width="90" DisplayMemberBinding="{Binding SizeText}"><GridViewColumnHeader Tag="Bytes" Content="{x:Static res:Resources.Col_Size}" /></GridViewColumn>
                                                <GridViewColumn Width="110" DisplayMemberBinding="{Binding LastChangeText}"><GridViewColumnHeader Tag="LastChange" Content="{x:Static res:Resources.Col_LastChange}" /></GridViewColumn>
                                            </GridView>
                                        </ListView.View>
                                    </ListView>

                                    <!-- Test yardımcı araçları: kapsamdaki stoklara / projelere bağlı olanlar (kapsam yoksa hepsi) -->
                                    <ListView x:Name="ToolRecordsList" Grid.Row="1" ItemsSource="{Binding ToolRows}"
                                              Visibility="{Binding IsViewTools, Converter={StaticResource BoolToVis}}"
                                              GridViewColumnHeader.Click="RecordHeader_Click" SelectionChanged="RecordList_SelectionChanged" AlternationCount="0" BorderThickness="0" Background="Transparent">
                                        <ListView.ItemContainerStyle>
                                            <StaticResource ResourceKey="RecordItemStyle" />
                                        </ListView.ItemContainerStyle>
                                        <ListView.View>
                                            <GridView>
                                                <GridViewColumn Width="34">
                                                    <GridViewColumn.CellTemplate>
                                                        <DataTemplate><local:AppIcon Glyph="{Binding Glyph}" FontSize="14" Foreground="{Binding Color}" /></DataTemplate>
                                                    </GridViewColumn.CellTemplate>
                                                </GridViewColumn>
                                                <GridViewColumn Width="120" CellTemplate="{StaticResource RecordNumberCell}"><GridViewColumnHeader Tag="Number" Content="{x:Static res:Resources.Col_Number}" /></GridViewColumn>
                                                <GridViewColumn Width="200" CellTemplate="{StaticResource RecordNameCell}"><GridViewColumnHeader Tag="Name" Content="{x:Static res:Resources.Col_Name}" /></GridViewColumn>
                                                <GridViewColumn Width="70" DisplayMemberBinding="{Binding TypeName}"><GridViewColumnHeader Tag="TypeName" Content="{x:Static res:Resources.Col_Type}" /></GridViewColumn>
                                                <GridViewColumn Width="100" DisplayMemberBinding="{Binding SubType}"><GridViewColumnHeader Tag="SubType" Content="{x:Static res:Resources.Col_SubType}" /></GridViewColumn>
                                                <GridViewColumn Width="120" DisplayMemberBinding="{Binding AttachedTo}"><GridViewColumnHeader Tag="AttachedTo" Content="{x:Static res:Resources.Col_Attached}" /></GridViewColumn>
                                                <GridViewColumn Width="110" DisplayMemberBinding="{Binding Location}"><GridViewColumnHeader Tag="Location" Content="{x:Static res:Resources.Col_Location}" /></GridViewColumn>
                                                <GridViewColumn Width="130" DisplayMemberBinding="{Binding Status}"><GridViewColumnHeader Tag="Status" Content="{x:Static res:Resources.Col_Status}" /></GridViewColumn>
                                            </GridView>
                                        </ListView.View>
                                    </ListView>

                                    <!-- Alt satır: görünüme göre toplamlar (proje / stok durumları / araç türleri) -->
                                    <TextBlock Grid.Row="2" Margin="4,10,0,0" Text="{Binding RecordFooterText}"
                                               Style="{DynamicResource CaptionTextBlockStyle}" Foreground="{DynamicResource TextSecondaryBrush}" />
                                </Grid>
                            </TabItem>
                        </TabControl>

                        <!-- Zaman süzgeci (Günlük: geriye, Yapılacaklar: ileriye) -->
                        <Border Style="{StaticResource SegmentBox}" HorizontalAlignment="Right" VerticalAlignment="Top"
                                Visibility="{Binding IsHomeRecordsTab, Converter={StaticResource InverseBoolToVis}}">
                            <StackPanel Orientation="Horizontal">
                                <RadioButton Style="{StaticResource SegmentStyle}" GroupName="HomeRange" Content="{x:Static res:Resources.Home_RangeToday}" IsChecked="{Binding IsRangeToday, Mode=TwoWay}" />
                                <RadioButton Style="{StaticResource SegmentStyle}" GroupName="HomeRange" Content="{x:Static res:Resources.Home_RangeWeek}" IsChecked="{Binding IsRangeWeek, Mode=TwoWay}" />
                                <RadioButton Style="{StaticResource SegmentStyle}" GroupName="HomeRange" Content="{x:Static res:Resources.Home_RangeMonth}" IsChecked="{Binding IsRangeMonth, Mode=TwoWay}" />
                                <RadioButton Style="{StaticResource SegmentStyle}" GroupName="HomeRange" Content="{x:Static res:Resources.Home_RangeAll}" IsChecked="{Binding IsRangeAll, Mode=TwoWay}" />
                            </StackPanel>
                        </Border>
                        <!-- Görünüm seçici (Kayıtlar): Projeler · Stoklar · Test yardımcı araçları, yanlarında sayı -->
                        <Border Style="{StaticResource SegmentBox}" HorizontalAlignment="Right" VerticalAlignment="Top"
                                Visibility="{Binding IsHomeRecordsTab, Converter={StaticResource BoolToVis}}">
                            <StackPanel Orientation="Horizontal">
                                <RadioButton Style="{StaticResource SegmentStyle}" GroupName="RecordView" IsChecked="{Binding IsViewProjects, Mode=TwoWay}"
                                             Visibility="{Binding IsProjectScope, Converter={StaticResource InverseBoolToVis}}">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{x:Static res:Resources.Records_ViewProjects}" />
                                        <TextBlock Margin="6,0,0,0" Text="{Binding ProjectRowCount}" Foreground="{DynamicResource TextTertiaryBrush}" FontWeight="Normal" />
                                    </StackPanel>
                                </RadioButton>
                                <RadioButton Style="{StaticResource SegmentStyle}" GroupName="RecordView" IsChecked="{Binding IsViewStocks, Mode=TwoWay}">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{x:Static res:Resources.Records_ViewStocks}" />
                                        <TextBlock Margin="6,0,0,0" Text="{Binding StockRowCount}" Foreground="{DynamicResource TextTertiaryBrush}" FontWeight="Normal" />
                                    </StackPanel>
                                </RadioButton>
                                <RadioButton Style="{StaticResource SegmentStyle}" GroupName="RecordView" IsChecked="{Binding IsViewTools, Mode=TwoWay}">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{x:Static res:Resources.Records_ViewTools}" />
                                        <TextBlock Margin="6,0,0,0" Text="{Binding ToolRowCount}" Foreground="{DynamicResource TextTertiaryBrush}" FontWeight="Normal" />
                                    </StackPanel>
                                </RadioButton>
                            </StackPanel>
                        </Border>
                    </Grid>
                </Grid>
            </Grid>

            <!-- Seçili düğüm: başlık, özet kutucukları, tablo -->
            <Grid Grid.Column="1"
                  Margin="32,20,32,12"
                  Visibility="{Binding IsDetailVisible, Converter={StaticResource BoolToVis}}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Başlık: numara + ad, üst kayıt (tıklanır) › tür / şablon, durum; sağda klasör ve ⋯ menüsü. Yol ipucunda. -->
                <Grid Grid.Row="0" DataContext="{Binding SelectedNode}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <local:AppIcon Grid.Column="0" Glyph="{Binding Glyph}" FontSize="38"
                                       Style="{StaticResource KindIconStyle}"
                                       VerticalAlignment="Top" Margin="0,4,20,0" />
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <WrapPanel ToolTip="{Binding Path}">
                            <TextBlock x:Name="HeaderTitle" FontSize="26" FontWeight="SemiBold" Text="{Binding Title}" VerticalAlignment="Bottom" />
                            <TextBlock Margin="14,0,0,3" FontSize="18" VerticalAlignment="Bottom" TextTrimming="CharacterEllipsis"
                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                       Text="{Binding DataContext.Detail.HeaderName, RelativeSource={RelativeSource AncestorType=Window}}" />
                        </WrapPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                            <Button Style="{DynamicResource HyperlinkButtonStyle}" Padding="0" Click="HeaderParent_Click"
                                    Content="{Binding DataContext.Detail.ParentName, RelativeSource={RelativeSource AncestorType=Window}}"
                                    ToolTip="{x:Static res:Resources.Header_GoParent}"
                                    Visibility="{Binding DataContext.Detail.HasParent, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVis}}" />
                            <!-- "›" yalnız üst kayıt ve yanında yazı (şablon, tür) varken -->
                            <TextBlock Margin="8,0,8,0" VerticalAlignment="Center" Foreground="{DynamicResource TextTertiaryBrush}" Text="›">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding DataContext.Detail.HasParent, RelativeSource={RelativeSource AncestorType=Window}}" Value="False">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding DataContext.Detail.ContextText, RelativeSource={RelativeSource AncestorType=Window}}" Value="">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                            <TextBlock VerticalAlignment="Center" Foreground="{DynamicResource TextSecondaryBrush}"
                                       Text="{Binding DataContext.Detail.ContextText, RelativeSource={RelativeSource AncestorType=Window}}" />
                        </StackPanel>
                        <!-- Proje / stok etiketleri (#SATIMO …): çip olarak; düzenle penceresinden verilir -->
                        <ItemsControl x:Name="HeaderTags" Margin="0,8,0,-6" ItemsSource="{Binding DataContext.Detail.Tags, RelativeSource={RelativeSource AncestorType=Window}}"
                                      Visibility="{Binding DataContext.Detail.HasTags, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVis}}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Margin="0,0,6,6" Padding="8,2" CornerRadius="{DynamicResource ControlCornerRadius}" Background="{DynamicResource SubtleFillColorSecondaryBrush}">
                                        <TextBlock Text="{Binding}" Style="{DynamicResource CaptionTextBlockStyle}" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" />
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <!-- Stok durum çipi kaldırıldı (15.11.2026); yalnız envanter kaydının durumu kalır. -->
                        <StackPanel Orientation="Horizontal" Margin="0,12,0,0"
                                    Visibility="{Binding DataContext.Inventory.IsRecord, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVis}}">
                            <controls:DropDownButton Padding="4,2"
                                                     VerticalAlignment="Center"
                                                     Menu="{StaticResource InventoryStatusMenu}"
                                                     ToolTip="{x:Static res:Resources.Status_ChangeHint}"
                                                     Visibility="{Binding DataContext.Inventory.IsRecord, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVis}}">
                                <ContentPresenter Content="{Binding DataContext.Inventory.Status, RelativeSource={RelativeSource AncestorType=Window}}"
                                                  ContentTemplate="{DynamicResource StatusChipTemplate}" />
                            </controls:DropDownButton>
                            <TextBlock Margin="12,0,0,0"
                                       VerticalAlignment="Center"
                                       Style="{DynamicResource CaptionTextBlockStyle}"
                                       Foreground="{DynamicResource TextTertiaryBrush}"
                                       Text="{Binding DataContext.Inventory.StatusInfo, RelativeSource={RelativeSource AncestorType=Window}}"
                                       Visibility="{Binding DataContext.Inventory.IsRecord, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVis}}" />
                        </StackPanel>
                    </StackPanel>
                    <!-- Sağ üst: Birim bilgisi (stokun ana md'si, yoksa oluşturur) · Klasör (Gezgin'de) · ⋯ -->
                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Top">
                        <Button Margin="0,0,6,0" Click="HeaderUnitInfo_Click" ToolTip="{x:Static res:Resources.Header_UnitInfoHint}"
                                Visibility="{Binding DataContext.Detail.IsStock, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVis}}">
                            <StackPanel Orientation="Horizontal">
                                <local:AppIcon Glyph="{x:Static local:AppIcons.Note}" FontSize="14" VerticalAlignment="Center" />
                                <TextBlock Text="{x:Static res:Resources.Header_UnitInfo}" Margin="8,0,0,0" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <Button Command="{Binding DataContext.OpenFolderCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                ToolTip="{x:Static res:Resources.Header_FolderHint}">
                            <StackPanel Orientation="Horizontal">
                                <local:AppIcon Glyph="{x:Static local:AppIcons.OpenFolder}" FontSize="14" VerticalAlignment="Center" />
                                <TextBlock Text="{x:Static res:Resources.Header_Folder}" Margin="8,0,0,0" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <Button x:Name="HeaderMoreButton" Margin="6,0,0,0" Style="{DynamicResource IconButtonStyle}" Click="HeaderMore_Click"
                                ToolTip="{x:Static res:Resources.Header_More}">
                            <local:AppIcon Glyph="{x:Static local:AppIcons.More}" FontSize="16" />
                        </Button>
                    </StackPanel>
                </Grid>

                <!-- Hesaplanıyor -->
                <StackPanel Grid.Row="3" Orientation="Horizontal" VerticalAlignment="Top" Margin="0,16,0,0"
                            Visibility="{Binding Detail.IsLoading, Converter={StaticResource BoolToVis}}">
                    <controls:ProgressRing Width="16" Height="16" IsActive="True" />
                    <TextBlock Margin="8,0,0,0" Foreground="{DynamicResource TextSecondaryBrush}"
                               Text="{x:Static res:Resources.Detail_Loading}" />
                </StackPanel>

                <!-- Stok sayfası (15.11.2026): sayı satırı; solda TEÜ görünümü, sağda zaman çizelgesi; altta sekmeler
                     Doğrulamalar · Yapılacaklar · Test yardımcı araçları. -->
                <Grid Grid.Row="1" Grid.RowSpan="4" Margin="0,10,0,0" TextElement.FontWeight="Normal"
                      Visibility="{Binding Detail.IsStock, Converter={StaticResource BoolToVis}}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="440" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Grid.Resources>
                        <Style x:Key="StockSegment" TargetType="RadioButton">
                            <Setter Property="FontSize" Value="13" />
                            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
                            <Setter Property="Cursor" Value="Hand" />
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="RadioButton">
                                        <Border x:Name="Bg" CornerRadius="4" Padding="10,3" Background="Transparent">
                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Bg" Property="Background" Value="{DynamicResource SubtleFillColorTertiaryBrush}" />
                                            </Trigger>
                                            <Trigger Property="IsChecked" Value="True">
                                                <Setter TargetName="Bg" Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
                                                <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
                                                <Setter Property="FontWeight" Value="SemiBold" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                        <Style TargetType="TabItem" BasedOn="{StaticResource {x:Type TabItem}}">
                            <Setter Property="FontSize" Value="15" />
                        </Style>
                    </Grid.Resources>

                    <!-- Sayı satırı: açık iş, boyut, seri no'lar -->
                    <WrapPanel Margin="0,0,0,12" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" Visibility="{Binding VerificationCount, Converter={StaticResource CountToVis}}">
                            <TextBlock VerticalAlignment="Center" Text="{Binding StockVerificationText}" Foreground="{DynamicResource TextSecondaryBrush}" />
                            <ProgressBar Margin="10,0,0,0" Width="80" Height="4" MinHeight="4" VerticalAlignment="Center" Maximum="100"
                                         Value="{Binding VerificationProgress, Mode=OneWay}" Foreground="{DynamicResource SystemFillColorSuccessBrush}" />
                            <TextBlock Margin="12,0" VerticalAlignment="Center" Text="·" Foreground="{DynamicResource TextTertiaryBrush}" />
                        </StackPanel>
                        <TextBlock VerticalAlignment="Center" Text="{Binding StockTasksText}" Foreground="{DynamicResource TextSecondaryBrush}" />
                        <TextBlock Margin="12,0" VerticalAlignment="Center" Text="·" Foreground="{DynamicResource TextTertiaryBrush}" />
                        <TextBlock VerticalAlignment="Center" FontWeight="SemiBold" Text="{Binding StockSizeText}" />
                        <StackPanel Orientation="Horizontal" Visibility="{Binding HasStockSerials, Converter={StaticResource BoolToVis}}">
                            <TextBlock Margin="12,0" VerticalAlignment="Center" Text="·" Foreground="{DynamicResource TextTertiaryBrush}" />
                            <TextBlock Margin="0,0,8,0" VerticalAlignment="Center" Text="{x:Static res:Resources.Stock_Serials}" Foreground="{DynamicResource TextSecondaryBrush}" />
                            <ItemsControl ItemsSource="{Binding StockSerials}" Focusable="False" VerticalAlignment="Center">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel Orientation="Horizontal" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Margin="0,0,6,0" Padding="7,1" CornerRadius="5" Background="{DynamicResource SubtleFillColorSecondaryBrush}">
                                            <TextBlock Text="{Binding}" FontSize="12" />
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </WrapPanel>

                    <!-- Üst: solda TEÜ görünümü, sağda zaman çizelgesi -->
                    <Grid Grid.Row="1">
                        <Grid.ColumnDefinitions>
                            <!-- Fotoğraf yoksa kapak daralır, çizelge genişler -->
                            <ColumnDefinition>
                                <ColumnDefinition.Style>
                                    <Style TargetType="ColumnDefinition">
                                        <Setter Property="Width" Value="360" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Detail.Cover.HasCover}" Value="False">
                                                <Setter Property="Width" Value="190" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </ColumnDefinition.Style>
                            </ColumnDefinition>
                            <ColumnDefinition Width="18" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border CornerRadius="10" BorderThickness="1" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" Background="{DynamicResource LayerBrush}"
                                Cursor="Hand" MouseLeftButtonUp="StockCover_MouseLeftButtonUp" ToolTip="{Binding Detail.Cover.CoverPhoto}">
                            <Grid>
                                <Image Margin="10" Stretch="Uniform" Source="{Binding Detail.Cover.CoverPhoto, Converter={StaticResource PathToImage}}"
                                       Visibility="{Binding Detail.Cover.HasCover, Converter={StaticResource BoolToVis}}" />
                                <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" Margin="20"
                                           Foreground="{DynamicResource TextTertiaryBrush}" Text="{x:Static res:Resources.Stock_NoCover}"
                                           Visibility="{Binding Detail.Cover.HasCover, Converter={StaticResource InverseBoolToVis}}" />
                            </Grid>
                        </Border>
                        <Border Grid.Column="2" CornerRadius="10" BorderThickness="1" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                                Background="{DynamicResource LayerBrush}" Padding="14,10,6,8">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>
                                <Grid Margin="0,0,8,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center" Text="{x:Static res:Resources.Stock_Timeline}" />
                                    <Border Grid.Column="1" CornerRadius="6" BorderThickness="1" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" Padding="2" VerticalAlignment="Center">
                                        <StackPanel Orientation="Horizontal">
                                            <RadioButton Style="{StaticResource StockSegment}" GroupName="StockRange" Content="{x:Static res:Resources.Home_RangeToday}" IsChecked="{Binding IsRangeToday, Mode=TwoWay}" />
                                            <RadioButton Style="{StaticResource StockSegment}" GroupName="StockRange" Content="{x:Static res:Resources.Home_RangeWeek}" IsChecked="{Binding IsRangeWeek, Mode=TwoWay}" />
                                            <RadioButton Style="{StaticResource StockSegment}" GroupName="StockRange" Content="{x:Static res:Resources.Home_RangeMonth}" IsChecked="{Binding IsRangeMonth, Mode=TwoWay}" />
                                            <RadioButton Style="{StaticResource StockSegment}" GroupName="StockRange" Content="{x:Static res:Resources.Home_RangeAll}" IsChecked="{Binding IsRangeAll, Mode=TwoWay}" />
                                        </StackPanel>
                                    </Border>
                                    <Button Grid.Column="2" Margin="8,0,0,0" Padding="12,5" HorizontalAlignment="Left" Click="TaskDialogOpen_Click" ToolTip="{x:Static res:Resources.Timeline_AddTaskHint}">
                                        <StackPanel Orientation="Horizontal">
                                            <local:AppIcon Glyph="{x:Static local:AppIcons.Add}" FontSize="12" VerticalAlignment="Center" />
                                            <TextBlock Margin="6,0,0,0" VerticalAlignment="Center" Text="{x:Static res:Resources.Timeline_AddTask}" />
                                        </StackPanel>
                                    </Button>
                                    <Button Grid.Column="3" Margin="8,0,0,0" Style="{DynamicResource AccentButtonStyle}" Padding="12,5" Click="TimelineAdd_Click" ToolTip="{x:Static res:Resources.Timeline_AddHint}">
                                        <StackPanel Orientation="Horizontal">
                                            <local:AppIcon Glyph="{x:Static local:AppIcons.Add}" FontSize="12" VerticalAlignment="Center" />
                                            <TextBlock Margin="6,0,0,0" VerticalAlignment="Center" Text="{x:Static res:Resources.Timeline_Add}" />
                                        </StackPanel>
                                    </Button>
                                </Grid>
                                <Border Grid.Row="1" Margin="0,0,0,6" HorizontalAlignment="Left" CornerRadius="6" BorderThickness="1" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" Padding="2">
                                    <StackPanel Orientation="Horizontal">
                                        <RadioButton Style="{StaticResource StockSegment}" GroupName="TimelineFilter" Content="{x:Static res:Resources.Timeline_FilterAll}" IsChecked="{Binding IsTimelineAll, Mode=TwoWay}" />
                                        <RadioButton Style="{StaticResource StockSegment}" GroupName="TimelineFilter" Content="{x:Static res:Resources.Timeline_FilterDone}" IsChecked="{Binding IsTimelineDone, Mode=TwoWay}" />
                                        <RadioButton Style="{StaticResource StockSegment}" GroupName="TimelineFilter" Content="{x:Static res:Resources.Timeline_FilterPlanned}" IsChecked="{Binding IsTimelinePlanned, Mode=TwoWay}" />
                                        <RadioButton Style="{StaticResource StockSegment}" GroupName="TimelineFilter" Content="{x:Static res:Resources.Timeline_FilterImportant}" IsChecked="{Binding IsTimelineImportant, Mode=TwoWay}" />
                                    </StackPanel>
                                </Border>
                                <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,0,8,0">
                                    <StackPanel>
                                        <ItemsControl ItemsSource="{Binding StockDays}" ItemTemplate="{StaticResource TimelineDayTemplate}" Focusable="False" />
                                        <TextBlock Margin="2,6" Foreground="{DynamicResource TextTertiaryBrush}" Text="{x:Static res:Resources.Stock_NoEvents}"
                                                   Visibility="{Binding IsStockTimelineEmpty, Converter={StaticResource BoolToVis}}" />
                                    </StackPanel>
                                </ScrollViewer>
                            </Grid>
                        </Border>
                    </Grid>

                    <!-- Sekmeler -->
                    <TabControl Grid.Row="2" Margin="0,16,0,0" Background="Transparent">
                        <!-- Doğrulamalar: 03_Testler\<stok>_Test_Gereksinimleri.md tablosu, gruba göre; üstte grup süzgeci ve "+ Madde" -->
                        <TabItem>
                            <TabItem.Header>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{x:Static res:Resources.Stock_TabVerification}" />
                                    <TextBlock Margin="8,0,0,0" Text="{Binding VerificationCount}" Foreground="{DynamicResource TextTertiaryBrush}" FontWeight="Normal" />
                                </StackPanel>
                            </TabItem.Header>
                            <Grid Margin="0,10,0,0" TextElement.FontWeight="Normal" TextElement.FontSize="14">
                                <Grid.Resources>
                                    <!-- Satır: ince ayraç, üstüne gelince hafif dolgu; tıklanınca açılır -->
                                    <Style x:Key="VerificationRowBorder" TargetType="Border">
                                        <Setter Property="Padding" Value="0,12,8,12" />
                                        <Setter Property="CornerRadius" Value="9" />
                                        <Setter Property="Background" Value="Transparent" />
                                        <Setter Property="Cursor" Value="Hand" />
                                        <Style.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
                                            </Trigger>
                                        </Style.Triggers>
                                    </Style>
                                    <!-- Sütun ayırıcısı: başlıkta ince çizgi, üstüne gelince vurgulu; sürüklenince sütun genişliği değişir -->
                                    <Style x:Key="ColumnGrip" TargetType="Thumb">
                                        <Setter Property="Width" Value="9" />
                                        <Setter Property="Margin" Value="-4,-4,-4,-4" />
                                        <Setter Property="Cursor" Value="SizeWE" />
                                        <Setter Property="Focusable" Value="False" />
                                        <Setter Property="ToolTip" Value="{x:Static res:Resources.Verify_ColumnGripHint}" />
                                        <EventSetter Event="DragDelta" Handler="VerificationColumn_DragDelta" />
                                        <EventSetter Event="DragCompleted" Handler="VerificationColumn_DragCompleted" />
                                        <EventSetter Event="MouseDoubleClick" Handler="VerificationColumn_MouseDoubleClick" />
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="Thumb">
                                                    <Grid Background="Transparent">
                                                        <Rectangle x:Name="Line" Width="1" Margin="0,2" HorizontalAlignment="Center" Fill="{DynamicResource DividerStrokeColorDefaultBrush}" />
                                                    </Grid>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter TargetName="Line" Property="Width" Value="2" />
                                                            <Setter TargetName="Line" Property="Fill" Value="{DynamicResource AccentFillColorDefaultBrush}" />
                                                        </Trigger>
                                                        <Trigger Property="IsDragging" Value="True">
                                                            <Setter TargetName="Line" Property="Width" Value="2" />
                                                            <Setter TargetName="Line" Property="Fill" Value="{DynamicResource AccentFillColorDefaultBrush}" />
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                    <!-- Madde kartı: ince kenarlık, yuvarlak köşe; açılınca kenarlık vurgulanır -->
                                    <Style x:Key="VerificationCard" TargetType="Border">
                                        <Setter Property="Margin" Value="0,0,0,8" />
                                        <Setter Property="CornerRadius" Value="10" />
                                        <Setter Property="BorderThickness" Value="1" />
                                        <Setter Property="BorderBrush" Value="{DynamicResource CardStrokeColorDefaultBrush}" />
                                        <Setter Property="Background" Value="{DynamicResource CardBackgroundFillColorDefaultBrush}" />
                                    </Style>
                                    <!-- Süzgeç hapı: grup noktası, ad, sayı rozeti; seçili olan vurgulu -->
                                    <Style x:Key="VerificationPill" TargetType="RadioButton">
                                        <Setter Property="Margin" Value="0,0,8,0" />
                                        <Setter Property="Focusable" Value="False" />
                                        <Setter Property="Cursor" Value="Hand" />
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="RadioButton">
                                                    <Border x:Name="Pill" CornerRadius="16" Padding="12,5,6,5" BorderThickness="1"
                                                            Background="{DynamicResource ControlFillColorDefaultBrush}" BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}">
                                                        <StackPanel Orientation="Horizontal">
                                                            <Ellipse x:Name="Dot" Width="8" Height="8" Margin="0,0,7,0" VerticalAlignment="Center" Fill="{DynamicResource TextTertiaryBrush}" />
                                                            <TextBlock x:Name="Label" VerticalAlignment="Center" FontSize="13" Text="{Binding Text}" Foreground="{DynamicResource TextSecondaryBrush}" />
                                                            <Border x:Name="Badge" Margin="8,0,0,0" MinWidth="22" Height="20" Padding="6,0" CornerRadius="10" Background="{DynamicResource SubtleFillColorSecondaryBrush}">
                                                                <TextBlock x:Name="BadgeText" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="11.5" Text="{Binding Badge}" Foreground="{DynamicResource TextSecondaryBrush}" />
                                                            </Border>
                                                        </StackPanel>
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <DataTrigger Binding="{Binding Tone}" Value="-1"><Setter TargetName="Dot" Property="Visibility" Value="Collapsed" /></DataTrigger>
                                                        <DataTrigger Binding="{Binding Tone}" Value="0"><Setter TargetName="Dot" Property="Fill" Value="{DynamicResource AccentTextFillColorPrimaryBrush}" /></DataTrigger>
                                                        <DataTrigger Binding="{Binding Tone}" Value="1"><Setter TargetName="Dot" Property="Fill" Value="{DynamicResource SystemFillColorSuccessBrush}" /></DataTrigger>
                                                        <DataTrigger Binding="{Binding Tone}" Value="2"><Setter TargetName="Dot" Property="Fill" Value="{DynamicResource SystemFillColorCautionBrush}" /></DataTrigger>
                                                        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Pill" Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}" /></Trigger>
                                                        <Trigger Property="IsChecked" Value="True">
                                                            <Setter TargetName="Pill" Property="BorderBrush" Value="{DynamicResource AccentFillColorDefaultBrush}" />
                                                            <Setter TargetName="Pill" Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
                                                            <Setter TargetName="Label" Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
                                                            <Setter TargetName="Label" Property="FontWeight" Value="SemiBold" />
                                                            <Setter TargetName="Badge" Property="Background" Value="{DynamicResource AccentFillColorDefaultBrush}" />
                                                            <Setter TargetName="BadgeText" Property="Foreground" Value="{DynamicResource TextOnAccentFillColorPrimaryBrush}" />
                                                            <Setter TargetName="BadgeText" Property="FontWeight" Value="Bold" />
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </Grid.Resources>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>

                                <!-- Süzgeç hapları + düğmeler -->
                                <Grid Grid.Row="0" Margin="0,0,0,12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <ItemsControl ItemsSource="{Binding VerificationFilters}" Focusable="False" VerticalAlignment="Center">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <WrapPanel Orientation="Horizontal" />
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <RadioButton Style="{StaticResource VerificationPill}" GroupName="VerificationFilter" IsChecked="{Binding IsChecked, Mode=TwoWay}" />
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                        <Button Margin="0,0,8,0" Padding="12,6" Command="{Binding OpenVerificationFileCommand}" ToolTip="{x:Static res:Resources.Verify_OpenFileHint}"
                                                Visibility="{Binding HasVerificationFile, Converter={StaticResource BoolToVis}}">
                                            <StackPanel Orientation="Horizontal">
                                                <local:AppIcon Glyph="{x:Static local:AppIcons.Note}" FontSize="13" VerticalAlignment="Center" />
                                                <TextBlock Margin="6,0,0,0" VerticalAlignment="Center" Text="{x:Static res:Resources.Verify_OpenFile}" />
                                            </StackPanel>
                                        </Button>
                                        <Button Style="{DynamicResource AccentButtonStyle}" Padding="14,6" Command="{Binding AddVerificationCommand}">
                                            <StackPanel Orientation="Horizontal">
                                                <local:AppIcon Glyph="{x:Static local:AppIcons.Add}" FontSize="13" VerticalAlignment="Center" />
                                                <TextBlock Margin="6,0,0,0" VerticalAlignment="Center" Text="{x:Static res:Resources.Verify_Add}" />
                                            </StackPanel>
                                        </Button>
                                    </StackPanel>
                                </Grid>

                                <!-- Tablo kartı -->
                                <Border Grid.Row="1" CornerRadius="12" BorderThickness="1" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                                        Background="{DynamicResource LayerBrush}" Padding="16,8,8,10">
                                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,0,8,0">
                                        <StackPanel>
                                            <!-- Başlık: sütun adları; aradaki ayırıcılar sürüklenince genişlik değişir (çift tık: varsayılan) -->
                                            <Border Margin="1,0,1,4" Padding="0,8,8,8" BorderThickness="0,0,0,1" BorderBrush="{DynamicResource DividerStrokeColorDefaultBrush}">
                                                <Grid TextElement.Foreground="{DynamicResource TextSecondaryBrush}" TextElement.FontSize="12" TextElement.FontWeight="SemiBold">
                                                    <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="4" />
                                                    <ColumnDefinition Width="{Binding DataContext.VerificationColumns.Tg, RelativeSource={RelativeSource AncestorType=Window}}" />
                                                    <ColumnDefinition Width="*" MinWidth="200" />
                                                    <ColumnDefinition Width="{Binding DataContext.VerificationColumns.Kind, RelativeSource={RelativeSource AncestorType=Window}}" />
                                                    <ColumnDefinition Width="{Binding DataContext.VerificationColumns.Method, RelativeSource={RelativeSource AncestorType=Window}}" />
                                                    <ColumnDefinition Width="{Binding DataContext.VerificationColumns.Plan, RelativeSource={RelativeSource AncestorType=Window}}" />
                                                    <ColumnDefinition Width="{Binding DataContext.VerificationColumns.Report, RelativeSource={RelativeSource AncestorType=Window}}" />
                                                    <ColumnDefinition Width="{Binding DataContext.VerificationColumns.Status, RelativeSource={RelativeSource AncestorType=Window}}" />
                                                    <ColumnDefinition Width="28" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Grid.Column="1" Margin="12,0,0,0" Text="{x:Static res:Resources.Verify_FieldTgNo}" />
                                                    <Thumb Grid.Column="1" Style="{StaticResource ColumnGrip}" HorizontalAlignment="Right" Tag="tg" />
                                                    <TextBlock Grid.Column="2" Text="{x:Static res:Resources.Verify_ColRequirement}" />
                                                    <TextBlock Grid.Column="3" Margin="10,0,0,0" Text="{x:Static res:Resources.Verify_ColKind}" />
                                                    <Thumb Grid.Column="3" Style="{StaticResource ColumnGrip}" HorizontalAlignment="Left" Tag="kind" />
                                                    <TextBlock Grid.Column="4" Margin="10,0,0,0" Text="{x:Static res:Resources.Verify_ColMethod}" />
                                                    <Thumb Grid.Column="4" Style="{StaticResource ColumnGrip}" HorizontalAlignment="Left" Tag="method" />
                                                    <TextBlock Grid.Column="5" Margin="10,0,0,0" Text="{x:Static res:Resources.Verify_ColPlan}" />
                                                    <Thumb Grid.Column="5" Style="{StaticResource ColumnGrip}" HorizontalAlignment="Left" Tag="plan" />
                                                    <TextBlock Grid.Column="6" Margin="10,0,0,0" Text="{x:Static res:Resources.Verify_ColReport}" />
                                                    <Thumb Grid.Column="6" Style="{StaticResource ColumnGrip}" HorizontalAlignment="Left" Tag="report" />
                                                    <TextBlock Grid.Column="7" Margin="10,0,0,0" Text="{x:Static res:Resources.Verify_FieldStatus}" />
                                                    <Thumb Grid.Column="7" Style="{StaticResource ColumnGrip}" HorizontalAlignment="Left" Tag="status" />
                                                </Grid>
                                            </Border>

                                            <ItemsControl ItemsSource="{Binding VerificationGroups}" Focusable="False">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <StackPanel Margin="0,0,0,4">
                                                            <!-- Grup başlığı: nokta, ad, özet, geçen / kalan çubuğu -->
                                                            <StackPanel Orientation="Horizontal" Margin="4,16,0,6">
                                                                <Ellipse x:Name="GroupDot" Width="9" Height="9" VerticalAlignment="Center" Fill="{DynamicResource TextTertiaryBrush}" />
                                                                <TextBlock Margin="10,0,0,0" FontWeight="SemiBold" FontSize="15.5" Text="{Binding Title}" />
                                                                <TextBlock Margin="10,0,0,0" VerticalAlignment="Center" Text="{Binding Summary}" FontSize="13" Foreground="{DynamicResource TextTertiaryBrush}" />
                                                                <Border Margin="12,0,0,0" Width="90" Height="5" CornerRadius="3" VerticalAlignment="Center" Background="{DynamicResource SubtleFillColorSecondaryBrush}" ClipToBounds="True">
                                                                    <StackPanel Orientation="Horizontal">
                                                                        <Rectangle Width="{Binding PassedWidth}" Fill="{DynamicResource SystemFillColorSuccessBrush}" />
                                                                        <Rectangle Width="{Binding FailedWidth}" Fill="{DynamicResource SystemFillColorCriticalBrush}" />
                                                                    </StackPanel>
                                                                </Border>
                                                            </StackPanel>
                                                            <ItemsControl ItemsSource="{Binding Rows}" Focusable="False">
                                                                <ItemsControl.ItemTemplate>
                                                                    <DataTemplate>
                                                                        <Border x:Name="RowCard" Style="{StaticResource VerificationCard}">
                                                                        <StackPanel>
                                                                        <Border Style="{StaticResource VerificationRowBorder}" MouseLeftButtonDown="VerificationRow_MouseLeftButtonDown"
                                                                                ContextMenuOpening="VerificationRow_ContextMenuOpening">
                                                                            <Border.ContextMenu>
                                                                                <ContextMenu />
                                                                            </Border.ContextMenu>
                                                                            <Grid>
                                                                                <Grid.ColumnDefinitions>
                                                                                    <ColumnDefinition Width="4" />
                                                                                    <ColumnDefinition Width="{Binding DataContext.VerificationColumns.Tg, RelativeSource={RelativeSource AncestorType=Window}}" />
                                                                                    <ColumnDefinition Width="*" MinWidth="200" />
                                                                                    <ColumnDefinition Width="{Binding DataContext.VerificationColumns.Kind, RelativeSource={RelativeSource AncestorType=Window}}" />
                                                                                    <ColumnDefinition Width="{Binding DataContext.VerificationColumns.Method, RelativeSource={RelativeSource AncestorType=Window}}" />
                                                                                    <ColumnDefinition Width="{Binding DataContext.VerificationColumns.Plan, RelativeSource={RelativeSource AncestorType=Window}}" />
                                                                                    <ColumnDefinition Width="{Binding DataContext.VerificationColumns.Report, RelativeSource={RelativeSource AncestorType=Window}}" />
                                                                                    <ColumnDefinition Width="{Binding DataContext.VerificationColumns.Status, RelativeSource={RelativeSource AncestorType=Window}}" />
                                                                                    <ColumnDefinition Width="28" />
                                                                                </Grid.ColumnDefinitions>

                                                                                <Rectangle x:Name="StatusBar" Margin="0,2" RadiusX="2" RadiusY="2" Fill="{DynamicResource DividerStrokeColorDefaultBrush}" />
                                                                                <TextBlock x:Name="IdText" Grid.Column="1" Margin="12,0,6,0" VerticalAlignment="Center" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"
                                                                                           Text="{Binding Id}" ToolTip="{Binding Id}" />
                                                                                <StackPanel Grid.Column="2" Margin="0,0,16,0" VerticalAlignment="Center">
                                                                                    <TextBlock x:Name="RowText" FontWeight="SemiBold" TextWrapping="Wrap" Text="{Binding DisplayText}" />
                                                                                    <TextBlock Margin="0,2,0,0" FontSize="12.5" TextTrimming="CharacterEllipsis" Foreground="{DynamicResource TextTertiaryBrush}"
                                                                                               Text="{Binding Description}" Visibility="{Binding ShowsDescriptionLine, Converter={StaticResource BoolToVis}}" />
                                                                                </StackPanel>
                                                                                <StackPanel Grid.Column="3" Margin="10,0,6,0" Orientation="Horizontal" VerticalAlignment="Center">
                                                                                    <TextBlock Text="{Binding KindText}" FontSize="13" Foreground="{DynamicResource TextSecondaryBrush}" />
                                                                                    <TextBlock Margin="6,0,0,0" FontSize="13" Text="{Binding ParentText}" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}"
                                                                                               Visibility="{Binding HasParent, Converter={StaticResource BoolToVis}}" />
                                                                                </StackPanel>
                                                                                <Border x:Name="MethodChip" Grid.Column="4" Margin="10,0,0,0" HorizontalAlignment="Left" VerticalAlignment="Center" Padding="9,2" CornerRadius="6"
                                                                                        Background="{DynamicResource SubtleFillColorSecondaryBrush}" Visibility="{Binding HasMethod, Converter={StaticResource BoolToVis}}">
                                                                                    <TextBlock x:Name="MethodText" Text="{Binding Method}" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" />
                                                                                </Border>
                                                                                <TextBlock x:Name="TpText" Grid.Column="5" Margin="10,0,6,0" VerticalAlignment="Center" FontSize="13" TextTrimming="CharacterEllipsis" Text="{Binding TpText}" />
                                                                                <TextBlock x:Name="TrText" Grid.Column="6" Margin="10,0,6,0" VerticalAlignment="Center" FontSize="13" TextTrimming="CharacterEllipsis" Text="{Binding TrText}" />
                                                                                <Border x:Name="StatusPill" Grid.Column="7" Margin="10,0,0,0" HorizontalAlignment="Left" VerticalAlignment="Center" Padding="10,3" CornerRadius="11"
                                                                                        Background="{DynamicResource SubtleFillColorSecondaryBrush}" Cursor="Hand" ToolTip="{x:Static res:Resources.Verify_StatusHint}"
                                                                                        MouseLeftButtonUp="VerificationStatus_MouseLeftButtonUp" MouseLeftButtonDown="VerificationStatus_MouseLeftButtonDown">
                                                                                    <StackPanel Orientation="Horizontal">
                                                                                        <Ellipse x:Name="StatusDot" Width="6" Height="6" Margin="0,0,6,0" VerticalAlignment="Center" Fill="{DynamicResource TextTertiaryBrush}" />
                                                                                        <TextBlock x:Name="StatusLabel" Text="{Binding StatusText}" FontSize="12.5" Foreground="{DynamicResource TextSecondaryBrush}" />
                                                                                    </StackPanel>
                                                                                </Border>
                                                                                <StackPanel Grid.Column="8" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                                                                    <Button x:Name="RowAttempt" Margin="0,0,4,0" Padding="9,2" VerticalAlignment="Center" Visibility="Hidden"
                                                                                            ToolTip="{x:Static res:Resources.Verify_AddAttemptHint}" Click="VerificationAttempt_Click">
                                                                                        <TextBlock FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center" Text="{x:Static res:Resources.Verify_AddAttempt}" />
                                                                                    </Button>
                                                                                    <Button x:Name="RowMd" Margin="0,0,4,0" Padding="9,2" MinWidth="38" VerticalAlignment="Center" Visibility="Hidden"
                                                                                            ToolTip="{x:Static res:Resources.Verify_OpenInFile}" Click="VerificationOpenNote_Click">
                                                                                        <StackPanel Orientation="Horizontal">
                                                                                            <local:AppIcon Glyph="{x:Static local:AppIcons.Note}" FontSize="12" VerticalAlignment="Center" />
                                                                                            <TextBlock Margin="5,0,0,0" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center" Text="{x:Static res:Resources.Timeline_OpenNoteShort}" />
                                                                                        </StackPanel>
                                                                                    </Button>
                                                                                    <Button Padding="4,2" VerticalAlignment="Center" Style="{DynamicResource SubtleButtonStyle}"
                                                                                            ToolTip="{x:Static res:Resources.Verify_RowMenuHint}" Click="VerificationRowMenu_Click">
                                                                                        <local:AppIcon Glyph="{x:Static local:AppIcons.More}" FontSize="13" />
                                                                                    </Button>
                                                                                </StackPanel>
                                                                            </Grid>
                                                                        </Border>

                                                                        <!-- Açılan satır: tam gereksinim, kaynak; plan ve rapor tek satırlık özet -->
                                                                        <Border BorderThickness="0,1,0,0" BorderBrush="{DynamicResource DividerStrokeColorDefaultBrush}" Margin="12,0"
                                                                                Visibility="{Binding IsExpanded, Converter={StaticResource BoolToVis}}" />
                                                                        <StackPanel Margin="112,12,16,14" Visibility="{Binding IsExpanded, Converter={StaticResource BoolToVis}}">
                                                                            <TextBlock Margin="0,0,0,4" TextWrapping="Wrap" MaxWidth="900" HorizontalAlignment="Left" LineHeight="21" Text="{Binding Requirement}"
                                                                                       Visibility="{Binding HasRequirement, Converter={StaticResource BoolToVis}}" />
                                                                            <TextBlock Margin="0,0,0,4" FontSize="12" Foreground="{DynamicResource TextTertiaryBrush}" Text="{Binding SourceLine}"
                                                                                       Visibility="{Binding HasSourceLine, Converter={StaticResource BoolToVis}}" />
                                                                            <!-- Denemeler: maddeye bağlı ölçüm kayıtları (zaman çizelgesinden), yeniden eskiye -->
                                                                            <StackPanel Margin="0,8,0,0" Orientation="Horizontal">
                                                                                <TextBlock FontWeight="SemiBold" FontSize="13" VerticalAlignment="Center" Text="{x:Static res:Resources.Verify_Attempts}" />
                                                                                <TextBlock Margin="8,0,0,0" FontSize="12.5" VerticalAlignment="Center" Foreground="{DynamicResource TextTertiaryBrush}" Text="{Binding AttemptCountText}" />
                                                                            </StackPanel>
                                                                            <TextBlock Margin="0,4,0,0" FontSize="12.5" Foreground="{DynamicResource TextTertiaryBrush}" Text="{x:Static res:Resources.Verify_NoAttempts}"
                                                                                       Visibility="{Binding HasAttempts, Converter={StaticResource InverseBoolToVis}}" />
                                                                            <ItemsControl Margin="0,4,0,0" ItemsSource="{Binding Attempts}" Focusable="False">
                                                                                <ItemsControl.ItemTemplate>
                                                                                    <DataTemplate>
                                                                                        <Grid Margin="0,2">
                                                                                            <Grid.ColumnDefinitions>
                                                                                                <ColumnDefinition Width="92" />
                                                                                                <ColumnDefinition Width="72" />
                                                                                                <ColumnDefinition Width="*" />
                                                                                            </Grid.ColumnDefinitions>
                                                                                            <TextBlock FontSize="12.5" VerticalAlignment="Center" Foreground="{DynamicResource TextSecondaryBrush}" Text="{Binding DateText}" />
                                                                                            <Border x:Name="AttemptPill" Grid.Column="1" Padding="8,1" CornerRadius="5" HorizontalAlignment="Left" VerticalAlignment="Center"
                                                                                                    Background="{DynamicResource SubtleFillColorSecondaryBrush}">
                                                                                                <TextBlock x:Name="AttemptText" FontSize="11.5" FontWeight="SemiBold" Text="{Binding Result}" Foreground="{DynamicResource TextSecondaryBrush}" />
                                                                                            </Border>
                                                                                            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                                                                                <TextBlock FontSize="12.5" TextTrimming="CharacterEllipsis" Text="{Binding Title}" />
                                                                                                <TextBlock Margin="8,0,0,0" FontSize="12" Foreground="{DynamicResource TextTertiaryBrush}" Text="{Binding TagText}" />
                                                                                                <Button Margin="8,0,0,0" Padding="6,0" Style="{DynamicResource SubtleButtonStyle}" ToolTip="{x:Static res:Resources.Timeline_OpenFolder}"
                                                                                                        Visibility="{Binding HasFolder, Converter={StaticResource BoolToVis}}" Click="AttemptFolder_Click">
                                                                                                    <local:AppIcon Glyph="{x:Static local:AppIcons.Folder}" FontSize="12" Foreground="{DynamicResource SystemFillColorCautionBrush}" />
                                                                                                </Button>
                                                                                            </StackPanel>
                                                                                        </Grid>
                                                                                        <DataTemplate.Triggers>
                                                                                            <DataTrigger Binding="{Binding ResultKind}" Value="1">
                                                                                                <Setter TargetName="AttemptPill" Property="Background" Value="{DynamicResource SystemFillColorSuccessBackgroundBrush}" />
                                                                                                <Setter TargetName="AttemptText" Property="Foreground" Value="{DynamicResource SystemFillColorSuccessBrush}" />
                                                                                            </DataTrigger>
                                                                                            <DataTrigger Binding="{Binding ResultKind}" Value="2">
                                                                                                <Setter TargetName="AttemptPill" Property="Background" Value="{DynamicResource SystemFillColorCriticalBackgroundBrush}" />
                                                                                                <Setter TargetName="AttemptText" Property="Foreground" Value="{DynamicResource SystemFillColorCriticalBrush}" />
                                                                                            </DataTrigger>
                                                                                        </DataTemplate.Triggers>
                                                                                    </DataTemplate>
                                                                                </ItemsControl.ItemTemplate>
                                                                            </ItemsControl>
                                                                            <UniformGrid Margin="0,8,0,0" Rows="1" Width="720" HorizontalAlignment="Left">
                                                                                <Border Margin="0,0,10,0" Padding="12,9" CornerRadius="9" BorderThickness="1"
                                                                                        Background="{DynamicResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}">
                                                                                    <StackPanel>
                                                                                        <StackPanel Orientation="Horizontal">
                                                                                            <TextBlock FontWeight="SemiBold" FontSize="13" Text="{x:Static res:Resources.Verify_ColPlan}" />
                                                                                            <TextBlock Margin="8,0,0,0" FontSize="12.5" Foreground="{DynamicResource TextTertiaryBrush}" Text="{Binding TpText}" />
                                                                                        </StackPanel>
                                                                                        <TextBlock Margin="0,5,0,0" FontSize="12.8" TextWrapping="Wrap" Foreground="{DynamicResource TextSecondaryBrush}" Text="{Binding PlanLine}" />
                                                                                    </StackPanel>
                                                                                </Border>
                                                                                <Border Padding="12,9" CornerRadius="9" BorderThickness="1"
                                                                                        Background="{DynamicResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}">
                                                                                    <StackPanel>
                                                                                        <StackPanel Orientation="Horizontal">
                                                                                            <TextBlock FontWeight="SemiBold" FontSize="13" Text="{x:Static res:Resources.Verify_ColReport}" />
                                                                                            <TextBlock Margin="8,0,0,0" FontSize="12.5" Foreground="{DynamicResource TextTertiaryBrush}" Text="{Binding TrText}" />
                                                                                        </StackPanel>
                                                                                        <TextBlock Margin="0,5,0,0" FontSize="12.8" TextWrapping="Wrap" Foreground="{DynamicResource TextSecondaryBrush}" Text="{Binding ReportLine}" />
                                                                                    </StackPanel>
                                                                                </Border>
                                                                            </UniformGrid>
                                                                        </StackPanel>
                                                                        </StackPanel>
                                                                        </Border>
                                                                        <DataTemplate.Triggers>
                                                                            <Trigger SourceName="RowCard" Property="IsMouseOver" Value="True"><Setter TargetName="RowMd" Property="Visibility" Value="Visible" /><Setter TargetName="RowAttempt" Property="Visibility" Value="Visible" /></Trigger>
                                                                            <DataTrigger Binding="{Binding IsExpanded}" Value="True"><Setter TargetName="RowMd" Property="Visibility" Value="Visible" /><Setter TargetName="RowAttempt" Property="Visibility" Value="Visible" /></DataTrigger>
                                                                            <DataTrigger Binding="{Binding IsExpanded}" Value="True">
                                                                                <Setter TargetName="RowCard" Property="BorderBrush" Value="{DynamicResource AccentFillColorDefaultBrush}" />
                                                                            </DataTrigger>
                                                                            <DataTrigger Binding="{Binding IsSourceOnly}" Value="True">
                                                                                <Setter TargetName="IdText" Property="FontWeight" Value="Normal" />
                                                                                <Setter TargetName="IdText" Property="FontSize" Value="12.5" />
                                                                                <Setter TargetName="IdText" Property="Foreground" Value="{DynamicResource TextTertiaryBrush}" />
                                                                            </DataTrigger>
                                                                            <DataTrigger Binding="{Binding IsTextLater}" Value="True">
                                                                                <Setter TargetName="RowText" Property="Foreground" Value="{DynamicResource TextTertiaryBrush}" />
                                                                                <Setter TargetName="RowText" Property="FontStyle" Value="Italic" />
                                                                                <Setter TargetName="RowText" Property="FontWeight" Value="Normal" />
                                                                            </DataTrigger>
                                                                            <DataTrigger Binding="{Binding HasTp}" Value="False"><Setter TargetName="TpText" Property="Foreground" Value="{DynamicResource TextTertiaryBrush}" /></DataTrigger>
                                                                            <DataTrigger Binding="{Binding HasTr}" Value="False"><Setter TargetName="TrText" Property="Foreground" Value="{DynamicResource TextTertiaryBrush}" /></DataTrigger>
                                                                            <DataTrigger Binding="{Binding MethodTone}" Value="1"><Setter TargetName="MethodText" Property="Foreground" Value="{DynamicResource AccentTextFillColorPrimaryBrush}" /></DataTrigger>
                                                                            <DataTrigger Binding="{Binding MethodTone}" Value="2"><Setter TargetName="MethodText" Property="Foreground" Value="{DynamicResource SystemFillColorSuccessBrush}" /></DataTrigger>
                                                                            <DataTrigger Binding="{Binding MethodTone}" Value="3"><Setter TargetName="MethodText" Property="Foreground" Value="{DynamicResource SystemFillColorCautionBrush}" /></DataTrigger>
                                                                            <DataTrigger Binding="{Binding MethodTone}" Value="4"><Setter TargetName="MethodText" Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" /></DataTrigger>
                                                                            <!-- Durum renkleri: 6 planlandı, 7 hazırlık, 3 yapılıyor, 8 değerlendiriliyor, 1 geçti, 2 kaldı, 9 şartlı kabul, 4 tekrarlanacak, 5 kapsam dışı -->
                                                                            <DataTrigger Binding="{Binding StatusKind}" Value="6">
                                                                                <Setter TargetName="StatusLabel" Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
                                                                                <Setter TargetName="StatusLabel" Property="FontWeight" Value="SemiBold" />
                                                                                <Setter TargetName="StatusDot" Property="Fill" Value="{DynamicResource TextPrimaryBrush}" />
                                                                            </DataTrigger>
                                                                            <DataTrigger Binding="{Binding StatusKind}" Value="7">
                                                                                <Setter TargetName="StatusPill" Property="Background" Value="{DynamicResource SystemFillColorCautionBackgroundBrush}" />
                                                                                <Setter TargetName="StatusLabel" Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
                                                                                <Setter TargetName="StatusDot" Property="Fill" Value="{DynamicResource SystemFillColorCautionBrush}" />
                                                                                <Setter TargetName="StatusBar" Property="Fill" Value="{DynamicResource SystemFillColorCautionBrush}" />
                                                                            </DataTrigger>
                                                                            <DataTrigger Binding="{Binding StatusKind}" Value="3">
                                                                                <Setter TargetName="StatusLabel" Property="Foreground" Value="{DynamicResource AccentTextFillColorPrimaryBrush}" />
                                                                                <Setter TargetName="StatusDot" Property="Fill" Value="{DynamicResource AccentTextFillColorPrimaryBrush}" />
                                                                                <Setter TargetName="StatusBar" Property="Fill" Value="{DynamicResource AccentTextFillColorPrimaryBrush}" />
                                                                            </DataTrigger>
                                                                            <DataTrigger Binding="{Binding StatusKind}" Value="8">
                                                                                <Setter TargetName="StatusLabel" Property="Foreground" Value="{DynamicResource AccentTextFillColorPrimaryBrush}" />
                                                                                <Setter TargetName="StatusLabel" Property="FontStyle" Value="Italic" />
                                                                                <Setter TargetName="StatusDot" Property="Fill" Value="{DynamicResource AccentTextFillColorPrimaryBrush}" />
                                                                                <Setter TargetName="StatusBar" Property="Fill" Value="{DynamicResource AccentTextFillColorPrimaryBrush}" />
                                                                            </DataTrigger>
                                                                            <DataTrigger Binding="{Binding StatusKind}" Value="1">
                                                                                <Setter TargetName="StatusPill" Property="Background" Value="{DynamicResource SystemFillColorSuccessBackgroundBrush}" />
                                                                                <Setter TargetName="StatusLabel" Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
                                                                                <Setter TargetName="StatusDot" Property="Fill" Value="{DynamicResource SystemFillColorSuccessBrush}" />
                                                                                <Setter TargetName="StatusBar" Property="Fill" Value="{DynamicResource SystemFillColorSuccessBrush}" />
                                                                            </DataTrigger>
                                                                            <DataTrigger Binding="{Binding StatusKind}" Value="9">
                                                                                <Setter TargetName="StatusPill" Property="Background" Value="{DynamicResource SystemFillColorSuccessBackgroundBrush}" />
                                                                                <Setter TargetName="StatusLabel" Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
                                                                                <Setter TargetName="StatusLabel" Property="FontStyle" Value="Italic" />
                                                                                <Setter TargetName="StatusDot" Property="Fill" Value="{DynamicResource SystemFillColorCautionBrush}" />
                                                                                <Setter TargetName="StatusBar" Property="Fill" Value="{DynamicResource SystemFillColorSuccessBrush}" />
                                                                            </DataTrigger>
                                                                            <DataTrigger Binding="{Binding StatusKind}" Value="2">
                                                                                <Setter TargetName="StatusPill" Property="Background" Value="{DynamicResource SystemFillColorCriticalBackgroundBrush}" />
                                                                                <Setter TargetName="StatusLabel" Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
                                                                                <Setter TargetName="StatusDot" Property="Fill" Value="{DynamicResource SystemFillColorCriticalBrush}" />
                                                                                <Setter TargetName="StatusBar" Property="Fill" Value="{DynamicResource SystemFillColorCriticalBrush}" />
                                                                            </DataTrigger>
                                                                            <DataTrigger Binding="{Binding StatusKind}" Value="4">
                                                                                <Setter TargetName="StatusPill" Property="Background" Value="{DynamicResource SystemFillColorCautionBackgroundBrush}" />
                                                                                <Setter TargetName="StatusLabel" Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
                                                                                <Setter TargetName="StatusLabel" Property="FontWeight" Value="SemiBold" />
                                                                                <Setter TargetName="StatusDot" Property="Fill" Value="{DynamicResource SystemFillColorCautionBrush}" />
                                                                                <Setter TargetName="StatusBar" Property="Fill" Value="{DynamicResource SystemFillColorCautionBrush}" />
                                                                            </DataTrigger>
                                                                            <DataTrigger Binding="{Binding StatusKind}" Value="5">
                                                                                <Setter TargetName="StatusPill" Property="Background" Value="Transparent" />
                                                                                <Setter TargetName="StatusLabel" Property="Foreground" Value="{DynamicResource TextTertiaryBrush}" />
                                                                                <Setter TargetName="StatusBar" Property="Fill" Value="Transparent" />
                                                                            </DataTrigger>
                                                                        </DataTemplate.Triggers>
                                                                    </DataTemplate>
                                                                </ItemsControl.ItemTemplate>
                                                            </ItemsControl>
                                                        </StackPanel>
                                                        <DataTemplate.Triggers>
                                                            <DataTrigger Binding="{Binding Tone}" Value="0"><Setter TargetName="GroupDot" Property="Fill" Value="{DynamicResource AccentTextFillColorPrimaryBrush}" /></DataTrigger>
                                                            <DataTrigger Binding="{Binding Tone}" Value="1"><Setter TargetName="GroupDot" Property="Fill" Value="{DynamicResource SystemFillColorSuccessBrush}" /></DataTrigger>
                                                            <DataTrigger Binding="{Binding Tone}" Value="2"><Setter TargetName="GroupDot" Property="Fill" Value="{DynamicResource SystemFillColorCautionBrush}" /></DataTrigger>
                                                        </DataTemplate.Triggers>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                            <TextBlock Margin="10,14" TextWrapping="Wrap" Foreground="{DynamicResource TextTertiaryBrush}" Text="{x:Static res:Resources.Verify_Empty}"
                                                       Visibility="{Binding IsVerificationEmpty, Converter={StaticResource BoolToVis}}" />
                                        </StackPanel>
                                    </ScrollViewer>
                                </Border>
                            </Grid>
                        </TabItem>

                        <!-- Yapılacaklar: gruplu (Gecikmiş · Bugün · Bu hafta · Sonra · Tarihsiz); kutu işi kapatır (önce sorulur) -->
                        <TabItem>
                            <TabItem.Header>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{x:Static res:Resources.Home_TabTasks}" />
                                    <Border Margin="8,0,0,0" MinWidth="20" Height="20" Padding="6,0" CornerRadius="10" VerticalAlignment="Center"
                                            Visibility="{Binding StockOpenCount, Converter={StaticResource CountToVis}}">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding HasStockLate}" Value="True">
                                                        <Setter Property="Background" Value="{DynamicResource SystemFillColorCriticalBrush}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <TextBlock Text="{Binding StockOpenCount}" FontSize="11" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                </StackPanel>
                            </TabItem.Header>
                            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,0,12,0">
                                <StackPanel Margin="0,10,0,0" MaxWidth="1100" HorizontalAlignment="Left" MinWidth="600">
                                    <Button HorizontalAlignment="Right" Margin="0,0,0,4" Style="{DynamicResource AccentButtonStyle}" Padding="14,6" Click="TaskDialogOpen_Click" ToolTip="{x:Static res:Resources.Timeline_AddTaskHint}">
                                        <StackPanel Orientation="Horizontal">
                                            <local:AppIcon Glyph="{x:Static local:AppIcons.Add}" FontSize="13" VerticalAlignment="Center" />
                                            <TextBlock Margin="6,0,0,0" VerticalAlignment="Center" Text="{x:Static res:Resources.Timeline_AddTask}" />
                                        </StackPanel>
                                    </Button>
                                    <StackPanel Margin="0,4,0,12" Visibility="{Binding HasOpenRequests, Converter={StaticResource BoolToVis}}">
                                        <TextBlock Margin="0,0,0,8" FontSize="14" FontWeight="SemiBold" Text="{x:Static res:Resources.Request_OpenTitle}" />
                                        <ItemsControl ItemsSource="{Binding OpenRequests}" ItemTemplate="{StaticResource TimelineCardTemplate}" Focusable="False" />
                                    </StackPanel>
                                    <ItemsControl ItemsSource="{Binding StockTaskGroups}" Focusable="False">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <StackPanel Margin="0,0,0,8">
                                                    <StackPanel Orientation="Horizontal" Margin="4,8,0,4">
                                                        <TextBlock x:Name="GroupTitle" FontWeight="SemiBold" Text="{Binding Title}" Foreground="{DynamicResource TextSecondaryBrush}" />
                                                        <TextBlock Margin="6,0,0,0" Text="{Binding Count, StringFormat='· {0}'}" Foreground="{DynamicResource TextTertiaryBrush}" />
                                                    </StackPanel>
                                                    <ItemsControl ItemsSource="{Binding Rows}" Focusable="False">
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate>
                                                                <Border Padding="8,9" BorderThickness="0,0,0,1" BorderBrush="{DynamicResource DividerStrokeColorDefaultBrush}">
                                                                    <Grid>
                                                                        <Grid.ColumnDefinitions>
                                                                            <ColumnDefinition Width="Auto" />
                                                                            <ColumnDefinition Width="*" />
                                                                            <ColumnDefinition Width="180" />
                                                                            <ColumnDefinition Width="120" />
                                                                        </Grid.ColumnDefinitions>
                                                                        <CheckBox VerticalAlignment="Center" IsChecked="{Binding IsDone, Mode=OneWay}" Click="TaskDone_Click" />
                                                                        <TextBlock Grid.Column="1" Margin="4,0,12,0" VerticalAlignment="Center" Text="{Binding Text}" TextTrimming="CharacterEllipsis" />
                                                                        <TextBlock Grid.Column="2" VerticalAlignment="Center" Text="{Binding Label}" TextTrimming="CharacterEllipsis" Foreground="{DynamicResource TextSecondaryBrush}" />
                                                                        <TextBlock x:Name="Due" Grid.Column="3" VerticalAlignment="Center" Text="{Binding DueText}" Foreground="{DynamicResource TextSecondaryBrush}" />
                                                                    </Grid>
                                                                </Border>
                                                                <DataTemplate.Triggers>
                                                                    <DataTrigger Binding="{Binding IsLate}" Value="True">
                                                                        <Setter TargetName="Due" Property="Foreground" Value="{DynamicResource SystemFillColorCriticalBrush}" />
                                                                    </DataTrigger>
                                                                </DataTemplate.Triggers>
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>
                                                </StackPanel>
                                                <DataTemplate.Triggers>
                                                    <DataTrigger Binding="{Binding IsLate}" Value="True">
                                                        <Setter TargetName="GroupTitle" Property="Foreground" Value="{DynamicResource SystemFillColorCriticalBrush}" />
                                                    </DataTrigger>
                                                </DataTemplate.Triggers>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <TextBlock Margin="4,10" Foreground="{DynamicResource TextTertiaryBrush}" Text="{x:Static res:Resources.Stock_NoTasks}"
                                               Visibility="{Binding StockOpenCount, Converter={StaticResource ZeroToVis}}" />
                                </StackPanel>
                            </ScrollViewer>
                        </TabItem>

                        <!-- Test yardımcı araçları: bu stokta duran ya da bu stoka bağlanmış jig, kablo, yazılım … -->
                        <TabItem>
                            <TabItem.Header>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{x:Static res:Resources.Records_ViewTools}" />
                                    <TextBlock Margin="8,0,0,0" Text="{Binding StockToolCount}" Foreground="{DynamicResource TextTertiaryBrush}" FontWeight="Normal" />
                                </StackPanel>
                            </TabItem.Header>
                            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,0,12,0">
                                <StackPanel Margin="0,10,0,0">
                                    <Grid Margin="8,0,8,6">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="34" />
                                            <ColumnDefinition Width="170" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="120" />
                                            <ColumnDefinition Width="160" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="1" FontSize="12" Foreground="{DynamicResource TextTertiaryBrush}" Text="{x:Static res:Resources.Col_Number}" />
                                        <TextBlock Grid.Column="2" FontSize="12" Foreground="{DynamicResource TextTertiaryBrush}" Text="{x:Static res:Resources.Col_Name}" />
                                        <TextBlock Grid.Column="3" FontSize="12" Foreground="{DynamicResource TextTertiaryBrush}" Text="{x:Static res:Resources.Col_Type}" />
                                        <TextBlock Grid.Column="4" FontSize="12" Foreground="{DynamicResource TextTertiaryBrush}" Text="{x:Static res:Resources.Col_SubType}" />
                                    </Grid>
                                    <ItemsControl ItemsSource="{Binding StockToolRows}" Focusable="False">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Button Padding="8,10" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Background="Transparent"
                                                        BorderThickness="0,0,0,1" BorderBrush="{DynamicResource DividerStrokeColorDefaultBrush}" Click="StockToolRow_Click">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="34" />
                                                            <ColumnDefinition Width="170" />
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="120" />
                                                            <ColumnDefinition Width="160" />
                                                        </Grid.ColumnDefinitions>
                                                        <local:AppIcon Glyph="{Binding Glyph}" FontSize="14" Foreground="{Binding Color}" VerticalAlignment="Center" />
                                                        <TextBlock Grid.Column="1" FontWeight="SemiBold" Text="{Binding Number}" VerticalAlignment="Center" />
                                                        <TextBlock Grid.Column="2" Text="{Binding Name}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                                        <TextBlock Grid.Column="3" Text="{Binding TypeName}" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" />
                                                        <TextBlock Grid.Column="4" Text="{Binding SubType}" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" />
                                                    </Grid>
                                                </Button>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <TextBlock Margin="8,10" Foreground="{DynamicResource TextTertiaryBrush}" Text="{x:Static res:Resources.Stock_NoTools}"
                                               Visibility="{Binding StockToolCount, Converter={StaticResource ZeroToVis}}" />
                                </StackPanel>
                            </ScrollViewer>
                        </TabItem>
                    </TabControl>
                </Grid>

                <!-- Envanter kaydı: dosyalar, bilgiler, not ve geçmiş -->
                <ScrollViewer Grid.Row="2" Grid.RowSpan="3" Margin="0,16,0,0" VerticalScrollBarVisibility="Auto"
                              Visibility="{Binding Inventory.IsRecord, Converter={StaticResource BoolToVis}}">
                <Grid TextElement.FontWeight="Normal">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="16" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                    <!-- Etiketler (#SATIMO …): çip olarak -->
                    <ItemsControl Margin="0,0,0,12" ItemsSource="{Binding Inventory.Tags}" Visibility="{Binding Inventory.HasTags, Converter={StaticResource BoolToVis}}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Margin="0,0,6,6" Padding="10,3" CornerRadius="{DynamicResource ControlCornerRadius}" Background="{DynamicResource SubtleFillColorSecondaryBrush}">
                                    <TextBlock Text="{Binding}" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" />
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <!-- Süreç: düzey, talep, yapan, teslim, not (numara, tanım, alt tür, konum başlıkta yazar) -->
                    <Border Padding="16,12" Margin="0,0,0,16"
                            Background="{DynamicResource LayerBrush}" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                            CornerRadius="{DynamicResource OverlayCornerRadius}">
                        <StackPanel>
                            <TextBlock Style="{StaticResource PaneLabel}" Text="{x:Static res:Resources.Inv_Process}" />
                            <ItemsControl x:Name="ProcessList" ItemsSource="{Binding Inventory.ProcessFacts}" ItemTemplate="{StaticResource FactCellTemplate}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <local:TwoColumnRowsPanel />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                            </ItemsControl>
                        </StackPanel>
                    </Border>

                    <!-- Özellikler: türe özel alanlar iki sütun; etiket üstte küçük, değer altta, ince çizgiyle ayrılır; boş olan soluk -->
                    <Border Padding="16,12" Margin="0,0,0,16" Visibility="{Binding Inventory.HasProperties, Converter={StaticResource BoolToVis}}"
                            Background="{DynamicResource LayerBrush}" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                            CornerRadius="{DynamicResource OverlayCornerRadius}">
                        <StackPanel>
                            <TextBlock Style="{StaticResource PaneLabel}" Text="{Binding Inventory.PropertiesHeader}" />
                            <!-- Yalnız dolu alanlar görünür (başlıkta "2 / 6 dolu"); hiçbiri dolu değilse tek satır ipucu -->
                            <ItemsControl x:Name="PropertyList" ItemsSource="{Binding Inventory.Properties}" ItemTemplate="{StaticResource FactCellTemplate}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <local:TwoColumnRowsPanel />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemContainerStyle>
                                    <Style TargetType="ContentPresenter">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsEmpty}" Value="True">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </ItemsControl.ItemContainerStyle>
                            </ItemsControl>
                            <TextBlock Margin="0,2,0,0" TextWrapping="Wrap" Foreground="{DynamicResource TextTertiaryBrush}"
                                       Visibility="{Binding Inventory.HasNoFilledProperties, Converter={StaticResource BoolToVis}}"
                                       Text="{x:Static res:Resources.Inv_PropertiesEmpty}" />
                        </StackPanel>
                    </Border>

                    <!-- Dosyalar: alt klasör düğmeleri, not, fotoğraf küçük resimleri -->
                    <Border Padding="16,12" Margin="0,0,0,16"
                            Background="{DynamicResource LayerBrush}" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                            CornerRadius="{DynamicResource OverlayCornerRadius}">
                        <StackPanel>
                            <TextBlock Style="{StaticResource PaneLabel}" Text="{x:Static res:Resources.Inv_Files}" />
                            <WrapPanel>
                                <ItemsControl ItemsSource="{Binding Inventory.FolderTiles}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <WrapPanel />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Button Margin="0,0,6,6" Padding="10,5" Tag="{Binding Path}" Click="RecordFolder_Click" ToolTip="{Binding Path}">
                                                <StackPanel Orientation="Horizontal">
                                                    <local:AppIcon Glyph="{x:Static local:AppIcons.OpenFolder}" FontSize="13" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" />
                                                    <TextBlock Margin="8,0,0,0" Text="{Binding Label}" VerticalAlignment="Center" />
                                                    <TextBlock x:Name="TileValue" Margin="6,0,0,0" Text="{Binding Value}" FontWeight="SemiBold" VerticalAlignment="Center" />
                                                </StackPanel>
                                            </Button>
                                            <DataTemplate.Triggers>
                                                <DataTrigger Binding="{Binding IsEmpty}" Value="True">
                                                    <Setter TargetName="TileValue" Property="FontWeight" Value="Normal" />
                                                    <Setter TargetName="TileValue" Property="Foreground" Value="{DynamicResource TextTertiaryBrush}" />
                                                </DataTrigger>
                                            </DataTemplate.Triggers>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <Button Margin="0,0,6,6" Padding="10,5" VerticalAlignment="Top" Click="RecordNote_Click"
                                        Visibility="{Binding Inventory.HasNote, Converter={StaticResource BoolToVis}}">
                                    <StackPanel Orientation="Horizontal">
                                        <local:AppIcon Glyph="{x:Static local:AppIcons.Note}" FontSize="13" VerticalAlignment="Center" />
                                        <TextBlock Margin="8,0,0,0" Text="{x:Static res:Resources.Inv_OpenNote}" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                                <Button Margin="0,0,6,6" Padding="10,5" VerticalAlignment="Top" Click="RecordCreateNote_Click"
                                        Visibility="{Binding Inventory.HasNote, Converter={StaticResource InverseBoolToVis}}">
                                    <StackPanel Orientation="Horizontal">
                                        <local:AppIcon Glyph="{x:Static local:AppIcons.Add}" FontSize="13" VerticalAlignment="Center" />
                                        <TextBlock Margin="8,0,0,0" Text="{x:Static res:Resources.Inv_CreateNote}" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                            </WrapPanel>
                            <Grid Margin="0,6,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <ItemsControl ItemsSource="{Binding Inventory.Photos}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <UniformGrid Rows="1" Columns="4" />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Button Margin="0,0,6,0" Padding="0" Height="84" Tag="{Binding}" Click="RecordPhoto_Click" ToolTip="{Binding}"
                                                    HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch">
                                                <Border CornerRadius="{DynamicResource ControlCornerRadius}" ClipToBounds="True">
                                                    <Image Source="{Binding Converter={StaticResource PathToImage}}" Stretch="UniformToFill" />
                                                </Border>
                                            </Button>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <TextBlock Grid.Column="1" VerticalAlignment="Center" Margin="4,0,0,0"
                                           Foreground="{DynamicResource TextSecondaryBrush}" Text="{Binding Inventory.MorePhotos}" />
                            </Grid>
                        </StackPanel>
                    </Border>
                    <ContentControl Content="{Binding}" ContentTemplate="{StaticResource MentionsCardTemplate}" Focusable="False" />
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                    <Border VerticalAlignment="Top" Padding="16,12"
                            Background="{DynamicResource LayerBrush}" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                            CornerRadius="{DynamicResource OverlayCornerRadius}">
                        <StackPanel>
                            <Grid Margin="0,0,0,4">
                                <TextBlock Style="{StaticResource PaneLabel}" Text="{x:Static res:Resources.Inv_History}" VerticalAlignment="Center" />
                                <Button HorizontalAlignment="Right" Margin="0,-6,0,0" Padding="8,3" Click="JournalAdd_Click" ToolTip="{x:Static res:Resources.Journal_ButtonHint}">
                                    <StackPanel Orientation="Horizontal">
                                        <local:AppIcon Glyph="{x:Static local:AppIcons.Add}" FontSize="12" Foreground="{DynamicResource AccentBrush}" />
                                        <TextBlock Margin="6,0,0,0" Text="{x:Static res:Resources.Journal_Button}" />
                                    </StackPanel>
                                </Button>
                            </Grid>                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBox Tag="Record" KeyDown="QuickNoteBox_KeyDown" local:MentionAssist.Mode="plain" controls:TextBoxHelper.PlaceholderText="{x:Static res:Resources.QuickNote_Placeholder}" ToolTip="{x:Static res:Resources.QuickNote_Hint}" />
                                <Button Grid.Column="1" Margin="6,0,0,0" Tag="Record" Click="QuickNoteAdd_Click">
                                    <StackPanel Orientation="Horizontal">
                                        <local:AppIcon Glyph="{x:Static local:AppIcons.Note}" FontSize="14" />
                                        <TextBlock Margin="8,0,0,0" Text="{x:Static res:Resources.QuickNote_Add}" />
                                    </StackPanel>
                                </Button>
                            </Grid>
                            <ItemsControl Margin="0,0,0,10" ItemsSource="{Binding Inventory.HistoryFilter.Options}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <controls:FilterChip Margin="0,0,6,6" Content="{Binding Label}" IsChecked="{Binding IsSelected, Mode=TwoWay}" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <ItemsControl ItemsSource="{Binding Inventory.History}" ItemTemplate="{StaticResource HistoryTemplate}" />
                        </StackPanel>
                    </Border>
                    </StackPanel>
                </Grid>
                </ScrollViewer>

                <!-- Envanter: liste (tür ya da bölüm seçiliyken); üstte süzgeçler -->
                <Grid Grid.Row="2" Grid.RowSpan="3" Margin="0,16,0,0" TextElement.FontWeight="Normal"
                      Visibility="{Binding Inventory.IsList, Converter={StaticResource BoolToVis}}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <WrapPanel Grid.Row="0" Orientation="Horizontal">
                        <controls:SearchBox Width="220" Margin="0,0,8,6" PlaceholderText="{x:Static res:Resources.Filter_Search}"
                                            Text="{Binding Inventory.FilterText, UpdateSourceTrigger=PropertyChanged}" />
                        <StackPanel Orientation="Horizontal" Margin="0,0,8,6" Visibility="{Binding Inventory.ShowTypeFilter, Converter={StaticResource BoolToVis}}">
                            <TextBlock VerticalAlignment="Center" Margin="0,0,6,0" Foreground="{DynamicResource TextSecondaryBrush}" Text="{x:Static res:Resources.Inv_Type}" />
                            <ComboBox MinWidth="110" ItemsSource="{Binding Inventory.TypeOptions}" SelectedItem="{Binding Inventory.FilterType, Mode=TwoWay}" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,8,6">
                            <TextBlock VerticalAlignment="Center" Margin="0,0,6,0" Foreground="{DynamicResource TextSecondaryBrush}" Text="{x:Static res:Resources.Inv_SubType}" />
                            <ComboBox MinWidth="130" ItemsSource="{Binding Inventory.SubTypeOptions}" SelectedItem="{Binding Inventory.FilterSubType, Mode=TwoWay}" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,8,6">
                            <TextBlock VerticalAlignment="Center" Margin="0,0,6,0" Foreground="{DynamicResource TextSecondaryBrush}" Text="{x:Static res:Resources.Col_Status}" />
                            <ComboBox MinWidth="150" ItemsSource="{Binding Inventory.StatusOptions}" SelectedItem="{Binding Inventory.FilterStatus, Mode=TwoWay}" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,8,6">
                            <TextBlock VerticalAlignment="Center" Margin="0,0,6,0" Foreground="{DynamicResource TextSecondaryBrush}" Text="{x:Static res:Resources.Inv_Level}" />
                            <ComboBox MinWidth="100" ItemsSource="{Binding Inventory.LevelOptions}" SelectedItem="{Binding Inventory.FilterLevel, Mode=TwoWay}" />
                        </StackPanel>
                        <TextBlock VerticalAlignment="Center" Margin="4,0,0,6" Style="{DynamicResource CaptionTextBlockStyle}"
                                   Foreground="{DynamicResource TextTertiaryBrush}" Text="{Binding Inventory.FilterSummary}" />
                    </WrapPanel>
                    <ListView x:Name="InventoryList" Grid.Row="1" Margin="0,10,0,0" ContextMenu="{StaticResource InventoryRowMenu}"
                              ItemsSource="{Binding Inventory.Rows}"
                              MouseDoubleClick="InventoryList_MouseDoubleClick">
                        <ListView.View>
                            <GridView>
                                <GridViewColumn Width="44">
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate>
                                            <Button Style="{DynamicResource IconButtonStyle}" Tag="{Binding Folder}" Click="RowFolder_Click"
                                                    ToolTip="{x:Static res:Resources.Menu_OpenFolder}">
                                                <local:AppIcon Glyph="{x:Static local:AppIcons.OpenFolder}" FontSize="13" />
                                            </Button>
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>
                                <GridViewColumn Header="{x:Static res:Resources.Inv_Number}" Width="120" DisplayMemberBinding="{Binding Number}" />
                                <GridViewColumn Header="{x:Static res:Resources.Inv_Name}" Width="190" DisplayMemberBinding="{Binding Name}" />
                                <GridViewColumn x:Name="InventoryTypeColumn" Header="{x:Static res:Resources.Inv_Type}" Width="60" DisplayMemberBinding="{Binding TypeName}" />
                                <GridViewColumn Header="{x:Static res:Resources.Inv_SubType}" Width="120" DisplayMemberBinding="{Binding SubType}" />
                                <GridViewColumn Header="{x:Static res:Resources.Col_Status}" Width="175">
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate>
                                            <ContentPresenter Content="{Binding Status}" ContentTemplate="{DynamicResource StatusChipTemplate}" />
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>
                                <GridViewColumn Header="{x:Static res:Resources.Inv_Location}" Width="120" DisplayMemberBinding="{Binding Location}" />
                                <GridViewColumn Header="{x:Static res:Resources.Inv_Level}" Width="145" DisplayMemberBinding="{Binding Level}" />
                            </GridView>
                        </ListView.View>
                    </ListView>
                </Grid>


            </Grid>
        </Grid>

        <!-- Durum çubuğu: solda kök ve izleme (değişiklik varsa tıklayınca yenilenir), ortada sayılar, sağda son iş (tıklayınca yazdığı dosya açılır) -->
        <StatusBar Grid.Row="2" Padding="6,1" TextElement.FontSize="12.5" VerticalContentAlignment="Center">
            <StatusBarItem DockPanel.Dock="Right" Visibility="{Binding HasLastAction, Converter={StaticResource BoolToVis}}">
                <Button Padding="8,1" MinHeight="0" Style="{DynamicResource SubtleButtonStyle}" Click="LastAction_Click" IsEnabled="{Binding HasLastActionPath}"
                        ToolTip="{x:Static res:Resources.StatusBar_OpenLast}" ToolTipService.ShowOnDisabled="False">
                    <StackPanel Orientation="Horizontal">
                        <local:AppIcon Glyph="{x:Static local:AppIcons.Check}" FontSize="12" Foreground="{DynamicResource SystemFillColorSuccessBrush}" VerticalAlignment="Center" />
                        <TextBlock Margin="6,0,0,0" Foreground="{DynamicResource TextSecondaryBrush}" Text="{Binding LastAction}" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
            </StatusBarItem>
            <StatusBarItem>
                <Button x:Name="WatchButton" Padding="8,1" MinHeight="0" Style="{DynamicResource SubtleButtonStyle}" Command="{Binding RefreshCommand}" IsHitTestVisible="{Binding IsDiskChanged}">
                    <StackPanel Orientation="Horizontal">
                        <Ellipse x:Name="WatchDot" Width="8" Height="8" VerticalAlignment="Center">
                            <Ellipse.Style>
                                <Style TargetType="Ellipse">
                                    <Setter Property="Fill" Value="{DynamicResource SystemFillColorSuccessBrush}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsDiskChanged}" Value="True">
                                            <Setter Property="Fill" Value="{DynamicResource SystemFillColorCautionBrush}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Ellipse.Style>
                        </Ellipse>
                        <TextBlock Margin="8,0,0,0" Foreground="{DynamicResource TextSecondaryBrush}" Text="{Binding WatchText}" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
            </StatusBarItem>
            <StatusBarItem Margin="12,0,0,0">
                <TextBlock Foreground="{DynamicResource TextTertiaryBrush}" Text="{Binding StatusCounts}" />
            </StatusBarItem>
            <StatusBarItem Margin="12,0,0,0" Visibility="{Binding HasStatusNote, Converter={StaticResource BoolToVis}}">
                <TextBlock Foreground="{DynamicResource SystemFillColorCautionBrush}" Text="{Binding StatusNote}" TextTrimming="CharacterEllipsis" />
            </StatusBarItem>
        </StatusBar>

        <!-- Test koşusu: analiz tarihi ve kısa not -->
        <controls:ContentDialog Grid.RowSpan="3"
                                IsOpen="{Binding IsAnalysisOpen, Mode=TwoWay}"
                                Title="{x:Static res:Resources.Analysis_Title}"
                                PrimaryButtonText="{x:Static res:Resources.Edit_Save}"
                                CloseButtonText="{x:Static res:Resources.Dialog_Cancel}"
                                PrimaryButtonClick="AnalysisDialog_PrimaryButtonClick">
            <StackPanel Width="300">
                <TextBlock Margin="0,0,0,14" Foreground="{DynamicResource TextSecondaryBrush}" TextTrimming="CharacterEllipsis" Text="{Binding AnalysisTarget}" />
                <controls:FormField Header="{x:Static res:Resources.Field_AnalysisDate}" LabelWidth="90" ErrorText="{Binding AnalysisError}">
                    <TextBox Text="{Binding AnalysisDateText, UpdateSourceTrigger=PropertyChanged}" IsVisibleChanged="FocusWhenVisible" />
                </controls:FormField>
                <controls:FormField Header="{x:Static res:Resources.Field_AnalysisNote}" LabelWidth="90" Margin="0,12,0,0">
                    <TextBox Text="{Binding AnalysisNote, UpdateSourceTrigger=PropertyChanged}" TextWrapping="Wrap" AcceptsReturn="False" MinHeight="56" VerticalContentAlignment="Top" />
                </controls:FormField>
                <TextBlock Margin="0,12,0,0" Style="{DynamicResource CaptionTextBlockStyle}" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" Text="{x:Static res:Resources.Analysis_Hint}" />
            </StackPanel>
        </controls:ContentDialog>

        <!-- Yeni proje -->
        <controls:ContentDialog Grid.RowSpan="3"
                                IsOpen="{Binding IsProjectDialogOpen, Mode=TwoWay}"
                                                                Title="{x:Static res:Resources.Dialog_NewProjectTitle}"
                                PrimaryButtonText="{x:Static res:Resources.Dialog_Create}"
                                CloseButtonText="{x:Static res:Resources.Dialog_Cancel}"
                                PrimaryButtonClick="ProjectDialog_PrimaryButtonClick">
            <StackPanel Width="300">
                <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                    <local:AppIcon Glyph="{x:Static local:AppIcons.Project}" FontSize="22" Foreground="{DynamicResource Pusula.ProjectIconBrush}" VerticalAlignment="Center" />
                    <TextBlock Margin="12,0,0,0" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" MaxWidth="270"
                               Foreground="{DynamicResource TextSecondaryBrush}" Text="{Binding RootPath}" ToolTip="{Binding RootPath}" />
                </StackPanel>
                <controls:FormField Header="{x:Static res:Resources.Field_ProjectNo}" IsRequired="True" LabelWidth="90">
                    <TextBox Text="{Binding NewProjectNo, UpdateSourceTrigger=PropertyChanged}"
                             controls:TextBoxHelper.PlaceholderText="{x:Static res:Resources.Placeholder_ProjectNo}"
                             IsVisibleChanged="FocusWhenVisible" />
                </controls:FormField>
                <controls:FormField Header="{x:Static res:Resources.Field_ProjectName}" IsRequired="True" LabelWidth="90"
                                    Margin="0,12,0,0"
                                    ErrorText="{Binding ProjectError}">
                    <TextBox Text="{Binding NewProjectName, UpdateSourceTrigger=PropertyChanged}"
                             controls:TextBoxHelper.PlaceholderText="{x:Static res:Resources.Placeholder_ProjectName}" />
                </controls:FormField>
            </StackPanel>
        </controls:ContentDialog>

        <!-- Yeni stok -->
        <controls:ContentDialog Grid.RowSpan="3"
                                IsOpen="{Binding IsStockDialogOpen, Mode=TwoWay}"
                                                                Title="{Binding StockDialogTitle}"
                                PrimaryButtonText="{x:Static res:Resources.Dialog_Create}"
                                CloseButtonText="{x:Static res:Resources.Dialog_Cancel}"
                                PrimaryButtonClick="StockDialog_PrimaryButtonClick">
            <StackPanel Width="500">
                <controls:FormField Margin="0,4,0,0" Header="{x:Static res:Resources.Field_StockNo}" IsRequired="True" LabelWidth="90">
                    <TextBox Text="{Binding NewStockNo, UpdateSourceTrigger=PropertyChanged}" ToolTip="{Binding StockNumberHint}"
                             controls:TextBoxHelper.PlaceholderText="{Binding StockNumberPlaceholder}"
                             IsVisibleChanged="FocusWhenVisible" />
                </controls:FormField>
                <controls:FormField Header="{x:Static res:Resources.Field_StockName}" LabelWidth="90"
                                    Margin="0,12,0,0"
                                    ErrorText="{Binding StockError}">
                    <TextBox Text="{Binding NewStockName, UpdateSourceTrigger=PropertyChanged}"
                             controls:TextBoxHelper.PlaceholderText="{x:Static res:Resources.Placeholder_StockName}" />
                </controls:FormField>
                <controls:FormField Header="{x:Static res:Resources.Field_Template}" LabelWidth="90"
                                    Margin="0,12,0,0">
                    <ComboBox ItemsSource="{Binding TemplateNames}"
                              SelectedItem="{Binding SelectedTemplate, Mode=TwoWay}" />
                </controls:FormField>
                <controls:FormField Header="{x:Static res:Resources.Field_Modules}" LabelWidth="90"
                                    Margin="0,16,0,0">
                    <ItemsControl ItemsSource="{Binding StockModules}" ItemTemplate="{StaticResource ModuleOptionTemplate}" />
                </controls:FormField>
            </StackPanel>
        </controls:ContentDialog>

        <!-- Doğrulama maddesi ekle / düzenle: 03_Testler\<stok>_Test_Gereksinimleri.md tablosuna satır; yeni altyapı ortak listeye -->
        <controls:ContentDialog Grid.RowSpan="3"
                                IsOpen="{Binding IsVerificationDialogOpen, Mode=TwoWay}"
                                DialogWidth="680"
                                Title="{Binding VerificationDialogTitle}"
                                PrimaryButtonText="{Binding VerificationDialogButton}"
                                CloseButtonText="{x:Static res:Resources.Dialog_Cancel}"
                                PrimaryButtonClick="VerificationDialog_PrimaryButtonClick">
            <ScrollViewer MaxHeight="620" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,0,10,0">
                <StackPanel>
                    <TextBlock Margin="0,0,0,14" Foreground="{DynamicResource TextSecondaryBrush}" Text="{Binding VerificationFileText}" TextTrimming="CharacterEllipsis" />
                    <controls:FormField Header="{x:Static res:Resources.Verify_FieldTgNo}" LabelWidth="150">
                        <TextBox Text="{Binding NewVerTgNo, UpdateSourceTrigger=PropertyChanged}" controls:TextBoxHelper.PlaceholderText="{x:Static res:Resources.Verify_PlaceholderTgNo}"
                                 IsVisibleChanged="FocusWhenVisible" />
                    </controls:FormField>
                    <controls:FormField Margin="0,12,0,0" Header="{x:Static res:Resources.Verify_FieldTitle}" LabelWidth="150" ErrorText="{Binding VerificationError}">
                        <TextBox x:Name="VerificationTextBox" Text="{Binding NewVerText, UpdateSourceTrigger=PropertyChanged}"
                                 controls:TextBoxHelper.PlaceholderText="{x:Static res:Resources.Verify_PlaceholderTitle}" />
                    </controls:FormField>
                    <controls:FormField Margin="0,12,0,0" Header="{x:Static res:Resources.Verify_FieldRequirement}" LabelWidth="150">
                        <!-- İpucu DesignKit'te tek satır ve ortada çizilir; çok satırlı kutuda sol üstten, kayarak kendimiz gösteririz -->
                        <Grid>
                            <TextBox x:Name="RequirementBox" Text="{Binding NewVerRequirement, UpdateSourceTrigger=PropertyChanged}" TextWrapping="Wrap" AcceptsReturn="False" MinLines="3" MaxLines="8"
                                     VerticalContentAlignment="Top" VerticalScrollBarVisibility="Auto" />
                            <TextBlock Margin="13,7,10,6" VerticalAlignment="Top" TextWrapping="Wrap" IsHitTestVisible="False" Foreground="{DynamicResource TextTertiaryBrush}"
                                       Text="{x:Static res:Resources.Verify_PlaceholderRequirement}">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Text, ElementName=RequirementBox}" Value="">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Grid>
                    </controls:FormField>
                    <controls:FormField Margin="0,12,0,0" Header="{x:Static res:Resources.Verify_FieldGroup}" IsRequired="True" LabelWidth="150">
                        <ComboBox ItemsSource="{Binding VerificationGroupChoices}" SelectedItem="{Binding NewVerGroupChoice, Mode=TwoWay}">
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal">
                                        <Ellipse x:Name="Dot" Width="9" Height="9" Margin="0,0,9,0" VerticalAlignment="Center" Fill="{DynamicResource TextTertiaryBrush}" />
                                        <TextBlock VerticalAlignment="Center" Text="{Binding Text}" />
                                    </StackPanel>
                                    <DataTemplate.Triggers>
                                        <DataTrigger Binding="{Binding Tone}" Value="0"><Setter TargetName="Dot" Property="Fill" Value="{DynamicResource AccentTextFillColorPrimaryBrush}" /></DataTrigger>
                                        <DataTrigger Binding="{Binding Tone}" Value="1"><Setter TargetName="Dot" Property="Fill" Value="{DynamicResource SystemFillColorSuccessBrush}" /></DataTrigger>
                                        <DataTrigger Binding="{Binding Tone}" Value="2"><Setter TargetName="Dot" Property="Fill" Value="{DynamicResource SystemFillColorCautionBrush}" /></DataTrigger>
                                    </DataTemplate.Triggers>
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                    </controls:FormField>
                    <controls:FormField Margin="0,12,0,0" Header="{x:Static res:Resources.Verify_FieldKind}" LabelWidth="150">
                        <ComboBox ItemsSource="{Binding VerificationKinds}" SelectedItem="{Binding NewVerKind, Mode=TwoWay}" />
                    </controls:FormField>
                    <controls:FormField Margin="0,12,0,0" Header="{x:Static res:Resources.Verify_FieldParent}" LabelWidth="150"
                                        Visibility="{Binding IsNewVerDerived, Converter={StaticResource BoolToVis}}">
                        <ComboBox ItemsSource="{Binding VerificationParents}" SelectedItem="{Binding NewVerParent, Mode=TwoWay}" />
                    </controls:FormField>
                    <controls:FormField Margin="0,12,0,0" Header="{x:Static res:Resources.Verify_FieldMethod}" LabelWidth="150">
                        <ComboBox ItemsSource="{Binding VerificationMethods}" SelectedItem="{Binding NewVerMethod, Mode=TwoWay}" />
                    </controls:FormField>
                    <controls:FormField Margin="0,12,0,0" Header="{x:Static res:Resources.Verify_FieldFacility}" LabelWidth="150">
                        <StackPanel>
                            <ComboBox ItemsSource="{Binding FacilityPick.Options}" SelectedItem="{Binding FacilityPick.Selected, Mode=TwoWay}" />
                            <StackPanel Visibility="{Binding FacilityPick.IsNew, Converter={StaticResource BoolToVis}}">
                                <TextBox Margin="0,6,0,0" Text="{Binding FacilityPick.NewText, UpdateSourceTrigger=PropertyChanged}"
                                         controls:TextBoxHelper.PlaceholderText="{x:Static res:Resources.Verify_PlaceholderFacility}" IsVisibleChanged="FocusWhenVisible" />
                                <TextBlock Margin="0,4,0,0" FontSize="12" TextWrapping="Wrap" Foreground="{DynamicResource TextTertiaryBrush}" Text="{x:Static res:Resources.Verify_FacilityHint}" />
                            </StackPanel>
                        </StackPanel>
                    </controls:FormField>
                    <controls:FormField Margin="0,12,0,0" Header="{x:Static res:Resources.Verify_FieldPlanReport}" LabelWidth="150">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="8" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBox Text="{Binding NewVerTpNo, UpdateSourceTrigger=PropertyChanged}" controls:TextBoxHelper.PlaceholderText="{x:Static res:Resources.Verify_PlaceholderTp}" />
                            <TextBox Grid.Column="2" Text="{Binding NewVerTrNo, UpdateSourceTrigger=PropertyChanged}" controls:TextBoxHelper.PlaceholderText="{x:Static res:Resources.Verify_PlaceholderTr}" />
                        </Grid>
                    </controls:FormField>
                    <controls:FormField Margin="0,12,0,0" Header="{x:Static res:Resources.Verify_FieldStatus}" LabelWidth="150">
                        <ComboBox ItemsSource="{Binding VerificationStatuses}" SelectedItem="{Binding NewVerStatus, Mode=TwoWay}" />
                    </controls:FormField>
                </StackPanel>
            </ScrollViewer>
        </controls:ContentDialog>

        <!-- Doğrulama maddesini sil: satır tablodan kalkar, diğer numaralar değişmez; önce sorulur -->
        <controls:ContentDialog Grid.RowSpan="3"
                                IsOpen="{Binding IsVerificationDeleteOpen, Mode=TwoWay}"
                                Title="{x:Static res:Resources.Verify_DeleteTitle}"
                                PrimaryButtonText="{x:Static res:Resources.Verify_Delete}"
                                CloseButtonText="{x:Static res:Resources.Dialog_Cancel}"
                                PrimaryButtonClick="VerificationDelete_PrimaryButtonClick">
            <TextBlock Width="380" TextWrapping="Wrap" Text="{Binding VerificationDeleteText}" />
        </controls:ContentDialog>

        <!-- Elle açılmış klasörü proje / stok olarak işaretle -->
        <controls:ContentDialog Grid.RowSpan="3"
                                IsOpen="{Binding IsMarkDialogOpen, Mode=TwoWay}"
                                                                Title="{Binding MarkTitle}"
                                PrimaryButtonText="{x:Static res:Resources.Mark_Confirm}"
                                CloseButtonText="{x:Static res:Resources.Dialog_Cancel}"
                                PrimaryButtonClick="MarkDialog_PrimaryButtonClick">
            <StackPanel Width="300">
                <TextBlock Style="{DynamicResource CaptionTextBlockStyle}"
                           Foreground="{DynamicResource TextSecondaryBrush}"
                           TextWrapping="Wrap"
                           MaxWidth="380"
                           HorizontalAlignment="Left"
                           Margin="0,0,0,12"
                           Text="{x:Static res:Resources.Mark_Hint}" />
                <controls:FormField Header="{Binding MarkNumberLabel}" IsRequired="True" LabelWidth="90">
                    <TextBox Text="{Binding MarkNumber, UpdateSourceTrigger=PropertyChanged}" IsVisibleChanged="FocusWhenVisible" />
                </controls:FormField>
                <TextBlock Margin="98,4,0,0"
                           MaxWidth="320"
                           HorizontalAlignment="Left"
                           TextWrapping="Wrap"
                           Style="{DynamicResource CaptionTextBlockStyle}"
                           Foreground="{DynamicResource TextTertiaryBrush}"
                           Text="{Binding StockNumberHint}"
                           Visibility="{Binding MarkIsStock, Converter={StaticResource BoolToVis}}" />
                <controls:FormField Header="{Binding MarkNameLabel}" LabelWidth="90" Margin="0,8,0,0"
                                    ErrorText="{Binding MarkError}">
                    <TextBox Text="{Binding MarkName, UpdateSourceTrigger=PropertyChanged}" />
                </controls:FormField>
            </StackPanel>
        </controls:ContentDialog>

        <!-- Yeni envanter kaydı (kablo, jig …): üstte genel bilgiler iki sütun, altta türe özel alanlar iki sütun -->
        <controls:ContentDialog Grid.RowSpan="3"
                                IsOpen="{Binding IsInventoryDialogOpen, Mode=TwoWay}"
                                DialogWidth="680"
                                Title="{Binding InventoryDialogTitle}"
                                PrimaryButtonText="{x:Static res:Resources.Dialog_Create}"
                                CloseButtonText="{x:Static res:Resources.Dialog_Cancel}"
                                PrimaryButtonClick="InventoryDialog_PrimaryButtonClick">
            <StackPanel>
                <TextBlock Style="{DynamicResource CaptionTextBlockStyle}" Foreground="{DynamicResource TextSecondaryBrush}"
                           TextWrapping="Wrap" Margin="0,0,0,10"
                           Text="{x:Static res:Resources.Mark_Hint}"
                           Visibility="{Binding IsInventoryMarkMode, Converter={StaticResource BoolToVis}}" />
                <controls:FormField Header="{x:Static res:Resources.Inv_Name}" IsRequired="True" LabelWidth="130">
                    <TextBox Text="{Binding NewInventoryName, UpdateSourceTrigger=PropertyChanged}" IsVisibleChanged="FocusWhenVisible" controls:TextBoxHelper.PlaceholderText="{Binding NewInventoryNamePlaceholder}" />
                </controls:FormField>
                <UniformGrid Columns="2" Margin="0,10,0,0">
                    <controls:FormField Header="{x:Static res:Resources.Inv_StockNo}" IsRequired="True" LabelWidth="130" Margin="0,0,16,0">
                        <TextBox Text="{Binding NewInventoryNumber, UpdateSourceTrigger=PropertyChanged}" ToolTip="{Binding InventoryNumberHint}" controls:TextBoxHelper.PlaceholderText="{Binding InventoryNumberHint}" />
                    </controls:FormField>
                    <Grid>
                        <controls:FormField Header="{x:Static res:Resources.Inv_Level}" LabelWidth="130"
                                            Visibility="{Binding IsInventoryMarkMode, Converter={StaticResource InverseBoolToVis}}">
                            <ComboBox ItemsSource="{Binding InventoryLevels}" SelectedItem="{Binding NewInventoryLevel, Mode=TwoWay}" DisplayMemberPath="Label" />
                        </controls:FormField>
                        <controls:FormField Header="{x:Static res:Resources.Col_Status}" LabelWidth="130"
                                            Visibility="{Binding IsInventoryMarkMode, Converter={StaticResource BoolToVis}}">
                            <ComboBox ItemsSource="{Binding InventoryStatuses}" SelectedItem="{Binding NewInventoryStatus, Mode=TwoWay}" />
                        </controls:FormField>
                    </Grid>
                </UniformGrid>
                <UniformGrid Columns="2" Margin="0,10,0,0" Visibility="{Binding HasInventorySubTypes, Converter={StaticResource BoolToVis}}">
                    <controls:FormField Header="{x:Static res:Resources.Inv_SubType}" LabelWidth="130" Margin="0,0,16,0">
                        <ComboBox ItemsSource="{Binding InventorySubTypes}" SelectedItem="{Binding NewInventorySubType, Mode=TwoWay}" />
                    </controls:FormField>
                </UniformGrid>
                <controls:FormField Header="{x:Static res:Resources.Inv_Note}" LabelWidth="130" Margin="0,10,0,0" ErrorText="{Binding InventoryError}">
                    <TextBox Text="{Binding NewInventoryNote, UpdateSourceTrigger=PropertyChanged}" controls:TextBoxHelper.PlaceholderText="{x:Static res:Resources.Placeholder_Note}" />
                </controls:FormField>
                <controls:FormField Header="{x:Static res:Resources.Inv_Tags}" LabelWidth="130" Margin="0,10,0,0">
                    <local:TagBox Tags="{Binding NewInventoryTags, Mode=TwoWay}" Placeholder="{x:Static res:Resources.Tag_Placeholder}" />
                </controls:FormField>
                <TextBlock Margin="0,10,0,0" Style="{DynamicResource CaptionTextBlockStyle}" Foreground="{DynamicResource TextTertiaryBrush}"
                           TextWrapping="Wrap" Text="{x:Static res:Resources.Inv_DetailsLater}" />
                <TextBlock Margin="0,10,0,0" Style="{DynamicResource CaptionTextBlockStyle}" Foreground="{DynamicResource TextTertiaryBrush}"
                           TextWrapping="Wrap"
                           Text="{x:Static res:Resources.Inv_TemplateHint}"
                           Visibility="{Binding IsInventoryMarkMode, Converter={StaticResource InverseBoolToVis}}" />
            </StackPanel>
        </controls:ContentDialog>

        <!-- Envanter durum olayı: tarih, kişi, konum, not -->
        <controls:ContentDialog Grid.RowSpan="3"
                                IsOpen="{Binding IsEventDialogOpen, Mode=TwoWay}"
                                                                Title="{Binding EventTitle}"
                                PrimaryButtonText="{x:Static res:Resources.Editor_Save}"
                                CloseButtonText="{x:Static res:Resources.Dialog_Cancel}"
                                PrimaryButtonClick="EventDialog_PrimaryButtonClick">
            <StackPanel Width="300">
                <controls:FormField Header="{x:Static res:Resources.Inv_Date}" LabelWidth="90">
                    <DatePicker SelectedDate="{Binding EventDate, Mode=TwoWay}" />
                </controls:FormField>
                <controls:FormField Header="{x:Static res:Resources.Inv_Person}" LabelWidth="90" Margin="0,8,0,0">
                    <TextBox Text="{Binding EventPerson, UpdateSourceTrigger=PropertyChanged}" />
                </controls:FormField>
                <controls:FormField Header="{x:Static res:Resources.Inv_Location}" LabelWidth="90" Margin="0,8,0,0">
                    <TextBox Text="{Binding EventLocation, UpdateSourceTrigger=PropertyChanged}" IsVisibleChanged="FocusWhenVisible" />
                </controls:FormField>
                <controls:FormField Header="{x:Static res:Resources.Inv_Note}" LabelWidth="90" Margin="0,8,0,0">
                    <TextBox Text="{Binding EventNote, UpdateSourceTrigger=PropertyChanged}" local:MentionAssist.Mode="plain" />
                </controls:FormField>
            </StackPanel>
        </controls:ContentDialog>

        <!-- Durum notu (Beklemede gibi) -->
        <controls:ContentDialog Grid.RowSpan="3"
                                IsOpen="{Binding IsQuickNoteOpen, Mode=TwoWay}"
                                                                Title="{Binding QuickNoteTitle}"
                                PrimaryButtonText="{x:Static res:Resources.QuickNote_Add}"
                                CloseButtonText="{x:Static res:Resources.Dialog_Cancel}"
                                PrimaryButtonClick="QuickNote_PrimaryButtonClick">
            <TextBox Width="300" MinHeight="70" TextWrapping="Wrap" AcceptsReturn="True" VerticalContentAlignment="Top"
                     Text="{Binding QuickNoteText, UpdateSourceTrigger=PropertyChanged}" IsVisibleChanged="FocusWhenVisible" local:MentionAssist.Mode="plain" />
        </controls:ContentDialog>

        <!-- Düzenle: proje, stok, envanter kaydı (ortak) -->
        <controls:ContentDialog
                                Style="{StaticResource RecordEditDialog}" Grid.RowSpan="3"
                                IsOpen="{Binding IsEditOpen, Mode=TwoWay}"
                                                                Title="{Binding EditTitle}"
                                PrimaryButtonText="{x:Static res:Resources.Edit_Save}"
                                CloseButtonText="{x:Static res:Resources.Dialog_Cancel}"
                                PrimaryButtonClick="Edit_PrimaryButtonClick">
            <StackPanel>
                <!-- Numara: salt okunur kutu (klasörün adı); açıklaması ipucunda -->
                <controls:FormField Margin="0,0,0,10" Header="{x:Static res:Resources.Edit_Number}" LabelWidth="130">
                    <TextBox Text="{Binding EditNumber, Mode=OneWay}" IsReadOnly="True" IsTabStop="False"
                             Foreground="{DynamicResource TextSecondaryBrush}" ToolTip="{x:Static res:Resources.Edit_NumberHint}" />
                </controls:FormField>
                <!-- Stokta "Tanım", proje ve envanter kaydında "Ad" -->
                <controls:FormField LabelWidth="130">
                    <controls:FormField.Style>
                        <Style TargetType="controls:FormField" BasedOn="{StaticResource {x:Type controls:FormField}}">
                            <Setter Property="Header" Value="{x:Static res:Resources.Edit_Name}" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsEditStock}" Value="True">
                                    <Setter Property="Header" Value="{x:Static res:Resources.Field_StockName}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </controls:FormField.Style>
                    <TextBox x:Name="EditNameBox" Text="{Binding EditName, UpdateSourceTrigger=PropertyChanged}" IsVisibleChanged="FocusWhenVisible" controls:TextBoxHelper.PlaceholderText="{Binding EditNamePlaceholder}" />
                </controls:FormField>
                <controls:FormField Margin="0,10,0,0" Header="{x:Static res:Resources.Edit_Template}" LabelWidth="130"
                                    Visibility="{Binding IsEditStock, Converter={StaticResource BoolToVis}}">
                    <ComboBox ItemsSource="{Binding EditTemplates}" SelectedItem="{Binding EditTemplate, Mode=TwoWay}">
                        <!-- Boş seçenek "Şablonsuz" diye görünür -->
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock x:Name="Text" Text="{Binding}" />
                                <DataTemplate.Triggers>
                                    <DataTrigger Binding="{Binding}" Value="">
                                        <Setter TargetName="Text" Property="Text" Value="{x:Static res:Resources.Template_None}" />
                                        <Setter TargetName="Text" Property="Foreground" Value="{DynamicResource TextTertiaryBrush}" />
                                    </DataTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                </controls:FormField>
                <UniformGrid Columns="2" Margin="0,10,0,0" Visibility="{Binding IsEditInventory, Converter={StaticResource BoolToVis}}">
                    <controls:FormField Header="{x:Static res:Resources.Edit_SubType}" LabelWidth="130" Margin="0,0,16,0"
                                        Visibility="{Binding HasEditSubTypes, Converter={StaticResource BoolToVis}}">
                        <ComboBox x:Name="EditSubTypeBox" ItemsSource="{Binding EditSubTypes}" SelectedItem="{Binding EditSubType, Mode=TwoWay}" />
                    </controls:FormField>
                </UniformGrid>
                <controls:FormField Header="{x:Static res:Resources.Edit_Note}" LabelWidth="130" Margin="0,10,0,0" Visibility="{Binding IsEditInventory, Converter={StaticResource BoolToVis}}">
                    <TextBox Text="{Binding EditNote, UpdateSourceTrigger=PropertyChanged}" controls:TextBoxHelper.PlaceholderText="{x:Static res:Resources.Placeholder_Note}" />
                </controls:FormField>
                <controls:FormField Header="{x:Static res:Resources.Inv_Tags}" LabelWidth="130" Margin="0,10,0,0">
                    <local:TagBox Tags="{Binding EditTags, Mode=TwoWay}" Placeholder="{x:Static res:Resources.Tag_Placeholder}" />
                </controls:FormField>                <!-- Süreç (isteğe bağlı): talep, yapan, doküman -->
                <StackPanel Visibility="{Binding IsEditInventory, Converter={StaticResource BoolToVis}}">
                    <Border Margin="0,16,0,10" Padding="0,0,0,6" BorderThickness="0,0,0,1" BorderBrush="{DynamicResource DividerStrokeColorDefaultBrush}">
                        <TextBlock FontWeight="SemiBold" Text="{x:Static res:Resources.Edit_Process}" />
                    </Border>
                    <UniformGrid Columns="2">
                        <controls:FormField Header="{x:Static res:Resources.Inv_RequestDate}" LabelWidth="130" Margin="0,0,16,10">
                            <TextBox Text="{Binding EditRequestDateText, UpdateSourceTrigger=PropertyChanged}" controls:TextBoxHelper.PlaceholderText="{x:Static res:Resources.Date_Placeholder}" />
                        </controls:FormField>
                        <controls:FormField Header="{x:Static res:Resources.Inv_RequestedBy}" LabelWidth="130" Margin="0,0,0,10">
                            <TextBox Text="{Binding EditRequester, UpdateSourceTrigger=PropertyChanged}" local:MentionAssist.Mode="person" controls:TextBoxHelper.PlaceholderText="{x:Static res:Resources.Placeholder_Person}" />
                        </controls:FormField>
                        <controls:FormField Header="{x:Static res:Resources.Inv_MadeBy}" LabelWidth="130" Margin="0,0,16,10">
                            <TextBox Text="{Binding EditMaker, UpdateSourceTrigger=PropertyChanged}" local:MentionAssist.Mode="person" controls:TextBoxHelper.PlaceholderText="{x:Static res:Resources.Placeholder_Person}" />
                        </controls:FormField>
                        <controls:FormField Header="{x:Static res:Resources.Inv_Docs}" LabelWidth="130" Margin="0,0,0,10">
                            <CheckBox IsChecked="{Binding EditDocsReady}" VerticalAlignment="Center" Content="{x:Static res:Resources.Inv_DocsReady}" />
                        </controls:FormField>
                    </UniformGrid>
                </StackPanel>
                <!-- Türe özel alanlar (alt türe göre), iki sütun -->
                <StackPanel Visibility="{Binding HasEditFields, Converter={StaticResource BoolToVis}}">
                    <Border Margin="0,16,0,10" Padding="0,0,0,6" BorderThickness="0,0,0,1" BorderBrush="{DynamicResource DividerStrokeColorDefaultBrush}">
                        <TextBlock FontWeight="SemiBold" Text="{Binding EditFieldsHeader}" />
                    </Border>
                    <ScrollViewer MaxHeight="360" VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding EditFields}" ItemTemplate="{StaticResource FieldInputTemplate}" ItemsPanel="{StaticResource TwoColumnPanel}" />
                    </ScrollViewer>
                </StackPanel>
                <TextBlock Margin="0,10,0,0" TextWrapping="Wrap" Foreground="{DynamicResource SystemFillColorCriticalBrush}" Text="{Binding EditError}" />
            </StackPanel>
        </controls:ContentDialog>

        <!-- Sil: klasör _SILINENLER'e taşınır; Sil düğmesi ad doğru yazılınca görünür -->
        <controls:ContentDialog Grid.RowSpan="3"
                                IsOpen="{Binding IsDeleteOpen, Mode=TwoWay}"
                                                                Title="{Binding DeleteTitle}"
                                PrimaryButtonText="{Binding DeletePrimaryText}"
                                CloseButtonText="{x:Static res:Resources.Dialog_Cancel}"
                                PrimaryButtonClick="Delete_PrimaryButtonClick">
            <!-- Kısa açıklama, soluk yol, sonra "adını yazın" + kalın ad ve kutu -->
            <StackPanel Width="420">
                <TextBlock TextWrapping="Wrap" Text="{Binding DeleteText}" Foreground="{DynamicResource TextSecondaryBrush}" />
                <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                    <local:AppIcon Glyph="{x:Static local:AppIcons.Folder}" FontSize="12" VerticalAlignment="Center" Foreground="{DynamicResource TextTertiaryBrush}" />
                    <TextBlock Margin="6,0,0,0" Text="{Binding DeleteTrashPath}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"
                               Style="{DynamicResource CaptionTextBlockStyle}" Foreground="{DynamicResource TextTertiaryBrush}" />
                </StackPanel>
                <TextBlock Margin="0,18,0,6">
                    <Run Text="{x:Static res:Resources.Delete_TypeHint}" />
                    <Run Text="{Binding DeleteExpected, Mode=OneWay}" FontWeight="SemiBold" />
                </TextBlock>
                <TextBox Text="{Binding DeleteTyped, UpdateSourceTrigger=PropertyChanged}" IsVisibleChanged="FocusWhenVisible"
                         controls:TextBoxHelper.PlaceholderText="{Binding DeleteExpected}" />
            </StackPanel>
        </controls:ContentDialog>

        <!-- + Olay: ana notun ## Günlük bölümüne eklenir (en yeni en üstte); Ekle düğmesi başlık yazılınca görünür -->
        <controls:ContentDialog Grid.RowSpan="3"
                                IsOpen="{Binding IsJournalOpen, Mode=TwoWay}"
                                Title="{Binding JournalTitle}"
                                PrimaryButtonText="{Binding JournalPrimaryText}"
                                CloseButtonText="{x:Static res:Resources.Dialog_Cancel}"
                                DialogWidth="620"
                                PrimaryButtonClick="Journal_PrimaryButtonClick">
            <StackPanel>
                <StackPanel.Resources>
                    <!-- Seçilebilen hap (yapıldı / yapılacak, önem) -->
                    <Style x:Key="ChoicePill" TargetType="RadioButton">
                        <Setter Property="Margin" Value="0,0,8,0" />
                        <Setter Property="Focusable" Value="False" />
                        <Setter Property="Cursor" Value="Hand" />
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="RadioButton">
                                    <Border x:Name="Pill" CornerRadius="15" Padding="14,5" BorderThickness="1" MinWidth="76"
                                            Background="{DynamicResource ControlFillColorDefaultBrush}" BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}">
                                        <ContentPresenter HorizontalAlignment="Center" TextElement.Foreground="{DynamicResource TextSecondaryBrush}" />
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Pill" Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
                                        </Trigger>
                                        <Trigger Property="IsChecked" Value="True">
                                            <Setter TargetName="Pill" Property="BorderBrush" Value="{DynamicResource AccentFillColorDefaultBrush}" />
                                            <Setter TargetName="Pill" Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
                                            <Setter Property="FontWeight" Value="SemiBold" />
                                        </Trigger>
                                        <Trigger Property="IsEnabled" Value="False">
                                            <Setter TargetName="Pill" Property="Opacity" Value="0.4" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                    <!-- İşlem ızgarasında bir tür: ikon (tonunda) ve ad; seçili olan vurgulu -->
                    <Style x:Key="KindTile" TargetType="ListBoxItem">
                        <Setter Property="Margin" Value="0,0,6,6" />
                        <Setter Property="Width" Value="146" />
                        <Setter Property="Cursor" Value="Hand" />
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ListBoxItem">
                                    <Border x:Name="Tile" CornerRadius="8" Padding="9,6" BorderThickness="1"
                                            Background="{DynamicResource ControlFillColorDefaultBrush}" BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}">
                                        <ContentPresenter />
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Tile" Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
                                        </Trigger>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter TargetName="Tile" Property="BorderBrush" Value="{DynamicResource AccentFillColorDefaultBrush}" />
                                            <Setter TargetName="Tile" Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                    <DataTemplate x:Key="KindTileTemplate">
                        <StackPanel Orientation="Horizontal">
                            <Border x:Name="IconBox" Width="22" Height="22" CornerRadius="6" Background="{DynamicResource SubtleFillColorSecondaryBrush}">
                                <local:AppIcon x:Name="KindIcon" Glyph="{Binding Glyph}" FontSize="12" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{DynamicResource TextSecondaryBrush}" />
                            </Border>
                            <TextBlock Margin="8,0,0,0" FontSize="12.5" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Text="{Binding Label}" />
                        </StackPanel>
                        <DataTemplate.Triggers>
                            <DataTrigger Binding="{Binding Tone}" Value="active"><Setter TargetName="KindIcon" Property="Foreground" Value="{DynamicResource AccentTextFillColorPrimaryBrush}" /></DataTrigger>
                            <DataTrigger Binding="{Binding Tone}" Value="waiting"><Setter TargetName="KindIcon" Property="Foreground" Value="{DynamicResource SystemFillColorCautionBrush}" /></DataTrigger>
                            <DataTrigger Binding="{Binding Tone}" Value="done"><Setter TargetName="KindIcon" Property="Foreground" Value="{DynamicResource SystemFillColorSuccessBrush}" /></DataTrigger>
                            <DataTrigger Binding="{Binding Tone}" Value="failed"><Setter TargetName="KindIcon" Property="Foreground" Value="{DynamicResource SystemFillColorCriticalBrush}" /></DataTrigger>
                            <DataTrigger Binding="{Binding Tone}" Value="purple"><Setter TargetName="KindIcon" Property="Foreground" Value="{DynamicResource Pusula.EventPurpleBrush}" /></DataTrigger>
                            <DataTrigger Binding="{Binding Tone}" Value="orange"><Setter TargetName="KindIcon" Property="Foreground" Value="{DynamicResource Pusula.EventOrangeBrush}" /></DataTrigger>
                        </DataTemplate.Triggers>
                    </DataTemplate>
                </StackPanel.Resources>

                <TextBlock Margin="0,0,0,14" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" Text="{Binding JournalTarget}" />


                <controls:FormField Header="{x:Static res:Resources.Journal_DateTime}" IsRequired="True" LabelWidth="120">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <TextBox Width="140" Text="{Binding JournalDayText, UpdateSourceTrigger=PropertyChanged}" ToolTip="{x:Static res:Resources.Journal_DateHint}" />
                            <TextBox Width="90" Margin="8,0,0,0" Text="{Binding JournalTimeText, UpdateSourceTrigger=PropertyChanged}" />
                        </StackPanel>
                        <TextBlock Margin="0,4,0,0" FontSize="12" TextWrapping="Wrap" Foreground="{DynamicResource TextTertiaryBrush}" Text="{x:Static res:Resources.Journal_DateTimeHint}" />
                    </StackPanel>
                </controls:FormField>

                <controls:FormField Margin="0,12,0,0" Header="{x:Static res:Resources.Journal_Kind}" LabelWidth="120">
                    <ComboBox ItemsSource="{Binding JournalKinds}" SelectedItem="{Binding JournalKindOption, Mode=TwoWay}"
                              ItemTemplate="{StaticResource KindTileTemplate}" MaxDropDownHeight="360" />
                </controls:FormField>

                <!-- Ölçüm: madde (— Yok · doğrulama maddeleri · + Yeni ek madde) ve elle seçilen sonuç -->
                <Border Margin="-12,12,-12,0" Padding="12,10,12,2" CornerRadius="8" BorderThickness="1"
                        BorderBrush="{DynamicResource AccentFillColorTertiaryBrush}" Background="{DynamicResource SubtleFillColorTertiaryBrush}"
                        Visibility="{Binding IsJournalMeasurement, Converter={StaticResource BoolToVis}}">
                    <StackPanel>
                        <controls:FormField Header="{x:Static res:Resources.Journal_Item}" LabelWidth="120">
                            <StackPanel>
                                <ComboBox x:Name="JournalItemBox" ItemsSource="{Binding JournalItemOptions}" SelectedItem="{Binding JournalItemOption, Mode=TwoWay}" MaxDropDownHeight="380">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate>
                                            <DockPanel>
                                                <Border x:Name="ItemBadge" DockPanel.Dock="Right" Margin="10,0,0,0" Padding="7,1" CornerRadius="5" VerticalAlignment="Center"
                                                        Background="{DynamicResource SubtleFillColorSecondaryBrush}">
                                                    <TextBlock x:Name="ItemBadgeText" FontSize="11" FontWeight="SemiBold" Text="{Binding Badge}" Foreground="{DynamicResource TextSecondaryBrush}" />
                                                </Border>
                                                <TextBlock VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Text="{Binding Text}" />
                                            </DockPanel>
                                            <DataTemplate.Triggers>
                                                <DataTrigger Binding="{Binding Badge}" Value=""><Setter TargetName="ItemBadge" Property="Visibility" Value="Collapsed" /></DataTrigger>
                                                <DataTrigger Binding="{Binding Badge}" Value="{x:Static res:Resources.Verify_StatusPassed}">
                                                    <Setter TargetName="ItemBadge" Property="Background" Value="{DynamicResource SystemFillColorSuccessBackgroundBrush}" />
                                                    <Setter TargetName="ItemBadgeText" Property="Foreground" Value="{DynamicResource SystemFillColorSuccessBrush}" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Badge}" Value="{x:Static res:Resources.Verify_StatusFailed}">
                                                    <Setter TargetName="ItemBadge" Property="Background" Value="{DynamicResource SystemFillColorCriticalBackgroundBrush}" />
                                                    <Setter TargetName="ItemBadgeText" Property="Foreground" Value="{DynamicResource SystemFillColorCriticalBrush}" />
                                                </DataTrigger>
                                            </DataTemplate.Triggers>
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>
                                <TextBlock Margin="0,4,0,0" FontSize="12" TextWrapping="Wrap" Foreground="{DynamicResource TextTertiaryBrush}" Text="{x:Static res:Resources.Journal_ItemHint}" />
                            </StackPanel>
                        </controls:FormField>

                        <!-- Yeni ek madde: numara kendiliğinden (EK-n); metin zorunlu, kaynak isteğe bağlı -->
                        <Border Margin="120,10,0,0" Padding="10,8,10,0" CornerRadius="8" BorderThickness="1"
                                BorderBrush="{DynamicResource Pusula.EventPurpleBrush}" Visibility="{Binding IsJournalNewItem, Converter={StaticResource BoolToVis}}">
                            <StackPanel>
                                <TextBlock Margin="0,0,0,8" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource Pusula.EventPurpleBrush}" Text="{Binding JournalNewItemCaption}" />
                                <controls:FormField Header="{x:Static res:Resources.Journal_NewItemText}" IsRequired="True" LabelWidth="70">
                                    <TextBox Text="{Binding JournalNewItemText, UpdateSourceTrigger=PropertyChanged}" controls:TextBoxHelper.PlaceholderText="{x:Static res:Resources.Journal_NewItemPlaceholder}" />
                                </controls:FormField>
                                <controls:FormField Margin="0,8,0,8" Header="{x:Static res:Resources.Journal_NewItemSource}" LabelWidth="70">
                                    <TextBox Text="{Binding JournalNewItemSource, UpdateSourceTrigger=PropertyChanged}" controls:TextBoxHelper.PlaceholderText="{x:Static res:Resources.Journal_NewItemSourceHint}" />
                                </controls:FormField>
                            </StackPanel>
                        </Border>

                        <controls:FormField Margin="0,12,0,10" Header="{x:Static res:Resources.Journal_Result}" LabelWidth="120">
                            <StackPanel>
                                <ItemsControl ItemsSource="{Binding JournalResultChoices}" Focusable="False">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <StackPanel Orientation="Horizontal" />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <RadioButton Style="{StaticResource ChoicePill}" GroupName="JournalResult" Content="{Binding Text}" IsChecked="{Binding IsChecked, Mode=TwoWay}" />
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <TextBlock Margin="0,5,0,0" FontSize="12" TextWrapping="Wrap" Foreground="{DynamicResource TextTertiaryBrush}" Text="{Binding JournalResultHint}" />
                            </StackPanel>
                        </controls:FormField>

                        <!-- Ölçüm klasörü: kayıtla birlikte boş klasör açılır ve Gezgini'nde gösterilir; dosyaları kullanıcı koyar -->
                        <controls:FormField Margin="0,0,0,10" Header="{x:Static res:Resources.Journal_FolderLabel}" LabelWidth="120">
                            <StackPanel>
                                <CheckBox Content="{x:Static res:Resources.Journal_CreateFolder}" IsChecked="{Binding JournalCreateFolder, Mode=TwoWay}"
                                          Visibility="{Binding HasJournalFolder, Converter={StaticResource InverseBoolToVis}}" />
                                <TextBlock Margin="0,4,0,0" FontSize="12" TextWrapping="Wrap" Foreground="{DynamicResource TextTertiaryBrush}" Text="{Binding JournalFolderText}" />
                            </StackPanel>
                        </controls:FormField>
                    </StackPanel>
                </Border>

                <!-- Talep: tür, talep no, kimden, istenen tarih; türe göre ilgili kayıt, kalemler ya da istenen -->
                <Border Margin="-12,12,-12,0" Padding="12,10,12,2" CornerRadius="8" BorderThickness="1"
                        BorderBrush="{DynamicResource SystemFillColorSuccessBrush}" Background="{DynamicResource SubtleFillColorTertiaryBrush}"
                        Visibility="{Binding IsJournalRequest, Converter={StaticResource BoolToVis}}">
                    <StackPanel>
                        <controls:FormField Header="{x:Static res:Resources.Request_Type}" LabelWidth="120">
                            <ItemsControl ItemsSource="{Binding JournalRequestTypeChoices}" Focusable="False">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <UniformGrid Columns="4" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <RadioButton GroupName="RequestType" IsChecked="{Binding IsChecked, Mode=TwoWay}" Margin="0,0,6,6" Cursor="Hand" Focusable="False">
                                            <RadioButton.Template>
                                                <ControlTemplate TargetType="RadioButton">
                                                    <Border x:Name="Tile" Padding="6,5" CornerRadius="8" BorderThickness="1"
                                                            Background="{DynamicResource ControlFillColorDefaultBrush}" BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}">
                                                        <StackPanel Orientation="Horizontal">
                                                            <ContentControl Width="22" Height="22" Focusable="False" Content="{Binding Badge}" ContentTemplate="{StaticResource RequestIconTemplate}" />
                                                            <TextBlock x:Name="Label" Margin="7,0,0,0" FontSize="12.5" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Text="{Binding Text}" />
                                                        </StackPanel>
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter TargetName="Tile" Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
                                                        </Trigger>
                                                        <Trigger Property="IsChecked" Value="True">
                                                            <Setter TargetName="Tile" Property="BorderBrush" Value="{DynamicResource AccentFillColorDefaultBrush}" />
                                                            <Setter TargetName="Tile" Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
                                                            <Setter TargetName="Label" Property="FontWeight" Value="SemiBold" />
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </RadioButton.Template>
                                        </RadioButton>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </controls:FormField>
                        <controls:FormField Margin="0,8,0,0" Header="{x:Static res:Resources.Request_No}" LabelWidth="120">
                            <StackPanel>
                                <TextBox Width="220" HorizontalAlignment="Left" Text="{Binding JournalRequestNo, UpdateSourceTrigger=PropertyChanged}" />
                                <TextBlock Margin="0,4,0,0" FontSize="12" Foreground="{DynamicResource TextTertiaryBrush}" Text="{x:Static res:Resources.Request_NoHint}" />
                            </StackPanel>
                        </controls:FormField>
                        <controls:FormField Margin="0,12,0,0" Header="{x:Static res:Resources.Request_From}" LabelWidth="120">
                            <StackPanel>
                                <local:TagBox Prefix="@" Tags="{Binding JournalRequestFrom, Mode=TwoWay}" Placeholder="{x:Static res:Resources.Task_PeoplePlaceholder}" />
                                <TextBlock Margin="0,4,0,0" FontSize="12" Foreground="{DynamicResource TextTertiaryBrush}" Text="{x:Static res:Resources.Request_FromHint}" />
                            </StackPanel>
                        </controls:FormField>
                        <controls:FormField Margin="0,12,0,0" Header="{x:Static res:Resources.Request_Due}" LabelWidth="120">
                            <StackPanel>
                                <TextBox Width="140" HorizontalAlignment="Left" Text="{Binding JournalRequestDueText, UpdateSourceTrigger=PropertyChanged}" />
                                <ItemsControl Margin="0,7,0,0" ItemsSource="{Binding JournalRequestDueChoices}" Focusable="False">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <StackPanel Orientation="Horizontal" />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <RadioButton Style="{StaticResource ChoicePill}" GroupName="RequestDue" Content="{Binding Text}" IsChecked="{Binding IsChecked, Mode=TwoWay}" />
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </controls:FormField>
                        <controls:FormField Margin="0,12,0,0" Header="{x:Static res:Resources.Request_Record}" LabelWidth="120"
                                            Visibility="{Binding ShowsRequestRecord, Converter={StaticResource BoolToVis}}">
                            <StackPanel>
                                <TextBox Text="{Binding JournalRequestRecord, UpdateSourceTrigger=PropertyChanged}" />
                                <TextBlock Margin="0,4,0,0" FontSize="12" Foreground="{DynamicResource TextTertiaryBrush}" Text="{x:Static res:Resources.Request_RecordHint}" />
                            </StackPanel>
                        </controls:FormField>
                        <controls:FormField Margin="0,12,0,0" Header="{x:Static res:Resources.Request_Items}" LabelWidth="120"
                                            Visibility="{Binding ShowsRequestItems, Converter={StaticResource BoolToVis}}">
                            <StackPanel>
                                <Grid Margin="0,0,0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="140" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="70" />
                                        <ColumnDefinition Width="30" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock FontSize="11.5" Foreground="{DynamicResource TextTertiaryBrush}" Text="{x:Static res:Resources.Request_ItemStock}" />
                                    <TextBlock Grid.Column="1" Margin="6,0,0,0" FontSize="11.5" Foreground="{DynamicResource TextTertiaryBrush}" Text="{x:Static res:Resources.Request_ItemName}" />
                                    <TextBlock Grid.Column="2" Margin="6,0,0,0" FontSize="11.5" Foreground="{DynamicResource TextTertiaryBrush}" Text="{x:Static res:Resources.Request_ItemQty}" />
                                </Grid>
                                <ItemsControl ItemsSource="{Binding JournalRequestItems}" Focusable="False">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="0,0,0,6">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="140" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="70" />
                                                    <ColumnDefinition Width="30" />
                                                </Grid.ColumnDefinitions>
                                                <TextBox Text="{Binding StockNo, UpdateSourceTrigger=PropertyChanged}" />
                                                <TextBox Grid.Column="1" Margin="6,0,0,0" Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" />
                                                <TextBox Grid.Column="2" Margin="6,0,0,0" Text="{Binding Quantity, UpdateSourceTrigger=PropertyChanged}" />
                                                <Button Grid.Column="3" Margin="4,0,0,0" Padding="4,1" Style="{DynamicResource SubtleButtonStyle}" Click="RequestItemRemove_Click">
                                                    <local:AppIcon Glyph="{x:Static local:AppIcons.Remove}" FontSize="10" />
                                                </Button>
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <Button HorizontalAlignment="Left" Padding="10,3" Click="RequestItemAdd_Click">
                                    <StackPanel Orientation="Horizontal">
                                        <local:AppIcon Glyph="{x:Static local:AppIcons.Add}" FontSize="11" VerticalAlignment="Center" />
                                        <TextBlock Margin="6,0,0,0" FontSize="12.5" VerticalAlignment="Center" Text="{x:Static res:Resources.Request_AddItem}" />
                                    </StackPanel>
                                </Button>
                                <TextBlock Margin="0,4,0,0" FontSize="12" Foreground="{DynamicResource TextTertiaryBrush}" Text="{x:Static res:Resources.Request_ItemsHint}" />
                            </StackPanel>
                        </controls:FormField>
                        <controls:FormField Margin="0,12,0,0" Header="{x:Static res:Resources.Request_Detail}" LabelWidth="120"
                                            Visibility="{Binding ShowsRequestDetail, Converter={StaticResource BoolToVis}}">
                            <StackPanel>
                                <TextBox MinHeight="56" TextWrapping="Wrap" AcceptsReturn="True" VerticalContentAlignment="Top" Text="{Binding JournalRequestDetail, UpdateSourceTrigger=PropertyChanged}" />
                                <TextBlock Margin="0,4,0,0" FontSize="12" Foreground="{DynamicResource TextTertiaryBrush}" Text="{Binding JournalRequestDetailHint}" />
                            </StackPanel>
                        </controls:FormField>
                        <Border Height="10" />
                    </StackPanel>
                </Border>
                <!-- Karar: karar veren (@) ve isteğe bağlı ilgili madde -->
                <Border Margin="-12,12,-12,0" Padding="12,10,12,2" CornerRadius="8" BorderThickness="1"
                        BorderBrush="{DynamicResource Pusula.EventPurpleBrush}" Background="{DynamicResource SubtleFillColorTertiaryBrush}"
                        Visibility="{Binding IsJournalDecision, Converter={StaticResource BoolToVis}}">
                    <StackPanel>
                        <controls:FormField Header="{x:Static res:Resources.Journal_DecidedBy}" LabelWidth="120">
                            <StackPanel>
                                <local:TagBox Prefix="@" Tags="{Binding JournalDecidedBy, Mode=TwoWay}" Placeholder="{x:Static res:Resources.Task_PeoplePlaceholder}" />
                                <TextBlock Margin="0,4,0,0" FontSize="12" Foreground="{DynamicResource TextTertiaryBrush}" Text="{x:Static res:Resources.Journal_DecidedByHint}" />
                            </StackPanel>
                        </controls:FormField>
                        <controls:FormField Margin="0,12,0,10" Header="{x:Static res:Resources.Journal_DecisionItem}" LabelWidth="120">
                            <StackPanel>
                                <ComboBox x:Name="DecisionItemBox" ItemsSource="{Binding JournalItemOptions}" SelectedItem="{Binding JournalItemOption, Mode=TwoWay}" MaxDropDownHeight="380">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate>
                                            <DockPanel>
                                                <Border x:Name="DecBadge" DockPanel.Dock="Right" Margin="10,0,0,0" Padding="7,1" CornerRadius="5" VerticalAlignment="Center"
                                                        Background="{DynamicResource SubtleFillColorSecondaryBrush}">
                                                    <TextBlock x:Name="DecBadgeText" FontSize="11" FontWeight="SemiBold" Text="{Binding Badge}" Foreground="{DynamicResource TextSecondaryBrush}" />
                                                </Border>
                                                <TextBlock VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Text="{Binding Text}" />
                                            </DockPanel>
                                            <DataTemplate.Triggers>
                                                <DataTrigger Binding="{Binding Badge}" Value=""><Setter TargetName="DecBadge" Property="Visibility" Value="Collapsed" /></DataTrigger>
                                                <DataTrigger Binding="{Binding Badge}" Value="{x:Static res:Resources.Verify_StatusPassed}">
                                                    <Setter TargetName="DecBadge" Property="Background" Value="{DynamicResource SystemFillColorSuccessBackgroundBrush}" />
                                                    <Setter TargetName="DecBadgeText" Property="Foreground" Value="{DynamicResource SystemFillColorSuccessBrush}" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Badge}" Value="{x:Static res:Resources.Verify_StatusFailed}">
                                                    <Setter TargetName="DecBadge" Property="Background" Value="{DynamicResource SystemFillColorCriticalBackgroundBrush}" />
                                                    <Setter TargetName="DecBadgeText" Property="Foreground" Value="{DynamicResource SystemFillColorCriticalBrush}" />
                                                </DataTrigger>
                                            </DataTemplate.Triggers>
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>
                                <TextBlock Margin="0,4,0,0" FontSize="12" Foreground="{DynamicResource TextTertiaryBrush}" Text="{x:Static res:Resources.Journal_DecisionItemHint}" />
                            </StackPanel>
                        </controls:FormField>
                    </StackPanel>
                </Border>
                <!-- Toplantı: katılımcı (@), ortam (ikonlu), kararlar; açıklama "Notlar" olur -->
                <Border Margin="-12,12,-12,0" Padding="12,10,12,2" CornerRadius="8" BorderThickness="1"
                        BorderBrush="{DynamicResource Pusula.EventPurpleBrush}" Background="{DynamicResource SubtleFillColorTertiaryBrush}"
                        Visibility="{Binding IsJournalMeeting, Converter={StaticResource BoolToVis}}">
                    <StackPanel>
                        <controls:FormField Header="{x:Static res:Resources.Journal_Participants}" LabelWidth="120">
                            <local:TagBox Prefix="@" Tags="{Binding JournalParticipants, Mode=TwoWay}" Placeholder="{x:Static res:Resources.Task_PeoplePlaceholder}" />
                        </controls:FormField>
                        <controls:FormField Margin="0,12,0,0" Header="{x:Static res:Resources.Journal_Setting}" LabelWidth="120">
                            <StackPanel>
                                <ItemsControl ItemsSource="{Binding JournalSettingChoices}" Focusable="False">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <StackPanel Orientation="Horizontal" />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <RadioButton GroupName="JournalSetting" IsChecked="{Binding IsChecked, Mode=TwoWay}" Margin="0,0,6,0" Cursor="Hand" Focusable="False">
                                                <RadioButton.Template>
                                                    <ControlTemplate TargetType="RadioButton">
                                                        <Border x:Name="Tile" Width="68" Padding="2,8,2,6" CornerRadius="9" BorderThickness="1"
                                                                Background="{DynamicResource ControlFillColorDefaultBrush}" BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}">
                                                            <StackPanel HorizontalAlignment="Center">
                                                                <ContentControl Width="28" Height="28" Focusable="False" Content="{Binding Badge}"
                                                                                ContentTemplate="{StaticResource SettingIconTemplate}" />
                                                                <TextBlock x:Name="Label" Margin="0,5,0,0" HorizontalAlignment="Center" FontSize="12.5" Text="{Binding Text}" />
                                                            </StackPanel>
                                                        </Border>
                                                        <ControlTemplate.Triggers>
                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                <Setter TargetName="Tile" Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
                                                            </Trigger>
                                                            <Trigger Property="IsChecked" Value="True">
                                                                <Setter TargetName="Tile" Property="BorderBrush" Value="{DynamicResource AccentFillColorDefaultBrush}" />
                                                                <Setter TargetName="Tile" Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
                                                                <Setter TargetName="Label" Property="FontWeight" Value="SemiBold" />
                                                            </Trigger>
                                                        </ControlTemplate.Triggers>
                                                    </ControlTemplate>
                                                </RadioButton.Template>
                                            </RadioButton>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <TextBlock Margin="0,5,0,0" FontSize="12" Foreground="{DynamicResource TextTertiaryBrush}" Text="{x:Static res:Resources.Journal_SettingHint}" />
                            </StackPanel>
                        </controls:FormField>
                        <controls:FormField Margin="0,12,0,10" Header="{x:Static res:Resources.Journal_Decisions}" LabelWidth="120">
                            <StackPanel>
                                <TextBox MinHeight="64" TextWrapping="Wrap" AcceptsReturn="True" VerticalContentAlignment="Top"
                                         Text="{Binding JournalDecisions, UpdateSourceTrigger=PropertyChanged}" />
                                <TextBlock Margin="0,4,0,0" FontSize="12" Foreground="{DynamicResource TextTertiaryBrush}" Text="{x:Static res:Resources.Journal_DecisionsHint}" />
                            </StackPanel>
                        </controls:FormField>
                    </StackPanel>
                </Border>
                <controls:FormField Margin="0,12,0,0" Header="{x:Static res:Resources.Journal_Importance}" LabelWidth="120"
                                    Visibility="{Binding JournalDone, Converter={StaticResource BoolToVis}}">
                    <ComboBox ItemsSource="{Binding JournalImportanceOptions}" SelectedItem="{Binding JournalImportanceOption, Mode=TwoWay}"
                              ItemTemplate="{StaticResource KindTileTemplate}" />
                </controls:FormField>

                <controls:FormField Margin="0,12,0,0" Header="{x:Static res:Resources.Journal_Heading}" IsRequired="True" LabelWidth="120">
                    <TextBox Text="{Binding JournalHeading, UpdateSourceTrigger=PropertyChanged}" IsVisibleChanged="FocusWhenVisible" local:MentionAssist.Mode="link" />
                </controls:FormField>

                <controls:FormField Margin="0,12,0,0" Header="{Binding JournalBodyLabel}" LabelWidth="120"
                                    Visibility="{Binding JournalDone, Converter={StaticResource BoolToVis}}">
                    <StackPanel>
                    <TextBox MinHeight="110" TextWrapping="Wrap" AcceptsReturn="True" VerticalContentAlignment="Top"
                             Text="{Binding JournalBody, UpdateSourceTrigger=PropertyChanged}" local:MentionAssist.Mode="link" />
                    </StackPanel>
                </controls:FormField>

                <controls:FormField Margin="0,12,0,0" Header="{x:Static res:Resources.Journal_Tags}" LabelWidth="120">
                    <StackPanel>
                        <local:TagBox Tags="{Binding JournalTags, Mode=TwoWay}" Placeholder="{x:Static res:Resources.Tag_Placeholder}" />
                        <TextBlock Margin="0,4,0,0" FontSize="12" TextWrapping="Wrap" Foreground="{DynamicResource TextTertiaryBrush}" Text="{x:Static res:Resources.Journal_TagsHint}" />
                    </StackPanel>
                </controls:FormField>
            </StackPanel>
        </controls:ContentDialog>
        <!-- Yapılacak iş ekle: iş, işlem, açıklama, kişiler, son tarih, ilgili madde, etiketler; kaydın ana notunun Yapılacaklar bölümüne -->
        <controls:ContentDialog Grid.RowSpan="3"
                                IsOpen="{Binding IsTaskDialogOpen, Mode=TwoWay}"
                                Title="{x:Static res:Resources.TaskDialog_Title}"
                                PrimaryButtonText="{Binding TaskPrimaryText}"
                                CloseButtonText="{x:Static res:Resources.Dialog_Cancel}"
                                DialogWidth="620"
                                PrimaryButtonClick="TaskDialog_PrimaryButtonClick">
            <StackPanel>
                <StackPanel.Resources>
                    <!-- Seçilebilen hap (yapıldı / yapılacak, önem) -->
                    <Style x:Key="ChoicePill" TargetType="RadioButton">
                        <Setter Property="Margin" Value="0,0,8,0" />
                        <Setter Property="Focusable" Value="False" />
                        <Setter Property="Cursor" Value="Hand" />
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="RadioButton">
                                    <Border x:Name="Pill" CornerRadius="15" Padding="14,5" BorderThickness="1" MinWidth="76"
                                            Background="{DynamicResource ControlFillColorDefaultBrush}" BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}">
                                        <ContentPresenter HorizontalAlignment="Center" TextElement.Foreground="{DynamicResource TextSecondaryBrush}" />
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Pill" Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
                                        </Trigger>
                                        <Trigger Property="IsChecked" Value="True">
                                            <Setter TargetName="Pill" Property="BorderBrush" Value="{DynamicResource AccentFillColorDefaultBrush}" />
                                            <Setter TargetName="Pill" Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
                                            <Setter Property="FontWeight" Value="SemiBold" />
                                        </Trigger>
                                        <Trigger Property="IsEnabled" Value="False">
                                            <Setter TargetName="Pill" Property="Opacity" Value="0.4" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                    <!-- İşlem ızgarasında bir tür: ikon (tonunda) ve ad; seçili olan vurgulu -->
                    <Style x:Key="KindTile" TargetType="ListBoxItem">
                        <Setter Property="Margin" Value="0,0,6,6" />
                        <Setter Property="Width" Value="146" />
                        <Setter Property="Cursor" Value="Hand" />
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ListBoxItem">
                                    <Border x:Name="Tile" CornerRadius="8" Padding="9,6" BorderThickness="1"
                                            Background="{DynamicResource ControlFillColorDefaultBrush}" BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}">
                                        <ContentPresenter />
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Tile" Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
                                        </Trigger>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter TargetName="Tile" Property="BorderBrush" Value="{DynamicResource AccentFillColorDefaultBrush}" />
                                            <Setter TargetName="Tile" Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                    <DataTemplate x:Key="KindTileTemplate">
                        <StackPanel Orientation="Horizontal">
                            <Border x:Name="IconBox" Width="22" Height="22" CornerRadius="6" Background="{DynamicResource SubtleFillColorSecondaryBrush}">
                                <local:AppIcon x:Name="KindIcon" Glyph="{Binding Glyph}" FontSize="12" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{DynamicResource TextSecondaryBrush}" />
                            </Border>
                            <TextBlock Margin="8,0,0,0" FontSize="12.5" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Text="{Binding Label}" />
                        </StackPanel>
                        <DataTemplate.Triggers>
                            <DataTrigger Binding="{Binding Tone}" Value="active"><Setter TargetName="KindIcon" Property="Foreground" Value="{DynamicResource AccentTextFillColorPrimaryBrush}" /></DataTrigger>
                            <DataTrigger Binding="{Binding Tone}" Value="waiting"><Setter TargetName="KindIcon" Property="Foreground" Value="{DynamicResource SystemFillColorCautionBrush}" /></DataTrigger>
                            <DataTrigger Binding="{Binding Tone}" Value="done"><Setter TargetName="KindIcon" Property="Foreground" Value="{DynamicResource SystemFillColorSuccessBrush}" /></DataTrigger>
                            <DataTrigger Binding="{Binding Tone}" Value="failed"><Setter TargetName="KindIcon" Property="Foreground" Value="{DynamicResource SystemFillColorCriticalBrush}" /></DataTrigger>
                            <DataTrigger Binding="{Binding Tone}" Value="purple"><Setter TargetName="KindIcon" Property="Foreground" Value="{DynamicResource Pusula.EventPurpleBrush}" /></DataTrigger>
                            <DataTrigger Binding="{Binding Tone}" Value="orange"><Setter TargetName="KindIcon" Property="Foreground" Value="{DynamicResource Pusula.EventOrangeBrush}" /></DataTrigger>
                        </DataTemplate.Triggers>
                    </DataTemplate>
                </StackPanel.Resources>

                <TextBlock Margin="0,0,0,14" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" Text="{Binding TaskTarget}" />

                <controls:FormField Header="{x:Static res:Resources.Task_FieldTitle}" IsRequired="True" LabelWidth="120">
                    <TextBox Text="{Binding TaskTitle, UpdateSourceTrigger=PropertyChanged}" IsVisibleChanged="FocusWhenVisible" local:MentionAssist.Mode="link" />
                </controls:FormField>

                <controls:FormField Margin="0,12,0,0" Header="{x:Static res:Resources.Journal_Kind}" LabelWidth="120">
                    <StackPanel>
                        <ComboBox Width="260" HorizontalAlignment="Left" ItemsSource="{Binding JournalKinds}" SelectedItem="{Binding TaskKindOption, Mode=TwoWay}"
                                  ItemTemplate="{StaticResource KindTileTemplate}" MaxDropDownHeight="360" />
                        <TextBlock Margin="0,4,0,0" FontSize="12" TextWrapping="Wrap" Foreground="{DynamicResource TextTertiaryBrush}" Text="{x:Static res:Resources.Task_KindHint}" />
                    </StackPanel>
                </controls:FormField>

                <controls:FormField Margin="0,12,0,0" Header="{x:Static res:Resources.Journal_Body}" LabelWidth="120">
                    <StackPanel>
                        <TextBox MinHeight="72" TextWrapping="Wrap" AcceptsReturn="True" VerticalContentAlignment="Top"
                                 Text="{Binding TaskBody, UpdateSourceTrigger=PropertyChanged}" local:MentionAssist.Mode="link" />
                        <TextBlock Margin="0,4,0,0" FontSize="12" TextWrapping="Wrap" Foreground="{DynamicResource TextTertiaryBrush}" Text="{x:Static res:Resources.Task_BodyHint}" />
                    </StackPanel>
                </controls:FormField>

                <controls:FormField Margin="0,12,0,0" Header="{x:Static res:Resources.Task_FieldPeople}" LabelWidth="120">
                    <StackPanel>
                        <local:TagBox Prefix="@" Tags="{Binding TaskPeople, Mode=TwoWay}" Placeholder="{x:Static res:Resources.Task_PeoplePlaceholder}" />
                        <TextBlock Margin="0,4,0,0" FontSize="12" TextWrapping="Wrap" Foreground="{DynamicResource TextTertiaryBrush}" Text="{x:Static res:Resources.Task_PeopleHint}" />
                    </StackPanel>
                </controls:FormField>

                <controls:FormField Margin="0,12,0,0" Header="{x:Static res:Resources.Task_FieldDue}" LabelWidth="120">
                    <StackPanel>
                        <TextBox Width="150" HorizontalAlignment="Left" Text="{Binding TaskDueText, UpdateSourceTrigger=PropertyChanged}" />
                        <ItemsControl Margin="0,7,0,0" ItemsSource="{Binding TaskDueChoices}" Focusable="False">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <RadioButton Style="{StaticResource ChoicePill}" GroupName="TaskDue" Content="{Binding Text}" IsChecked="{Binding IsChecked, Mode=TwoWay}" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock Margin="0,5,0,0" FontSize="12" TextWrapping="Wrap" Foreground="{DynamicResource TextTertiaryBrush}" Text="{x:Static res:Resources.Task_DueHint}" />
                    </StackPanel>
                </controls:FormField>

                <controls:FormField Margin="0,12,0,0" Header="{x:Static res:Resources.Task_FieldItem}" LabelWidth="120">
                    <StackPanel>
                        <ComboBox Width="360" HorizontalAlignment="Left" ItemsSource="{Binding TaskItemOptions}" SelectedItem="{Binding TaskItemOption, Mode=TwoWay}" DisplayMemberPath="Text" />
                        <TextBlock Margin="0,4,0,0" FontSize="12" TextWrapping="Wrap" Foreground="{DynamicResource TextTertiaryBrush}" Text="{x:Static res:Resources.Task_ItemHint}" />
                    </StackPanel>
                </controls:FormField>

                <controls:FormField Margin="0,12,0,0" Header="{x:Static res:Resources.Journal_Tags}" LabelWidth="120">
                    <local:TagBox Tags="{Binding TaskTags, Mode=TwoWay}" Placeholder="{x:Static res:Resources.Tag_Placeholder}" />
                </controls:FormField>
            </StackPanel>
        </controls:ContentDialog>

        <!-- Günlük olayını sil: yalnız o olayın satırları nottan kalkar -->
        <controls:ContentDialog Grid.RowSpan="3"
                                IsOpen="{Binding IsJournalDeleteOpen, Mode=TwoWay}"
                                Title="{x:Static res:Resources.Journal_DeleteTitle}"
                                PrimaryButtonText="{x:Static res:Resources.Journal_Delete}"
                                CloseButtonText="{x:Static res:Resources.Dialog_Cancel}"
                                PrimaryButtonClick="JournalDelete_PrimaryButtonClick">
            <TextBlock Width="300" TextWrapping="Wrap" Text="{Binding JournalDeleteText}" />
        </controls:ContentDialog>

        <!-- Yapılacak işi kapat / yeniden aç: kutuya basınca önce sorulur -->
        <controls:ContentDialog Grid.RowSpan="3"
                                IsOpen="{Binding IsTaskConfirmOpen, Mode=TwoWay}"
                                Title="{Binding TaskConfirmTitle}"
                                PrimaryButtonText="{Binding TaskConfirmButton}"
                                CloseButtonText="{x:Static res:Resources.Dialog_Cancel}"
                                DialogWidth="500"
                                PrimaryButtonClick="TaskConfirm_PrimaryButtonClick">
            <StackPanel>
                <!-- İş kartı: işlem çipi, başlık, son tarih, etiketler; hangi notta olduğu -->
                <Border Padding="12,9" CornerRadius="9" BorderThickness="1" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                        Background="{DynamicResource SubtleFillColorTertiaryBrush}" DataContext="{Binding TaskConfirmCard}">
                    <StackPanel>
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Right" Margin="10,0,0,0" VerticalAlignment="Center" FontSize="12" Foreground="{DynamicResource TextTertiaryBrush}" Text="{Binding TimeText}" />
                            <Border DockPanel.Dock="Left" Margin="0,0,8,0" Padding="7,2" CornerRadius="6" VerticalAlignment="Center" Background="{DynamicResource SubtleFillColorSecondaryBrush}">
                                <StackPanel Orientation="Horizontal">
                                    <local:AppIcon Glyph="{Binding Glyph}" FontSize="11" VerticalAlignment="Center" Foreground="{DynamicResource TextSecondaryBrush}" />
                                    <TextBlock Margin="5,0,0,0" FontSize="11.5" VerticalAlignment="Center" Text="{Binding KindLabel}" Foreground="{DynamicResource TextSecondaryBrush}" />
                                </StackPanel>
                            </Border>
                            <TextBlock FontWeight="SemiBold" VerticalAlignment="Center" TextWrapping="Wrap" Text="{Binding Title}" />
                        </DockPanel>
                        <ItemsControl Margin="0,6,0,0" ItemsSource="{Binding Tags}" Focusable="False" Visibility="{Binding HasTags, Converter={StaticResource BoolToVis}}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Margin="0,0,6,0" Padding="8,1" CornerRadius="10" BorderThickness="1" BorderBrush="{DynamicResource AccentFillColorTertiaryBrush}">
                                        <TextBlock FontSize="11.5" Text="{Binding Text}" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" />
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>
                <TextBlock Margin="2,6,0,0" FontSize="12" Foreground="{DynamicResource TextTertiaryBrush}" Text="{Binding TaskConfirmNote}" />
                <CheckBox Margin="0,14,0,0" IsChecked="{Binding TaskConfirmJournal, Mode=TwoWay}" Content="{x:Static res:Resources.Task_AlsoJournal}"
                          Visibility="{Binding IsTaskClosing, Converter={StaticResource BoolToVis}}" />
            </StackPanel>
        </controls:ContentDialog>

        <!-- Takipten çıkar: dosyalar silinmez -->
        <controls:ContentDialog Grid.RowSpan="3"
                                IsOpen="{Binding IsUntrackOpen, Mode=TwoWay}"
                                                                Title="{Binding UntrackTitle}"
                                PrimaryButtonText="{x:Static res:Resources.Untrack_Confirm}"
                                CloseButtonText="{x:Static res:Resources.Dialog_Cancel}"
                                PrimaryButtonClick="Untrack_PrimaryButtonClick">
            <TextBlock Width="300" TextWrapping="Wrap" Text="{Binding UntrackText}" />
        </controls:ContentDialog>

        <controls:ContentDialog Grid.RowSpan="3"
                                IsOpen="{Binding IsStatusNoteOpen, Mode=TwoWay}"
                                                                Title="{Binding StatusNoteTitle}"
                                PrimaryButtonText="{x:Static res:Resources.ModuleDialog_Apply}"
                                CloseButtonText="{x:Static res:Resources.Dialog_Cancel}"
                                PrimaryButtonClick="StatusNote_PrimaryButtonClick">
            <controls:FormField Width="300" Header="{x:Static res:Resources.Field_StatusNote}" LabelWidth="60">
                <TextBox Text="{Binding StatusNoteText, UpdateSourceTrigger=PropertyChanged}" IsVisibleChanged="FocusWhenVisible" />
            </controls:FormField>
        </controls:ContentDialog>

        <!-- Modül ekle -->
        <controls:ContentDialog Grid.RowSpan="3"
                                IsOpen="{Binding IsModuleDialogOpen, Mode=TwoWay}"
                                                                Title="{Binding ModuleDialogTitle}"
                                PrimaryButtonText="{x:Static res:Resources.Dialog_Add}"
                                CloseButtonText="{x:Static res:Resources.Dialog_Cancel}"
                                PrimaryButtonClick="ModuleDialog_PrimaryButtonClick">
            <ItemsControl Width="300"
                          ItemsSource="{Binding AddableModules}"
                          ItemTemplate="{StaticResource ModuleOptionTemplate}" />
        </controls:ContentDialog>
    </Grid>

</controls:ChromeWindow>
