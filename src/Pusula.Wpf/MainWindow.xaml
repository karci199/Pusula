<controls:ChromeWindow x:Class="Pusula.Wpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:DesignKit.Controls;assembly=DesignKit.Wpf"
        xmlns:icons="clr-namespace:DesignKit.Icons;assembly=DesignKit.Wpf"
        xmlns:core="clr-namespace:Pusula.Core.Tracking;assembly=Pusula.Core"
        xmlns:local="clr-namespace:Pusula.Wpf"
        xmlns:res="clr-namespace:Pusula.Wpf.Properties"
        Icon="/Pusula;component/Assets/pusula.ico"
        Title="{x:Static res:Resources.Window_Title}"
        Width="1200" Height="760"
        MinWidth="800" MinHeight="500"
        WindowStartupLocation="CenterScreen"
        FontFamily="{DynamicResource AppFont}"
        Foreground="{DynamicResource TextPrimaryBrush}"
        Background="{DynamicResource SurfaceBaseBrush}">

    <controls:ChromeWindow.InputBindings>
        <KeyBinding Modifiers="Control" Key="N" Command="{Binding NewProjectCommand}" />
        <KeyBinding Modifiers="Control+Shift" Key="N" Command="{Binding NewStockCommand}" />
        <KeyBinding Key="F5" Command="{Binding RefreshCommand}" />
    </controls:ChromeWindow.InputBindings>

    <controls:ChromeWindow.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
        <local:InverseBooleanToVisibilityConverter x:Key="InverseBoolToVis" />
        <local:PathToImageConverter x:Key="PathToImage" />

        <!-- Stok: bir envanter türünün sekmesi (Jigler, Kablolar …); sekmeler kodda türlerden kurulur -->
        <DataTemplate x:Key="StockInventoryTabTemplate">
            <Grid Margin="0,12,0,0" TextElement.FontWeight="Normal">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <controls:FontIcon Glyph="{Binding Glyph}" Foreground="{Binding Color}" FontSize="16" VerticalAlignment="Center" />
                    <TextBlock Margin="10,0,0,0" Text="{Binding Summary}" VerticalAlignment="Center"
                               Style="{DynamicResource CaptionTextBlockStyle}" Foreground="{DynamicResource TextSecondaryBrush}" />
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button Tag="{Binding Type}" Click="StockInvAdd_Click" ToolTip="{x:Static res:Resources.StockInv_AddHint}">
                        <StackPanel Orientation="Horizontal">
                            <controls:FontIcon Glyph="{x:Static local:AppIcons.Inventory}" FontSize="14" />
                            <TextBlock Margin="8,0,0,0" Text="{x:Static res:Resources.StockInv_AddExisting}" />
                        </StackPanel>
                    </Button>
                    <Button Margin="6,0,0,0" Tag="{Binding Type}" Click="StockInvNew_Click" ToolTip="{x:Static res:Resources.StockInv_NewHint}">
                        <StackPanel Orientation="Horizontal">
                            <controls:FontIcon Glyph="{x:Static local:AppIcons.Add}" FontSize="14" />
                            <TextBlock Margin="8,0,0,0" Text="{x:Static res:Resources.StockInv_New}" />
                        </StackPanel>
                    </Button>
                </StackPanel>
                <ListView Grid.Row="1" Grid.ColumnSpan="2" Margin="0,8,0,0"
                          ItemsSource="{Binding Rows}"
                          MouseDoubleClick="InventoryList_MouseDoubleClick">
                    <ListView.ContextMenu>
                        <ContextMenu>
                            <MenuItem Header="{x:Static res:Resources.StockInv_OpenRecord}" Click="StockInvOpen_Click" />
                            <MenuItem Header="{x:Static res:Resources.Menu_OpenFolder}" Click="StockInvFolder_Click" />
                            <MenuItem Header="{x:Static res:Resources.QuickNote_AddMenu}" Click="StockInvNote_Click" />
                            <Separator />
                            <MenuItem Header="{x:Static res:Resources.Menu_Edit}" Click="StockInvEdit_Click" />
                            <MenuItem Header="{x:Static res:Resources.Menu_Untrack}" Click="StockInvUntrack_Click" />
<MenuItem Header="{x:Static res:Resources.Menu_Delete}" Click="StockInvDelete_Click" />
                            <MenuItem Header="{x:Static res:Resources.StockInv_Unlink}" Click="StockInvUnlink_Click"
                                      Visibility="{Binding PlacementTarget.SelectedItem.IsLinked, RelativeSource={RelativeSource AncestorType=ContextMenu}, Converter={StaticResource BoolToVis}, FallbackValue=Collapsed}" />
                        </ContextMenu>
                    </ListView.ContextMenu>
                    <ListView.View>
                        <GridView>
                            <GridViewColumn Header="{x:Static res:Resources.Inv_Number}" Width="130" DisplayMemberBinding="{Binding Number}" />
                            <GridViewColumn Header="{x:Static res:Resources.Inv_Name}" Width="220" DisplayMemberBinding="{Binding Name}" />
                            <GridViewColumn Header="{x:Static res:Resources.Inv_SubType}" Width="110" DisplayMemberBinding="{Binding SubType}" />
                            <GridViewColumn Header="{x:Static res:Resources.Col_Status}" Width="190">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <ContentPresenter Content="{Binding Status}" ContentTemplate="{DynamicResource StatusChipTemplate}" />
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                            <GridViewColumn Header="{x:Static res:Resources.Inv_Location}" Width="130" DisplayMemberBinding="{Binding Location}" />
                            <GridViewColumn Header="{x:Static res:Resources.Inv_Level}" Width="170" DisplayMemberBinding="{Binding Level}" />
                        </GridView>
                    </ListView.View>
                </ListView>
                <TextBlock Grid.Row="1" Grid.ColumnSpan="2" Margin="12,44,0,0" VerticalAlignment="Top"
                           Style="{DynamicResource HintText}" Text="{x:Static res:Resources.StockInv_Empty}"
                           Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVis}}" />
            </Grid>
        </DataTemplate>

        <Style x:Key="PaneLabel" TargetType="TextBlock" BasedOn="{StaticResource CaptionTextBlockStyle}">
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
            <Setter Property="Margin" Value="0,0,0,6" />
        </Style>

        <Style x:Key="HintText" TargetType="TextBlock" BasedOn="{StaticResource CaptionTextBlockStyle}">
            <Setter Property="Foreground" Value="{DynamicResource TextTertiaryBrush}" />
            <Setter Property="Margin" Value="0,6,0,0" />
        </Style>

        <ItemsPanelTemplate x:Key="TilesPanel">
            <UniformGrid Rows="1" />
        </ItemsPanelTemplate>

        <DataTemplate x:Key="TileTemplate">
            <Border Background="{DynamicResource LayerBrush}"
                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="{DynamicResource OverlayCornerRadius}"
                    Padding="12,8"
                    Margin="0,0,8,0">
                <StackPanel>
                    <TextBlock Style="{DynamicResource CaptionTextBlockStyle}"
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               Text="{Binding Label}" />
                    <TextBlock Style="{DynamicResource SubtitleTextBlockStyle}"
                               TextTrimming="CharacterEllipsis"
                               ToolTip="{Binding Value}"
                               Text="{Binding Value}" />
                </StackPanel>
            </Border>
        </DataTemplate>

        <!-- Genel sekmesi: dikkat kartı (ikon, başlık, açıklama) -->
        <DataTemplate x:Key="AlertTemplate">
            <Border x:Name="Box" Margin="0,0,0,8" Padding="12,9" CornerRadius="{DynamicResource OverlayCornerRadius}" BorderThickness="1"
                    Background="{DynamicResource LayerBrush}" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <controls:FontIcon x:Name="Icon" Glyph="{Binding Glyph}" FontSize="16" Margin="0,1,10,0" VerticalAlignment="Top"
                                       Foreground="{DynamicResource TextSecondaryBrush}" />
                    <StackPanel Grid.Column="1">
                        <TextBlock x:Name="Title" Text="{Binding Title}" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" />
                        <TextBlock Text="{Binding Detail}" TextWrapping="Wrap" Style="{DynamicResource CaptionTextBlockStyle}"
                                   Foreground="{DynamicResource TextSecondaryBrush}" />
                    </StackPanel>
                </Grid>
            </Border>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding Tone}" Value="waiting">
                    <Setter TargetName="Box" Property="Background" Value="{DynamicResource SystemFillColorCautionBackgroundBrush}" />
                    <Setter TargetName="Box" Property="BorderBrush" Value="Transparent" />
                    <Setter TargetName="Icon" Property="Foreground" Value="{DynamicResource SystemFillColorCautionBrush}" />
                    <Setter TargetName="Title" Property="Foreground" Value="{DynamicResource SystemFillColorCautionBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Tone}" Value="failed">
                    <Setter TargetName="Box" Property="Background" Value="{DynamicResource SystemFillColorCriticalBackgroundBrush}" />
                    <Setter TargetName="Box" Property="BorderBrush" Value="Transparent" />
                    <Setter TargetName="Icon" Property="Foreground" Value="{DynamicResource SystemFillColorCriticalBrush}" />
                    <Setter TargetName="Title" Property="Foreground" Value="{DynamicResource SystemFillColorCriticalBrush}" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <!-- Genel sekmesi: özet kartı -->
        <DataTemplate x:Key="KpiTemplate">
            <Border Background="{DynamicResource LayerBrush}" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                    CornerRadius="{DynamicResource OverlayCornerRadius}" Padding="12,8" Margin="0,0,10,0">
                <StackPanel>
                    <TextBlock Text="{Binding Label}" Style="{DynamicResource CaptionTextBlockStyle}" Foreground="{DynamicResource TextSecondaryBrush}" />
                    <TextBlock x:Name="Value" Text="{Binding Value}" Style="{DynamicResource SubtitleTextBlockStyle}" TextTrimming="CharacterEllipsis"
                               ToolTip="{Binding Value}" />
                </StackPanel>
            </Border>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding Tone}" Value="done">
                    <Setter TargetName="Value" Property="Foreground" Value="{DynamicResource SystemFillColorSuccessBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Tone}" Value="failed">
                    <Setter TargetName="Value" Property="Foreground" Value="{DynamicResource SystemFillColorCriticalBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Tone}" Value="waiting">
                    <Setter TargetName="Value" Property="Foreground" Value="{DynamicResource SystemFillColorCautionBrush}" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <!-- Genel sekmesi: zaman çizelgesi kartı (dikey çizgi + renkli nokta; tıklayınca açılır) -->
        <DataTemplate x:Key="TimelineTemplate">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="22" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Rectangle Grid.Column="0" Width="2" HorizontalAlignment="Center" Fill="{DynamicResource DividerStrokeColorDefaultBrush}" />
                <Ellipse x:Name="Dot" Grid.Column="0" Width="12" Height="12" Margin="0,13,0,0" VerticalAlignment="Top" HorizontalAlignment="Center"
                         Stroke="{DynamicResource LayerBrush}" StrokeThickness="2" Fill="{DynamicResource TextTertiaryBrush}" />
                <Border Grid.Column="1" Margin="6,0,0,10" Padding="12,8" Cursor="Hand"
                        Background="{DynamicResource LayerBrush}" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                        CornerRadius="{DynamicResource OverlayCornerRadius}"
                        MouseLeftButtonUp="TimelineCard_MouseLeftButtonUp">
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{Binding Title}" FontWeight="SemiBold" VerticalAlignment="Center" />
                            <ContentPresenter x:Name="ResultChip" Grid.Column="1" Margin="8,0,0,0" VerticalAlignment="Center"
                                              Content="{Binding Result}" ContentTemplate="{DynamicResource StatusChipTemplate}" />
                            <Button x:Name="NoteButton" Grid.Column="3" Style="{DynamicResource IconButtonStyle}" Width="28" Height="28"
                                    ToolTip="{x:Static res:Resources.Run_OpenNote}" Click="TimelineNote_Click">
                                <controls:FontIcon Glyph="{x:Static local:AppIcons.Note}" FontSize="13" />
                            </Button>
                            <Button x:Name="FolderButton" Grid.Column="4" Style="{DynamicResource IconButtonStyle}" Width="28" Height="28"
                                    ToolTip="{x:Static res:Resources.Run_OpenFolder}" Click="TimelineFolder_Click">
                                <controls:FontIcon Glyph="{x:Static local:AppIcons.OpenFolder}" FontSize="13" />
                            </Button>
                        </Grid>
                        <TextBlock Text="{Binding Summary}" TextTrimming="CharacterEllipsis" Foreground="{DynamicResource TextSecondaryBrush}" />
                        <TextBlock Text="{Binding Meta}" Margin="0,2,0,0" Style="{DynamicResource CaptionTextBlockStyle}" Foreground="{DynamicResource TextTertiaryBrush}" />
                        <StackPanel x:Name="Details" Visibility="Collapsed" Margin="0,8,0,0">
                            <TextBlock Text="{Binding Detail}" TextWrapping="Wrap" Foreground="{DynamicResource TextSecondaryBrush}" />
                            <Image Source="{Binding Photo, Converter={StaticResource PathToImage}}" MaxHeight="220" Margin="0,8,0,0"
                                   HorizontalAlignment="Left" Stretch="Uniform"
                                   Visibility="{Binding HasPhoto, Converter={StaticResource BoolToVis}}" />
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Grid>
            <DataTemplate.Triggers>
                <!-- Kısa not: sonuç etiketi ve not / klasör düğmeleri yok; nokta soluk -->
                <DataTrigger Binding="{Binding IsQuickNote}" Value="True">
                    <Setter TargetName="ResultChip" Property="Visibility" Value="Collapsed" />
                    <Setter TargetName="NoteButton" Property="Visibility" Value="Collapsed" />
                    <Setter TargetName="FolderButton" Property="Visibility" Value="Collapsed" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsExpanded}" Value="True">
                    <Setter TargetName="Details" Property="Visibility" Value="Visible" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Result.Tone}" Value="done">
                    <Setter TargetName="Dot" Property="Fill" Value="{DynamicResource SystemFillColorSuccessBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Result.Tone}" Value="failed">
                    <Setter TargetName="Dot" Property="Fill" Value="{DynamicResource SystemFillColorCriticalBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Result.Tone}" Value="waiting">
                    <Setter TargetName="Dot" Property="Fill" Value="{DynamicResource SystemFillColorCautionBrush}" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <!-- Testler / Kalifikasyon tablosu (iki listede ayrı örnek) -->
        <GridView x:Key="RunsGridView" x:Shared="False">
            <GridViewColumn Width="80" DisplayMemberBinding="{Binding Serial}">
                <GridViewColumnHeader Content="{x:Static res:Resources.Col_Serial}" Tag="Serial" />
            </GridViewColumn>
            <GridViewColumn Width="60" DisplayMemberBinding="{Binding RoundText}">
                <GridViewColumnHeader Content="{x:Static res:Resources.Col_Round}" Tag="Round" />
            </GridViewColumn>
            <GridViewColumn Width="100" DisplayMemberBinding="{Binding System}">
                <GridViewColumnHeader Content="{x:Static res:Resources.Col_System}" Tag="System" />
            </GridViewColumn>
            <GridViewColumn Width="130">
                <GridViewColumnHeader Content="{x:Static res:Resources.Col_Result}" Tag="ResultName" />
                <GridViewColumn.CellTemplate>
                    <DataTemplate>
                        <ContentPresenter Content="{Binding Result}" ContentTemplate="{DynamicResource StatusChipTemplate}" />
                    </DataTemplate>
                </GridViewColumn.CellTemplate>
            </GridViewColumn>
            <GridViewColumn Width="100" DisplayMemberBinding="{Binding DateText}">
                <GridViewColumnHeader Content="{x:Static res:Resources.Col_Date}" Tag="Date" />
            </GridViewColumn>
            <GridViewColumn Width="90" DisplayMemberBinding="{Binding Person}">
                <GridViewColumnHeader Content="{x:Static res:Resources.Col_Person}" Tag="Person" />
            </GridViewColumn>
            <GridViewColumn Width="380" DisplayMemberBinding="{Binding Summary}">
                <GridViewColumnHeader Content="{x:Static res:Resources.Col_Note}" Tag="Summary" />
            </GridViewColumn>
        </GridView>

        <!-- Türe göre renkli ikon: proje sarı, stok vurgu rengi, işaretsiz klasör soluk. -->
        <!--
            Ağaç satırı: DesignKit şablonunun aynısı, tek fark üzerine gelme vurgusu yalnız satırın kendisine
            (Bd) bakar. DesignKit'te tetikleyici TreeViewItem'ın IsMouseOver'ına bakıyor; o, alt satırın üstündeyken
            de doğru olduğu için üst satır (proje) ile alt satır (stok) aynı anda vurgulanıyordu.
        -->
        <Style x:Key="TreeItemStyle" TargetType="TreeViewItem" BasedOn="{StaticResource {x:Type TreeViewItem}}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TreeViewItem">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="20" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <ToggleButton x:Name="Expander" Grid.Row="0" Grid.Column="0" Width="20" Height="20"
                                          Background="Transparent" Focusable="False" ClickMode="Press"
                                          IsChecked="{Binding IsExpanded, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border Background="{TemplateBinding Background}">
                                            <TextBlock x:Name="Chevron" Text="{x:Static icons:Symbol.ChevronRight}" FontFamily="{DynamicResource SymbolThemeFontFamily}" FontSize="10"
                                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center"
                                                       RenderTransformOrigin="0.5,0.5" />
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsChecked" Value="True">
                                                <Setter TargetName="Chevron" Property="RenderTransform">
                                                    <Setter.Value>
                                                        <RotateTransform Angle="90" />
                                                    </Setter.Value>
                                                </Setter>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>
                            <Border x:Name="Bd" Grid.Row="0" Grid.Column="1" Background="Transparent"
                                    CornerRadius="{DynamicResource ControlCornerRadius}" Padding="{TemplateBinding Padding}"
                                    SnapsToDevicePixels="True">
                                <ContentPresenter Margin="12,0,0,0" ContentSource="Header" VerticalAlignment="Center" />
                            </Border>
                            <ItemsPresenter x:Name="ItemsHost" Grid.Row="1" Grid.Column="1" Visibility="Collapsed" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="HasItems" Value="False">
                                <Setter TargetName="Expander" Property="Visibility" Value="Hidden" />
                            </Trigger>
                            <Trigger Property="IsExpanded" Value="True">
                                <Setter TargetName="ItemsHost" Property="Visibility" Value="Visible" />
                            </Trigger>
                            <Trigger SourceName="Bd" Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Foreground" Value="{DynamicResource TextFillColorDisabledBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Test planı kartı (Testler / Kalifikasyon sekmesinin üstü) -->
        <DataTemplate x:Key="PlanTemplate">
            <Border Margin="0,0,0,8" Padding="12,10" BorderThickness="1"
                    Background="{DynamicResource LayerBrush}" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                    CornerRadius="{DynamicResource OverlayCornerRadius}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock FontWeight="SemiBold" TextTrimming="CharacterEllipsis" Text="{Binding Name}" />
                        <TextBlock Margin="0,2,0,0" TextWrapping="Wrap" Foreground="{DynamicResource TextSecondaryBrush}" Text="{Binding Description}"
                                   Visibility="{Binding HasDescription, Converter={StaticResource BoolToVis}}" />
                        <TextBlock Margin="0,4,0,0" Style="{DynamicResource CaptionTextBlockStyle}" Foreground="{DynamicResource TextTertiaryBrush}">
                            <Run Text="{Binding Meta, Mode=OneWay}" />
                            <Run Text=" · " />
                            <Run Text="{Binding RunsText, Mode=OneWay}" Foreground="{DynamicResource TextSecondaryBrush}" />
                        </TextBlock>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0,0,0">
                        <Button Style="{DynamicResource IconButtonStyle}" Tag="{Binding Path}" Click="PlanOpen_Click" ToolTip="{x:Static res:Resources.Plan_Open}">
                            <controls:FontIcon Glyph="{x:Static local:AppIcons.Note}" FontSize="14" />
                        </Button>
                        <Button Style="{DynamicResource IconButtonStyle}" Tag="{Binding Folder}" Click="PlanFolder_Click" ToolTip="{x:Static res:Resources.Menu_OpenFolder}">
                            <controls:FontIcon Glyph="{x:Static local:AppIcons.OpenFolder}" FontSize="14" />
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>
        </DataTemplate>

        <Style x:Key="KindIconStyle" TargetType="controls:FontIcon">
            <Setter Property="Foreground" Value="{DynamicResource TextTertiaryBrush}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Kind}" Value="{x:Static core:FolderKind.Project}">
                    <Setter Property="Foreground" Value="{DynamicResource Pusula.ProjectIconBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Kind}" Value="{x:Static core:FolderKind.Stock}">
                    <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Kind}" Value="{x:Static core:FolderKind.InventoryType}">
                    <Setter Property="Foreground" Value="{Binding Color}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Kind}" Value="{x:Static core:FolderKind.InventoryItem}">
                    <Setter Property="Foreground" Value="{Binding Color}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- Modül onay kutusu: ad, klasör; stokta varsa kilitli ve "var" etiketli. -->
        <DataTemplate x:Key="ModuleOptionTemplate">
            <CheckBox IsChecked="{Binding IsChecked, Mode=TwoWay}"
                      IsEnabled="{Binding CanChange}"
                      Margin="0,2">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="{Binding Name}" />
                    <TextBlock Text="{Binding Folder}"
                               Margin="8,0,0,0"
                               Foreground="{DynamicResource TextTertiaryBrush}" />
                    <TextBlock Text="{x:Static res:Resources.Module_Exists}"
                               Margin="8,0,0,0"
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               Visibility="{Binding Exists, Converter={StaticResource BoolToVis}}" />
                </StackPanel>
            </CheckBox>
        </DataTemplate>

        <!-- Özet tablosu satırı: boş, eksik ya da özel klasörler soluk. -->
        <Style x:Key="DetailRowStyle" TargetType="ListViewItem" BasedOn="{StaticResource {x:Type ListViewItem}}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsDim}" Value="True">
                    <Setter Property="Foreground" Value="{DynamicResource TextTertiaryBrush}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- Durum etiketi: renk, durumun anlamına göre (neutral, waiting, active, done, warning). -->
        <DataTemplate x:Key="StatusChipTemplate">
            <Border x:Name="Chip"
                    HorizontalAlignment="Left"
                    CornerRadius="10"
                    Padding="10,2"
                    BorderThickness="1"
                    Background="{DynamicResource ControlFillColorSecondaryBrush}"
                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}">
                <TextBlock x:Name="ChipText"
                           Text="{Binding Name}"
                           FontSize="12"
                           Foreground="{DynamicResource TextSecondaryBrush}" />
            </Border>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding Tone}" Value="waiting">
                    <Setter TargetName="ChipText" Property="Foreground" Value="{DynamicResource SystemFillColorCautionBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Tone}" Value="active">
                    <Setter TargetName="Chip" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                    <Setter TargetName="ChipText" Property="Foreground" Value="{DynamicResource AccentBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Tone}" Value="done">
                    <Setter TargetName="Chip" Property="Background" Value="{DynamicResource SystemFillColorSuccessBackgroundBrush}" />
                    <Setter TargetName="Chip" Property="BorderBrush" Value="Transparent" />
                    <Setter TargetName="ChipText" Property="Foreground" Value="{DynamicResource SystemFillColorSuccessBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Tone}" Value="failed">
                    <Setter TargetName="Chip" Property="Background" Value="{DynamicResource SystemFillColorCriticalBackgroundBrush}" />
                    <Setter TargetName="Chip" Property="BorderBrush" Value="Transparent" />
                    <Setter TargetName="ChipText" Property="Foreground" Value="{DynamicResource SystemFillColorCriticalBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Tone}" Value="none">
                    <Setter TargetName="Chip" Property="Background" Value="Transparent" />
                    <Setter TargetName="Chip" Property="BorderBrush" Value="Transparent" />
                    <Setter TargetName="ChipText" Property="Foreground" Value="{DynamicResource TextTertiaryBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Tone}" Value="warning">
                    <Setter TargetName="Chip" Property="Background" Value="{DynamicResource SystemFillColorCautionBackgroundBrush}" />
                    <Setter TargetName="Chip" Property="BorderBrush" Value="Transparent" />
                    <Setter TargetName="ChipText" Property="Foreground" Value="{DynamicResource SystemFillColorCautionBrush}" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <!-- Aşama çubuğunda bir adım: geçilmiş, şu an, gelecek. -->
        <DataTemplate x:Key="StatusStepTemplate">
            <Border x:Name="Step"
                    Margin="0,0,4,0"
                    Padding="4,5"
                    CornerRadius="{DynamicResource ControlCornerRadius}"
                    Background="{DynamicResource ControlFillColorSecondaryBrush}">
                <TextBlock x:Name="StepText"
                           Text="{Binding Name}"
                           FontSize="11"
                           HorizontalAlignment="Center"
                           TextTrimming="CharacterEllipsis"
                           Foreground="{DynamicResource TextTertiaryBrush}" />
            </Border>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding State}" Value="past">
                    <Setter TargetName="Step" Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
                    <Setter TargetName="StepText" Property="Foreground" Value="{DynamicResource AccentBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding State}" Value="current">
                    <Setter TargetName="Step" Property="Background" Value="{DynamicResource AccentBrush}" />
                    <Setter TargetName="StepText" Property="Foreground" Value="{DynamicResource TextOnAccentFillColorPrimaryBrush}" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <!-- Testler / Kalifikasyon satırı sağ tık menüsü -->
        <ContextMenu x:Key="RunMenu">
            <MenuItem Header="{x:Static res:Resources.Run_OpenNote}" Click="RunMenuNote_Click">
                <MenuItem.Icon>
                    <controls:FontIcon Glyph="{x:Static local:AppIcons.Note}" />
                </MenuItem.Icon>
            </MenuItem>
            <MenuItem Header="{x:Static res:Resources.Run_OpenFolder}" Click="RunMenuFolder_Click">
                <MenuItem.Icon>
                    <controls:FontIcon Glyph="{x:Static local:AppIcons.OpenFolder}" />
                </MenuItem.Icon>
            </MenuItem>
            <MenuItem Header="{x:Static res:Resources.Run_OpenRaw}" Click="RunMenuRaw_Click" />
            <MenuItem Header="{x:Static res:Resources.Run_OpenPhotos}" Click="RunMenuPhotos_Click" />
        </ContextMenu>

        <!-- Envanter kaydı: geçmişte bir olay (dikey çizgi + renkli nokta) -->
        <DataTemplate x:Key="HistoryTemplate">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="20" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Rectangle Width="2" HorizontalAlignment="Center" Fill="{DynamicResource DividerStrokeColorDefaultBrush}" />
                <Ellipse x:Name="Dot" Width="11" Height="11" Margin="0,5,0,0" VerticalAlignment="Top" HorizontalAlignment="Center"
                         Stroke="{DynamicResource LayerBrush}" StrokeThickness="2" Fill="{DynamicResource TextTertiaryBrush}" />
                <StackPanel Grid.Column="1" Margin="6,0,0,12">
                    <StackPanel Orientation="Horizontal">
                        <ContentPresenter Content="{Binding Status}" ContentTemplate="{DynamicResource StatusChipTemplate}" VerticalAlignment="Center" />
                        <TextBlock Text="{Binding Meta}" Margin="8,0,0,0" VerticalAlignment="Center"
                                   Style="{DynamicResource CaptionTextBlockStyle}" Foreground="{DynamicResource TextTertiaryBrush}" />
                        <Button Margin="6,0,0,0" Style="{DynamicResource IconButtonStyle}" Width="24" Height="24" Tag="{Binding NotePath}"
                                Click="HistoryNote_Click" ToolTip="{x:Static res:Resources.Run_OpenNote}"
                                Visibility="{Binding HasNote, Converter={StaticResource BoolToVis}}">
                            <controls:FontIcon Glyph="{x:Static local:AppIcons.Note}" FontSize="12" />
                        </Button>
                    </StackPanel>
                    <TextBlock Text="{Binding Detail}" TextWrapping="Wrap" Margin="0,3,0,0" Foreground="{DynamicResource TextSecondaryBrush}"
                               Visibility="{Binding HasDetail, Converter={StaticResource BoolToVis}}" />
                </StackPanel>
            </Grid>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding Status.Tone}" Value="done">
                    <Setter TargetName="Dot" Property="Fill" Value="{DynamicResource SystemFillColorSuccessBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Status.Tone}" Value="active">
                    <Setter TargetName="Dot" Property="Fill" Value="{DynamicResource AccentBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Status.Tone}" Value="waiting">
                    <Setter TargetName="Dot" Property="Fill" Value="{DynamicResource SystemFillColorCautionBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Status.Tone}" Value="warning">
                    <Setter TargetName="Dot" Property="Fill" Value="{DynamicResource SystemFillColorCautionBrush}" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <!-- Envanter durum menüsü: her açılışta tür kalıbından kurulur. -->
        <ContextMenu x:Key="InventoryStatusMenu" Opened="InventoryStatusMenu_Opened" />

        <!-- Durum menüsü: her açılışta tür kalıbından kurulur (MainWindow.xaml.cs). -->
        <ContextMenu x:Key="StatusMenu" Opened="StatusMenu_Opened" />

        <!-- Menüler ağaçla aynı DataContext'i kod tarafında alır (MainWindow.xaml.cs). -->
        <!-- "+ Yeni" menüsü: proje, stok (seçili projeye), sonra Türler'deki envanter türleri (AddMenu_Opened ekler) -->
        <ContextMenu x:Key="AddMenu" Opened="AddMenu_Opened">
            <MenuItem Header="{x:Static res:Resources.Menu_NewProject}"
                      Command="{Binding NewProjectCommand}"
                      InputGestureText="{x:Static res:Resources.Gesture_NewProject}">
                <MenuItem.Icon>
                    <controls:FontIcon Glyph="{x:Static local:AppIcons.Project}" Foreground="{DynamicResource Pusula.ProjectIconBrush}" />
                </MenuItem.Icon>
            </MenuItem>
            <MenuItem Header="{Binding NewStockMenuText}"
                      Command="{Binding NewStockCommand}"
                      InputGestureText="{x:Static res:Resources.Gesture_NewStock}">
                <MenuItem.Icon>
                    <controls:FontIcon Glyph="{x:Static local:AppIcons.Stock}" Foreground="{DynamicResource AccentBrush}" />
                </MenuItem.Icon>
            </MenuItem>
        </ContextMenu>

        <!-- Envanter listesi satırı: aç, klasör, not -->
        <ContextMenu x:Key="InventoryRowMenu">
            <MenuItem Header="{x:Static res:Resources.StockInv_OpenRecord}" Click="StockInvOpen_Click" />
            <MenuItem Header="{x:Static res:Resources.Menu_OpenFolder}" Click="StockInvFolder_Click" />
            <MenuItem Header="{x:Static res:Resources.QuickNote_AddMenu}" Click="StockInvNote_Click" />
            <Separator />
            <MenuItem Header="{x:Static res:Resources.Menu_Edit}" Click="StockInvEdit_Click" />
            <MenuItem Header="{x:Static res:Resources.Menu_Untrack}" Click="StockInvUntrack_Click" />
<MenuItem Header="{x:Static res:Resources.Menu_Delete}" Click="StockInvDelete_Click" />
        </ContextMenu>

        <ContextMenu x:Key="NodeMenu">
            <MenuItem Header="{Binding NewStockMenuText}" Command="{Binding NewStockCommand}">
                <MenuItem.Icon>
                    <controls:FontIcon Glyph="{x:Static local:AppIcons.Stock}" Foreground="{DynamicResource AccentBrush}" />
                </MenuItem.Icon>
            </MenuItem>
            <MenuItem Header="{x:Static res:Resources.Menu_MarkAsProject}"
                      Command="{Binding MarkAsProjectCommand}"
                      Visibility="{Binding CanMarkAsProject, Converter={StaticResource BoolToVis}}">
                <MenuItem.Icon>
                    <controls:FontIcon Glyph="{x:Static local:AppIcons.Project}" Foreground="{DynamicResource Pusula.ProjectIconBrush}" />
                </MenuItem.Icon>
            </MenuItem>
            <MenuItem Header="{Binding MarkInventoryMenuText}"
                      Command="{Binding MarkAsInventoryCommand}"
                      Visibility="{Binding CanMarkAsInventory, Converter={StaticResource BoolToVis}}">
                <MenuItem.Icon>
                    <controls:FontIcon Glyph="{x:Static local:AppIcons.Check}" />
                </MenuItem.Icon>
            </MenuItem>
            <MenuItem Header="{x:Static res:Resources.Menu_MarkAsStock}"
                      Command="{Binding MarkAsStockCommand}"
                      Visibility="{Binding CanMarkAsStock, Converter={StaticResource BoolToVis}}">
                <MenuItem.Icon>
                    <controls:FontIcon Glyph="{x:Static local:AppIcons.Stock}" Foreground="{DynamicResource AccentBrush}" />
                </MenuItem.Icon>
            </MenuItem>
            <MenuItem Header="{x:Static res:Resources.Menu_Edit}" Click="NodeEdit_Click"
                      Visibility="{Binding CanEditSelected, Converter={StaticResource BoolToVis}}">
                <MenuItem.Icon>
                    <controls:FontIcon Glyph="{x:Static local:AppIcons.Edit}" />
                </MenuItem.Icon>
            </MenuItem>
            <MenuItem Header="{x:Static res:Resources.Menu_Untrack}" Click="NodeUntrack_Click"
                      Visibility="{Binding CanEditSelected, Converter={StaticResource BoolToVis}}">
                <MenuItem.Icon>
                    <controls:FontIcon Glyph="{x:Static local:AppIcons.Remove}" />
                </MenuItem.Icon>
            </MenuItem>
            <MenuItem Header="{x:Static res:Resources.Menu_Delete}" Click="NodeDelete_Click"
                      Visibility="{Binding CanEditSelected, Converter={StaticResource BoolToVis}}">
                <MenuItem.Icon>
                    <controls:FontIcon Glyph="{x:Static local:AppIcons.Delete}" />
                </MenuItem.Icon>
            </MenuItem>
            <MenuItem Header="{x:Static res:Resources.Menu_AddModules}" Command="{Binding AddModulesCommand}">
                <MenuItem.Icon>
                    <controls:FontIcon Glyph="{x:Static local:AppIcons.Add}" />
                </MenuItem.Icon>
            </MenuItem>
            <MenuItem Header="{x:Static res:Resources.Menu_OpenFolder}" Command="{Binding OpenFolderCommand}">
                <MenuItem.Icon>
                    <controls:FontIcon Glyph="{x:Static local:AppIcons.OpenFolder}" />
                </MenuItem.Icon>
            </MenuItem>
            <Separator />
            <MenuItem Header="{x:Static res:Resources.Menu_Refresh}" Command="{Binding RefreshCommand}" InputGestureText="{x:Static res:Resources.Gesture_Refresh}">
                <MenuItem.Icon>
                    <controls:FontIcon Glyph="{x:Static local:AppIcons.Refresh}" />
                </MenuItem.Icon>
            </MenuItem>
        </ContextMenu>

        <ContextMenu x:Key="TreeMenu">
            <MenuItem Header="{x:Static res:Resources.Menu_NewProject}"
                      Command="{Binding NewProjectCommand}"
                      InputGestureText="{x:Static res:Resources.Gesture_NewProject}">
                <MenuItem.Icon>
                    <controls:FontIcon Glyph="{x:Static local:AppIcons.Project}" Foreground="{DynamicResource Pusula.ProjectIconBrush}" />
                </MenuItem.Icon>
            </MenuItem>
            <MenuItem Header="{x:Static res:Resources.Menu_Refresh}" Command="{Binding RefreshCommand}" InputGestureText="{x:Static res:Resources.Gesture_Refresh}">
                <MenuItem.Icon>
                    <controls:FontIcon Glyph="{x:Static local:AppIcons.Refresh}" />
                </MenuItem.Icon>
            </MenuItem>
        </ContextMenu>
    </controls:ChromeWindow.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>


        <!-- Gövde: solda ağaç, sağda seçili düğüm -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="320" MinWidth="220" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Win11 düzeni: sağdaki içerik, zeminden ayrılan köşesi yuvarlak bir kart -->
            <Border Grid.Column="1"
                    Background="{DynamicResource LayerBrush}"
                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1,1,0,0"
                    CornerRadius="8,0,0,0" />

            <Border Grid.Column="0" Background="Transparent">
                <Grid x:Name="TreePane" SizeChanged="TreePane_SizeChanged">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" MinHeight="40" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" MinHeight="60" />
                    </Grid.RowDefinitions>

                    <!-- Ağaç başlığı: Projeler + ekle + yenile -->
                    <Grid Grid.Row="0" Margin="16,8,8,4">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <!-- Ağaçta ara: numara, ad, tanım -->
                        <controls:SearchBox Grid.Row="1" Grid.ColumnSpan="4" Margin="-4,8,0,0"
                                            PlaceholderText="{x:Static res:Resources.Tree_Search}"
                                            Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                                            Visibility="{Binding HasRoot, Converter={StaticResource BoolToVis}}" />
                        <TextBlock Grid.Column="0"
                                   Style="{DynamicResource CaptionTextBlockStyle}"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   VerticalAlignment="Center"
                                   Text="{x:Static res:Resources.Tree_Header}" />
                        <controls:DropDownButton x:Name="AddButton"
                                                 Grid.Column="1"
                                                 Menu="{StaticResource AddMenu}"
                                                 ToolTip="{x:Static res:Resources.Button_Add}">
                            <controls:FontIcon Glyph="{x:Static local:AppIcons.Add}" FontSize="14" Foreground="{DynamicResource AccentBrush}" />

                        </controls:DropDownButton>
                        <Button Grid.Column="2"
                                Style="{DynamicResource IconButtonStyle}"
                                Command="{Binding RefreshCommand}"
                                ToolTip="{x:Static res:Resources.Button_Refresh}"
                                Margin="4,0,0,0">
                            <controls:FontIcon Glyph="{x:Static local:AppIcons.Refresh}" FontSize="14" />
                        </Button>
                        <Button Grid.Column="3"
                                Style="{DynamicResource IconButtonStyle}"
                                Click="Settings_Click"
                                ToolTip="{x:Static res:Resources.Button_Settings}">
                            <controls:FontIcon Glyph="{x:Static local:AppIcons.Settings}" FontSize="14" />
                        </Button>
                    </Grid>

                    <TextBlock Grid.Row="1"
                               Margin="16,8"
                               TextWrapping="Wrap"
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               Text="{x:Static res:Resources.Tree_NoRoot}">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource CaptionTextBlockStyle}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasRoot}" Value="True">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>

                    <TreeView x:Name="FolderTree"
                              Grid.Row="1"
                              ItemsSource="{Binding ProjectNodes}"
                              Visibility="{Binding HasRoot, Converter={StaticResource BoolToVis}}"
                              ContextMenu="{StaticResource TreeMenu}"
                              Background="Transparent"
                              BorderThickness="0"
                              Padding="4"
                              SelectedItemChanged="FolderTree_SelectedItemChanged"
                              PreviewMouseRightButtonDown="FolderTree_PreviewMouseRightButtonDown">
                        <TreeView.ItemContainerStyle>
                            <Style TargetType="TreeViewItem" BasedOn="{StaticResource TreeItemStyle}">
                                <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}" />
                                <Setter Property="IsSelected" Value="{Binding IsSelected, Mode=TwoWay}" />
                                <Setter Property="ContextMenu" Value="{StaticResource NodeMenu}" />
                                <Setter Property="Visibility" Value="{Binding IsVisible, Converter={StaticResource BoolToVis}}" />

                            </Style>
                        </TreeView.ItemContainerStyle>
                        <TreeView.ItemTemplate>
                            <HierarchicalDataTemplate ItemsSource="{Binding Children}">
                                <StackPanel>
                                    <StackPanel x:Name="Row" Orientation="Horizontal" Margin="0,1" ToolTip="{Binding ToolTipText}">
                                        <controls:FontIcon x:Name="Icon" Glyph="{Binding Glyph}" FontSize="15"
                                                           Style="{StaticResource KindIconStyle}"
                                                           VerticalAlignment="Center" />
                                        <TextBlock x:Name="Title" Text="{Binding Title}" Margin="9,0,0,0" VerticalAlignment="Center" />
                                        <TextBlock x:Name="Subtitle" Text="{Binding DisplaySubtitle}" Margin="8,0,0,0" VerticalAlignment="Center" MaxWidth="120" TextWrapping="NoWrap"
                                                   TextTrimming="CharacterEllipsis"
                                                   Style="{DynamicResource CaptionTextBlockStyle}" Foreground="{DynamicResource TextTertiaryBrush}" />
                                    </StackPanel>
                                </StackPanel>
                                <HierarchicalDataTemplate.Triggers>
                                    <DataTrigger Binding="{Binding Kind}" Value="{x:Static core:FolderKind.InventoryGroup}">

                                        <Setter TargetName="Title" Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
                                        <Setter TargetName="Title" Property="FontWeight" Value="SemiBold" />
                                        <Setter TargetName="Icon" Property="FontSize" Value="14" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Kind}" Value="{x:Static core:FolderKind.InventoryItem}">
                                        <Setter TargetName="Subtitle" Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding IsUnmarkedInventory}" Value="True">
                                        <Setter TargetName="Subtitle" Property="Visibility" Value="Collapsed" />
                                        <Setter TargetName="Title" Property="Foreground" Value="{DynamicResource TextTertiaryBrush}" />
                                        <Setter TargetName="Title" Property="FontStyle" Value="Italic" />
                                    </DataTrigger>
                                </HierarchicalDataTemplate.Triggers>
                            </HierarchicalDataTemplate>
                        </TreeView.ItemTemplate>
                    </TreeView>

                    <!-- Envanter ayrı bölmede; aradaki çizgi sürüklenerek boyutlanır -->
                    <Border Grid.Row="2" Height="1" Margin="12,2" VerticalAlignment="Center" IsHitTestVisible="False"
                            Background="{DynamicResource CardStrokeColorDefaultBrush}"
                            Visibility="{Binding HasInventory, Converter={StaticResource BoolToVis}}" />
                    <GridSplitter Grid.Row="2" Height="6" HorizontalAlignment="Stretch" ResizeDirection="Rows"
                                  Background="Transparent" Focusable="False"
                                  Visibility="{Binding HasInventory, Converter={StaticResource BoolToVis}}" />
                    <TreeView x:Name="InventoryTree"
                              Grid.Row="3"
                              ItemsSource="{Binding InventoryNodes}"
                              Visibility="{Binding HasInventory, Converter={StaticResource BoolToVis}}"
                              ItemContainerStyle="{Binding ItemContainerStyle, ElementName=FolderTree}"
                              ItemTemplate="{Binding ItemTemplate, ElementName=FolderTree}"
                              Background="Transparent"
                              BorderThickness="0"
                              Padding="4"
                              SelectedItemChanged="FolderTree_SelectedItemChanged"
                              PreviewMouseRightButtonDown="FolderTree_PreviewMouseRightButtonDown" />
                </Grid>
            </Border>

            <!-- Hiçbir şey seçili değil -->
            <StackPanel Grid.Column="1"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center">
                <StackPanel.Style>
                    <Style TargetType="StackPanel">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding HasSelection}" Value="True">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </StackPanel.Style>
                <controls:FontIcon Glyph="{x:Static local:AppIcons.Project}" FontSize="40"
                                   Foreground="{DynamicResource TextTertiaryBrush}"
                                   HorizontalAlignment="Center" />
                <TextBlock Style="{DynamicResource SubtitleTextBlockStyle}"
                           HorizontalAlignment="Center"
                           Margin="0,12,0,0"
                           Text="{x:Static res:Resources.Content_EmptyTitle}" />
                <TextBlock Style="{DynamicResource BodyTextBlockStyle}"
                           Foreground="{DynamicResource TextSecondaryBrush}"
                           HorizontalAlignment="Center"
                           Text="{x:Static res:Resources.Content_EmptyHint}" />
            </StackPanel>

            <!-- Seçili düğüm: başlık, özet kutucukları, tablo -->
            <Grid Grid.Column="1"
                  Margin="32,20,32,12"
                  Visibility="{Binding HasSelection, Converter={StaticResource BoolToVis}}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Başlık -->
                <Grid Grid.Row="0" DataContext="{Binding SelectedNode}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <controls:FontIcon Grid.Column="0" Glyph="{Binding Glyph}" FontSize="32"
                                       Style="{StaticResource KindIconStyle}"
                                       VerticalAlignment="Center" Margin="0,0,16,0" />
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Style="{DynamicResource CaptionTextBlockStyle}"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   Text="{Binding DataContext.Detail.Subtitle, RelativeSource={RelativeSource AncestorType=Window}}" />
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{DynamicResource SubtitleTextBlockStyle}" Text="{Binding Title}" VerticalAlignment="Center" />
                            <controls:DropDownButton Margin="14,0,0,0"
                                                     Padding="4,2"
                                                     VerticalAlignment="Center"
                                                     Menu="{StaticResource StatusMenu}"
                                                     ToolTip="{x:Static res:Resources.Status_ChangeHint}"
                                                     Visibility="{Binding DataContext.Detail.IsStock, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVis}}">
                                <ContentPresenter Content="{Binding DataContext.Detail.Status, RelativeSource={RelativeSource AncestorType=Window}}"
                                                  ContentTemplate="{DynamicResource StatusChipTemplate}" />
                            </controls:DropDownButton>
                            <TextBlock Margin="10,0,0,0"
                                       VerticalAlignment="Center"
                                       Style="{DynamicResource CaptionTextBlockStyle}"
                                       Foreground="{DynamicResource TextTertiaryBrush}"
                                       Text="{Binding DataContext.Detail.StatusInfo, RelativeSource={RelativeSource AncestorType=Window}}"
                                       Visibility="{Binding DataContext.Detail.IsStock, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVis}}" />
                            <controls:DropDownButton Margin="14,0,0,0"
                                                     Padding="4,2"
                                                     VerticalAlignment="Center"
                                                     Menu="{StaticResource InventoryStatusMenu}"
                                                     ToolTip="{x:Static res:Resources.Status_ChangeHint}"
                                                     Visibility="{Binding DataContext.Inventory.IsRecord, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVis}}">
                                <ContentPresenter Content="{Binding DataContext.Inventory.Status, RelativeSource={RelativeSource AncestorType=Window}}"
                                                  ContentTemplate="{DynamicResource StatusChipTemplate}" />
                            </controls:DropDownButton>
                            <TextBlock Margin="10,0,0,0"
                                       VerticalAlignment="Center"
                                       Style="{DynamicResource CaptionTextBlockStyle}"
                                       Foreground="{DynamicResource TextTertiaryBrush}"
                                       Text="{Binding DataContext.Inventory.StatusInfo, RelativeSource={RelativeSource AncestorType=Window}}"
                                       Visibility="{Binding DataContext.Inventory.IsRecord, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVis}}" />
                        </StackPanel>
                        <TextBlock Style="{DynamicResource CaptionTextBlockStyle}"
                                   Foreground="{DynamicResource TextTertiaryBrush}"
                                   TextTrimming="CharacterEllipsis"
                                   Text="{Binding Path}" />
                    </StackPanel>
                    <Button Grid.Column="2"
                            VerticalAlignment="Center"
                            Command="{Binding DataContext.OpenFolderCommand, RelativeSource={RelativeSource AncestorType=Window}}">
                        <StackPanel Orientation="Horizontal">
                            <controls:FontIcon Glyph="{x:Static local:AppIcons.OpenFolder}" FontSize="14" VerticalAlignment="Center" />
                            <TextBlock Text="{x:Static res:Resources.Menu_OpenFolder}" Margin="8,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                </Grid>

                <!-- Stok: aşama çubuğu -->
                <ItemsControl Grid.Row="1" Margin="0,14,0,0"
                              ItemsSource="{Binding Detail.Steps}"
                              ItemTemplate="{StaticResource StatusStepTemplate}"
                              Visibility="{Binding Detail.IsStock, Converter={StaticResource BoolToVis}}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <UniformGrid Rows="1" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                </ItemsControl>

                <!-- Envanter kaydı: aşama çubuğu -->
                <ItemsControl Grid.Row="1" Margin="0,14,0,0"
                              ItemsSource="{Binding Inventory.Steps}"
                              ItemTemplate="{StaticResource StatusStepTemplate}"
                              Visibility="{Binding Inventory.IsRecord, Converter={StaticResource BoolToVis}}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <UniformGrid Rows="1" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                </ItemsControl>

                <!-- Proje: durum dağılımı -->
                <ItemsControl Grid.Row="1" Margin="0,14,0,0"
                              ItemsSource="{Binding Detail.Distribution}"
                              Visibility="{Binding Detail.IsProject, Converter={StaticResource BoolToVis}}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <ContentPresenter Content="{Binding}" ContentTemplate="{DynamicResource StatusChipTemplate}" Margin="0,0,6,0" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- Özet kutucukları (proje) -->
                <ItemsControl Grid.Row="2" Margin="0,16,0,0"
                              ItemsSource="{Binding Detail.Tiles}"
                              ItemsPanel="{StaticResource TilesPanel}"
                              ItemTemplate="{StaticResource TileTemplate}"
                              Visibility="{Binding Detail.IsProject, Converter={StaticResource BoolToVis}}" />

                <!-- Hesaplanıyor -->
                <StackPanel Grid.Row="3" Orientation="Horizontal" VerticalAlignment="Top" Margin="0,16,0,0"
                            Visibility="{Binding Detail.IsLoading, Converter={StaticResource BoolToVis}}">
                    <controls:ProgressRing Width="16" Height="16" IsActive="True" />
                    <TextBlock Margin="8,0,0,0" Foreground="{DynamicResource TextSecondaryBrush}"
                               Text="{x:Static res:Resources.Detail_Loading}" />
                </StackPanel>

                <!-- Proje: kısa notlar ve stok tablosu -->
                <Grid Grid.Row="3" Margin="0,16,0,0" Visibility="{Binding Detail.IsProject, Converter={StaticResource BoolToVis}}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Border Grid.Row="0" Margin="0,0,0,14" Padding="14,10" TextElement.FontWeight="Normal"
                            Background="{DynamicResource LayerBrush}" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                            CornerRadius="{DynamicResource OverlayCornerRadius}">
                        <StackPanel>
                            <TextBlock Style="{StaticResource PaneLabel}" Text="{x:Static res:Resources.QuickNote_Section}" />
                            <Grid Margin="0,0,0,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBox Tag="Project" KeyDown="QuickNoteBox_KeyDown" ToolTip="{x:Static res:Resources.QuickNote_Hint}" />
                                <Button Grid.Column="1" Margin="6,0,0,0" Tag="Project" Click="QuickNoteAdd_Click">
                                    <StackPanel Orientation="Horizontal">
                                        <controls:FontIcon Glyph="{x:Static local:AppIcons.Note}" FontSize="14" />
                                        <TextBlock Margin="8,0,0,0" Text="{x:Static res:Resources.QuickNote_Add}" />
                                    </StackPanel>
                                </Button>
                            </Grid>
                            <ScrollViewer MaxHeight="150" VerticalScrollBarVisibility="Auto">
                                <ItemsControl ItemsSource="{Binding Detail.ProjectNotes}" ItemTemplate="{StaticResource HistoryTemplate}" />
                            </ScrollViewer>
                            <!-- Projenin bütün stoklarındaki açık işler (aç / kapa) -->
                            <Expander Margin="0,10,0,0" IsExpanded="{Binding Detail.OpenTasksExpanded, Mode=TwoWay}"
                                      Visibility="{Binding Detail.HasOpenTasks, Converter={StaticResource BoolToVis}}">
                                <Expander.Header>
                                    <TextBlock Style="{StaticResource PaneLabel}" Margin="0" Text="{Binding Detail.OpenTasksHeader}" />
                                </Expander.Header>
                                <ScrollViewer Margin="0,4,0,0" MaxHeight="190" VerticalScrollBarVisibility="Auto">
                                    <ItemsControl ItemsSource="{Binding Detail.OpenTasks}" ItemTemplate="{Binding ItemTemplate, ElementName=OpenTaskList}" />
                                </ScrollViewer>
                            </Expander>
                        </StackPanel>
                    </Border>
                <ListView Grid.Row="1"
                          ItemsSource="{Binding Detail.Rows}"
                          ItemContainerStyle="{StaticResource DetailRowStyle}"
                          MouseDoubleClick="DetailList_MouseDoubleClick">
                    <ListView.ContextMenu>
                        <ContextMenu>
                            <MenuItem Header="{x:Static res:Resources.Row_Open}" Click="DetailRowOpen_Click" />
                            <MenuItem Header="{x:Static res:Resources.Menu_OpenFolder}" Click="DetailRowFolder_Click" />
                            <MenuItem Header="{x:Static res:Resources.QuickNote_AddMenu}" Click="DetailRowNote_Click" />
                            <Separator />
                            <MenuItem Header="{x:Static res:Resources.Menu_Edit}" Click="DetailRowEdit_Click" />
                            <MenuItem Header="{x:Static res:Resources.Menu_Untrack}" Click="DetailRowUntrack_Click" />
<MenuItem Header="{x:Static res:Resources.Menu_Delete}" Click="DetailRowDelete_Click" />
                        </ContextMenu>
                    </ListView.ContextMenu>
                    <ListView.View>
                        <GridView>
                            <GridViewColumn Width="44">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <Button Style="{DynamicResource IconButtonStyle}" Tag="{Binding Path}" Click="RowFolder_Click"
                                                ToolTip="{x:Static res:Resources.Menu_OpenFolder}">
                                            <controls:FontIcon Glyph="{x:Static local:AppIcons.OpenFolder}" FontSize="13" />
                                        </Button>
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                            <GridViewColumn Header="{x:Static res:Resources.Col_Stock}" Width="140" DisplayMemberBinding="{Binding Name}" />
                            <GridViewColumn Header="{x:Static res:Resources.Col_Status}" Width="160">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <ContentPresenter Content="{Binding Status}" ContentTemplate="{DynamicResource StatusChipTemplate}" />
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                            <GridViewColumn Header="{x:Static res:Resources.Col_Template}" Width="130" DisplayMemberBinding="{Binding Template}" />
                            <GridViewColumn Header="{x:Static res:Resources.Col_Files}" Width="80" DisplayMemberBinding="{Binding FileCount}" />
                            <GridViewColumn Header="{x:Static res:Resources.Col_Size}" Width="100" DisplayMemberBinding="{Binding Size}" />
                            <GridViewColumn Header="{x:Static res:Resources.Col_LastChange}" Width="150" DisplayMemberBinding="{Binding LastChange}" />
                        </GridView>
                    </ListView.View>
                </ListView>
                </Grid>

                <!-- Envanter kaydı: dosyalar, bilgiler, not ve geçmiş -->
                <ScrollViewer Grid.Row="2" Grid.RowSpan="3" Margin="0,16,0,0" VerticalScrollBarVisibility="Auto"
                              Visibility="{Binding Inventory.IsRecord, Converter={StaticResource BoolToVis}}">
                <Grid TextElement.FontWeight="Normal">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="16" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                    <!-- Dosyalar: alt klasör kutucukları ve fotoğraf şeridi -->
                    <Border Padding="16,12" Margin="0,0,0,16"
                            Background="{DynamicResource LayerBrush}" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                            CornerRadius="{DynamicResource OverlayCornerRadius}">
                        <StackPanel>
                            <TextBlock Style="{StaticResource PaneLabel}" Text="{x:Static res:Resources.Inv_Files}" />
                            <ItemsControl ItemsSource="{Binding Inventory.FolderTiles}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <UniformGrid Rows="1" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Button Margin="0,0,6,0" Padding="10,6" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                                                Tag="{Binding Path}" Click="RecordFolder_Click" ToolTip="{Binding Path}">
                                            <StackPanel>
                                                <TextBlock Text="{Binding Label}" Style="{DynamicResource CaptionTextBlockStyle}"
                                                           Foreground="{DynamicResource TextSecondaryBrush}" TextTrimming="CharacterEllipsis" />
                                                <TextBlock x:Name="TileValue" Text="{Binding Value}" FontWeight="SemiBold" />
                                <TextBlock Text="{Binding Kinds}" Style="{DynamicResource CaptionTextBlockStyle}" TextTrimming="CharacterEllipsis"
                                           Foreground="{DynamicResource TextTertiaryBrush}" ToolTip="{Binding Kinds}"
                                           Visibility="{Binding HasKinds, Converter={StaticResource BoolToVis}}" />
                                            </StackPanel>
                                        </Button>
                                        <DataTemplate.Triggers>
                                            <DataTrigger Binding="{Binding IsEmpty}" Value="True">
                                                <Setter TargetName="TileValue" Property="FontWeight" Value="Normal" />
                                                <Setter TargetName="TileValue" Property="Foreground" Value="{DynamicResource TextTertiaryBrush}" />
                                            </DataTrigger>
                                        </DataTemplate.Triggers>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <Grid Margin="0,10,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <ItemsControl ItemsSource="{Binding Inventory.Photos}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <UniformGrid Rows="1" Columns="4" />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Button Margin="0,0,6,0" Padding="0" Height="72" Tag="{Binding}" Click="RecordPhoto_Click" ToolTip="{Binding}">
                                                <Image Source="{Binding Converter={StaticResource PathToImage}}" Stretch="UniformToFill" />
                                            </Button>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <TextBlock Grid.Column="1" VerticalAlignment="Center" Margin="4,0,0,0"
                                           Foreground="{DynamicResource TextSecondaryBrush}" Text="{Binding Inventory.MorePhotos}" />
                            </Grid>
                        </StackPanel>
                    </Border>
                    <Border VerticalAlignment="Top" Padding="16,12"
                            Background="{DynamicResource LayerBrush}" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                            CornerRadius="{DynamicResource OverlayCornerRadius}">
                        <StackPanel>
                            <TextBlock Style="{StaticResource PaneLabel}" Text="{x:Static res:Resources.Inv_Facts}" />
                            <ItemsControl ItemsSource="{Binding Inventory.Facts}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,3">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="110" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{Binding Label}" Foreground="{DynamicResource TextSecondaryBrush}" />
                                            <TextBlock Grid.Column="1" Text="{Binding Value}" TextWrapping="Wrap" />
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                    <!-- Obsidian notu: ilk satırlar; yoksa "Not oluştur" -->
                    <Border Padding="16,12" Margin="0,0,0,16"
                            Background="{DynamicResource LayerBrush}" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                            CornerRadius="{DynamicResource OverlayCornerRadius}">
                        <StackPanel>
                            <TextBlock Style="{StaticResource PaneLabel}" Text="{x:Static res:Resources.Inv_NoteTitle}" />
                            <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource TextSecondaryBrush}"
                                       Text="{Binding Inventory.NoteExcerpt}"
                                       Visibility="{Binding Inventory.HasNote, Converter={StaticResource BoolToVis}}" />
                            <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource TextTertiaryBrush}"
                                       Text="{x:Static res:Resources.Inv_NoNote}"
                                       Visibility="{Binding Inventory.HasNote, Converter={StaticResource InverseBoolToVis}}" />
                            <Button Margin="0,10,0,0" HorizontalAlignment="Left" Click="RecordNote_Click"
                                    Visibility="{Binding Inventory.HasNote, Converter={StaticResource BoolToVis}}">
                                <StackPanel Orientation="Horizontal">
                                    <controls:FontIcon Glyph="{x:Static local:AppIcons.Note}" FontSize="14" />
                                    <TextBlock Margin="8,0,0,0" Text="{x:Static res:Resources.Inv_OpenNote}" />
                                </StackPanel>
                            </Button>
                            <Button Margin="0,10,0,0" HorizontalAlignment="Left" Click="RecordCreateNote_Click"
                                    Visibility="{Binding Inventory.HasNote, Converter={StaticResource InverseBoolToVis}}">
                                <StackPanel Orientation="Horizontal">
                                    <controls:FontIcon Glyph="{x:Static local:AppIcons.Add}" FontSize="14" />
                                    <TextBlock Margin="8,0,0,0" Text="{x:Static res:Resources.Inv_CreateNote}" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Border>
                    <Border VerticalAlignment="Top" Padding="16,12"
                            Background="{DynamicResource LayerBrush}" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                            CornerRadius="{DynamicResource OverlayCornerRadius}">
                        <StackPanel>
                            <TextBlock Style="{StaticResource PaneLabel}" Text="{x:Static res:Resources.Inv_History}" />                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBox Tag="Record" KeyDown="QuickNoteBox_KeyDown" ToolTip="{x:Static res:Resources.QuickNote_Hint}" />
                                <Button Grid.Column="1" Margin="6,0,0,0" Tag="Record" Click="QuickNoteAdd_Click">
                                    <StackPanel Orientation="Horizontal">
                                        <controls:FontIcon Glyph="{x:Static local:AppIcons.Note}" FontSize="14" />
                                        <TextBlock Margin="8,0,0,0" Text="{x:Static res:Resources.QuickNote_Add}" />
                                    </StackPanel>
                                </Button>
                            </Grid>
                            <ItemsControl ItemsSource="{Binding Inventory.History}" ItemTemplate="{StaticResource HistoryTemplate}" />
                        </StackPanel>
                    </Border>
                    </StackPanel>
                </Grid>
                </ScrollViewer>

                <!-- Envanter: liste (tür ya da bölüm seçiliyken); üstte süzgeçler -->
                <Grid Grid.Row="2" Grid.RowSpan="3" Margin="0,16,0,0" TextElement.FontWeight="Normal"
                      Visibility="{Binding Inventory.IsList, Converter={StaticResource BoolToVis}}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <WrapPanel Grid.Row="0" Orientation="Horizontal">
                        <controls:SearchBox Width="220" Margin="0,0,8,6" PlaceholderText="{x:Static res:Resources.Filter_Search}"
                                            Text="{Binding Inventory.FilterText, UpdateSourceTrigger=PropertyChanged}" />
                        <StackPanel Orientation="Horizontal" Margin="0,0,8,6" Visibility="{Binding Inventory.ShowTypeFilter, Converter={StaticResource BoolToVis}}">
                            <TextBlock VerticalAlignment="Center" Margin="0,0,6,0" Foreground="{DynamicResource TextSecondaryBrush}" Text="{x:Static res:Resources.Inv_Type}" />
                            <ComboBox MinWidth="110" ItemsSource="{Binding Inventory.TypeOptions}" SelectedItem="{Binding Inventory.FilterType, Mode=TwoWay}" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,8,6">
                            <TextBlock VerticalAlignment="Center" Margin="0,0,6,0" Foreground="{DynamicResource TextSecondaryBrush}" Text="{x:Static res:Resources.Inv_SubType}" />
                            <ComboBox MinWidth="130" ItemsSource="{Binding Inventory.SubTypeOptions}" SelectedItem="{Binding Inventory.FilterSubType, Mode=TwoWay}" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,8,6">
                            <TextBlock VerticalAlignment="Center" Margin="0,0,6,0" Foreground="{DynamicResource TextSecondaryBrush}" Text="{x:Static res:Resources.Col_Status}" />
                            <ComboBox MinWidth="150" ItemsSource="{Binding Inventory.StatusOptions}" SelectedItem="{Binding Inventory.FilterStatus, Mode=TwoWay}" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,8,6">
                            <TextBlock VerticalAlignment="Center" Margin="0,0,6,0" Foreground="{DynamicResource TextSecondaryBrush}" Text="{x:Static res:Resources.Inv_Level}" />
                            <ComboBox MinWidth="100" ItemsSource="{Binding Inventory.LevelOptions}" SelectedItem="{Binding Inventory.FilterLevel, Mode=TwoWay}" />
                        </StackPanel>
                        <TextBlock VerticalAlignment="Center" Margin="4,0,0,6" Style="{DynamicResource CaptionTextBlockStyle}"
                                   Foreground="{DynamicResource TextTertiaryBrush}" Text="{Binding Inventory.FilterSummary}" />
                    </WrapPanel>
                    <ListView x:Name="InventoryList" Grid.Row="1" Margin="0,10,0,0" ContextMenu="{StaticResource InventoryRowMenu}"
                              ItemsSource="{Binding Inventory.Rows}"
                              MouseDoubleClick="InventoryList_MouseDoubleClick">
                        <ListView.View>
                            <GridView>
                                <GridViewColumn Width="44">
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate>
                                            <Button Style="{DynamicResource IconButtonStyle}" Tag="{Binding Folder}" Click="RowFolder_Click"
                                                    ToolTip="{x:Static res:Resources.Menu_OpenFolder}">
                                                <controls:FontIcon Glyph="{x:Static local:AppIcons.OpenFolder}" FontSize="13" />
                                            </Button>
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>
                                <GridViewColumn Header="{x:Static res:Resources.Inv_Number}" Width="120" DisplayMemberBinding="{Binding Number}" />
                                <GridViewColumn Header="{x:Static res:Resources.Inv_Name}" Width="190" DisplayMemberBinding="{Binding Name}" />
                                <GridViewColumn x:Name="InventoryTypeColumn" Header="{x:Static res:Resources.Inv_Type}" Width="60" DisplayMemberBinding="{Binding TypeName}" />
                                <GridViewColumn Header="{x:Static res:Resources.Inv_SubType}" Width="120" DisplayMemberBinding="{Binding SubType}" />
                                <GridViewColumn Header="{x:Static res:Resources.Col_Status}" Width="175">
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate>
                                            <ContentPresenter Content="{Binding Status}" ContentTemplate="{DynamicResource StatusChipTemplate}" />
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>
                                <GridViewColumn Header="{x:Static res:Resources.Inv_Location}" Width="120" DisplayMemberBinding="{Binding Location}" />
                                <GridViewColumn Header="{x:Static res:Resources.Inv_Level}" Width="145" DisplayMemberBinding="{Binding Level}" />
                            </GridView>
                        </ListView.View>
                    </ListView>
                </Grid>

                <!-- Stok: sekmeler -->
                <TabControl x:Name="StockTabs" Grid.Row="3" Grid.RowSpan="2" Margin="0,14,0,0"
                            Visibility="{Binding Detail.IsStock, Converter={StaticResource BoolToVis}}">
                    <!-- Genel -->
                    <TabItem Header="{x:Static res:Resources.Tab_General}">
                        <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,14,0,0" TextElement.FontWeight="Normal">
                            <StackPanel>
                                <!-- Kapak: fotoğraf + not -->
                                <Border Margin="0,0,0,16" Padding="12" DataContext="{Binding Detail.Cover}"
                                        Background="{DynamicResource LayerBrush}" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                                        CornerRadius="{DynamicResource OverlayCornerRadius}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <!--
                                            Kapak kırpılmaz. Kutu fotoğrafın oranına göre boyutlanır: en çok 320×180; çok dar ya da çok geniş
                                            fotoğrafta kutu en az 132×132 kalır, fotoğraf ortalanır. Köşedeki düğme fotoğrafı tam boy açar.
                                        -->
                                        <Grid Grid.Column="0" Margin="0,0,16,0" VerticalAlignment="Top" HorizontalAlignment="Left"
                                              Visibility="{Binding HasCover, Converter={StaticResource BoolToVis}}">
                                            <Border x:Name="CoverFrame" MinWidth="132" MinHeight="132" Padding="4"
                                                    Background="{DynamicResource ControlFillColorDefaultBrush}"
                                                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                                                    CornerRadius="{DynamicResource ControlCornerRadius}">
                                                <Image x:Name="CoverImage" Source="{Binding CoverPhoto, Converter={StaticResource PathToImage}}"
                                                       Stretch="Uniform" MaxWidth="320" MaxHeight="180"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            </Border>
                                            <Button x:Name="CoverButton" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,8,8" Padding="6"
                                                    Click="CoverPhoto_Click" ToolTip="{x:Static res:Resources.Cover_Open}">
                                                <controls:FontIcon Glyph="{x:Static local:AppIcons.FullScreen}" FontSize="12" />
                                            </Button>
                                        </Grid>
                                        <StackPanel Grid.Column="1">
                                            <TextBlock Style="{StaticResource PaneLabel}" Text="{x:Static res:Resources.Inv_NoteTitle}" />
                                            <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource TextSecondaryBrush}" Text="{Binding NoteExcerpt}"
                                                       Visibility="{Binding HasNote, Converter={StaticResource BoolToVis}}" />
                                            <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource TextTertiaryBrush}" Text="{x:Static res:Resources.Stock_NoNote}"
                                                       Visibility="{Binding HasNote, Converter={StaticResource InverseBoolToVis}}" />
                                            <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                                <Button Click="StockNote_Click" Visibility="{Binding HasNote, Converter={StaticResource BoolToVis}}">
                                                    <StackPanel Orientation="Horizontal">
                                                        <controls:FontIcon Glyph="{x:Static local:AppIcons.Note}" FontSize="14" />
                                                        <TextBlock Margin="8,0,0,0" Text="{x:Static res:Resources.Inv_OpenNote}" />
                                                    </StackPanel>
                                                </Button>
                                                <Button Click="StockCreateNote_Click" Visibility="{Binding HasNote, Converter={StaticResource InverseBoolToVis}}">
                                                    <StackPanel Orientation="Horizontal">
                                                        <controls:FontIcon Glyph="{x:Static local:AppIcons.Add}" FontSize="14" />
                                                        <TextBlock Margin="8,0,0,0" Text="{x:Static res:Resources.Inv_CreateNote}" />
                                                    </StackPanel>
                                                </Button>
                                                <Button Margin="6,0,0,0" Click="StockPhotos_Click" Visibility="{Binding HasPhotosFolder, Converter={StaticResource BoolToVis}}">
                                                    <StackPanel Orientation="Horizontal">
                                                        <controls:FontIcon Glyph="{x:Static local:AppIcons.OpenFolder}" FontSize="14" />
                                                        <TextBlock Margin="8,0,0,0" Text="{Binding PhotosText}" />
                                                    </StackPanel>
                                                </Button>
                                                <Button Margin="6,0,0,0" Click="StockDocuments_Click" ToolTip="{Binding DocumentsFolder}"
                                                        Visibility="{Binding HasDocumentsFolder, Converter={StaticResource BoolToVis}}">
                                                    <StackPanel Orientation="Horizontal">
                                                        <controls:FontIcon Glyph="{x:Static local:AppIcons.OpenFolder}" FontSize="14" />
                                                        <TextBlock Margin="8,0,0,0" Text="{Binding DocumentsText}" />
                                                    </StackPanel>
                                                </Button>
                                            </StackPanel>
                                            <Grid Margin="0,10,0,0">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <TextBox Tag="Stock" KeyDown="QuickNoteBox_KeyDown" ToolTip="{x:Static res:Resources.QuickNote_Hint}" />
                                                <Button Grid.Column="1" Margin="6,0,0,0" Tag="Stock" Click="QuickNoteAdd_Click">
                                                    <StackPanel Orientation="Horizontal">
                                                        <controls:FontIcon Glyph="{x:Static local:AppIcons.Note}" FontSize="14" />
                                                        <TextBlock Margin="8,0,0,0" Text="{x:Static res:Resources.QuickNote_Add}" />
                                                    </StackPanel>
                                                </Button>
                                            </Grid>
                                            <ItemsControl Margin="0,10,0,0" ItemsSource="{Binding Strip}">
                                                <ItemsControl.ItemsPanel>
                                                    <ItemsPanelTemplate>
                                                        <StackPanel Orientation="Horizontal" />
                                                    </ItemsPanelTemplate>
                                                </ItemsControl.ItemsPanel>
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Button Width="84" Height="56" Padding="0" Margin="0,0,6,0" Tag="{Binding}" Click="StockPhoto_Click" ToolTip="{Binding}">
                                                            <Image Source="{Binding Converter={StaticResource PathToImage}}" Stretch="UniformToFill" />
                                                        </Button>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>
                                    </Grid>
                                </Border>

                                <ItemsControl ItemsSource="{Binding Detail.TestKpis}" ItemTemplate="{StaticResource KpiTemplate}" Margin="0,0,-10,16"
                                              Visibility="{Binding Detail.HasRuns, Converter={StaticResource BoolToVis}}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <UniformGrid Rows="1" />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                </ItemsControl>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="9*" />
                                        <ColumnDefinition Width="24" />
                                        <ColumnDefinition Width="11*" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Style="{StaticResource PaneLabel}" Text="{x:Static res:Resources.General_Attention}" />
                                        <ItemsControl ItemsSource="{Binding Detail.Alerts}" ItemTemplate="{StaticResource AlertTemplate}" />
                                        <TextBlock Style="{StaticResource HintText}" Text="{x:Static res:Resources.General_NoAttention}"
                                                   Visibility="{Binding Detail.HasAlerts, Converter={StaticResource InverseBoolToVis}}" />

                                        <!-- Açık işler: md notlarındaki "- [ ]" maddeleri; tıklayınca not açılır -->
                                        <Expander Margin="0,12,0,0" IsExpanded="{Binding Detail.OpenTasksExpanded, Mode=TwoWay}"
                                                  Visibility="{Binding Detail.HasOpenTasks, Converter={StaticResource BoolToVis}}">
                                            <Expander.Header>
                                                <TextBlock Style="{StaticResource PaneLabel}" Margin="0" Text="{Binding Detail.OpenTasksHeader}" />
                                            </Expander.Header>
                                            <ItemsControl x:Name="OpenTaskList" Margin="0,4,0,0" ItemsSource="{Binding Detail.OpenTasks}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Button Style="{DynamicResource SubtleButtonStyle}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                                                                Padding="6,4" Margin="0,0,0,2" Tag="{Binding NotePath}" Click="OpenTaskNote_Click">
                                                            <Grid>
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="Auto" />
                                                                    <ColumnDefinition Width="*" />
                                                                    <ColumnDefinition Width="Auto" />
                                                                </Grid.ColumnDefinitions>
                                                                <Border Width="12" Height="12" Margin="0,3,10,0" VerticalAlignment="Top" CornerRadius="2"
                                                                        BorderThickness="1.5" BorderBrush="{DynamicResource TextSecondaryBrush}" />
                                                                <TextBlock Grid.Column="1" TextWrapping="Wrap" Text="{Binding Text}" />
                                                                <TextBlock Grid.Column="2" Margin="10,0,0,0" Style="{DynamicResource CaptionTextBlockStyle}"
                                                                           Foreground="{DynamicResource TextTertiaryBrush}" Text="{Binding Label}" />
                                                            </Grid>
                                                        </Button>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </Expander>

                                        <TextBlock Style="{StaticResource PaneLabel}" Margin="0,16,0,8" Text="{x:Static res:Resources.StockInv_Section}" />
                                        <ItemsControl ItemsSource="{Binding Detail.InventoryGroups}">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <UniformGrid Rows="1" />
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border x:Name="Box" Margin="0,0,8,0" Padding="12,9" BorderThickness="1"
                                                            CornerRadius="{DynamicResource OverlayCornerRadius}"
                                                            Background="{DynamicResource LayerBrush}" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}">
                                                        <StackPanel Orientation="Horizontal">
                                                            <controls:FontIcon Glyph="{Binding Glyph}" Foreground="{Binding Color}" FontSize="16" VerticalAlignment="Center" />
                                                            <TextBlock Margin="10,0,0,0" Text="{Binding Summary}" VerticalAlignment="Center" />
                                                        </StackPanel>
                                                    </Border>
                                                    <DataTemplate.Triggers>
                                                        <DataTrigger Binding="{Binding HasWarning}" Value="True">
                                                            <Setter TargetName="Box" Property="Background" Value="{DynamicResource SystemFillColorCautionBackgroundBrush}" />
                                                        </DataTrigger>
                                                    </DataTemplate.Triggers>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>

                                        <TextBlock Style="{StaticResource PaneLabel}" Margin="0,16,0,8" Text="{x:Static res:Resources.General_Latest}" />
                                        <StackPanel Visibility="{Binding Detail.HasRuns, Converter={StaticResource BoolToVis}}">
                                            <StackPanel Orientation="Horizontal">
                                                <Border Width="64" />
                                                <ItemsControl ItemsSource="{Binding Detail.MatrixHeaders}">
                                                    <ItemsControl.ItemsPanel>
                                                        <ItemsPanelTemplate>
                                                            <StackPanel Orientation="Horizontal" />
                                                        </ItemsPanelTemplate>
                                                    </ItemsControl.ItemsPanel>
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <TextBlock Width="132" TextAlignment="Center" Text="{Binding}" Style="{DynamicResource CaptionTextBlockStyle}"
                                                                       Foreground="{DynamicResource TextSecondaryBrush}" />
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </StackPanel>
                                            <ItemsControl ItemsSource="{Binding Detail.MatrixRows}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                                            <TextBlock Width="64" Text="{Binding Serial}" VerticalAlignment="Center" FontWeight="SemiBold" />
                                                            <ItemsControl ItemsSource="{Binding Cells}">
                                                                <ItemsControl.ItemsPanel>
                                                                    <ItemsPanelTemplate>
                                                                        <StackPanel Orientation="Horizontal" />
                                                                    </ItemsPanelTemplate>
                                                                </ItemsControl.ItemsPanel>
                                                                <ItemsControl.ItemTemplate>
                                                                    <DataTemplate>
                                                                        <Border Width="126" Height="34" Margin="0,0,6,0"
                                                                                Background="{DynamicResource LayerBrush}" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                                                                                BorderThickness="1" CornerRadius="{DynamicResource ControlCornerRadius}">
                                                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                                                                              Content="{Binding}" ContentTemplate="{DynamicResource StatusChipTemplate}" />
                                                                        </Border>
                                                                    </DataTemplate>
                                                                </ItemsControl.ItemTemplate>
                                                            </ItemsControl>
                                                        </StackPanel>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>
                                        <TextBlock Style="{StaticResource HintText}" TextWrapping="Wrap" Text="{x:Static res:Resources.General_NoRuns}"
                                                   Visibility="{Binding Detail.HasRuns, Converter={StaticResource InverseBoolToVis}}" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Style="{StaticResource PaneLabel}" Text="{x:Static res:Resources.General_Timeline}" />
                                        <ItemsControl ItemsSource="{Binding Detail.Timeline}" ItemTemplate="{StaticResource TimelineTemplate}" />
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </ScrollViewer>
                    </TabItem>

                    <!-- Testler -->
                    <TabItem Header="{Binding Detail.TestsHeader}">
                        <DockPanel Margin="0,8,0,0" TextElement.FontWeight="Normal">
                            <ItemsControl x:Name="TestPlanList" DockPanel.Dock="Top" ItemsSource="{Binding Detail.TestPlans}" ItemTemplate="{StaticResource PlanTemplate}" />
                            <ListView ItemsSource="{Binding Detail.DevelopmentRuns}"
                                      View="{StaticResource RunsGridView}"
                                      GridViewColumnHeader.Click="RunsHeader_Click"
                                      MouseDoubleClick="RunsList_MouseDoubleClick"
                                      ContextMenu="{StaticResource RunMenu}" />
                        </DockPanel>
                    </TabItem>

                    <!-- Kalifikasyon -->
                    <TabItem Header="{Binding Detail.QualificationHeader}">
                        <DockPanel Margin="0,8,0,0" TextElement.FontWeight="Normal">
                            <ItemsControl DockPanel.Dock="Top" ItemsSource="{Binding Detail.QualificationPlans}" ItemTemplate="{StaticResource PlanTemplate}" />
                            <ListView ItemsSource="{Binding Detail.QualificationRuns}"
                                      View="{StaticResource RunsGridView}"
                                      GridViewColumnHeader.Click="RunsHeader_Click"
                                      MouseDoubleClick="RunsList_MouseDoubleClick"
                                      ContextMenu="{StaticResource RunMenu}" />
                        </DockPanel>
                    </TabItem>

                    <!-- Klasörler -->
                    <TabItem Header="{x:Static res:Resources.Tab_Folders}">
                        <Grid Margin="0,12,0,0" TextElement.FontWeight="Normal">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <ItemsControl Grid.Row="0"
                                          ItemsSource="{Binding Detail.Tiles}"
                                          ItemsPanel="{StaticResource TilesPanel}"
                                          ItemTemplate="{StaticResource TileTemplate}" />
                            <TreeView Grid.Row="1" Margin="0,12,0,0"
                                      ItemsSource="{Binding Detail.FolderTree}"
                                      Background="Transparent" BorderThickness="0"
                                      MouseDoubleClick="FolderTreeView_MouseDoubleClick">
                                <TreeView.ItemContainerStyle>
                                    <Style TargetType="TreeViewItem" BasedOn="{StaticResource TreeItemStyle}">
                                        <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}" />
                                    </Style>
                                </TreeView.ItemContainerStyle>
                                <TreeView.ItemTemplate>
                                    <HierarchicalDataTemplate ItemsSource="{Binding Children}">
                                        <StackPanel Orientation="Horizontal" Margin="0,1">
                                            <controls:FontIcon Glyph="{x:Static local:AppIcons.Folder}" FontSize="14"
                                                               Foreground="{DynamicResource Pusula.ProjectIconBrush}" VerticalAlignment="Center" />
                                            <TextBlock x:Name="FolderName" Text="{Binding Name}" Margin="8,0,0,0" FontFamily="Consolas" VerticalAlignment="Center" />
                                            <TextBlock Text="{Binding CountText}" Margin="10,0,0,0" VerticalAlignment="Center"
                                                       Style="{DynamicResource CaptionTextBlockStyle}" Foreground="{DynamicResource TextTertiaryBrush}" />
                                        </StackPanel>
                                        <HierarchicalDataTemplate.Triggers>
                                            <DataTrigger Binding="{Binding IsDim}" Value="True">
                                                <Setter TargetName="FolderName" Property="Foreground" Value="{DynamicResource TextTertiaryBrush}" />
                                            </DataTrigger>
                                        </HierarchicalDataTemplate.Triggers>
                                    </HierarchicalDataTemplate>
                                </TreeView.ItemTemplate>
                            </TreeView>
                            <TextBlock Grid.Row="2" Style="{StaticResource HintText}" Text="{x:Static res:Resources.Folders_Hint}" />
                        </Grid>
                    </TabItem>
                </TabControl>

                <TextBlock Grid.Row="4" Margin="0,8,0,0"
                           Style="{DynamicResource CaptionTextBlockStyle}"
                           Foreground="{DynamicResource TextTertiaryBrush}"
                           Text="{Binding Detail.Note}"
                           Visibility="{Binding Detail.IsProject, Converter={StaticResource BoolToVis}}" />
            </Grid>
        </Grid>

        <!-- Durum çubuğu -->
        <StatusBar Grid.Row="2">
            <StatusBarItem>
                <TextBlock Text="{Binding Status}" />
            </StatusBarItem>
        </StatusBar>

        <!-- Yeni proje -->
        <controls:ContentDialog Grid.RowSpan="3"
                                IsOpen="{Binding IsProjectDialogOpen, Mode=TwoWay}"
                                                                Title="{x:Static res:Resources.Dialog_NewProjectTitle}"
                                PrimaryButtonText="{x:Static res:Resources.Dialog_Create}"
                                CloseButtonText="{x:Static res:Resources.Dialog_Cancel}"
                                PrimaryButtonClick="ProjectDialog_PrimaryButtonClick">
            <StackPanel MinWidth="320">
                <controls:FormField Header="{x:Static res:Resources.Field_ProjectNo}" IsRequired="True" LabelWidth="90">
                    <TextBox Text="{Binding NewProjectNo, UpdateSourceTrigger=PropertyChanged}"
                             IsVisibleChanged="FocusWhenVisible" />
                </controls:FormField>
                <controls:FormField Header="{x:Static res:Resources.Field_ProjectName}" IsRequired="True" LabelWidth="90"
                                    Margin="0,8,0,0"
                                    ErrorText="{Binding ProjectError}">
                    <TextBox Text="{Binding NewProjectName, UpdateSourceTrigger=PropertyChanged}" />
                </controls:FormField>
            </StackPanel>
        </controls:ContentDialog>

        <!-- Yeni stok -->
        <controls:ContentDialog Grid.RowSpan="3"
                                IsOpen="{Binding IsStockDialogOpen, Mode=TwoWay}"
                                                                Title="{Binding StockDialogTitle}"
                                PrimaryButtonText="{x:Static res:Resources.Dialog_Create}"
                                CloseButtonText="{x:Static res:Resources.Dialog_Cancel}"
                                PrimaryButtonClick="StockDialog_PrimaryButtonClick">
            <StackPanel MinWidth="320">
                <controls:FormField Header="{x:Static res:Resources.Field_StockNo}" IsRequired="True" LabelWidth="90">
                    <TextBox Text="{Binding NewStockNo, UpdateSourceTrigger=PropertyChanged}"
                             IsVisibleChanged="FocusWhenVisible" />
                </controls:FormField>
                <TextBlock Margin="98,4,0,0"
                           MaxWidth="320"
                           HorizontalAlignment="Left"
                           TextWrapping="Wrap"
                           Style="{DynamicResource CaptionTextBlockStyle}"
                           Foreground="{DynamicResource TextTertiaryBrush}"
                           Text="{Binding StockNumberHint}" />
                <controls:FormField Header="{x:Static res:Resources.Field_StockName}" LabelWidth="90"
                                    Margin="0,8,0,0"
                                    ErrorText="{Binding StockError}">
                    <TextBox Text="{Binding NewStockName, UpdateSourceTrigger=PropertyChanged}" />
                </controls:FormField>
                <controls:FormField Header="{x:Static res:Resources.Field_Template}" LabelWidth="90"
                                    Margin="0,8,0,0">
                    <ComboBox ItemsSource="{Binding TemplateNames}"
                              SelectedItem="{Binding SelectedTemplate, Mode=TwoWay}" />
                </controls:FormField>
                <controls:FormField Header="{x:Static res:Resources.Field_Modules}" LabelWidth="90"
                                    Margin="0,8,0,0">
                    <ItemsControl ItemsSource="{Binding StockModules}" ItemTemplate="{StaticResource ModuleOptionTemplate}" />
                </controls:FormField>
            </StackPanel>
        </controls:ContentDialog>

        <!-- Elle açılmış klasörü proje / stok olarak işaretle -->
        <controls:ContentDialog Grid.RowSpan="3"
                                IsOpen="{Binding IsMarkDialogOpen, Mode=TwoWay}"
                                                                Title="{Binding MarkTitle}"
                                PrimaryButtonText="{x:Static res:Resources.Mark_Confirm}"
                                CloseButtonText="{x:Static res:Resources.Dialog_Cancel}"
                                PrimaryButtonClick="MarkDialog_PrimaryButtonClick">
            <StackPanel MinWidth="340">
                <TextBlock Style="{DynamicResource CaptionTextBlockStyle}"
                           Foreground="{DynamicResource TextSecondaryBrush}"
                           TextWrapping="Wrap"
                           MaxWidth="380"
                           HorizontalAlignment="Left"
                           Margin="0,0,0,12"
                           Text="{x:Static res:Resources.Mark_Hint}" />
                <controls:FormField Header="{Binding MarkNumberLabel}" IsRequired="True" LabelWidth="90">
                    <TextBox Text="{Binding MarkNumber, UpdateSourceTrigger=PropertyChanged}" IsVisibleChanged="FocusWhenVisible" />
                </controls:FormField>
                <TextBlock Margin="98,4,0,0"
                           MaxWidth="320"
                           HorizontalAlignment="Left"
                           TextWrapping="Wrap"
                           Style="{DynamicResource CaptionTextBlockStyle}"
                           Foreground="{DynamicResource TextTertiaryBrush}"
                           Text="{Binding StockNumberHint}"
                           Visibility="{Binding MarkIsStock, Converter={StaticResource BoolToVis}}" />
                <controls:FormField Header="{Binding MarkNameLabel}" LabelWidth="90" Margin="0,8,0,0"
                                    ErrorText="{Binding MarkError}">
                    <TextBox Text="{Binding MarkName, UpdateSourceTrigger=PropertyChanged}" />
                </controls:FormField>
            </StackPanel>
        </controls:ContentDialog>

        <!-- Yeni envanter kaydı (kablo, jig …) -->
        <controls:ContentDialog Grid.RowSpan="3"
                                IsOpen="{Binding IsInventoryDialogOpen, Mode=TwoWay}"
                                                                Title="{Binding InventoryDialogTitle}"
                                PrimaryButtonText="{x:Static res:Resources.Dialog_Create}"
                                CloseButtonText="{x:Static res:Resources.Dialog_Cancel}"
                                PrimaryButtonClick="InventoryDialog_PrimaryButtonClick">
            <StackPanel MinWidth="380">
                <TextBlock Style="{DynamicResource CaptionTextBlockStyle}" Foreground="{DynamicResource TextSecondaryBrush}"
                           TextWrapping="Wrap" MaxWidth="400" HorizontalAlignment="Left" Margin="0,0,0,10"
                           Text="{x:Static res:Resources.Mark_Hint}"
                           Visibility="{Binding IsInventoryMarkMode, Converter={StaticResource BoolToVis}}" />
                <controls:FormField Header="{x:Static res:Resources.Inv_Level}" LabelWidth="90"
                                    Visibility="{Binding IsInventoryMarkMode, Converter={StaticResource InverseBoolToVis}}">
                    <ComboBox ItemsSource="{Binding InventoryLevels}" SelectedItem="{Binding NewInventoryLevel, Mode=TwoWay}" DisplayMemberPath="Label" />
                </controls:FormField>
                <controls:FormField Header="{x:Static res:Resources.Col_Status}" LabelWidth="90"
                                    Visibility="{Binding IsInventoryMarkMode, Converter={StaticResource BoolToVis}}">
                    <ComboBox ItemsSource="{Binding InventoryStatuses}" SelectedItem="{Binding NewInventoryStatus, Mode=TwoWay}" />
                </controls:FormField>
                <controls:FormField Header="{x:Static res:Resources.Inv_Number}" IsRequired="True" LabelWidth="90" Margin="0,8,0,0">
                    <TextBox Text="{Binding NewInventoryNumber, UpdateSourceTrigger=PropertyChanged}" IsVisibleChanged="FocusWhenVisible" />
                </controls:FormField>
                <TextBlock Margin="98,4,0,0" Style="{DynamicResource CaptionTextBlockStyle}" Foreground="{DynamicResource TextTertiaryBrush}"
                           Text="{Binding InventoryNumberHint}" />
                <controls:FormField Header="{x:Static res:Resources.Inv_Name}" IsRequired="True" LabelWidth="90" Margin="0,8,0,0">
                    <TextBox Text="{Binding NewInventoryName, UpdateSourceTrigger=PropertyChanged}" />
                </controls:FormField>
                <controls:FormField Header="{x:Static res:Resources.Inv_SubType}" LabelWidth="90" Margin="0,8,0,0">
                    <ComboBox ItemsSource="{Binding InventorySubTypes}" SelectedItem="{Binding NewInventorySubType, Mode=TwoWay}" />
                </controls:FormField>
                <controls:FormField Header="{x:Static res:Resources.Inv_Note}" LabelWidth="90" Margin="0,8,0,0"
                                    ErrorText="{Binding InventoryError}">
                    <TextBox Text="{Binding NewInventoryNote, UpdateSourceTrigger=PropertyChanged}" />
                </controls:FormField>
                <TextBlock Margin="98,8,0,0" Style="{DynamicResource CaptionTextBlockStyle}" Foreground="{DynamicResource TextTertiaryBrush}"
                           TextWrapping="Wrap" Width="220" HorizontalAlignment="Left"
                           Text="{x:Static res:Resources.Inv_TemplateHint}"
                           Visibility="{Binding IsInventoryMarkMode, Converter={StaticResource InverseBoolToVis}}" />
            </StackPanel>
        </controls:ContentDialog>

        <!-- Envanter durum olayı: tarih, kişi, konum, not -->
        <controls:ContentDialog Grid.RowSpan="3"
                                IsOpen="{Binding IsEventDialogOpen, Mode=TwoWay}"
                                                                Title="{Binding EventTitle}"
                                PrimaryButtonText="{x:Static res:Resources.Editor_Save}"
                                CloseButtonText="{x:Static res:Resources.Dialog_Cancel}"
                                PrimaryButtonClick="EventDialog_PrimaryButtonClick">
            <StackPanel MinWidth="380">
                <controls:FormField Header="{x:Static res:Resources.Inv_Date}" LabelWidth="90">
                    <DatePicker SelectedDate="{Binding EventDate, Mode=TwoWay}" />
                </controls:FormField>
                <controls:FormField Header="{x:Static res:Resources.Inv_Person}" LabelWidth="90" Margin="0,8,0,0">
                    <TextBox Text="{Binding EventPerson, UpdateSourceTrigger=PropertyChanged}" />
                </controls:FormField>
                <controls:FormField Header="{x:Static res:Resources.Inv_Location}" LabelWidth="90" Margin="0,8,0,0">
                    <TextBox Text="{Binding EventLocation, UpdateSourceTrigger=PropertyChanged}" IsVisibleChanged="FocusWhenVisible" />
                </controls:FormField>
                <controls:FormField Header="{x:Static res:Resources.Inv_Note}" LabelWidth="90" Margin="0,8,0,0">
                    <TextBox Text="{Binding EventNote, UpdateSourceTrigger=PropertyChanged}" />
                </controls:FormField>
            </StackPanel>
        </controls:ContentDialog>

        <!-- Durum notu (Beklemede gibi) -->
        <controls:ContentDialog Grid.RowSpan="3"
                                IsOpen="{Binding IsQuickNoteOpen, Mode=TwoWay}"
                                                                Title="{Binding QuickNoteTitle}"
                                PrimaryButtonText="{x:Static res:Resources.QuickNote_Add}"
                                CloseButtonText="{x:Static res:Resources.Dialog_Cancel}"
                                PrimaryButtonClick="QuickNote_PrimaryButtonClick">
            <TextBox MinWidth="380" MinHeight="70" TextWrapping="Wrap" AcceptsReturn="True" VerticalContentAlignment="Top"
                     Text="{Binding QuickNoteText, UpdateSourceTrigger=PropertyChanged}" IsVisibleChanged="FocusWhenVisible" />
        </controls:ContentDialog>

        <!-- Düzenle: proje, stok, envanter kaydı (ortak) -->
        <controls:ContentDialog Grid.RowSpan="3"
                                IsOpen="{Binding IsEditOpen, Mode=TwoWay}"
                                                                Title="{Binding EditTitle}"
                                PrimaryButtonText="{x:Static res:Resources.Edit_Save}"
                                CloseButtonText="{x:Static res:Resources.Dialog_Cancel}"
                                PrimaryButtonClick="Edit_PrimaryButtonClick">
            <StackPanel MinWidth="400">
                <controls:FormField Header="{x:Static res:Resources.Edit_Number}" LabelWidth="80">
                    <TextBlock Text="{Binding EditNumber}" FontWeight="SemiBold" VerticalAlignment="Center" />
                </controls:FormField>
                <TextBlock Margin="80,2,0,10" Style="{DynamicResource CaptionTextBlockStyle}" Foreground="{DynamicResource TextTertiaryBrush}"
                           Text="{x:Static res:Resources.Edit_NumberHint}" />
                <controls:FormField Header="{x:Static res:Resources.Edit_Name}" LabelWidth="80">
                    <TextBox x:Name="EditNameBox" Text="{Binding EditName, UpdateSourceTrigger=PropertyChanged}" IsVisibleChanged="FocusWhenVisible" />
                </controls:FormField>
                <controls:FormField Margin="0,8,0,0" Header="{x:Static res:Resources.Edit_Template}" LabelWidth="80"
                                    Visibility="{Binding IsEditStock, Converter={StaticResource BoolToVis}}">
                    <ComboBox ItemsSource="{Binding EditTemplates}" SelectedItem="{Binding EditTemplate, Mode=TwoWay}" />
                </controls:FormField>
                <controls:FormField Margin="0,8,0,0" Header="{x:Static res:Resources.Edit_SubType}" LabelWidth="80"
                                    Visibility="{Binding IsEditInventory, Converter={StaticResource BoolToVis}}">
                    <ComboBox ItemsSource="{Binding EditSubTypes}" Text="{Binding EditSubType, Mode=TwoWay}" IsEditable="True" />
                </controls:FormField>
                <controls:FormField Margin="0,8,0,0" Header="{x:Static res:Resources.Edit_Note}" LabelWidth="80"
                                    Visibility="{Binding IsEditInventory, Converter={StaticResource BoolToVis}}">
                    <TextBox Text="{Binding EditNote, UpdateSourceTrigger=PropertyChanged}" />
                </controls:FormField>
                <TextBlock Margin="0,10,0,0" TextWrapping="Wrap" Foreground="{DynamicResource SystemFillColorCriticalBrush}" Text="{Binding EditError}" />
            </StackPanel>
        </controls:ContentDialog>

        <!-- Sil: klasör _SILINENLER'e taşınır; Sil düğmesi ad doğru yazılınca görünür -->
        <controls:ContentDialog Grid.RowSpan="3"
                                IsOpen="{Binding IsDeleteOpen, Mode=TwoWay}"
                                                                Title="{Binding DeleteTitle}"
                                PrimaryButtonText="{Binding DeletePrimaryText}"
                                CloseButtonText="{x:Static res:Resources.Dialog_Cancel}"
                                PrimaryButtonClick="Delete_PrimaryButtonClick">
            <StackPanel MaxWidth="460">
                <TextBlock TextWrapping="Wrap" Text="{Binding DeleteText}" />
                <controls:SearchBox Margin="0,12,0,0" PlaceholderText="{x:Static res:Resources.Delete_TypeHint}"
                                    Text="{Binding DeleteTyped, UpdateSourceTrigger=PropertyChanged}" IsVisibleChanged="FocusWhenVisible" />
            </StackPanel>
        </controls:ContentDialog>

        <!-- Takipten çıkar: dosyalar silinmez -->
        <controls:ContentDialog Grid.RowSpan="3"
                                IsOpen="{Binding IsUntrackOpen, Mode=TwoWay}"
                                                                Title="{Binding UntrackTitle}"
                                PrimaryButtonText="{x:Static res:Resources.Untrack_Confirm}"
                                CloseButtonText="{x:Static res:Resources.Dialog_Cancel}"
                                PrimaryButtonClick="Untrack_PrimaryButtonClick">
            <TextBlock MaxWidth="440" TextWrapping="Wrap" Text="{Binding UntrackText}" />
        </controls:ContentDialog>

        <controls:ContentDialog Grid.RowSpan="3"
                                IsOpen="{Binding IsStatusNoteOpen, Mode=TwoWay}"
                                                                Title="{Binding StatusNoteTitle}"
                                PrimaryButtonText="{x:Static res:Resources.ModuleDialog_Apply}"
                                CloseButtonText="{x:Static res:Resources.Dialog_Cancel}"
                                PrimaryButtonClick="StatusNote_PrimaryButtonClick">
            <controls:FormField MinWidth="320" Header="{x:Static res:Resources.Field_StatusNote}" LabelWidth="60">
                <TextBox Text="{Binding StatusNoteText, UpdateSourceTrigger=PropertyChanged}" IsVisibleChanged="FocusWhenVisible" />
            </controls:FormField>
        </controls:ContentDialog>

        <!-- Modül ekle -->
        <controls:ContentDialog Grid.RowSpan="3"
                                IsOpen="{Binding IsModuleDialogOpen, Mode=TwoWay}"
                                                                Title="{Binding ModuleDialogTitle}"
                                PrimaryButtonText="{x:Static res:Resources.Dialog_Add}"
                                CloseButtonText="{x:Static res:Resources.Dialog_Cancel}"
                                PrimaryButtonClick="ModuleDialog_PrimaryButtonClick">
            <ItemsControl MinWidth="320"
                          ItemsSource="{Binding AddableModules}"
                          ItemTemplate="{StaticResource ModuleOptionTemplate}" />
        </controls:ContentDialog>
    </Grid>

</controls:ChromeWindow>
