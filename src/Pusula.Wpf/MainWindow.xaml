                        <Ellipse Canvas.Left="18.3" Canvas.Top="10.3" Width="6.4" Height="6.4" Fill="White" Opacity="0.85" />
                        <Path Data="M5.5,25 C6.1,20.6 8.8,18.2 12,18.2 S17.9,20.6 18.5,25 Z" Fill="White" />
