<controls:ChromeWindow x:Class="Pusula.Wpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:DesignKit.Controls;assembly=DesignKit.Wpf"
        xmlns:icons="clr-namespace:DesignKit.Icons;assembly=DesignKit.Wpf"
        xmlns:core="clr-namespace:Pusula.Core.Tracking;assembly=Pusula.Core"
        xmlns:local="clr-namespace:Pusula.Wpf"
        xmlns:res="clr-namespace:Pusula.Wpf.Properties"
        Icon="/Pusula;component/Assets/pusula.ico"
        Title="{x:Static res:Resources.Window_Title}"
        Width="1380" Height="860"
        MinWidth="800" MinHeight="500"
        WindowStartupLocation="CenterScreen"
        FontFamily="{DynamicResource AppFont}"
        Foreground="{DynamicResource TextPrimaryBrush}"
        Background="{DynamicResource SurfaceBaseBrush}">

    <controls:ChromeWindow.InputBindings>
        <KeyBinding Modifiers="Control" Key="N" Command="{Binding NewProjectCommand}" />
        <KeyBinding Modifiers="Control+Shift" Key="N" Command="{Binding NewStockCommand}" />
        <KeyBinding Key="F5" Command="{Binding RefreshCommand}" />
    </controls:ChromeWindow.InputBindings>

    <controls:ChromeWindow.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
        <!-- Türe özel alan girişi (düzenle ve yeni kayıt): yazı / sayı, seçim listesi, evet-hayır -->
        <!-- Düzenle penceresi: envanter kaydında (türe özel alanlar iki sütun) geniş, proje / stokta dar -->
        <Style x:Key="RecordEditDialog" TargetType="controls:ContentDialog">
            <Setter Property="DialogWidth" Value="560" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsEditInventory}" Value="True">
                    <Setter Property="DialogWidth" Value="680" />
                </DataTrigger>
            </Style.Triggers>
        </Style>        <!-- Kayıt sayfasında bilgi hücresi: etiket üstte küçük, değer altta; üstte ince çizgi; boş değer ("—") soluk -->
        <DataTemplate x:Key="FactCellTemplate">
            <Border Margin="0,0,16,0" Padding="0,6,0,6" BorderThickness="0,1,0,0" BorderBrush="{DynamicResource DividerStrokeColorDefaultBrush}">
                <StackPanel>
                    <TextBlock Style="{DynamicResource CaptionTextBlockStyle}" Foreground="{DynamicResource TextSecondaryBrush}" Text="{Binding Label}" TextTrimming="CharacterEllipsis" />
                    <TextBlock x:Name="FactValue" Margin="0,2,0,0" TextWrapping="Wrap" Text="{Binding Value}" />
                </StackPanel>
            </Border>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding IsEmpty}" Value="True">
                    <Setter TargetName="FactValue" Property="Foreground" Value="{DynamicResource TextTertiaryBrush}" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>
        <ItemsPanelTemplate x:Key="TwoColumnPanel">
            <local:TwoColumnRowsPanel VerticalAlignment="Top" />
        </ItemsPanelTemplate>
        <DataTemplate x:Key="FieldInputTemplate">
            <controls:FormField Margin="0,0,16,10" Header="{Binding Label}" LabelWidth="130" ToolTip="{Binding Label}">
                <Grid>
                    <TextBox Text="{Binding Value, UpdateSourceTrigger=PropertyChanged}" controls:TextBoxHelper.PlaceholderText="{Binding Placeholder}"
                             Visibility="{Binding IsText, Converter={StaticResource BoolToVis}}" />
                    <ComboBox ItemsSource="{Binding Choices}" SelectedItem="{Binding Value, Mode=TwoWay}"
                              Visibility="{Binding IsChoice, Converter={StaticResource BoolToVis}}" />
                    <CheckBox IsChecked="{Binding IsYes}" VerticalAlignment="Center"
                              Visibility="{Binding IsYesNo, Converter={StaticResource BoolToVis}}" />
                </Grid>
            </controls:FormField>
        </DataTemplate>
        <local:InverseBooleanToVisibilityConverter x:Key="InverseBoolToVis" />
        <local:PathToImageConverter x:Key="PathToImage" />

        <!-- Stok: bir envanter türünün sekmesi (Jigler, Kablolar …); sekmeler kodda türlerden kurulur -->
        <DataTemplate x:Key="StockInventoryTabTemplate">
            <Grid Margin="0,12,0,0" TextElement.FontWeight="Normal">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <local:AppIcon Glyph="{Binding Glyph}" Foreground="{Binding Color}" FontSize="16" VerticalAlignment="Center" />
                    <TextBlock Margin="10,0,0,0" Text="{Binding Summary}" VerticalAlignment="Center"
                               Style="{DynamicResource CaptionTextBlockStyle}" Foreground="{DynamicResource TextSecondaryBrush}" />
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button Tag="{Binding Type}" Click="StockInvAdd_Click" ToolTip="{x:Static res:Resources.StockInv_AddHint}">
                        <StackPanel Orientation="Horizontal">
                            <local:AppIcon Glyph="{x:Static local:AppIcons.Inventory}" FontSize="14" />
                            <TextBlock Margin="8,0,0,0" Text="{x:Static res:Resources.StockInv_AddExisting}" />
                        </StackPanel>
                    </Button>
                    <Button Margin="6,0,0,0" Tag="{Binding Type}" Click="StockInvNew_Click" ToolTip="{x:Static res:Resources.StockInv_NewHint}">
                        <StackPanel Orientation="Horizontal">
                            <local:AppIcon Glyph="{x:Static local:AppIcons.Add}" FontSize="14" />
                            <TextBlock Margin="8,0,0,0" Text="{x:Static res:Resources.StockInv_New}" />
                        </StackPanel>
                    </Button>
                </StackPanel>
                <ListView Grid.Row="1" Grid.ColumnSpan="2" Margin="0,8,0,0"
                          ItemsSource="{Binding Rows}"
                          MouseDoubleClick="InventoryList_MouseDoubleClick">
                    <ListView.ContextMenu>
                        <ContextMenu>
                            <MenuItem Header="{x:Static res:Resources.StockInv_OpenRecord}" Click="StockInvOpen_Click" />
                            <MenuItem Header="{x:Static res:Resources.Menu_OpenFolder}" Click="StockInvFolder_Click" />
                            <MenuItem Header="{x:Static res:Resources.QuickNote_AddMenu}" Click="StockInvNote_Click" />
                            <Separator />
                            <MenuItem Header="{x:Static res:Resources.Menu_Edit}" Click="StockInvEdit_Click" />
                            <MenuItem Header="{x:Static res:Resources.Menu_Untrack}" Click="StockInvUntrack_Click" />
<MenuItem Header="{x:Static res:Resources.Menu_Delete}" Click="StockInvDelete_Click" />
                            <MenuItem Header="{x:Static res:Resources.StockInv_Unlink}" Click="StockInvUnlink_Click"
                                      Visibility="{Binding PlacementTarget.SelectedItem.IsLinked, RelativeSource={RelativeSource AncestorType=ContextMenu}, Converter={StaticResource BoolToVis}, FallbackValue=Collapsed}" />
                        </ContextMenu>
                    </ListView.ContextMenu>
                    <ListView.View>
                        <GridView>
                            <GridViewColumn Header="{x:Static res:Resources.Inv_Number}" Width="130" DisplayMemberBinding="{Binding Number}" />
                            <GridViewColumn Header="{x:Static res:Resources.Inv_Name}" Width="220" DisplayMemberBinding="{Binding Name}" />
                            <GridViewColumn Header="{x:Static res:Resources.Inv_SubType}" Width="110" DisplayMemberBinding="{Binding SubType}" />
                            <GridViewColumn Header="{x:Static res:Resources.Col_Status}" Width="190">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <ContentPresenter Content="{Binding Status}" ContentTemplate="{DynamicResource StatusChipTemplate}" />
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                            <GridViewColumn Header="{x:Static res:Resources.Inv_Location}" Width="130" DisplayMemberBinding="{Binding Location}" />
                            <GridViewColumn Header="{x:Static res:Resources.Inv_Level}" Width="170" DisplayMemberBinding="{Binding Level}" />
                        </GridView>
                    </ListView.View>
                </ListView>
                <TextBlock Grid.Row="1" Grid.ColumnSpan="2" Margin="12,44,0,0" VerticalAlignment="Top"
                           Style="{DynamicResource HintText}" Text="{x:Static res:Resources.StockInv_Empty}"
                           Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVis}}" />
            </Grid>
        </DataTemplate>

        <Style x:Key="PaneLabel" TargetType="TextBlock" BasedOn="{StaticResource CaptionTextBlockStyle}">
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
            <Setter Property="Margin" Value="0,0,0,6" />
        </Style>

        <Style x:Key="HintText" TargetType="TextBlock" BasedOn="{StaticResource CaptionTextBlockStyle}">
            <Setter Property="Foreground" Value="{DynamicResource TextTertiaryBrush}" />
            <Setter Property="Margin" Value="0,6,0,0" />
        </Style>

        <!-- Sayı çipi: tür simgesi, ad, sayı -->
        <DataTemplate x:Key="CountChipTemplate">
            <Border Margin="0,0,8,8" Padding="10,5" CornerRadius="{DynamicResource ControlCornerRadius}"
                    Background="{DynamicResource LayerBrush}" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                <StackPanel Orientation="Horizontal">
                    <local:AppIcon Glyph="{Binding Glyph}" Foreground="{Binding Color}" FontSize="14" VerticalAlignment="Center" />
                    <TextBlock Margin="8,0,0,0" VerticalAlignment="Center" Foreground="{DynamicResource TextSecondaryBrush}" Text="{Binding Label}" />
                    <TextBlock Margin="8,0,0,0" VerticalAlignment="Center" FontWeight="SemiBold" Text="{Binding Count}" />
                </StackPanel>
            </Border>
        </DataTemplate>
        <ItemsPanelTemplate x:Key="TilesPanel">
            <UniformGrid Rows="1" />
        </ItemsPanelTemplate>

        <DataTemplate x:Key="TileTemplate">
            <Border Background="{DynamicResource LayerBrush}"
                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="{DynamicResource OverlayCornerRadius}"
                    Padding="12,8"
                    Margin="0,0,8,0">
                <StackPanel>
                    <TextBlock Style="{DynamicResource CaptionTextBlockStyle}"
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               Text="{Binding Label}" />
                    <TextBlock Style="{DynamicResource SubtitleTextBlockStyle}"
                               TextTrimming="CharacterEllipsis"
                               ToolTip="{Binding Value}"
                               Text="{Binding Value}" />
                </StackPanel>
            </Border>
        </DataTemplate>

        <!-- Genel sekmesi: dikkat kartı (ikon, başlık, açıklama) -->
        <DataTemplate x:Key="AlertTemplate">
            <Border x:Name="Box" Margin="0,0,0,8" Padding="12,9" CornerRadius="{DynamicResource OverlayCornerRadius}" BorderThickness="1"
                    Background="{DynamicResource LayerBrush}" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <local:AppIcon x:Name="Icon" Glyph="{Binding Glyph}" FontSize="16" Margin="0,1,10,0" VerticalAlignment="Top"
                                       Foreground="{DynamicResource TextSecondaryBrush}" />
                    <StackPanel Grid.Column="1">
                        <TextBlock x:Name="Title" Text="{Binding Title}" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" />
                        <TextBlock Text="{Binding Detail}" TextWrapping="Wrap" Style="{DynamicResource CaptionTextBlockStyle}"
                                   Foreground="{DynamicResource TextSecondaryBrush}" />
                    </StackPanel>
                </Grid>
            </Border>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding Tone}" Value="waiting">
                    <Setter TargetName="Box" Property="Background" Value="{DynamicResource SystemFillColorCautionBackgroundBrush}" />
                    <Setter TargetName="Box" Property="BorderBrush" Value="Transparent" />
                    <Setter TargetName="Icon" Property="Foreground" Value="{DynamicResource SystemFillColorCautionBrush}" />
                    <Setter TargetName="Title" Property="Foreground" Value="{DynamicResource SystemFillColorCautionBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Tone}" Value="failed">
                    <Setter TargetName="Box" Property="Background" Value="{DynamicResource SystemFillColorCriticalBackgroundBrush}" />
                    <Setter TargetName="Box" Property="BorderBrush" Value="Transparent" />
                    <Setter TargetName="Icon" Property="Foreground" Value="{DynamicResource SystemFillColorCriticalBrush}" />
                    <Setter TargetName="Title" Property="Foreground" Value="{DynamicResource SystemFillColorCriticalBrush}" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <!-- Genel sekmesi: özet kartı -->
        <DataTemplate x:Key="KpiTemplate">
            <Border Background="{DynamicResource LayerBrush}" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                    CornerRadius="{DynamicResource OverlayCornerRadius}" Padding="12,8" Margin="0,0,10,0">
                <StackPanel>
                    <TextBlock Text="{Binding Label}" Style="{DynamicResource CaptionTextBlockStyle}" Foreground="{DynamicResource TextSecondaryBrush}" />
                    <TextBlock x:Name="Value" Text="{Binding Value}" Style="{DynamicResource SubtitleTextBlockStyle}" TextTrimming="CharacterEllipsis"
                               ToolTip="{Binding Value}" />
                </StackPanel>
            </Border>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding Tone}" Value="done">
                    <Setter TargetName="Value" Property="Foreground" Value="{DynamicResource SystemFillColorSuccessBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Tone}" Value="failed">
                    <Setter TargetName="Value" Property="Foreground" Value="{DynamicResource SystemFillColorCriticalBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Tone}" Value="waiting">
                    <Setter TargetName="Value" Property="Foreground" Value="{DynamicResource SystemFillColorCautionBrush}" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <!-- Genel sekmesi: zaman çizelgesi kartı (dikey çizgi + renkli nokta; tıklayınca açılır) -->
        <DataTemplate x:Key="TimelineTemplate">
            <Grid>
            <Grid.ContextMenu>
                <ContextMenu Visibility="{Binding IsJournal, Converter={StaticResource BoolToVis}}">
                    <MenuItem Header="{x:Static res:Resources.Menu_Edit}" Click="JournalEdit_Click" />
                    <MenuItem Header="{x:Static res:Resources.Journal_Delete}" Click="JournalDelete_Click" />
                </ContextMenu>
            </Grid.ContextMenu>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="22" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Rectangle Grid.Column="0" Width="2" HorizontalAlignment="Center" Fill="{DynamicResource DividerStrokeColorDefaultBrush}" />
                <Ellipse x:Name="Dot" Grid.Column="0" Width="12" Height="12" Margin="0,13,0,0" VerticalAlignment="Top" HorizontalAlignment="Center"
                         Stroke="{DynamicResource LayerBrush}" StrokeThickness="2" Fill="{DynamicResource TextTertiaryBrush}" />
                <Border x:Name="Card" Grid.Column="1" Margin="6,0,0,10" Padding="12,9" Cursor="Hand"
                        Background="{DynamicResource CardBackgroundFillColorSecondaryBrush}" BorderBrush="{DynamicResource TextTertiaryBrush}" BorderThickness="3,0,0,0"
                        CornerRadius="{DynamicResource ControlCornerRadius}"
                        MouseLeftButtonUp="TimelineCard_MouseLeftButtonUp">
                    <StackPanel>
                        <Grid>
                            <!-- Başlık ve durum etiketi yer kalmazsa alt satıra iner; not / klasör düğmeleri kartın içinde kalır -->
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <WrapPanel VerticalAlignment="Center">
                                <TextBlock Margin="0,0,8,0" Text="{Binding Title}" FontWeight="SemiBold" TextWrapping="Wrap" VerticalAlignment="Center" />
                                <ContentPresenter x:Name="ResultChip" VerticalAlignment="Center"
                                                  Content="{Binding Result}" ContentTemplate="{DynamicResource StatusChipTemplate}" />
                            </WrapPanel>
                            <Button x:Name="NoteButton" Grid.Column="1" Style="{DynamicResource IconButtonStyle}" Width="28" Height="28" VerticalAlignment="Top"
                                    ToolTip="{x:Static res:Resources.Run_OpenNote}" Click="TimelineNote_Click">
                                <local:AppIcon Glyph="{x:Static local:AppIcons.Note}" FontSize="13" />
                            </Button>
                            <Button x:Name="FolderButton" Grid.Column="2" Style="{DynamicResource IconButtonStyle}" Width="28" Height="28" VerticalAlignment="Top"
                                    ToolTip="{x:Static res:Resources.Run_OpenFolder}" Click="TimelineFolder_Click">
                                <local:AppIcon Glyph="{x:Static local:AppIcons.OpenFolder}" FontSize="13" />
                            </Button>
                        </Grid>
                        <TextBlock Text="{Binding Summary}" TextTrimming="CharacterEllipsis" Foreground="{DynamicResource TextSecondaryBrush}" />
                        <TextBlock Text="{Binding Meta}" Margin="0,2,0,0" Style="{DynamicResource CaptionTextBlockStyle}" Foreground="{DynamicResource TextTertiaryBrush}" />
                        <StackPanel x:Name="Details" Visibility="Collapsed" Margin="0,8,0,0">
                            <TextBlock Text="{Binding Detail}" TextWrapping="Wrap" Foreground="{DynamicResource TextSecondaryBrush}" />
                            <Image Source="{Binding Photo, Converter={StaticResource PathToImage}}" MaxHeight="220" Margin="0,8,0,0"
                                   HorizontalAlignment="Left" Stretch="Uniform"
                                   Visibility="{Binding HasPhoto, Converter={StaticResource BoolToVis}}" />
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Grid>
            <DataTemplate.Triggers>
                <!-- Kısa not: sonuç etiketi ve not / klasör düğmeleri yok; nokta soluk -->
                <DataTrigger Binding="{Binding IsQuickNote}" Value="True">
                    <Setter TargetName="ResultChip" Property="Visibility" Value="Collapsed" />
                    <Setter TargetName="NoteButton" Property="Visibility" Value="Collapsed" />
                    <Setter TargetName="FolderButton" Property="Visibility" Value="Collapsed" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsExpanded}" Value="True">
                    <Setter TargetName="Details" Property="Visibility" Value="Visible" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Result.Tone}" Value="active">
                    <Setter TargetName="Dot" Property="Fill" Value="{DynamicResource AccentBrush}" />
                    <Setter TargetName="Card" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Result.Tone}" Value="done">
                    <Setter TargetName="Dot" Property="Fill" Value="{DynamicResource SystemFillColorSuccessBrush}" />
                    <Setter TargetName="Card" Property="BorderBrush" Value="{DynamicResource SystemFillColorSuccessBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Result.Tone}" Value="failed">
                    <Setter TargetName="Dot" Property="Fill" Value="{DynamicResource SystemFillColorCriticalBrush}" />
                    <Setter TargetName="Card" Property="BorderBrush" Value="{DynamicResource SystemFillColorCriticalBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Result.Tone}" Value="waiting">
                    <Setter TargetName="Dot" Property="Fill" Value="{DynamicResource SystemFillColorCautionBrush}" />
                    <Setter TargetName="Card" Property="BorderBrush" Value="{DynamicResource SystemFillColorCautionBrush}" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <!-- Testler / Kalifikasyon tablosu (iki listede ayrı örnek) -->
        <GridView x:Key="RunsGridView" x:Shared="False">
            <GridViewColumn Width="80" DisplayMemberBinding="{Binding Serial}">
                <GridViewColumnHeader Content="{x:Static res:Resources.Col_Serial}" Tag="Serial" />
            </GridViewColumn>
            <GridViewColumn Width="60" DisplayMemberBinding="{Binding RoundText}">
                <GridViewColumnHeader Content="{x:Static res:Resources.Col_Round}" Tag="Round" />
            </GridViewColumn>
            <GridViewColumn Width="100" DisplayMemberBinding="{Binding System}">
                <GridViewColumnHeader Content="{x:Static res:Resources.Col_System}" Tag="System" />
            </GridViewColumn>
            <GridViewColumn Width="130">
                <GridViewColumnHeader Content="{x:Static res:Resources.Col_Result}" Tag="ResultName" />
                <GridViewColumn.CellTemplate>
                    <DataTemplate>
                        <ContentPresenter Content="{Binding Result}" ContentTemplate="{DynamicResource StatusChipTemplate}" />
                    </DataTemplate>
                </GridViewColumn.CellTemplate>
            </GridViewColumn>
            <GridViewColumn Width="100" DisplayMemberBinding="{Binding DateText}">
                <GridViewColumnHeader Content="{x:Static res:Resources.Col_Date}" Tag="Date" />
            </GridViewColumn>
            <GridViewColumn Width="90" DisplayMemberBinding="{Binding AnalysisText}">
                <GridViewColumnHeader Content="{x:Static res:Resources.Col_Analysis}" Tag="AnalysisDate" />
            </GridViewColumn>
            <GridViewColumn Width="90" DisplayMemberBinding="{Binding Person}">
                <GridViewColumnHeader Content="{x:Static res:Resources.Col_Person}" Tag="Person" />
            </GridViewColumn>
            <GridViewColumn Width="380" DisplayMemberBinding="{Binding Summary}">
                <GridViewColumnHeader Content="{x:Static res:Resources.Col_Note}" Tag="Summary" />
            </GridViewColumn>
        </GridView>

        <!-- Türe göre renkli ikon: proje sarı, stok vurgu rengi, işaretsiz klasör soluk. -->
        <!--
            Ağaç satırı: DesignKit şablonunun aynısı, tek fark üzerine gelme vurgusu yalnız satırın kendisine
            (Bd) bakar. DesignKit'te tetikleyici TreeViewItem'ın IsMouseOver'ına bakıyor; o, alt satırın üstündeyken
            de doğru olduğu için üst satır (proje) ile alt satır (stok) aynı anda vurgulanıyordu.
        -->
        <Style x:Key="TreeItemStyle" TargetType="TreeViewItem" BasedOn="{StaticResource {x:Type TreeViewItem}}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TreeViewItem">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="20" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <ToggleButton x:Name="Expander" Grid.Row="0" Grid.Column="0" Width="20" Height="20"
                                          Background="Transparent" Focusable="False" ClickMode="Press"
                                          IsChecked="{Binding IsExpanded, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border Background="{TemplateBinding Background}">
                                            <TextBlock x:Name="Chevron" Text="{x:Static icons:Symbol.ChevronRight}" FontFamily="{DynamicResource SymbolThemeFontFamily}" FontSize="10"
                                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center"
                                                       RenderTransformOrigin="0.5,0.5" />
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsChecked" Value="True">
                                                <Setter TargetName="Chevron" Property="RenderTransform">
                                                    <Setter.Value>
                                                        <RotateTransform Angle="90" />
                                                    </Setter.Value>
                                                </Setter>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>
                            <!-- Vurgu açma okunu da kapsar (Win11 gezinme satırı gibi); seçiliyken solda vurgu çizgisi -->
                            <Border x:Name="Bd" Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2" Background="Transparent" MinHeight="34"
                                    CornerRadius="{DynamicResource ControlCornerRadius}" Padding="{TemplateBinding Padding}"
                                    SnapsToDevicePixels="True" Panel.ZIndex="-1">
                                <Grid>
                                    <Border x:Name="Pill" Width="3" Height="16" CornerRadius="1.5" HorizontalAlignment="Left" VerticalAlignment="Center"
                                            Background="{DynamicResource AccentBrush}" Visibility="Collapsed" />
                                    <ContentPresenter Margin="32,0,0,0" ContentSource="Header" VerticalAlignment="Center" />
                                </Grid>
                            </Border>
                            <ItemsPresenter x:Name="ItemsHost" Grid.Row="1" Grid.Column="1" Visibility="Collapsed" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="HasItems" Value="False">
                                <Setter TargetName="Expander" Property="Visibility" Value="Hidden" />
                            </Trigger>
                            <Trigger Property="IsExpanded" Value="True">
                                <Setter TargetName="ItemsHost" Property="Visibility" Value="Visible" />
                            </Trigger>
                            <!-- Üzerine gelince hafif, seçiliyken daha belirgin + vurgu çizgisi -->
                            <Trigger SourceName="Bd" Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource SubtleFillColorTertiaryBrush}" />
                            </Trigger>
                            <Trigger SourceName="Expander" Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource SubtleFillColorTertiaryBrush}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
                                <Setter TargetName="Pill" Property="Visibility" Value="Visible" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Foreground" Value="{DynamicResource TextFillColorDisabledBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Test planı kartı (Testler / Kalifikasyon sekmesinin üstü) -->
        <DataTemplate x:Key="PlanTemplate">
            <Border Margin="0,0,0,8" Padding="12,10" BorderThickness="1"
                    Background="{DynamicResource LayerBrush}" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                    CornerRadius="{DynamicResource OverlayCornerRadius}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock FontWeight="SemiBold" TextTrimming="CharacterEllipsis" Text="{Binding Name}" />
                        <TextBlock Margin="0,2,0,0" TextWrapping="Wrap" Foreground="{DynamicResource TextSecondaryBrush}" Text="{Binding Description}"
                                   Visibility="{Binding HasDescription, Converter={StaticResource BoolToVis}}" />
                        <TextBlock Margin="0,4,0,0" Style="{DynamicResource CaptionTextBlockStyle}" Foreground="{DynamicResource TextTertiaryBrush}">
                            <Run Text="{Binding Meta, Mode=OneWay}" />
                            <Run Text=" · " />
                            <Run Text="{Binding RunsText, Mode=OneWay}" Foreground="{DynamicResource TextSecondaryBrush}" />
                        </TextBlock>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0,0,0">
                        <Button Style="{DynamicResource IconButtonStyle}" Tag="{Binding Path}" Click="PlanOpen_Click" ToolTip="{x:Static res:Resources.Plan_Open}">
                            <local:AppIcon Glyph="{x:Static local:AppIcons.Note}" FontSize="14" />
                        </Button>
                        <Button Style="{DynamicResource IconButtonStyle}" Tag="{Binding Folder}" Click="PlanFolder_Click" ToolTip="{x:Static res:Resources.Menu_OpenFolder}">
                            <local:AppIcon Glyph="{x:Static local:AppIcons.OpenFolder}" FontSize="14" />
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>
        </DataTemplate>

        <Style x:Key="KindIconStyle" TargetType="local:AppIcon">
            <Setter Property="Foreground" Value="{DynamicResource TextTertiaryBrush}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Kind}" Value="{x:Static core:FolderKind.Project}">
                    <Setter Property="Foreground" Value="{DynamicResource Pusula.ProjectIconBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Kind}" Value="{x:Static core:FolderKind.Stock}">
                    <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Kind}" Value="{x:Static core:FolderKind.InventoryType}">
                    <Setter Property="Foreground" Value="{Binding Color}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Kind}" Value="{x:Static core:FolderKind.InventoryItem}">
                    <Setter Property="Foreground" Value="{Binding Color}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- Sol listede (ağaç) ikon: proje kendi renginde (proje.json ya da koddan türetilen); diğerleri KindIconStyle gibi. -->
        <Style x:Key="TreeIconStyle" TargetType="local:AppIcon" BasedOn="{StaticResource KindIconStyle}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding Kind}" Value="{x:Static core:FolderKind.Project}">
                    <Setter Property="Foreground" Value="{Binding ProjectColor}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- Modül onay kutusu: ad, klasör; stokta varsa kilitli ve "var" etiketli. -->
        <DataTemplate x:Key="ModuleOptionTemplate">
            <CheckBox IsChecked="{Binding IsChecked, Mode=TwoWay}"
                      IsEnabled="{Binding CanChange}"
                      Margin="0,5" ToolTip="{Binding Folder}">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="{Binding Name}" />
                    <TextBlock Text="{x:Static res:Resources.Module_Exists}"
                               Margin="8,0,0,0"
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               Visibility="{Binding Exists, Converter={StaticResource BoolToVis}}" />
                </StackPanel>
            </CheckBox>
        </DataTemplate>

        <!-- Özet tablosu satırı: boş, eksik ya da özel klasörler soluk. -->
        <Style x:Key="DetailRowStyle" TargetType="ListViewItem" BasedOn="{StaticResource {x:Type ListViewItem}}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsDim}" Value="True">
                    <Setter Property="Foreground" Value="{DynamicResource TextTertiaryBrush}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- Durum etiketi: renk, durumun anlamına göre (neutral, waiting, active, done, warning). -->
        <DataTemplate x:Key="StatusChipTemplate">
            <Border x:Name="Chip"
                    HorizontalAlignment="Left"
                    CornerRadius="10"
                    Padding="10,2"
                    BorderThickness="1"
                    Background="{DynamicResource ControlFillColorSecondaryBrush}"
                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}">
                <TextBlock x:Name="ChipText"
                           Text="{Binding Name}"
                           FontSize="12"
                           Foreground="{DynamicResource TextSecondaryBrush}" />
            </Border>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding Tone}" Value="waiting">
                    <Setter TargetName="ChipText" Property="Foreground" Value="{DynamicResource SystemFillColorCautionBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Tone}" Value="active">
                    <Setter TargetName="Chip" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                    <Setter TargetName="ChipText" Property="Foreground" Value="{DynamicResource AccentBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Tone}" Value="done">
                    <Setter TargetName="Chip" Property="Background" Value="{DynamicResource SystemFillColorSuccessBackgroundBrush}" />
                    <Setter TargetName="Chip" Property="BorderBrush" Value="Transparent" />
                    <Setter TargetName="ChipText" Property="Foreground" Value="{DynamicResource SystemFillColorSuccessBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Tone}" Value="failed">
                    <Setter TargetName="Chip" Property="Background" Value="{DynamicResource SystemFillColorCriticalBackgroundBrush}" />
                    <Setter TargetName="Chip" Property="BorderBrush" Value="Transparent" />
                    <Setter TargetName="ChipText" Property="Foreground" Value="{DynamicResource SystemFillColorCriticalBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Tone}" Value="none">
                    <Setter TargetName="Chip" Property="Background" Value="Transparent" />
                    <Setter TargetName="Chip" Property="BorderBrush" Value="Transparent" />
                    <Setter TargetName="ChipText" Property="Foreground" Value="{DynamicResource TextTertiaryBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Tone}" Value="warning">
                    <Setter TargetName="Chip" Property="Background" Value="{DynamicResource SystemFillColorCautionBackgroundBrush}" />
                    <Setter TargetName="Chip" Property="BorderBrush" Value="Transparent" />
                    <Setter TargetName="ChipText" Property="Foreground" Value="{DynamicResource SystemFillColorCautionBrush}" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <!-- Aşama çubuğunda bir adım: geçilmiş, şu an, gelecek. -->
        <!-- Aşamalar: ince çizgi üzerinde noktalar; geçilen vurgu renginde, şimdiki dolu ve kalın, sonrakiler soluk -->
        <DataTemplate x:Key="StatusStepTemplate">
            <Grid Margin="0,0,0,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="12" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Border x:Name="Line" Grid.Row="0" Height="2" VerticalAlignment="Center" Background="{DynamicResource DividerStrokeColorDefaultBrush}" />
                <Ellipse x:Name="Dot" Grid.Row="0" Width="10" Height="10" HorizontalAlignment="Center"
                         Fill="{DynamicResource LayerBrush}" Stroke="{DynamicResource TextTertiaryBrush}" StrokeThickness="1.5" />
                <TextBlock x:Name="StepText" Grid.Row="1" Margin="2,5,2,0"
                           Text="{Binding Name}"
                           FontSize="11"
                           HorizontalAlignment="Center"
                           TextTrimming="CharacterEllipsis"
                           Foreground="{DynamicResource TextTertiaryBrush}" />
            </Grid>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding State}" Value="past">
                    <Setter TargetName="Line" Property="Background" Value="{DynamicResource AccentBrush}" />
                    <Setter TargetName="Dot" Property="Fill" Value="{DynamicResource AccentBrush}" />
                    <Setter TargetName="Dot" Property="Stroke" Value="{DynamicResource AccentBrush}" />
                    <Setter TargetName="StepText" Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding State}" Value="current">
                    <Setter TargetName="Dot" Property="Width" Value="14" />
                    <Setter TargetName="Dot" Property="Height" Value="14" />
                    <Setter TargetName="Dot" Property="Fill" Value="{DynamicResource AccentBrush}" />
                    <Setter TargetName="Dot" Property="Stroke" Value="{DynamicResource LayerBrush}" />
                    <Setter TargetName="Dot" Property="StrokeThickness" Value="2" />
                    <Setter TargetName="StepText" Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
                    <Setter TargetName="StepText" Property="FontWeight" Value="SemiBold" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <!-- Bahsedildiği yerler: başka notlarda bu kayda yapılan bahisler; tıklayınca not açılır -->
        <DataTemplate x:Key="MentionsCardTemplate">
            <Expander Margin="0,12,0,0" IsExpanded="{Binding MentionsExpanded, Mode=TwoWay}"
                      Visibility="{Binding HasMentions, Converter={StaticResource BoolToVis}}">
                <Expander.Header>
                    <StackPanel Orientation="Horizontal">
                        <local:AppIcon Glyph="{x:Static local:AppIcons.Link}" FontSize="15" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" />
                        <TextBlock Margin="8,0,0,0" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center" Text="{Binding MentionsHeader}" />
                    </StackPanel>
                </Expander.Header>
                <ItemsControl Margin="0,4,0,0" ItemsSource="{Binding Mentions}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button Style="{DynamicResource SubtleButtonStyle}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                                    Padding="6,5" Margin="0,0,0,2" Tag="{Binding}" Click="Mention_Click" ToolTip="{Binding RelativePath}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <local:AppIcon x:Name="Kind" Glyph="{x:Static local:AppIcons.Link}" FontSize="12" Margin="0,3,10,0" VerticalAlignment="Top"
                                                       Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" ToolTip="{x:Static res:Resources.Mentions_Link}" />
                                    <StackPanel Grid.Column="1">
                                        <TextBlock FontWeight="SemiBold" TextTrimming="CharacterEllipsis" Text="{Binding Source}" />
                                        <TextBlock Margin="0,2,0,0" TextWrapping="Wrap" Foreground="{DynamicResource TextSecondaryBrush}" Text="{Binding Snippet}" />
                                    </StackPanel>
                                    <TextBlock Grid.Column="2" Margin="10,0,0,0" Style="{DynamicResource CaptionTextBlockStyle}"
                                               Foreground="{DynamicResource TextTertiaryBrush}" Text="{Binding Meta}" />
                                </Grid>
                            </Button>
                            <DataTemplate.Triggers>
                                <DataTrigger Binding="{Binding IsLink}" Value="False">
                                    <Setter TargetName="Kind" Property="Glyph" Value="{x:Static local:AppIcons.Note}" />
                                    <Setter TargetName="Kind" Property="Foreground" Value="{DynamicResource TextTertiaryBrush}" />
                                    <Setter TargetName="Kind" Property="ToolTip" Value="{x:Static res:Resources.Mentions_Text}" />
                                </DataTrigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Expander>
        </DataTemplate>

        <!-- Testler / Kalifikasyon satırı sağ tık menüsü -->
        <ContextMenu x:Key="RunMenu">
            <MenuItem Header="{x:Static res:Resources.Run_OpenNote}" Click="RunMenuNote_Click">
                <MenuItem.Icon>
                    <local:AppIcon Glyph="{x:Static local:AppIcons.Note}" />
                </MenuItem.Icon>
            </MenuItem>
            <MenuItem Header="{x:Static res:Resources.Run_OpenFolder}" Click="RunMenuFolder_Click">
                <MenuItem.Icon>
                    <local:AppIcon Glyph="{x:Static local:AppIcons.OpenFolder}" />
                </MenuItem.Icon>
            </MenuItem>
            <MenuItem Header="{x:Static res:Resources.Run_OpenRaw}" Click="RunMenuRaw_Click" />
            <MenuItem Header="{x:Static res:Resources.Run_OpenPhotos}" Click="RunMenuPhotos_Click" />
            <Separator />
            <MenuItem Header="{x:Static res:Resources.Run_Analysis}" Click="RunMenuAnalysis_Click">
                <MenuItem.Icon>
                    <local:AppIcon Glyph="{x:Static local:AppIcons.Edit}" />
                </MenuItem.Icon>
            </MenuItem>
        </ContextMenu>

        <!-- Envanter kaydı: geçmişte bir olay (dikey çizgi + renkli nokta) -->
        <DataTemplate x:Key="HistoryTemplate">
            <Grid>
            <Grid.ContextMenu>
                <ContextMenu Visibility="{Binding IsJournal, Converter={StaticResource BoolToVis}}">
                    <MenuItem Header="{x:Static res:Resources.Menu_Edit}" Click="JournalEdit_Click" />
                    <MenuItem Header="{x:Static res:Resources.Journal_Delete}" Click="JournalDelete_Click" />
                </ContextMenu>
            </Grid.ContextMenu>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="20" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Rectangle Width="2" HorizontalAlignment="Center" Fill="{DynamicResource DividerStrokeColorDefaultBrush}" />
                <Ellipse x:Name="Dot" Width="11" Height="11" Margin="0,5,0,0" VerticalAlignment="Top" HorizontalAlignment="Center"
                         Stroke="{DynamicResource LayerBrush}" StrokeThickness="2" Fill="{DynamicResource TextTertiaryBrush}" />
                <StackPanel Grid.Column="1" Margin="6,0,0,12">
                    <StackPanel Orientation="Horizontal">
                        <ContentPresenter Content="{Binding Status}" ContentTemplate="{DynamicResource StatusChipTemplate}" VerticalAlignment="Center" />
                        <TextBlock Text="{Binding Meta}" Margin="8,0,0,0" VerticalAlignment="Center"
                                   Style="{DynamicResource CaptionTextBlockStyle}" Foreground="{DynamicResource TextTertiaryBrush}" />
                        <Button Margin="6,0,0,0" Style="{DynamicResource IconButtonStyle}" Width="24" Height="24" Tag="{Binding NotePath}"
                                Click="HistoryNote_Click" ToolTip="{x:Static res:Resources.Run_OpenNote}"
                                Visibility="{Binding HasNote, Converter={StaticResource BoolToVis}}">
                            <local:AppIcon Glyph="{x:Static local:AppIcons.Note}" FontSize="12" />
                        </Button>
                    </StackPanel>
                    <TextBlock Text="{Binding Detail}" TextWrapping="Wrap" Margin="0,3,0,0" Foreground="{DynamicResource TextSecondaryBrush}"
                               Visibility="{Binding HasDetail, Converter={StaticResource BoolToVis}}" />
                </StackPanel>
            </Grid>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding Status.Tone}" Value="done">
                    <Setter TargetName="Dot" Property="Fill" Value="{DynamicResource SystemFillColorSuccessBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Status.Tone}" Value="active">
                    <Setter TargetName="Dot" Property="Fill" Value="{DynamicResource AccentBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Status.Tone}" Value="waiting">
                    <Setter TargetName="Dot" Property="Fill" Value="{DynamicResource SystemFillColorCautionBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Status.Tone}" Value="warning">
                    <Setter TargetName="Dot" Property="Fill" Value="{DynamicResource SystemFillColorCautionBrush}" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <!-- Envanter durum menüsü: her açılışta tür kalıbından kurulur. -->
        <ContextMenu x:Key="InventoryStatusMenu" Opened="InventoryStatusMenu_Opened" />

        <!-- Durum menüsü: her açılışta tür kalıbından kurulur (MainWindow.xaml.cs). -->
        <ContextMenu x:Key="StatusMenu" Opened="StatusMenu_Opened" />

        <!-- Menüler ağaçla aynı DataContext'i kod tarafında alır (MainWindow.xaml.cs). -->
        <!-- "+ Yeni" menüsü: proje, stok (seçili projeye), sonra Türler'deki envanter türleri (AddMenu_Opened ekler) -->
        <ContextMenu x:Key="AddMenu" Opened="AddMenu_Opened">
            <MenuItem Header="{x:Static res:Resources.Add_Project}"
                      Command="{Binding NewProjectCommand}"
                      InputGestureText="{x:Static res:Resources.Gesture_NewProject}">
                <MenuItem.Icon>
                    <local:AppIcon Glyph="{x:Static local:AppIcons.Project}" Foreground="{DynamicResource Pusula.ProjectIconBrush}" />
                </MenuItem.Icon>
            </MenuItem>
            <MenuItem Header="{Binding AddStockMenuText}"
                      Command="{Binding NewStockCommand}"
                      InputGestureText="{x:Static res:Resources.Gesture_NewStock}">
                <MenuItem.Icon>
                    <local:AppIcon Glyph="{x:Static local:AppIcons.Stock}" Foreground="{DynamicResource AccentBrush}" />
                </MenuItem.Icon>
            </MenuItem>
        </ContextMenu>

        <!-- Envanter listesi satırı: aç, klasör, not -->
        <ContextMenu x:Key="InventoryRowMenu">
            <MenuItem Header="{x:Static res:Resources.StockInv_OpenRecord}" Click="StockInvOpen_Click" />
            <MenuItem Header="{x:Static res:Resources.Menu_OpenFolder}" Click="StockInvFolder_Click" />
            <MenuItem Header="{x:Static res:Resources.QuickNote_AddMenu}" Click="StockInvNote_Click" />
            <Separator />
            <MenuItem Header="{x:Static res:Resources.Menu_Edit}" Click="StockInvEdit_Click" />
            <MenuItem Header="{x:Static res:Resources.Menu_Untrack}" Click="StockInvUntrack_Click" />
<MenuItem Header="{x:Static res:Resources.Menu_Delete}" Click="StockInvDelete_Click" />
        </ContextMenu>

        <ContextMenu x:Key="NodeMenu">
            <MenuItem Header="{Binding NewStockMenuText}" Command="{Binding NewStockCommand}">
                <MenuItem.Icon>
                    <local:AppIcon Glyph="{x:Static local:AppIcons.Stock}" Foreground="{DynamicResource AccentBrush}" />
                </MenuItem.Icon>
            </MenuItem>
            <MenuItem Header="{x:Static res:Resources.Menu_MarkAsProject}"
                      Command="{Binding MarkAsProjectCommand}"
                      Visibility="{Binding CanMarkAsProject, Converter={StaticResource BoolToVis}}">
                <MenuItem.Icon>
                    <local:AppIcon Glyph="{x:Static local:AppIcons.Project}" Foreground="{DynamicResource Pusula.ProjectIconBrush}" />
                </MenuItem.Icon>
            </MenuItem>
            <MenuItem Header="{Binding MarkInventoryMenuText}"
                      Command="{Binding MarkAsInventoryCommand}"
                      Visibility="{Binding CanMarkAsInventory, Converter={StaticResource BoolToVis}}">
                <MenuItem.Icon>
                    <local:AppIcon Glyph="{x:Static local:AppIcons.Check}" />
                </MenuItem.Icon>
            </MenuItem>
            <MenuItem Header="{x:Static res:Resources.Menu_MarkAsStock}"
                      Command="{Binding MarkAsStockCommand}"
                      Visibility="{Binding CanMarkAsStock, Converter={StaticResource BoolToVis}}">
                <MenuItem.Icon>
                    <local:AppIcon Glyph="{x:Static local:AppIcons.Stock}" Foreground="{DynamicResource AccentBrush}" />
                </MenuItem.Icon>
            </MenuItem>
            <MenuItem Header="{x:Static res:Resources.Menu_Edit}" Click="NodeEdit_Click"
                      Visibility="{Binding CanEditSelected, Converter={StaticResource BoolToVis}}">
                <MenuItem.Icon>
                    <local:AppIcon Glyph="{x:Static local:AppIcons.Edit}" />
                </MenuItem.Icon>
            </MenuItem>
            <MenuItem Header="{x:Static res:Resources.Menu_Untrack}" Click="NodeUntrack_Click"
                      Visibility="{Binding CanEditSelected, Converter={StaticResource BoolToVis}}">
                <MenuItem.Icon>
                    <local:AppIcon Glyph="{x:Static local:AppIcons.Remove}" />
                </MenuItem.Icon>
            </MenuItem>
            <MenuItem Header="{x:Static res:Resources.Menu_Delete}" Click="NodeDelete_Click"
                      Visibility="{Binding CanEditSelected, Converter={StaticResource BoolToVis}}">
                <MenuItem.Icon>
                    <local:AppIcon Glyph="{x:Static local:AppIcons.Delete}" />
                </MenuItem.Icon>
            </MenuItem>
            <MenuItem Header="{x:Static res:Resources.Menu_AddModules}" Command="{Binding AddModulesCommand}">
                <MenuItem.Icon>
                    <local:AppIcon Glyph="{x:Static local:AppIcons.Add}" />
                </MenuItem.Icon>
            </MenuItem>
            <MenuItem Header="{x:Static res:Resources.Menu_OpenFolder}" Command="{Binding OpenFolderCommand}">
                <MenuItem.Icon>
                    <local:AppIcon Glyph="{x:Static local:AppIcons.OpenFolder}" />
                </MenuItem.Icon>
            </MenuItem>
            <Separator />
            <MenuItem Header="{x:Static res:Resources.Menu_Refresh}" Command="{Binding RefreshCommand}" InputGestureText="{x:Static res:Resources.Gesture_Refresh}">
                <MenuItem.Icon>
                    <local:AppIcon Glyph="{x:Static local:AppIcons.Refresh}" />
                </MenuItem.Icon>
            </MenuItem>
        </ContextMenu>

        <ContextMenu x:Key="TreeMenu">
            <MenuItem Header="{x:Static res:Resources.Menu_NewProject}"
                      Command="{Binding NewProjectCommand}"
                      InputGestureText="{x:Static res:Resources.Gesture_NewProject}">
                <MenuItem.Icon>
                    <local:AppIcon Glyph="{x:Static local:AppIcons.Project}" Foreground="{DynamicResource Pusula.ProjectIconBrush}" />
                </MenuItem.Icon>
            </MenuItem>
            <MenuItem Header="{x:Static res:Resources.Menu_Refresh}" Command="{Binding RefreshCommand}" InputGestureText="{x:Static res:Resources.Gesture_Refresh}">
                <MenuItem.Icon>
                    <local:AppIcon Glyph="{x:Static local:AppIcons.Refresh}" />
                </MenuItem.Icon>
            </MenuItem>
        </ContextMenu>
    </controls:ChromeWindow.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>


        <!-- Gövde: solda ağaç, sağda seçili düğüm -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="320" MinWidth="220" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Win11 düzeni: sağdaki içerik, zeminden ayrılan köşesi yuvarlak bir kart -->
            <Border Grid.Column="1"
                    Background="{DynamicResource LayerBrush}"
                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1,1,0,0"
                    CornerRadius="8,0,0,0" />

            <Border Grid.Column="0" Background="Transparent">
                <Grid x:Name="TreePane" SizeChanged="TreePane_SizeChanged">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" MinHeight="40" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" MinHeight="60" />
                    </Grid.RowDefinitions>

                    <!-- Ağaç başlığı: Ana sayfa satırı; altında Projeler + ekle + yenile + ayarlar, arama -->
                    <StackPanel Grid.Row="0">
                    <Button Margin="8,8,8,4" Padding="12,0" Height="38" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                            Click="HomeButton_Click">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                                <Setter Property="Background" Value="Transparent" />
                                <Setter Property="BorderThickness" Value="0" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasSelection}" Value="False">
                                        <Setter Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                        <!-- Ağaçtaki seçili satırla aynı dil: ana sayfadayken solda vurgu çizgisi -->
                        <Grid>
                            <Border Width="3" Height="16" Margin="-12,0,0,0" CornerRadius="1.5" HorizontalAlignment="Left" VerticalAlignment="Center"
                                    Background="{DynamicResource AccentBrush}"
                                    Visibility="{Binding HasSelection, Converter={StaticResource InverseBoolToVis}}" />
                            <StackPanel Orientation="Horizontal" Margin="8,0,0,0">
                                <local:AppIcon Glyph="&#xE80F;" FontSize="16" VerticalAlignment="Center" Foreground="{DynamicResource AccentBrush}" />
                                <TextBlock Margin="12,0,0,0" FontSize="14" Text="{x:Static res:Resources.Home_Button}" VerticalAlignment="Center" />
                            </StackPanel>
                        </Grid>
                    </Button>
                    <Grid Margin="16,6,8,4">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <!-- Ağaçta ara: numara, ad, tanım -->
                        <controls:SearchBox Grid.Row="1" Grid.ColumnSpan="4" Margin="-4,8,0,0"
                                            PlaceholderText="{x:Static res:Resources.Tree_Search}"
                                            Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                                            Visibility="{Binding HasRoot, Converter={StaticResource BoolToVis}}" />
                        <TextBlock Grid.Column="0"
                                   FontSize="13" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   VerticalAlignment="Center"
                                   Text="{x:Static res:Resources.Tree_Header}" />
                        <Button x:Name="AddButton"
                                Grid.Column="1"
                                Width="34" Height="34"
                                Style="{DynamicResource IconButtonStyle}"
                                Click="AddButton_Click"
                                ToolTip="{x:Static res:Resources.Button_Add}">
                            <local:AppIcon Glyph="{x:Static local:AppIcons.Add}" FontSize="17" Foreground="{DynamicResource AccentBrush}" />
                        </Button>
                        <Button Grid.Column="2"
                                Command="{Binding RefreshCommand}"
                                Width="34" Height="34"
                                Margin="4,0,0,0">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource IconButtonStyle}">
                                    <Setter Property="ToolTip" Value="{x:Static res:Resources.Button_Refresh}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsDiskChanged}" Value="True">
                                            <Setter Property="ToolTip" Value="{x:Static res:Resources.Button_RefreshChanged}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                            <local:AppIcon Glyph="{x:Static local:AppIcons.Refresh}" FontSize="16">
                                <local:AppIcon.Style>
                                    <Style TargetType="local:AppIcon">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsDiskChanged}" Value="True">
                                                <Setter Property="Foreground" Value="{DynamicResource SystemFillColorCautionBrush}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </local:AppIcon.Style>
                            </local:AppIcon>
                        </Button>
                        <Button Grid.Column="3"
                                Width="34" Height="34" Margin="4,0,0,0"
                                Style="{DynamicResource IconButtonStyle}"
                                Click="Settings_Click"
                                ToolTip="{x:Static res:Resources.Button_Settings}">
                            <local:AppIcon Glyph="{x:Static local:AppIcons.Settings}" FontSize="16" />
                        </Button>
                    </Grid>
                    </StackPanel>

                    <TextBlock Grid.Row="1"
                               Margin="16,8"
                               TextWrapping="Wrap"
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               Text="{x:Static res:Resources.Tree_NoRoot}">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource CaptionTextBlockStyle}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasRoot}" Value="True">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>

                    <TreeView x:Name="FolderTree"
                              Grid.Row="1"
                              ItemsSource="{Binding ProjectNodes}"
                              Visibility="{Binding HasRoot, Converter={StaticResource BoolToVis}}"
                              ContextMenu="{StaticResource TreeMenu}"
                              Background="Transparent"
                              BorderThickness="0"
                              Padding="4"
                              SelectedItemChanged="FolderTree_SelectedItemChanged"
                              PreviewMouseRightButtonDown="FolderTree_PreviewMouseRightButtonDown">
                        <TreeView.ItemContainerStyle>
                            <Style TargetType="TreeViewItem" BasedOn="{StaticResource TreeItemStyle}">
                                <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}" />
                                <Setter Property="IsSelected" Value="{Binding IsSelected, Mode=TwoWay}" />
                                <Setter Property="ContextMenu" Value="{StaticResource NodeMenu}" />
                                <Setter Property="Visibility" Value="{Binding IsVisible, Converter={StaticResource BoolToVis}}" />

                            </Style>
                        </TreeView.ItemContainerStyle>
                        <TreeView.ItemTemplate>
                            <HierarchicalDataTemplate ItemsSource="{Binding Children}">
                                <StackPanel>
                                    <StackPanel x:Name="Row" Orientation="Horizontal" Margin="0,1" ToolTip="{Binding RowToolTip}">
                                        <local:AppIcon x:Name="Icon" Glyph="{Binding Glyph}" FontSize="15"
                                                           Style="{StaticResource TreeIconStyle}"
                                                           VerticalAlignment="Center" />
                                        <TextBlock x:Name="Title" Text="{Binding Title}" Margin="9,0,0,0" VerticalAlignment="Center" />
                                        <TextBlock x:Name="Subtitle" Text="{Binding DisplaySubtitle}" Margin="8,0,0,0" VerticalAlignment="Center" MaxWidth="120" TextWrapping="NoWrap"
                                                   TextTrimming="CharacterEllipsis"
                                                   Style="{DynamicResource CaptionTextBlockStyle}" Foreground="{DynamicResource TextTertiaryBrush}" />
                                    </StackPanel>
                                </StackPanel>
                                <HierarchicalDataTemplate.Triggers>
                                    <DataTrigger Binding="{Binding Kind}" Value="{x:Static core:FolderKind.InventoryGroup}">

                                        <Setter TargetName="Title" Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
                                        <Setter TargetName="Title" Property="FontWeight" Value="SemiBold" />
                                        <Setter TargetName="Icon" Property="FontSize" Value="14" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Kind}" Value="{x:Static core:FolderKind.InventoryItem}">
                                        <Setter TargetName="Subtitle" Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding IsUnmarkedInventory}" Value="True">
                                        <Setter TargetName="Subtitle" Property="Visibility" Value="Collapsed" />
                                        <Setter TargetName="Title" Property="Foreground" Value="{DynamicResource TextTertiaryBrush}" />
                                        <Setter TargetName="Title" Property="FontStyle" Value="Italic" />
                                    </DataTrigger>
                                    <!-- Henüz kaydı olmayan tür (Yazılımlar 0): soluk, ama tıklanıp kayıt eklenebilir -->
                                    <MultiDataTrigger>
                                        <MultiDataTrigger.Conditions>
                                            <Condition Binding="{Binding Kind}" Value="{x:Static core:FolderKind.InventoryType}" />
                                            <Condition Binding="{Binding Subtitle}" Value="0" />
                                        </MultiDataTrigger.Conditions>
                                        <Setter TargetName="Row" Property="Opacity" Value="0.55" />
                                    </MultiDataTrigger>
                                </HierarchicalDataTemplate.Triggers>
                            </HierarchicalDataTemplate>
                        </TreeView.ItemTemplate>
                    </TreeView>

                    <!-- Envanter ayrı bölmede; aradaki çizgi sürüklenerek boyutlanır -->
                    <Border Grid.Row="2" Height="1" Margin="12,2" VerticalAlignment="Center" IsHitTestVisible="False"
                            Background="{DynamicResource CardStrokeColorDefaultBrush}"
                            Visibility="{Binding HasInventory, Converter={StaticResource BoolToVis}}" />
                    <GridSplitter Grid.Row="2" Height="6" HorizontalAlignment="Stretch" ResizeDirection="Rows"
                                  Background="Transparent" Focusable="False"
                                  Visibility="{Binding HasInventory, Converter={StaticResource BoolToVis}}" />
                    <TreeView x:Name="InventoryTree"
                              Grid.Row="3"
                              ItemsSource="{Binding InventoryNodes}"
                              Visibility="{Binding HasInventory, Converter={StaticResource BoolToVis}}"
                              ItemContainerStyle="{Binding ItemContainerStyle, ElementName=FolderTree}"
                              ItemTemplate="{Binding ItemTemplate, ElementName=FolderTree}"
                              Background="Transparent"
                              BorderThickness="0"
                              Padding="4"
                              SelectedItemChanged="FolderTree_SelectedItemChanged"
                              PreviewMouseRightButtonDown="FolderTree_PreviewMouseRightButtonDown" />
                </Grid>
            </Border>

            <!-- Hiçbir şey seçili değil: başlangıç sayfası (son açılanlar, geciken işler, bana ait işler) -->
            <ScrollViewer x:Name="HomePage" Grid.Column="1" VerticalScrollBarVisibility="Auto">
                <ScrollViewer.Style>
                    <Style TargetType="ScrollViewer">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding HasSelection}" Value="True">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </ScrollViewer.Style>
                <ScrollViewer.Resources>
                    <DataTemplate x:Key="HomeTaskTemplate">
                        <Button Margin="0,0,0,6" Padding="12,8" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                                Click="HomeTask_Click" ToolTip="{x:Static res:Resources.Home_TaskHint}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="{Binding Text}" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Margin="0,2,0,0" Text="{Binding Meta}" TextTrimming="CharacterEllipsis"
                                               Style="{DynamicResource CaptionTextBlockStyle}" Foreground="{DynamicResource TextTertiaryBrush}" />
                                </StackPanel>
                                <TextBlock x:Name="Due" Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Top" Text="{Binding DueText}"
                                           Style="{DynamicResource CaptionTextBlockStyle}" Foreground="{DynamicResource TextSecondaryBrush}" />
                            </Grid>
                        </Button>
                        <DataTemplate.Triggers>
                            <DataTrigger Binding="{Binding IsLate}" Value="True">
                                <Setter TargetName="Due" Property="Foreground" Value="{DynamicResource SystemFillColorCriticalBrush}" />
                            </DataTrigger>
                        </DataTemplate.Triggers>
                    </DataTemplate>
                </ScrollViewer.Resources>
                <!-- Ana sayfa (15.11.2026): yalnız proje kartları; son açılanlar ve işler sonraki adımda eklenecek -->
                <StackPanel Margin="40,32,40,24" TextElement.FontWeight="Normal">
                    <!-- Başlık: Projeler + sayı, sağda Yeni proje -->
                    <Grid Margin="0,0,0,20">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock FontSize="26" FontWeight="SemiBold" Text="{x:Static res:Resources.Home_Projects}" VerticalAlignment="Center" />
                            <Border Margin="12,4,0,0" Padding="10,2" CornerRadius="11" VerticalAlignment="Center"
                                    Background="{DynamicResource SubtleFillColorSecondaryBrush}">
                                <TextBlock Text="{Binding ProjectCount}" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}" />
                            </Border>
                        </StackPanel>
                        <Button Grid.Column="1" Command="{Binding NewProjectCommand}" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal">
                                <local:AppIcon Glyph="{x:Static local:AppIcons.Add}" FontSize="13" VerticalAlignment="Center" />
                                <TextBlock Margin="8,0,0,0" Text="{x:Static res:Resources.Menu_NewProject}" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                    </Grid>

                    <!-- Proje kartları: renk, kod, ad; altta stok sayısı ve son değişiklik (tarih · stok). Tıklayınca proje açılır. -->
                    <ItemsControl ItemsSource="{Binding ProjectCards}" Focusable="False">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Width="280" Margin="0,0,14,14" Padding="0" Click="ProjectCard_Click"
                                        HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch">
                                    <StackPanel>
                                    <!-- Üstte projenin renginde ince şerit -->
                                    <Border Height="3" Margin="16,0" CornerRadius="0,0,3,3" Background="{Binding Color}" />
                                    <StackPanel Margin="18,14,18,14">
                                        <StackPanel Orientation="Horizontal">
                                            <Grid Width="40" Height="40">
                                                <Border CornerRadius="9" Background="{Binding Color}" Opacity="0.18" />
                                                <local:AppIcon Glyph="{x:Static local:AppIcons.Project}" FontSize="20" Foreground="{Binding Color}"
                                                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            </Grid>
                                            <StackPanel Margin="14,0,0,0" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Code}" FontFamily="Consolas" FontSize="18" FontWeight="SemiBold" />
                                                <TextBlock Margin="0,1,0,0" Text="{Binding Name}" TextTrimming="CharacterEllipsis" MaxWidth="190"
                                                           Foreground="{DynamicResource TextSecondaryBrush}" />
                                            </StackPanel>
                                        </StackPanel>
                                        <!-- Stok çipleri: ilk 2 numara, fazlası "+N" (tek satır) -->
                                        <StackPanel Orientation="Horizontal" Margin="0,12,0,0" Visibility="{Binding HasChips, Converter={StaticResource BoolToVis}}">
                                            <ItemsControl ItemsSource="{Binding StockChips}" Focusable="False">
                                                <ItemsControl.ItemsPanel>
                                                    <ItemsPanelTemplate>
                                                        <StackPanel Orientation="Horizontal" />
                                                    </ItemsPanelTemplate>
                                                </ItemsControl.ItemsPanel>
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Border Margin="0,0,5,5" Padding="7,2" VerticalAlignment="Top" CornerRadius="5" BorderThickness="1"
                                                                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" Background="{DynamicResource SubtleFillColorTertiaryBrush}">
                                                            <TextBlock Text="{Binding}" FontFamily="Consolas" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" />
                                                        </Border>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                            <Border Margin="0,0,5,5" Padding="7,2" CornerRadius="5" BorderThickness="1" VerticalAlignment="Top"
                                                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                                                    Visibility="{Binding HasMore, Converter={StaticResource BoolToVis}}">
                                                <TextBlock Text="{Binding MoreText}" FontSize="11" Foreground="{DynamicResource TextTertiaryBrush}" />
                                            </Border>
                                        </StackPanel>
                                        <Border Margin="0,8,0,0" Padding="0,10,0,0" BorderThickness="0,1,0,0" BorderBrush="{DynamicResource DividerStrokeColorDefaultBrush}">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Orientation="Horizontal">
                                                    <local:AppIcon Glyph="{x:Static local:AppIcons.Stock}" FontSize="12" VerticalAlignment="Center"
                                                                   Foreground="{DynamicResource TextTertiaryBrush}" />
                                                    <TextBlock Margin="6,0,0,0" Text="{Binding StockText}" VerticalAlignment="Center"
                                                               Style="{DynamicResource CaptionTextBlockStyle}" Foreground="{DynamicResource TextSecondaryBrush}" />
                                                </StackPanel>
                                                <TextBlock Grid.Column="1" Margin="12,0,0,0" HorizontalAlignment="Right" VerticalAlignment="Center"
                                                           Text="{Binding LastText}" TextTrimming="CharacterEllipsis"
                                                           Style="{DynamicResource CaptionTextBlockStyle}" Foreground="{DynamicResource TextTertiaryBrush}" />
                                            </Grid>
                                        </Border>
                                    </StackPanel>
                                    </StackPanel>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!-- Hiç proje yokken -->
                    <TextBlock Margin="0,8,0,0" Foreground="{DynamicResource TextSecondaryBrush}" Text="{x:Static res:Resources.Card_NoProjects}">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding ProjectCount}" Value="0">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </StackPanel>
            </ScrollViewer>

            <!-- Seçili düğüm: başlık, özet kutucukları, tablo -->
            <Grid Grid.Column="1"
                  Margin="32,20,32,12"
                  Visibility="{Binding HasSelection, Converter={StaticResource BoolToVis}}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Başlık: numara + ad, üst kayıt (tıklanır) › tür / şablon, durum; sağda klasör ve ⋯ menüsü. Yol ipucunda. -->
                <Grid Grid.Row="0" DataContext="{Binding SelectedNode}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <local:AppIcon Grid.Column="0" Glyph="{Binding Glyph}" FontSize="38"
                                       Style="{StaticResource KindIconStyle}"
                                       VerticalAlignment="Top" Margin="0,4,20,0" />
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <WrapPanel ToolTip="{Binding Path}">
                            <TextBlock x:Name="HeaderTitle" FontSize="26" FontWeight="SemiBold" Text="{Binding Title}" VerticalAlignment="Bottom" />
                            <TextBlock Margin="14,0,0,3" FontSize="18" VerticalAlignment="Bottom" TextTrimming="CharacterEllipsis"
                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                       Text="{Binding DataContext.Detail.HeaderName, RelativeSource={RelativeSource AncestorType=Window}}" />
                        </WrapPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                            <Button Style="{DynamicResource HyperlinkButtonStyle}" Padding="0" Click="HeaderParent_Click"
                                    Content="{Binding DataContext.Detail.ParentName, RelativeSource={RelativeSource AncestorType=Window}}"
                                    ToolTip="{x:Static res:Resources.Header_GoParent}"
                                    Visibility="{Binding DataContext.Detail.HasParent, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVis}}" />
                            <!-- "›" yalnız üst kayıt ve yanında yazı (şablon, tür) varken -->
                            <TextBlock Margin="8,0,8,0" VerticalAlignment="Center" Foreground="{DynamicResource TextTertiaryBrush}" Text="›">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding DataContext.Detail.HasParent, RelativeSource={RelativeSource AncestorType=Window}}" Value="False">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding DataContext.Detail.ContextText, RelativeSource={RelativeSource AncestorType=Window}}" Value="">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                            <TextBlock VerticalAlignment="Center" Foreground="{DynamicResource TextSecondaryBrush}"
                                       Text="{Binding DataContext.Detail.ContextText, RelativeSource={RelativeSource AncestorType=Window}}" />
                        </StackPanel>
                        <!-- Proje / stok etiketleri (#SATIMO …): çip olarak; düzenle penceresinden verilir -->
                        <ItemsControl x:Name="HeaderTags" Margin="0,8,0,-6" ItemsSource="{Binding DataContext.Detail.Tags, RelativeSource={RelativeSource AncestorType=Window}}"
                                      Visibility="{Binding DataContext.Detail.HasTags, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVis}}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Margin="0,0,6,6" Padding="8,2" CornerRadius="{DynamicResource ControlCornerRadius}" Background="{DynamicResource SubtleFillColorSecondaryBrush}">
                                        <TextBlock Text="{Binding}" Style="{DynamicResource CaptionTextBlockStyle}" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" />
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <!-- Stok durum çipi kaldırıldı (15.11.2026); yalnız envanter kaydının durumu kalır. -->
                        <StackPanel Orientation="Horizontal" Margin="0,12,0,0"
                                    Visibility="{Binding DataContext.Inventory.IsRecord, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVis}}">
                            <controls:DropDownButton Padding="4,2"
                                                     VerticalAlignment="Center"
                                                     Menu="{StaticResource InventoryStatusMenu}"
                                                     ToolTip="{x:Static res:Resources.Status_ChangeHint}"
                                                     Visibility="{Binding DataContext.Inventory.IsRecord, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVis}}">
                                <ContentPresenter Content="{Binding DataContext.Inventory.Status, RelativeSource={RelativeSource AncestorType=Window}}"
                                                  ContentTemplate="{DynamicResource StatusChipTemplate}" />
                            </controls:DropDownButton>
                            <TextBlock Margin="12,0,0,0"
                                       VerticalAlignment="Center"
                                       Style="{DynamicResource CaptionTextBlockStyle}"
                                       Foreground="{DynamicResource TextTertiaryBrush}"
                                       Text="{Binding DataContext.Inventory.StatusInfo, RelativeSource={RelativeSource AncestorType=Window}}"
                                       Visibility="{Binding DataContext.Inventory.IsRecord, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVis}}" />
                        </StackPanel>
                    </StackPanel>
                    <!-- Sağ üst: Birim bilgisi (stokun ana md'si, yoksa oluşturur) · Klasör (Gezgin'de) · ⋯ -->
                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Top">
                        <Button Margin="0,0,6,0" Click="HeaderUnitInfo_Click" ToolTip="{x:Static res:Resources.Header_UnitInfoHint}"
                                Visibility="{Binding DataContext.Detail.IsStock, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVis}}">
                            <StackPanel Orientation="Horizontal">
                                <local:AppIcon Glyph="{x:Static local:AppIcons.Note}" FontSize="14" VerticalAlignment="Center" />
                                <TextBlock Text="{x:Static res:Resources.Header_UnitInfo}" Margin="8,0,0,0" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <Button Command="{Binding DataContext.OpenFolderCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                ToolTip="{x:Static res:Resources.Header_FolderHint}">
                            <StackPanel Orientation="Horizontal">
                                <local:AppIcon Glyph="{x:Static local:AppIcons.OpenFolder}" FontSize="14" VerticalAlignment="Center" />
                                <TextBlock Text="{x:Static res:Resources.Header_Folder}" Margin="8,0,0,0" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <Button x:Name="HeaderMoreButton" Margin="6,0,0,0" Style="{DynamicResource IconButtonStyle}" Click="HeaderMore_Click"
                                ToolTip="{x:Static res:Resources.Header_More}">
                            <local:AppIcon Glyph="{x:Static local:AppIcons.More}" FontSize="16" />
                        </Button>
                    </StackPanel>
                </Grid>

                <!-- Hesaplanıyor -->
                <StackPanel Grid.Row="3" Orientation="Horizontal" VerticalAlignment="Top" Margin="0,16,0,0"
                            Visibility="{Binding Detail.IsLoading, Converter={StaticResource BoolToVis}}">
                    <controls:ProgressRing Width="16" Height="16" IsActive="True" />
                    <TextBlock Margin="8,0,0,0" Foreground="{DynamicResource TextSecondaryBrush}"
                               Text="{x:Static res:Resources.Detail_Loading}" />
                </StackPanel>

                <!-- Proje / stok sayfasÄ±nÄ±n iÃ§i yeniden tasarlanacak (15.11.2026): ÅŸimdilik baÅŸlÄ±k ve yer tutucu -->
                <Border Grid.Row="3" Grid.RowSpan="2" Margin="0,16,0,0" Padding="24"
                        CornerRadius="{DynamicResource OverlayCornerRadius}"
                        BorderThickness="1" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Detail.IsProject}" Value="True">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Detail.IsStock}" Value="True">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center"
                               Foreground="{DynamicResource TextTertiaryBrush}"
                               Text="{x:Static res:Resources.Detail_Redesign}" />
                </Border>

                <!-- Envanter kaydı: dosyalar, bilgiler, not ve geçmiş -->
                <ScrollViewer Grid.Row="2" Grid.RowSpan="3" Margin="0,16,0,0" VerticalScrollBarVisibility="Auto"
                              Visibility="{Binding Inventory.IsRecord, Converter={StaticResource BoolToVis}}">
                <Grid TextElement.FontWeight="Normal">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="16" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                    <!-- Etiketler (#SATIMO …): çip olarak -->
                    <ItemsControl Margin="0,0,0,12" ItemsSource="{Binding Inventory.Tags}" Visibility="{Binding Inventory.HasTags, Converter={StaticResource BoolToVis}}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Margin="0,0,6,6" Padding="10,3" CornerRadius="{DynamicResource ControlCornerRadius}" Background="{DynamicResource SubtleFillColorSecondaryBrush}">
                                    <TextBlock Text="{Binding}" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" />
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <!-- Süreç: düzey, talep, yapan, teslim, not (numara, tanım, alt tür, konum başlıkta yazar) -->
                    <Border Padding="16,12" Margin="0,0,0,16"
                            Background="{DynamicResource LayerBrush}" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                            CornerRadius="{DynamicResource OverlayCornerRadius}">
                        <StackPanel>
                            <TextBlock Style="{StaticResource PaneLabel}" Text="{x:Static res:Resources.Inv_Process}" />
                            <ItemsControl x:Name="ProcessList" ItemsSource="{Binding Inventory.ProcessFacts}" ItemTemplate="{StaticResource FactCellTemplate}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <local:TwoColumnRowsPanel />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                            </ItemsControl>
                        </StackPanel>
                    </Border>

                    <!-- Özellikler: türe özel alanlar iki sütun; etiket üstte küçük, değer altta, ince çizgiyle ayrılır; boş olan soluk -->
                    <Border Padding="16,12" Margin="0,0,0,16" Visibility="{Binding Inventory.HasProperties, Converter={StaticResource BoolToVis}}"
                            Background="{DynamicResource LayerBrush}" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                            CornerRadius="{DynamicResource OverlayCornerRadius}">
                        <StackPanel>
                            <TextBlock Style="{StaticResource PaneLabel}" Text="{Binding Inventory.PropertiesHeader}" />
                            <!-- Yalnız dolu alanlar görünür (başlıkta "2 / 6 dolu"); hiçbiri dolu değilse tek satır ipucu -->
                            <ItemsControl x:Name="PropertyList" ItemsSource="{Binding Inventory.Properties}" ItemTemplate="{StaticResource FactCellTemplate}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <local:TwoColumnRowsPanel />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemContainerStyle>
                                    <Style TargetType="ContentPresenter">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsEmpty}" Value="True">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </ItemsControl.ItemContainerStyle>
                            </ItemsControl>
                            <TextBlock Margin="0,2,0,0" TextWrapping="Wrap" Foreground="{DynamicResource TextTertiaryBrush}"
                                       Visibility="{Binding Inventory.HasNoFilledProperties, Converter={StaticResource BoolToVis}}"
                                       Text="{x:Static res:Resources.Inv_PropertiesEmpty}" />
                        </StackPanel>
                    </Border>

                    <!-- Dosyalar: alt klasör düğmeleri, not, fotoğraf küçük resimleri -->
                    <Border Padding="16,12" Margin="0,0,0,16"
                            Background="{DynamicResource LayerBrush}" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                            CornerRadius="{DynamicResource OverlayCornerRadius}">
                        <StackPanel>
                            <TextBlock Style="{StaticResource PaneLabel}" Text="{x:Static res:Resources.Inv_Files}" />
                            <WrapPanel>
                                <ItemsControl ItemsSource="{Binding Inventory.FolderTiles}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <WrapPanel />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Button Margin="0,0,6,6" Padding="10,5" Tag="{Binding Path}" Click="RecordFolder_Click" ToolTip="{Binding Path}">
                                                <StackPanel Orientation="Horizontal">
                                                    <local:AppIcon Glyph="{x:Static local:AppIcons.OpenFolder}" FontSize="13" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" />
                                                    <TextBlock Margin="8,0,0,0" Text="{Binding Label}" VerticalAlignment="Center" />
                                                    <TextBlock x:Name="TileValue" Margin="6,0,0,0" Text="{Binding Value}" FontWeight="SemiBold" VerticalAlignment="Center" />
                                                </StackPanel>
                                            </Button>
                                            <DataTemplate.Triggers>
                                                <DataTrigger Binding="{Binding IsEmpty}" Value="True">
                                                    <Setter TargetName="TileValue" Property="FontWeight" Value="Normal" />
                                                    <Setter TargetName="TileValue" Property="Foreground" Value="{DynamicResource TextTertiaryBrush}" />
                                                </DataTrigger>
                                            </DataTemplate.Triggers>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <Button Margin="0,0,6,6" Padding="10,5" VerticalAlignment="Top" Click="RecordNote_Click"
                                        Visibility="{Binding Inventory.HasNote, Converter={StaticResource BoolToVis}}">
                                    <StackPanel Orientation="Horizontal">
                                        <local:AppIcon Glyph="{x:Static local:AppIcons.Note}" FontSize="13" VerticalAlignment="Center" />
                                        <TextBlock Margin="8,0,0,0" Text="{x:Static res:Resources.Inv_OpenNote}" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                                <Button Margin="0,0,6,6" Padding="10,5" VerticalAlignment="Top" Click="RecordCreateNote_Click"
                                        Visibility="{Binding Inventory.HasNote, Converter={StaticResource InverseBoolToVis}}">
                                    <StackPanel Orientation="Horizontal">
                                        <local:AppIcon Glyph="{x:Static local:AppIcons.Add}" FontSize="13" VerticalAlignment="Center" />
                                        <TextBlock Margin="8,0,0,0" Text="{x:Static res:Resources.Inv_CreateNote}" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                            </WrapPanel>
                            <Grid Margin="0,6,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <ItemsControl ItemsSource="{Binding Inventory.Photos}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <UniformGrid Rows="1" Columns="4" />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Button Margin="0,0,6,0" Padding="0" Height="84" Tag="{Binding}" Click="RecordPhoto_Click" ToolTip="{Binding}"
                                                    HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch">
                                                <Border CornerRadius="{DynamicResource ControlCornerRadius}" ClipToBounds="True">
                                                    <Image Source="{Binding Converter={StaticResource PathToImage}}" Stretch="UniformToFill" />
                                                </Border>
                                            </Button>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <TextBlock Grid.Column="1" VerticalAlignment="Center" Margin="4,0,0,0"
                                           Foreground="{DynamicResource TextSecondaryBrush}" Text="{Binding Inventory.MorePhotos}" />
                            </Grid>
                        </StackPanel>
                    </Border>
                    <ContentControl Content="{Binding}" ContentTemplate="{StaticResource MentionsCardTemplate}" Focusable="False" />
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                    <Border VerticalAlignment="Top" Padding="16,12"
                            Background="{DynamicResource LayerBrush}" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                            CornerRadius="{DynamicResource OverlayCornerRadius}">
                        <StackPanel>
                            <Grid Margin="0,0,0,4">
                                <TextBlock Style="{StaticResource PaneLabel}" Text="{x:Static res:Resources.Inv_History}" VerticalAlignment="Center" />
                                <Button HorizontalAlignment="Right" Margin="0,-6,0,0" Padding="8,3" Click="JournalAdd_Click" ToolTip="{x:Static res:Resources.Journal_ButtonHint}">
                                    <StackPanel Orientation="Horizontal">
                                        <local:AppIcon Glyph="{x:Static local:AppIcons.Add}" FontSize="12" Foreground="{DynamicResource AccentBrush}" />
                                        <TextBlock Margin="6,0,0,0" Text="{x:Static res:Resources.Journal_Button}" />
                                    </StackPanel>
                                </Button>
                            </Grid>                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBox Tag="Record" KeyDown="QuickNoteBox_KeyDown" local:MentionAssist.Mode="plain" controls:TextBoxHelper.PlaceholderText="{x:Static res:Resources.QuickNote_Placeholder}" ToolTip="{x:Static res:Resources.QuickNote_Hint}" />
                                <Button Grid.Column="1" Margin="6,0,0,0" Tag="Record" Click="QuickNoteAdd_Click">
                                    <StackPanel Orientation="Horizontal">
                                        <local:AppIcon Glyph="{x:Static local:AppIcons.Note}" FontSize="14" />
                                        <TextBlock Margin="8,0,0,0" Text="{x:Static res:Resources.QuickNote_Add}" />
                                    </StackPanel>
                                </Button>
                            </Grid>
                            <ItemsControl Margin="0,0,0,10" ItemsSource="{Binding Inventory.HistoryFilter.Options}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <controls:FilterChip Margin="0,0,6,6" Content="{Binding Label}" IsChecked="{Binding IsSelected, Mode=TwoWay}" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <ItemsControl ItemsSource="{Binding Inventory.History}" ItemTemplate="{StaticResource HistoryTemplate}" />
                        </StackPanel>
                    </Border>
                    </StackPanel>
                </Grid>
                </ScrollViewer>

                <!-- Envanter: liste (tür ya da bölüm seçiliyken); üstte süzgeçler -->
                <Grid Grid.Row="2" Grid.RowSpan="3" Margin="0,16,0,0" TextElement.FontWeight="Normal"
                      Visibility="{Binding Inventory.IsList, Converter={StaticResource BoolToVis}}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <WrapPanel Grid.Row="0" Orientation="Horizontal">
                        <controls:SearchBox Width="220" Margin="0,0,8,6" PlaceholderText="{x:Static res:Resources.Filter_Search}"
                                            Text="{Binding Inventory.FilterText, UpdateSourceTrigger=PropertyChanged}" />
                        <StackPanel Orientation="Horizontal" Margin="0,0,8,6" Visibility="{Binding Inventory.ShowTypeFilter, Converter={StaticResource BoolToVis}}">
                            <TextBlock VerticalAlignment="Center" Margin="0,0,6,0" Foreground="{DynamicResource TextSecondaryBrush}" Text="{x:Static res:Resources.Inv_Type}" />
                            <ComboBox MinWidth="110" ItemsSource="{Binding Inventory.TypeOptions}" SelectedItem="{Binding Inventory.FilterType, Mode=TwoWay}" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,8,6">
                            <TextBlock VerticalAlignment="Center" Margin="0,0,6,0" Foreground="{DynamicResource TextSecondaryBrush}" Text="{x:Static res:Resources.Inv_SubType}" />
                            <ComboBox MinWidth="130" ItemsSource="{Binding Inventory.SubTypeOptions}" SelectedItem="{Binding Inventory.FilterSubType, Mode=TwoWay}" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,8,6">
                            <TextBlock VerticalAlignment="Center" Margin="0,0,6,0" Foreground="{DynamicResource TextSecondaryBrush}" Text="{x:Static res:Resources.Col_Status}" />
                            <ComboBox MinWidth="150" ItemsSource="{Binding Inventory.StatusOptions}" SelectedItem="{Binding Inventory.FilterStatus, Mode=TwoWay}" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,8,6">
                            <TextBlock VerticalAlignment="Center" Margin="0,0,6,0" Foreground="{DynamicResource TextSecondaryBrush}" Text="{x:Static res:Resources.Inv_Level}" />
                            <ComboBox MinWidth="100" ItemsSource="{Binding Inventory.LevelOptions}" SelectedItem="{Binding Inventory.FilterLevel, Mode=TwoWay}" />
                        </StackPanel>
                        <TextBlock VerticalAlignment="Center" Margin="4,0,0,6" Style="{DynamicResource CaptionTextBlockStyle}"
                                   Foreground="{DynamicResource TextTertiaryBrush}" Text="{Binding Inventory.FilterSummary}" />
                    </WrapPanel>
                    <ListView x:Name="InventoryList" Grid.Row="1" Margin="0,10,0,0" ContextMenu="{StaticResource InventoryRowMenu}"
                              ItemsSource="{Binding Inventory.Rows}"
                              MouseDoubleClick="InventoryList_MouseDoubleClick">
                        <ListView.View>
                            <GridView>
                                <GridViewColumn Width="44">
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate>
                                            <Button Style="{DynamicResource IconButtonStyle}" Tag="{Binding Folder}" Click="RowFolder_Click"
                                                    ToolTip="{x:Static res:Resources.Menu_OpenFolder}">
                                                <local:AppIcon Glyph="{x:Static local:AppIcons.OpenFolder}" FontSize="13" />
                                            </Button>
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>
                                <GridViewColumn Header="{x:Static res:Resources.Inv_Number}" Width="120" DisplayMemberBinding="{Binding Number}" />
                                <GridViewColumn Header="{x:Static res:Resources.Inv_Name}" Width="190" DisplayMemberBinding="{Binding Name}" />
                                <GridViewColumn x:Name="InventoryTypeColumn" Header="{x:Static res:Resources.Inv_Type}" Width="60" DisplayMemberBinding="{Binding TypeName}" />
                                <GridViewColumn Header="{x:Static res:Resources.Inv_SubType}" Width="120" DisplayMemberBinding="{Binding SubType}" />
                                <GridViewColumn Header="{x:Static res:Resources.Col_Status}" Width="175">
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate>
                                            <ContentPresenter Content="{Binding Status}" ContentTemplate="{DynamicResource StatusChipTemplate}" />
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>
                                <GridViewColumn Header="{x:Static res:Resources.Inv_Location}" Width="120" DisplayMemberBinding="{Binding Location}" />
                                <GridViewColumn Header="{x:Static res:Resources.Inv_Level}" Width="145" DisplayMemberBinding="{Binding Level}" />
                            </GridView>
                        </ListView.View>
                    </ListView>
                </Grid>


            </Grid>
        </Grid>

        <!-- Durum çubuğu -->
        <StatusBar Grid.Row="2">
            <!-- Sağda: son yapılan iş (kalıcı); solda geçici durum mesajı -->
            <StatusBarItem DockPanel.Dock="Right" Visibility="{Binding HasLastAction, Converter={StaticResource BoolToVis}}"
                           ToolTip="{x:Static res:Resources.LastAction_Hint}">
                <StackPanel Orientation="Horizontal">
                    <local:AppIcon Glyph="{x:Static local:AppIcons.Check}" FontSize="12" Foreground="{DynamicResource SystemFillColorSuccessBrush}" VerticalAlignment="Center" />
                    <TextBlock x:Name="LastActionText" Margin="6,0,4,0" Foreground="{DynamicResource TextSecondaryBrush}" Text="{Binding LastAction}" />
                </StackPanel>
            </StatusBarItem>
            <StatusBarItem>
                <TextBlock Text="{Binding Status}" />
            </StatusBarItem>
        </StatusBar>

        <!-- Test koşusu: analiz tarihi ve kısa not -->
        <controls:ContentDialog Grid.RowSpan="3"
                                IsOpen="{Binding IsAnalysisOpen, Mode=TwoWay}"
                                Title="{x:Static res:Resources.Analysis_Title}"
                                PrimaryButtonText="{x:Static res:Resources.Edit_Save}"
                                CloseButtonText="{x:Static res:Resources.Dialog_Cancel}"
                                PrimaryButtonClick="AnalysisDialog_PrimaryButtonClick">
            <StackPanel Width="300">
                <TextBlock Margin="0,0,0,14" Foreground="{DynamicResource TextSecondaryBrush}" TextTrimming="CharacterEllipsis" Text="{Binding AnalysisTarget}" />
                <controls:FormField Header="{x:Static res:Resources.Field_AnalysisDate}" LabelWidth="90" ErrorText="{Binding AnalysisError}">
                    <TextBox Text="{Binding AnalysisDateText, UpdateSourceTrigger=PropertyChanged}" IsVisibleChanged="FocusWhenVisible" />
                </controls:FormField>
                <controls:FormField Header="{x:Static res:Resources.Field_AnalysisNote}" LabelWidth="90" Margin="0,12,0,0">
                    <TextBox Text="{Binding AnalysisNote, UpdateSourceTrigger=PropertyChanged}" TextWrapping="Wrap" AcceptsReturn="False" MinHeight="56" VerticalContentAlignment="Top" />
                </controls:FormField>
                <TextBlock Margin="0,12,0,0" Style="{DynamicResource CaptionTextBlockStyle}" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" Text="{x:Static res:Resources.Analysis_Hint}" />
            </StackPanel>
        </controls:ContentDialog>

        <!-- Yeni proje -->
        <controls:ContentDialog Grid.RowSpan="3"
                                IsOpen="{Binding IsProjectDialogOpen, Mode=TwoWay}"
                                                                Title="{x:Static res:Resources.Dialog_NewProjectTitle}"
                                PrimaryButtonText="{x:Static res:Resources.Dialog_Create}"
                                CloseButtonText="{x:Static res:Resources.Dialog_Cancel}"
                                PrimaryButtonClick="ProjectDialog_PrimaryButtonClick">
            <StackPanel Width="300">
                <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                    <local:AppIcon Glyph="{x:Static local:AppIcons.Project}" FontSize="22" Foreground="{DynamicResource Pusula.ProjectIconBrush}" VerticalAlignment="Center" />
                    <TextBlock Margin="12,0,0,0" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" MaxWidth="270"
                               Foreground="{DynamicResource TextSecondaryBrush}" Text="{Binding RootPath}" ToolTip="{Binding RootPath}" />
                </StackPanel>
                <controls:FormField Header="{x:Static res:Resources.Field_ProjectNo}" IsRequired="True" LabelWidth="90">
                    <TextBox Text="{Binding NewProjectNo, UpdateSourceTrigger=PropertyChanged}"
                             IsVisibleChanged="FocusWhenVisible" />
                </controls:FormField>
                <controls:FormField Header="{x:Static res:Resources.Field_ProjectName}" IsRequired="True" LabelWidth="90"
                                    Margin="0,12,0,0"
                                    ErrorText="{Binding ProjectError}">
                    <TextBox Text="{Binding NewProjectName, UpdateSourceTrigger=PropertyChanged}" />
                </controls:FormField>
            </StackPanel>
        </controls:ContentDialog>

        <!-- Yeni stok -->
        <controls:ContentDialog Grid.RowSpan="3"
                                IsOpen="{Binding IsStockDialogOpen, Mode=TwoWay}"
                                                                Title="{Binding StockDialogTitle}"
                                PrimaryButtonText="{x:Static res:Resources.Dialog_Create}"
                                CloseButtonText="{x:Static res:Resources.Dialog_Cancel}"
                                PrimaryButtonClick="StockDialog_PrimaryButtonClick">
            <StackPanel Width="500">
                <controls:FormField Margin="0,4,0,0" Header="{x:Static res:Resources.Field_StockNo}" IsRequired="True" LabelWidth="90">
                    <TextBox Text="{Binding NewStockNo, UpdateSourceTrigger=PropertyChanged}" ToolTip="{Binding StockNumberHint}"
                             IsVisibleChanged="FocusWhenVisible" />
                </controls:FormField>
                <controls:FormField Header="{x:Static res:Resources.Field_StockName}" LabelWidth="90"
                                    Margin="0,12,0,0"
                                    ErrorText="{Binding StockError}">
                    <TextBox Text="{Binding NewStockName, UpdateSourceTrigger=PropertyChanged}" />
                </controls:FormField>
                <controls:FormField Header="{x:Static res:Resources.Field_Template}" LabelWidth="90"
                                    Margin="0,12,0,0">
                    <ComboBox ItemsSource="{Binding TemplateNames}"
                              SelectedItem="{Binding SelectedTemplate, Mode=TwoWay}" />
                </controls:FormField>
                <controls:FormField Header="{x:Static res:Resources.Field_Modules}" LabelWidth="90"
                                    Margin="0,16,0,0">
                    <ItemsControl ItemsSource="{Binding StockModules}" ItemTemplate="{StaticResource ModuleOptionTemplate}" />
                </controls:FormField>
            </StackPanel>
        </controls:ContentDialog>

        <!-- Elle açılmış klasörü proje / stok olarak işaretle -->
        <controls:ContentDialog Grid.RowSpan="3"
                                IsOpen="{Binding IsMarkDialogOpen, Mode=TwoWay}"
                                                                Title="{Binding MarkTitle}"
                                PrimaryButtonText="{x:Static res:Resources.Mark_Confirm}"
                                CloseButtonText="{x:Static res:Resources.Dialog_Cancel}"
                                PrimaryButtonClick="MarkDialog_PrimaryButtonClick">
            <StackPanel Width="300">
                <TextBlock Style="{DynamicResource CaptionTextBlockStyle}"
                           Foreground="{DynamicResource TextSecondaryBrush}"
                           TextWrapping="Wrap"
                           MaxWidth="380"
                           HorizontalAlignment="Left"
                           Margin="0,0,0,12"
                           Text="{x:Static res:Resources.Mark_Hint}" />
                <controls:FormField Header="{Binding MarkNumberLabel}" IsRequired="True" LabelWidth="90">
                    <TextBox Text="{Binding MarkNumber, UpdateSourceTrigger=PropertyChanged}" IsVisibleChanged="FocusWhenVisible" />
                </controls:FormField>
                <TextBlock Margin="98,4,0,0"
                           MaxWidth="320"
                           HorizontalAlignment="Left"
                           TextWrapping="Wrap"
                           Style="{DynamicResource CaptionTextBlockStyle}"
                           Foreground="{DynamicResource TextTertiaryBrush}"
                           Text="{Binding StockNumberHint}"
                           Visibility="{Binding MarkIsStock, Converter={StaticResource BoolToVis}}" />
                <controls:FormField Header="{Binding MarkNameLabel}" LabelWidth="90" Margin="0,8,0,0"
                                    ErrorText="{Binding MarkError}">
                    <TextBox Text="{Binding MarkName, UpdateSourceTrigger=PropertyChanged}" />
                </controls:FormField>
            </StackPanel>
        </controls:ContentDialog>

        <!-- Yeni envanter kaydı (kablo, jig …): üstte genel bilgiler iki sütun, altta türe özel alanlar iki sütun -->
        <controls:ContentDialog Grid.RowSpan="3"
                                IsOpen="{Binding IsInventoryDialogOpen, Mode=TwoWay}"
                                DialogWidth="680"
                                Title="{Binding InventoryDialogTitle}"
                                PrimaryButtonText="{x:Static res:Resources.Dialog_Create}"
                                CloseButtonText="{x:Static res:Resources.Dialog_Cancel}"
                                PrimaryButtonClick="InventoryDialog_PrimaryButtonClick">
            <StackPanel>
                <TextBlock Style="{DynamicResource CaptionTextBlockStyle}" Foreground="{DynamicResource TextSecondaryBrush}"
                           TextWrapping="Wrap" Margin="0,0,0,10"
                           Text="{x:Static res:Resources.Mark_Hint}"
                           Visibility="{Binding IsInventoryMarkMode, Converter={StaticResource BoolToVis}}" />
                <controls:FormField Header="{x:Static res:Resources.Inv_Name}" IsRequired="True" LabelWidth="130">
                    <TextBox Text="{Binding NewInventoryName, UpdateSourceTrigger=PropertyChanged}" IsVisibleChanged="FocusWhenVisible" controls:TextBoxHelper.PlaceholderText="{Binding NewInventoryNamePlaceholder}" />
                </controls:FormField>
                <UniformGrid Columns="2" Margin="0,10,0,0">
                    <controls:FormField Header="{x:Static res:Resources.Inv_StockNo}" IsRequired="True" LabelWidth="130" Margin="0,0,16,0">
                        <TextBox Text="{Binding NewInventoryNumber, UpdateSourceTrigger=PropertyChanged}" ToolTip="{Binding InventoryNumberHint}" controls:TextBoxHelper.PlaceholderText="{Binding InventoryNumberHint}" />
                    </controls:FormField>
                    <Grid>
                        <controls:FormField Header="{x:Static res:Resources.Inv_Level}" LabelWidth="130"
                                            Visibility="{Binding IsInventoryMarkMode, Converter={StaticResource InverseBoolToVis}}">
                            <ComboBox ItemsSource="{Binding InventoryLevels}" SelectedItem="{Binding NewInventoryLevel, Mode=TwoWay}" DisplayMemberPath="Label" />
                        </controls:FormField>
                        <controls:FormField Header="{x:Static res:Resources.Col_Status}" LabelWidth="130"
                                            Visibility="{Binding IsInventoryMarkMode, Converter={StaticResource BoolToVis}}">
                            <ComboBox ItemsSource="{Binding InventoryStatuses}" SelectedItem="{Binding NewInventoryStatus, Mode=TwoWay}" />
                        </controls:FormField>
                    </Grid>
                </UniformGrid>
                <UniformGrid Columns="2" Margin="0,10,0,0" Visibility="{Binding HasInventorySubTypes, Converter={StaticResource BoolToVis}}">
                    <controls:FormField Header="{x:Static res:Resources.Inv_SubType}" LabelWidth="130" Margin="0,0,16,0">
                        <ComboBox ItemsSource="{Binding InventorySubTypes}" SelectedItem="{Binding NewInventorySubType, Mode=TwoWay}" />
                    </controls:FormField>
                </UniformGrid>
                <controls:FormField Header="{x:Static res:Resources.Inv_Note}" LabelWidth="130" Margin="0,10,0,0" ErrorText="{Binding InventoryError}">
                    <TextBox Text="{Binding NewInventoryNote, UpdateSourceTrigger=PropertyChanged}" controls:TextBoxHelper.PlaceholderText="{x:Static res:Resources.Placeholder_Note}" />
                </controls:FormField>
                <controls:FormField Header="{x:Static res:Resources.Inv_Tags}" LabelWidth="130" Margin="0,10,0,0">
                    <local:TagBox Tags="{Binding NewInventoryTags, Mode=TwoWay}" Placeholder="{x:Static res:Resources.Tag_Placeholder}" />
                </controls:FormField>
                <TextBlock Margin="0,10,0,0" Style="{DynamicResource CaptionTextBlockStyle}" Foreground="{DynamicResource TextTertiaryBrush}"
                           TextWrapping="Wrap" Text="{x:Static res:Resources.Inv_DetailsLater}" />
                <TextBlock Margin="0,10,0,0" Style="{DynamicResource CaptionTextBlockStyle}" Foreground="{DynamicResource TextTertiaryBrush}"
                           TextWrapping="Wrap"
                           Text="{x:Static res:Resources.Inv_TemplateHint}"
                           Visibility="{Binding IsInventoryMarkMode, Converter={StaticResource InverseBoolToVis}}" />
            </StackPanel>
        </controls:ContentDialog>

        <!-- Envanter durum olayı: tarih, kişi, konum, not -->
        <controls:ContentDialog Grid.RowSpan="3"
                                IsOpen="{Binding IsEventDialogOpen, Mode=TwoWay}"
                                                                Title="{Binding EventTitle}"
                                PrimaryButtonText="{x:Static res:Resources.Editor_Save}"
                                CloseButtonText="{x:Static res:Resources.Dialog_Cancel}"
                                PrimaryButtonClick="EventDialog_PrimaryButtonClick">
            <StackPanel Width="300">
                <controls:FormField Header="{x:Static res:Resources.Inv_Date}" LabelWidth="90">
                    <DatePicker SelectedDate="{Binding EventDate, Mode=TwoWay}" />
                </controls:FormField>
                <controls:FormField Header="{x:Static res:Resources.Inv_Person}" LabelWidth="90" Margin="0,8,0,0">
                    <TextBox Text="{Binding EventPerson, UpdateSourceTrigger=PropertyChanged}" />
                </controls:FormField>
                <controls:FormField Header="{x:Static res:Resources.Inv_Location}" LabelWidth="90" Margin="0,8,0,0">
                    <TextBox Text="{Binding EventLocation, UpdateSourceTrigger=PropertyChanged}" IsVisibleChanged="FocusWhenVisible" />
                </controls:FormField>
                <controls:FormField Header="{x:Static res:Resources.Inv_Note}" LabelWidth="90" Margin="0,8,0,0">
                    <TextBox Text="{Binding EventNote, UpdateSourceTrigger=PropertyChanged}" local:MentionAssist.Mode="plain" />
                </controls:FormField>
            </StackPanel>
        </controls:ContentDialog>

        <!-- Durum notu (Beklemede gibi) -->
        <controls:ContentDialog Grid.RowSpan="3"
                                IsOpen="{Binding IsQuickNoteOpen, Mode=TwoWay}"
                                                                Title="{Binding QuickNoteTitle}"
                                PrimaryButtonText="{x:Static res:Resources.QuickNote_Add}"
                                CloseButtonText="{x:Static res:Resources.Dialog_Cancel}"
                                PrimaryButtonClick="QuickNote_PrimaryButtonClick">
            <TextBox Width="300" MinHeight="70" TextWrapping="Wrap" AcceptsReturn="True" VerticalContentAlignment="Top"
                     Text="{Binding QuickNoteText, UpdateSourceTrigger=PropertyChanged}" IsVisibleChanged="FocusWhenVisible" local:MentionAssist.Mode="plain" />
        </controls:ContentDialog>

        <!-- Düzenle: proje, stok, envanter kaydı (ortak) -->
        <controls:ContentDialog
                                Style="{StaticResource RecordEditDialog}" Grid.RowSpan="3"
                                IsOpen="{Binding IsEditOpen, Mode=TwoWay}"
                                                                Title="{Binding EditTitle}"
                                PrimaryButtonText="{x:Static res:Resources.Edit_Save}"
                                CloseButtonText="{x:Static res:Resources.Dialog_Cancel}"
                                PrimaryButtonClick="Edit_PrimaryButtonClick">
            <StackPanel>
                <!-- Numara: salt okunur kutu (klasörün adı); açıklaması ipucunda -->
                <controls:FormField Margin="0,0,0,10" Header="{x:Static res:Resources.Edit_Number}" LabelWidth="130">
                    <TextBox Text="{Binding EditNumber, Mode=OneWay}" IsReadOnly="True" IsTabStop="False" FontFamily="Consolas"
                             Foreground="{DynamicResource TextSecondaryBrush}" ToolTip="{x:Static res:Resources.Edit_NumberHint}" />
                </controls:FormField>
                <!-- Stokta "Tanım", proje ve envanter kaydında "Ad" -->
                <controls:FormField LabelWidth="130">
                    <controls:FormField.Style>
                        <Style TargetType="controls:FormField" BasedOn="{StaticResource {x:Type controls:FormField}}">
                            <Setter Property="Header" Value="{x:Static res:Resources.Edit_Name}" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsEditStock}" Value="True">
                                    <Setter Property="Header" Value="{x:Static res:Resources.Field_StockName}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </controls:FormField.Style>
                    <TextBox x:Name="EditNameBox" Text="{Binding EditName, UpdateSourceTrigger=PropertyChanged}" IsVisibleChanged="FocusWhenVisible" controls:TextBoxHelper.PlaceholderText="{Binding EditNamePlaceholder}" />
                </controls:FormField>
                <controls:FormField Margin="0,10,0,0" Header="{x:Static res:Resources.Edit_Template}" LabelWidth="130"
                                    Visibility="{Binding IsEditStock, Converter={StaticResource BoolToVis}}">
                    <ComboBox ItemsSource="{Binding EditTemplates}" SelectedItem="{Binding EditTemplate, Mode=TwoWay}">
                        <!-- Boş seçenek "Şablonsuz" diye görünür -->
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock x:Name="Text" Text="{Binding}" />
                                <DataTemplate.Triggers>
                                    <DataTrigger Binding="{Binding}" Value="">
                                        <Setter TargetName="Text" Property="Text" Value="{x:Static res:Resources.Template_None}" />
                                        <Setter TargetName="Text" Property="Foreground" Value="{DynamicResource TextTertiaryBrush}" />
                                    </DataTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                </controls:FormField>
                <UniformGrid Columns="2" Margin="0,10,0,0" Visibility="{Binding IsEditInventory, Converter={StaticResource BoolToVis}}">
                    <controls:FormField Header="{x:Static res:Resources.Edit_SubType}" LabelWidth="130" Margin="0,0,16,0"
                                        Visibility="{Binding HasEditSubTypes, Converter={StaticResource BoolToVis}}">
                        <ComboBox x:Name="EditSubTypeBox" ItemsSource="{Binding EditSubTypes}" SelectedItem="{Binding EditSubType, Mode=TwoWay}" />
                    </controls:FormField>
                </UniformGrid>
                <controls:FormField Header="{x:Static res:Resources.Edit_Note}" LabelWidth="130" Margin="0,10,0,0" Visibility="{Binding IsEditInventory, Converter={StaticResource BoolToVis}}">
                    <TextBox Text="{Binding EditNote, UpdateSourceTrigger=PropertyChanged}" controls:TextBoxHelper.PlaceholderText="{x:Static res:Resources.Placeholder_Note}" />
                </controls:FormField>
                <controls:FormField Header="{x:Static res:Resources.Inv_Tags}" LabelWidth="130" Margin="0,10,0,0">
                    <local:TagBox Tags="{Binding EditTags, Mode=TwoWay}" Placeholder="{x:Static res:Resources.Tag_Placeholder}" />
                </controls:FormField>                <!-- Süreç (isteğe bağlı): talep, yapan, doküman -->
                <StackPanel Visibility="{Binding IsEditInventory, Converter={StaticResource BoolToVis}}">
                    <Border Margin="0,16,0,10" Padding="0,0,0,6" BorderThickness="0,0,0,1" BorderBrush="{DynamicResource DividerStrokeColorDefaultBrush}">
                        <TextBlock FontWeight="SemiBold" Text="{x:Static res:Resources.Edit_Process}" />
                    </Border>
                    <UniformGrid Columns="2">
                        <controls:FormField Header="{x:Static res:Resources.Inv_RequestDate}" LabelWidth="130" Margin="0,0,16,10">
                            <TextBox Text="{Binding EditRequestDateText, UpdateSourceTrigger=PropertyChanged}" controls:TextBoxHelper.PlaceholderText="{x:Static res:Resources.Date_Placeholder}" />
                        </controls:FormField>
                        <controls:FormField Header="{x:Static res:Resources.Inv_RequestedBy}" LabelWidth="130" Margin="0,0,0,10">
                            <TextBox Text="{Binding EditRequester, UpdateSourceTrigger=PropertyChanged}" local:MentionAssist.Mode="person" controls:TextBoxHelper.PlaceholderText="{x:Static res:Resources.Placeholder_Person}" />
                        </controls:FormField>
                        <controls:FormField Header="{x:Static res:Resources.Inv_MadeBy}" LabelWidth="130" Margin="0,0,16,10">
                            <TextBox Text="{Binding EditMaker, UpdateSourceTrigger=PropertyChanged}" local:MentionAssist.Mode="person" controls:TextBoxHelper.PlaceholderText="{x:Static res:Resources.Placeholder_Person}" />
                        </controls:FormField>
                        <controls:FormField Header="{x:Static res:Resources.Inv_Docs}" LabelWidth="130" Margin="0,0,0,10">
                            <CheckBox IsChecked="{Binding EditDocsReady}" VerticalAlignment="Center" Content="{x:Static res:Resources.Inv_DocsReady}" />
                        </controls:FormField>
                    </UniformGrid>
                </StackPanel>
                <!-- Türe özel alanlar (alt türe göre), iki sütun -->
                <StackPanel Visibility="{Binding HasEditFields, Converter={StaticResource BoolToVis}}">
                    <Border Margin="0,16,0,10" Padding="0,0,0,6" BorderThickness="0,0,0,1" BorderBrush="{DynamicResource DividerStrokeColorDefaultBrush}">
                        <TextBlock FontWeight="SemiBold" Text="{Binding EditFieldsHeader}" />
                    </Border>
                    <ScrollViewer MaxHeight="360" VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding EditFields}" ItemTemplate="{StaticResource FieldInputTemplate}" ItemsPanel="{StaticResource TwoColumnPanel}" />
                    </ScrollViewer>
                </StackPanel>
                <TextBlock Margin="0,10,0,0" TextWrapping="Wrap" Foreground="{DynamicResource SystemFillColorCriticalBrush}" Text="{Binding EditError}" />
            </StackPanel>
        </controls:ContentDialog>

        <!-- Sil: klasör _SILINENLER'e taşınır; Sil düğmesi ad doğru yazılınca görünür -->
        <controls:ContentDialog Grid.RowSpan="3"
                                IsOpen="{Binding IsDeleteOpen, Mode=TwoWay}"
                                                                Title="{Binding DeleteTitle}"
                                PrimaryButtonText="{Binding DeletePrimaryText}"
                                CloseButtonText="{x:Static res:Resources.Dialog_Cancel}"
                                PrimaryButtonClick="Delete_PrimaryButtonClick">
            <StackPanel Width="300">
                <TextBlock TextWrapping="Wrap" Text="{Binding DeleteText}" />
                <controls:SearchBox Margin="0,12,0,0" PlaceholderText="{x:Static res:Resources.Delete_TypeHint}"
                                    Text="{Binding DeleteTyped, UpdateSourceTrigger=PropertyChanged}" IsVisibleChanged="FocusWhenVisible" />
            </StackPanel>
        </controls:ContentDialog>

        <!-- + Olay: ana notun ## Günlük bölümüne eklenir (en yeni en üstte); Ekle düğmesi başlık yazılınca görünür -->
        <controls:ContentDialog Grid.RowSpan="3"
                                IsOpen="{Binding IsJournalOpen, Mode=TwoWay}"
                                Title="{Binding JournalTitle}"
                                PrimaryButtonText="{Binding JournalPrimaryText}"
                                CloseButtonText="{x:Static res:Resources.Dialog_Cancel}"
                                PrimaryButtonClick="Journal_PrimaryButtonClick">
            <StackPanel Width="460">
                <TextBlock Margin="0,0,0,14" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" Text="{Binding JournalTarget}" />
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="76" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid.Resources>
                    <Style TargetType="TextBlock" x:Key="JournalLabel">
                        <Setter Property="VerticalAlignment" Value="Center" />
                        <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
                    </Style>
                </Grid.Resources>

                <TextBlock Grid.Row="0" Style="{StaticResource JournalLabel}" Text="{x:Static res:Resources.Journal_Kind}" />
                <ComboBox Grid.Row="0" Grid.Column="1" ItemsSource="{Binding JournalKinds}" SelectedItem="{Binding JournalKindOption, Mode=TwoWay}">
                    <ComboBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal">
                                <local:AppIcon x:Name="KindIcon" Glyph="{Binding Glyph}" FontSize="14" Width="20" Foreground="{DynamicResource TextSecondaryBrush}" />
                                <TextBlock Margin="8,0,0,0" Text="{Binding Label}" VerticalAlignment="Center" />
                            </StackPanel>
                            <DataTemplate.Triggers>
                                <DataTrigger Binding="{Binding Tone}" Value="active">
                                    <Setter TargetName="KindIcon" Property="Foreground" Value="{DynamicResource AccentBrush}" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Tone}" Value="waiting">
                                    <Setter TargetName="KindIcon" Property="Foreground" Value="{DynamicResource SystemFillColorCautionBrush}" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Tone}" Value="done">
                                    <Setter TargetName="KindIcon" Property="Foreground" Value="{DynamicResource SystemFillColorSuccessBrush}" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Tone}" Value="failed">
                                    <Setter TargetName="KindIcon" Property="Foreground" Value="{DynamicResource SystemFillColorCriticalBrush}" />
                                </DataTrigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>

                <TextBlock Grid.Row="1" Margin="0,10,0,0" Style="{StaticResource JournalLabel}" Text="{x:Static res:Resources.Journal_Date}" />
                <TextBox Grid.Row="1" Grid.Column="1" Margin="0,10,0,0" Width="160" HorizontalAlignment="Left"
                         Text="{Binding JournalDateText, UpdateSourceTrigger=PropertyChanged}" ToolTip="{x:Static res:Resources.Journal_DateHint}" />

                <TextBlock Grid.Row="2" Margin="0,10,0,0" Style="{StaticResource JournalLabel}" Text="{x:Static res:Resources.Journal_Heading}" />
                <TextBox Grid.Row="2" Grid.Column="1" Margin="0,10,0,0" Text="{Binding JournalHeading, UpdateSourceTrigger=PropertyChanged}" IsVisibleChanged="FocusWhenVisible" local:MentionAssist.Mode="link" />

                <TextBlock Grid.Row="3" Margin="0,10,0,0" VerticalAlignment="Top" Padding="0,6,0,0" Foreground="{DynamicResource TextSecondaryBrush}" Text="{x:Static res:Resources.Journal_Body}" />
                <TextBox Grid.Row="3" Grid.Column="1" Margin="0,10,0,0" MinHeight="180" TextWrapping="Wrap" AcceptsReturn="True" VerticalContentAlignment="Top"
                         Text="{Binding JournalBody, UpdateSourceTrigger=PropertyChanged}" local:MentionAssist.Mode="link" />

                <TextBlock Grid.Row="4" Margin="0,10,0,0" Style="{StaticResource JournalLabel}" Text="{x:Static res:Resources.Journal_Importance}" />
                <ComboBox Grid.Row="4" Grid.Column="1" Margin="0,10,0,0" Width="180" HorizontalAlignment="Left"
                          ItemsSource="{Binding JournalImportances}" SelectedItem="{Binding JournalImportance, Mode=TwoWay}">
                    <ComboBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal">
                                <Ellipse x:Name="Dot" Width="8" Height="8" Fill="{DynamicResource TextTertiaryBrush}" VerticalAlignment="Center" />
                                <TextBlock Margin="10,0,0,0" Text="{Binding}" VerticalAlignment="Center" />
                            </StackPanel>
                            <DataTemplate.Triggers>
                                <DataTrigger Binding="{Binding}" Value="{x:Static res:Resources.Importance_High}">
                                    <Setter TargetName="Dot" Property="Fill" Value="{DynamicResource SystemFillColorCriticalBrush}" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding}" Value="{x:Static res:Resources.Importance_Normal}">
                                    <Setter TargetName="Dot" Property="Fill" Value="{DynamicResource AccentBrush}" />
                                </DataTrigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>

                <TextBlock Grid.Row="5" Margin="0,10,0,0" Style="{StaticResource JournalLabel}" Text="{x:Static res:Resources.Journal_Tags}" />
                <local:TagBox Grid.Row="5" Grid.Column="1" Margin="0,10,0,0" Tags="{Binding JournalTags, Mode=TwoWay}" Placeholder="{x:Static res:Resources.Tag_Placeholder}" ToolTip="{x:Static res:Resources.Journal_TagsHint}" />

            </Grid>
            </StackPanel>
        </controls:ContentDialog>

        <!-- Günlük olayını sil: yalnız o olayın satırları nottan kalkar -->
        <controls:ContentDialog Grid.RowSpan="3"
                                IsOpen="{Binding IsJournalDeleteOpen, Mode=TwoWay}"
                                Title="{x:Static res:Resources.Journal_DeleteTitle}"
                                PrimaryButtonText="{x:Static res:Resources.Journal_Delete}"
                                CloseButtonText="{x:Static res:Resources.Dialog_Cancel}"
                                PrimaryButtonClick="JournalDelete_PrimaryButtonClick">
            <TextBlock Width="300" TextWrapping="Wrap" Text="{Binding JournalDeleteText}" />
        </controls:ContentDialog>

        <!-- Yapılacak işi kapat / yeniden aç: kutuya basınca önce sorulur -->
        <controls:ContentDialog Grid.RowSpan="3"
                                IsOpen="{Binding IsTaskConfirmOpen, Mode=TwoWay}"
                                Title="{Binding TaskConfirmTitle}"
                                PrimaryButtonText="{Binding TaskConfirmButton}"
                                CloseButtonText="{x:Static res:Resources.Dialog_Cancel}"
                                PrimaryButtonClick="TaskConfirm_PrimaryButtonClick">
            <TextBlock Width="340" TextWrapping="Wrap" Text="{Binding TaskConfirmText}" />
        </controls:ContentDialog>

        <!-- Takipten çıkar: dosyalar silinmez -->
        <controls:ContentDialog Grid.RowSpan="3"
                                IsOpen="{Binding IsUntrackOpen, Mode=TwoWay}"
                                                                Title="{Binding UntrackTitle}"
                                PrimaryButtonText="{x:Static res:Resources.Untrack_Confirm}"
                                CloseButtonText="{x:Static res:Resources.Dialog_Cancel}"
                                PrimaryButtonClick="Untrack_PrimaryButtonClick">
            <TextBlock Width="300" TextWrapping="Wrap" Text="{Binding UntrackText}" />
        </controls:ContentDialog>

        <controls:ContentDialog Grid.RowSpan="3"
                                IsOpen="{Binding IsStatusNoteOpen, Mode=TwoWay}"
                                                                Title="{Binding StatusNoteTitle}"
                                PrimaryButtonText="{x:Static res:Resources.ModuleDialog_Apply}"
                                CloseButtonText="{x:Static res:Resources.Dialog_Cancel}"
                                PrimaryButtonClick="StatusNote_PrimaryButtonClick">
            <controls:FormField Width="300" Header="{x:Static res:Resources.Field_StatusNote}" LabelWidth="60">
                <TextBox Text="{Binding StatusNoteText, UpdateSourceTrigger=PropertyChanged}" IsVisibleChanged="FocusWhenVisible" />
            </controls:FormField>
        </controls:ContentDialog>

        <!-- Modül ekle -->
        <controls:ContentDialog Grid.RowSpan="3"
                                IsOpen="{Binding IsModuleDialogOpen, Mode=TwoWay}"
                                                                Title="{Binding ModuleDialogTitle}"
                                PrimaryButtonText="{x:Static res:Resources.Dialog_Add}"
                                CloseButtonText="{x:Static res:Resources.Dialog_Cancel}"
                                PrimaryButtonClick="ModuleDialog_PrimaryButtonClick">
            <ItemsControl Width="300"
                          ItemsSource="{Binding AddableModules}"
                          ItemTemplate="{StaticResource ModuleOptionTemplate}" />
        </controls:ContentDialog>
    </Grid>

</controls:ChromeWindow>
