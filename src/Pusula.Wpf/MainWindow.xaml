                    </Canvas>
                    <Canvas x:Name="Zoom" Visibility="Collapsed">
                        <Rectangle Width="32" Height="32" RadiusX="8" RadiusY="8" Fill="#2D8CFF" />
                        <Rectangle Canvas.Left="6" Canvas.Top="10.5" Width="14" Height="11" RadiusX="3" RadiusY="3" Fill="White" />
