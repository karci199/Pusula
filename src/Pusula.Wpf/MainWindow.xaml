                            <Ellipse.Fill><LinearGradientBrush StartPoint="0,0" EndPoint="1,1"><GradientStop Color="#5A62C3" Offset="0" /><GradientStop Color="#4D55BD" Offset="1" /></LinearGradientBrush></Ellipse.Fill>
                        </Ellipse>
                        <Rectangle Canvas.Left="9.5" Canvas.Top="12.5" Width="14.5" Height="16.5" RadiusX="5" RadiusY="5">
                            <Rectangle.Fill><LinearGradientBrush StartPoint="0,0" EndPoint="1,1"><GradientStop Color="#5A62C3" Offset="0" /><GradientStop Color="#4D55BD" Offset="1" /></LinearGradientBrush></Rectangle.Fill>
                        </Rectangle>
                        <Rectangle Canvas.Left="1.5" Canvas.Top="8.5" Width="15" Height="15" RadiusX="2" RadiusY="2">
                            <Rectangle.Fill><LinearGradientBrush StartPoint="0,0" EndPoint="1,1"><GradientStop Color="#5A62C3" Offset="0" /><GradientStop Color="#3940AB" Offset="1" /></LinearGradientBrush></Rectangle.Fill>
