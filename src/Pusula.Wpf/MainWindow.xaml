<controls:ChromeWindow x:Class="Pusula.Wpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:DesignKit.Controls;assembly=DesignKit.Wpf"
        xmlns:icons="clr-namespace:DesignKit.Icons;assembly=DesignKit.Wpf"
        xmlns:res="clr-namespace:Pusula.Wpf.Properties"
        Title="{x:Static res:Resources.Window_Title}"
        Width="1200" Height="760"
        MinWidth="800" MinHeight="500"
        WindowStartupLocation="CenterScreen"
        FontFamily="{DynamicResource AppFont}"
        Foreground="{DynamicResource TextPrimaryBrush}"
        Background="{DynamicResource SurfaceBaseBrush}">

    <controls:ChromeWindow.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
    </controls:ChromeWindow.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Araç çubuğu: kök klasör, yeni proje, yeni stok, yenile -->
        <Grid Grid.Row="0" Margin="{DynamicResource PadCard}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <controls:FilePickerRow Grid.Column="0"
                                    Mode="Folder"
                                    SelectedPath="{Binding RootPath, Mode=TwoWay}"
                                    PlaceholderText="{x:Static res:Resources.Root_Placeholder}"
                                    BrowseText="{x:Static res:Resources.Root_Browse}"
                                    DialogTitle="{x:Static res:Resources.Root_DialogTitle}" />

            <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="12,0,0,0">
                <Button Command="{Binding NewProjectCommand}"
                        Content="{x:Static res:Resources.Button_NewProject}" />
                <Button Command="{Binding NewStockCommand}"
                        Content="{x:Static res:Resources.Button_NewStock}"
                        Margin="8,0,0,0" />
                <Button Style="{DynamicResource IconButtonStyle}"
                        Command="{Binding RefreshCommand}"
                        Content="{x:Static icons:Symbol.Refresh}"
                        ToolTip="{x:Static res:Resources.Button_Refresh}"
                        Margin="8,0,0,0" />
            </StackPanel>
        </Grid>

        <!-- Gövde: solda ağaç, sağda seçili düğüm -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="320" MinWidth="220" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0"
                    Background="{DynamicResource LayerBrush}"
                    BorderBrush="{DynamicResource DividerStrokeColorDefaultBrush}"
                    BorderThickness="0,1,1,0">
                <Grid>
                    <TextBlock Margin="{DynamicResource PadCard}"
                               TextWrapping="Wrap"
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               Text="{x:Static res:Resources.Tree_NoRoot}">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource CaptionTextBlockStyle}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasRoot}" Value="True">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>

                    <TreeView x:Name="FolderTree"
                              ItemsSource="{Binding Nodes}"
                              Visibility="{Binding HasRoot, Converter={StaticResource BoolToVis}}"
                              Background="Transparent"
                              BorderThickness="0"
                              Padding="4"
                              SelectedItemChanged="FolderTree_SelectedItemChanged">
                        <TreeView.ItemContainerStyle>
                            <Style TargetType="TreeViewItem" BasedOn="{StaticResource {x:Type TreeViewItem}}">
                                <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}" />
                            </Style>
                        </TreeView.ItemContainerStyle>
                        <TreeView.ItemTemplate>
                            <HierarchicalDataTemplate ItemsSource="{Binding Children}">
                                <StackPanel Orientation="Horizontal">
                                    <controls:FontIcon Glyph="{Binding Glyph}" FontSize="14"
                                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                                       VerticalAlignment="Center" />
                                    <TextBlock Text="{Binding Title}" Margin="8,0,0,0" VerticalAlignment="Center" />
                                </StackPanel>
                            </HierarchicalDataTemplate>
                        </TreeView.ItemTemplate>
                    </TreeView>
                </Grid>
            </Border>

            <!-- Hiçbir şey seçili değil -->
            <StackPanel Grid.Column="1"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center">
                <StackPanel.Style>
                    <Style TargetType="StackPanel">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding HasSelection}" Value="True">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </StackPanel.Style>
                <TextBlock Style="{DynamicResource SubtitleTextBlockStyle}"
                           HorizontalAlignment="Center"
                           Text="{x:Static res:Resources.Content_EmptyTitle}" />
                <TextBlock Style="{DynamicResource BodyTextBlockStyle}"
                           Foreground="{DynamicResource TextSecondaryBrush}"
                           HorizontalAlignment="Center"
                           Text="{x:Static res:Resources.Content_EmptyHint}" />
            </StackPanel>

            <!-- Seçili düğüm (şimdilik ad, tür, yol) -->
            <StackPanel Grid.Column="1"
                        Margin="24"
                        Visibility="{Binding HasSelection, Converter={StaticResource BoolToVis}}">
                <TextBlock Style="{DynamicResource CaptionTextBlockStyle}"
                           Foreground="{DynamicResource TextSecondaryBrush}"
                           Text="{Binding SelectedNode.KindText}" />
                <TextBlock Style="{DynamicResource SubtitleTextBlockStyle}"
                           Text="{Binding SelectedNode.Title}" />
                <TextBlock Style="{DynamicResource CaptionTextBlockStyle}"
                           Foreground="{DynamicResource TextSecondaryBrush}"
                           TextWrapping="Wrap"
                           Margin="0,4,0,0"
                           Text="{Binding SelectedNode.Path}" />
            </StackPanel>
        </Grid>

        <!-- Durum çubuğu -->
        <StatusBar Grid.Row="2">
            <StatusBarItem>
                <TextBlock Text="{Binding Status}" />
            </StatusBarItem>
        </StatusBar>

        <!-- Yeni proje -->
        <controls:ContentDialog Grid.RowSpan="3"
                                IsOpen="{Binding IsProjectDialogOpen, Mode=TwoWay}"
                                Title="{x:Static res:Resources.Dialog_NewProjectTitle}"
                                PrimaryButtonText="{x:Static res:Resources.Dialog_Create}"
                                CloseButtonText="{x:Static res:Resources.Dialog_Cancel}"
                                PrimaryButtonClick="ProjectDialog_PrimaryButtonClick">
            <StackPanel Width="360">
                <controls:FormField Header="{x:Static res:Resources.Field_ProjectNo}" IsRequired="True" LabelWidth="100">
                    <TextBox Text="{Binding NewProjectNo, UpdateSourceTrigger=PropertyChanged}" />
                </controls:FormField>
                <controls:FormField Header="{x:Static res:Resources.Field_ProjectName}" IsRequired="True" LabelWidth="100"
                                    Margin="0,8,0,0"
                                    ErrorText="{Binding ProjectError}">
                    <TextBox Text="{Binding NewProjectName, UpdateSourceTrigger=PropertyChanged}" />
                </controls:FormField>
            </StackPanel>
        </controls:ContentDialog>

        <!-- Yeni stok -->
        <controls:ContentDialog Grid.RowSpan="3"
                                IsOpen="{Binding IsStockDialogOpen, Mode=TwoWay}"
                                Title="{x:Static res:Resources.Dialog_NewStockTitle}"
                                PrimaryButtonText="{x:Static res:Resources.Dialog_Create}"
                                CloseButtonText="{x:Static res:Resources.Dialog_Cancel}"
                                PrimaryButtonClick="StockDialog_PrimaryButtonClick">
            <StackPanel Width="360">
                <controls:FormField Header="{x:Static res:Resources.Field_ParentProject}" LabelWidth="100">
                    <TextBlock Text="{Binding StockParentTitle}" VerticalAlignment="Center" />
                </controls:FormField>
                <controls:FormField Header="{x:Static res:Resources.Field_StockNo}" IsRequired="True" LabelWidth="100"
                                    Margin="0,8,0,0">
                    <TextBox Text="{Binding NewStockNo, UpdateSourceTrigger=PropertyChanged}" />
                </controls:FormField>
                <controls:FormField Header="{x:Static res:Resources.Field_StockName}" LabelWidth="100"
                                    Margin="0,8,0,0"
                                    ErrorText="{Binding StockError}">
                    <TextBox Text="{Binding NewStockName, UpdateSourceTrigger=PropertyChanged}" />
                </controls:FormField>
            </StackPanel>
        </controls:ContentDialog>
    </Grid>

</controls:ChromeWindow>
