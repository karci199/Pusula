<controls:ChromeWindow x:Class="Pusula.Wpf.TemplateEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:DesignKit.Controls;assembly=DesignKit.Wpf"
        xmlns:local="clr-namespace:Pusula.Wpf"
        xmlns:res="clr-namespace:Pusula.Wpf.Properties"
        Title="{x:Static res:Resources.Editor_Title}"
        Width="960" Height="700"
        MinWidth="760" MinHeight="520"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        FontFamily="{DynamicResource AppFont}"
        Foreground="{DynamicResource TextPrimaryBrush}"
        Background="{DynamicResource SurfaceBaseBrush}">

    <controls:ChromeWindow.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />

        <Style x:Key="SectionLabel" TargetType="TextBlock" BasedOn="{StaticResource CaptionTextBlockStyle}">
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <ContextMenu x:Key="AddModuleMenu" Opened="AddModuleMenu_Opened" />
    </controls:ChromeWindow.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="240" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Sol: şablonlar -->
            <Border Grid.Column="0"
                    Background="{DynamicResource LayerBrush}"
                    BorderBrush="{DynamicResource DividerStrokeColorDefaultBrush}"
                    BorderThickness="0,1,1,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Grid Margin="16,10,10,6">
                        <TextBlock Style="{StaticResource SectionLabel}" Text="{x:Static res:Resources.Editor_Templates}" />
                        <Button HorizontalAlignment="Right" Command="{Binding AddTemplateCommand}">
                            <StackPanel Orientation="Horizontal">
                                <controls:FontIcon Glyph="{x:Static local:AppIcons.Add}" FontSize="12" VerticalAlignment="Center" />
                                <TextBlock Text="{x:Static res:Resources.Editor_AddTemplate}" Margin="6,0,0,0" />
                            </StackPanel>
                        </Button>
                    </Grid>
                    <ListBox Grid.Row="1"
                             ItemsSource="{Binding Templates}"
                             SelectedItem="{Binding SelectedTemplate, Mode=TwoWay}"
                             Background="Transparent"
                             BorderThickness="0">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <controls:FontIcon Grid.Column="0" Glyph="{x:Static local:AppIcons.Template}" FontSize="14"
                                                       Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="1" Margin="10,0,0,0" Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Grid.Column="2" Margin="8,0,0,0"
                                               Style="{DynamicResource CaptionTextBlockStyle}"
                                               Foreground="{DynamicResource TextTertiaryBrush}"
                                               VerticalAlignment="Center"
                                               Text="{Binding ModuleCount}" />
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </Border>

            <!-- Sağ: seçili şablon yoksa -->
            <TextBlock Grid.Column="1"
                       HorizontalAlignment="Center" VerticalAlignment="Center"
                       Foreground="{DynamicResource TextSecondaryBrush}"
                       Text="{x:Static res:Resources.Editor_SelectTemplate}">
                <TextBlock.Style>
                    <Style TargetType="TextBlock" BasedOn="{StaticResource BodyTextBlockStyle}">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding HasSelection}" Value="True">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>

            <!-- Sağ: seçili şablon -->
            <Grid Grid.Column="1"
                  Margin="24,16,24,12"
                  DataContext="{Binding SelectedTemplate}"
                  Visibility="{Binding DataContext.HasSelection, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVis}}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Ad + şablonu sil -->
                <Grid Grid.Row="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <controls:FormField Header="{x:Static res:Resources.Editor_Name}" LabelWidth="60">
                        <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" />
                    </controls:FormField>
                    <Button Grid.Column="1" Margin="12,0,0,0"
                            Command="{Binding DataContext.DeleteTemplateCommand, RelativeSource={RelativeSource AncestorType=Window}}">
                        <StackPanel Orientation="Horizontal">
                            <controls:FontIcon Glyph="{x:Static local:AppIcons.Delete}" FontSize="12" VerticalAlignment="Center" />
                            <TextBlock Text="{x:Static res:Resources.Editor_DeleteTemplate}" Margin="6,0,0,0" />
                        </StackPanel>
                    </Button>
                </Grid>

                <!-- Modüller başlığı + modül ekle -->
                <Grid Grid.Row="1" Margin="0,20,0,6">
                    <TextBlock Style="{StaticResource SectionLabel}" Text="{x:Static res:Resources.Editor_Modules}" />
                    <controls:DropDownButton HorizontalAlignment="Right"
                                             Menu="{StaticResource AddModuleMenu}">
                        <StackPanel Orientation="Horizontal">
                            <controls:FontIcon Glyph="{x:Static local:AppIcons.Add}" FontSize="12" VerticalAlignment="Center" />
                            <TextBlock Text="{x:Static res:Resources.Editor_AddModule}" Margin="6,0,0,0" />
                        </StackPanel>
                    </controls:DropDownButton>
                </Grid>

                <!-- Şablondaki modüller -->
                <Border Grid.Row="2"
                        Background="{DynamicResource LayerBrush}"
                        BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="{DynamicResource OverlayCornerRadius}">
                    <ListBox ItemsSource="{Binding Modules}"
                             SelectedItem="{Binding SelectedModule, Mode=TwoWay}"
                             Background="Transparent"
                             BorderThickness="0"
                             HorizontalContentAlignment="Stretch"
                             MouseDoubleClick="ModuleList_MouseDoubleClick">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}">
                                <Setter Property="Padding" Value="12,0,6,0" />
                                <Setter Property="MinHeight" Value="34" />
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="30" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="{Binding Number}" FontFamily="Consolas"
                                               Foreground="{DynamicResource TextTertiaryBrush}" VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="1" Text="{Binding Name}" VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="2" Margin="12,0,0,0"
                                               Style="{DynamicResource CaptionTextBlockStyle}"
                                               Foreground="{DynamicResource TextTertiaryBrush}"
                                               VerticalAlignment="Center"
                                               Text="{Binding SubFolderText}" />
                                    <Button Grid.Column="3"
                                            Style="{DynamicResource IconButtonStyle}"
                                            Click="EditModule_Click" Width="28" Height="28"
                                            ToolTip="{x:Static res:Resources.Editor_EditModule}">
                                        <controls:FontIcon Glyph="{x:Static local:AppIcons.Edit}" FontSize="12" />
                                    </Button>
                                    <Button Grid.Column="4"
                                            Style="{DynamicResource IconButtonStyle}"
                                            Command="{Binding DataContext.RemoveModuleCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                            CommandParameter="{Binding}" Width="28" Height="28"
                                            ToolTip="{x:Static res:Resources.Editor_RemoveFromTemplate}">
                                        <controls:FontIcon Glyph="{x:Static local:AppIcons.Remove}" FontSize="12" />
                                    </Button>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Border>

                <!-- Seçili modülün alt klasörleri (salt okunur; düzenlemek için ✎) -->
                <StackPanel Grid.Row="3" Margin="0,12,0,0">
                    <TextBlock Style="{DynamicResource CaptionTextBlockStyle}"
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               TextWrapping="Wrap"
                               Text="{Binding DataContext.UsageText, RelativeSource={RelativeSource AncestorType=Window}}" />
                    <Border Margin="0,6,0,0"
                            Padding="8,4"
                            MaxHeight="170"
                            Background="{DynamicResource LayerBrush}"
                            BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1"
                            CornerRadius="{DynamicResource OverlayCornerRadius}"
                            DataContext="{Binding SelectedModule}">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding}" Value="{x:Null}">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <StackPanel>
                            <TextBlock Margin="4,4" FontFamily="Consolas" Text="{Binding Folder}" />
                            <TreeView ItemsSource="{Binding SubFolders}" Background="Transparent" BorderThickness="0" Focusable="False">
                                <TreeView.ItemContainerStyle>
                                    <Style TargetType="TreeViewItem" BasedOn="{StaticResource {x:Type TreeViewItem}}">
                                        <Setter Property="IsExpanded" Value="True" />
                                    </Style>
                                </TreeView.ItemContainerStyle>
                                <TreeView.ItemTemplate>
                                    <HierarchicalDataTemplate ItemsSource="{Binding Children}">
                                        <StackPanel Orientation="Horizontal">
                                            <controls:FontIcon Glyph="{x:Static local:AppIcons.Folder}" FontSize="13"
                                                               Foreground="{DynamicResource TextTertiaryBrush}" VerticalAlignment="Center" />
                                            <TextBlock Text="{Binding Name}" Margin="8,0,0,0" FontFamily="Consolas" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </HierarchicalDataTemplate>
                                </TreeView.ItemTemplate>
                            </TreeView>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>
        </Grid>

        <!-- Alt: dosya bilgisi, hata, vazgeç, kaydet -->
        <Border Grid.Row="1"
                Background="{DynamicResource LayerBrush}"
                BorderBrush="{DynamicResource DividerStrokeColorDefaultBrush}"
                BorderThickness="0,1,0,0"
                Padding="24,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock TextWrapping="Wrap"
                               Foreground="{DynamicResource SystemFillColorCriticalBrush}"
                               Text="{Binding Error}" />
                    <TextBlock Style="{DynamicResource CaptionTextBlockStyle}"
                               Foreground="{DynamicResource TextTertiaryBrush}"
                               TextTrimming="CharacterEllipsis"
                               Text="{Binding FileNote}" />
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="16,0,0,0">
                    <Button Content="{x:Static res:Resources.Dialog_Cancel}" IsCancel="True" Click="Cancel_Click" />
                    <Button Content="{x:Static res:Resources.Editor_Save}"
                            Style="{DynamicResource AccentButtonStyle}"
                            Margin="8,0,0,0"
                            Click="Save_Click" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>

</controls:ChromeWindow>
