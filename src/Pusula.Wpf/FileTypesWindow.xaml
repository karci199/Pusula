<controls:ChromeWindow x:Class="Pusula.Wpf.FileTypesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:DesignKit.Controls;assembly=DesignKit.Wpf"
        xmlns:res="clr-namespace:Pusula.Wpf.Properties"
        Title="{x:Static res:Resources.FileTypes_Title}"
        Width="720" Height="620"
        MinWidth="560" MinHeight="420"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        FontFamily="{DynamicResource AppFont}"
        Foreground="{DynamicResource TextPrimaryBrush}"
        Background="{DynamicResource SurfaceBaseBrush}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <TextBlock Grid.Row="0" Margin="20,14,20,10" TextWrapping="Wrap" Style="{DynamicResource CaptionTextBlockStyle}"
                   Foreground="{DynamicResource TextSecondaryBrush}" Text="{x:Static res:Resources.FileTypes_Hint}" />
        <DataGrid x:Name="Grid" Grid.Row="1" Margin="20,0,20,12" ItemsSource="{Binding Rows}"
                  AutoGenerateColumns="False" CanUserAddRows="True" CanUserDeleteRows="True" CanUserSortColumns="True"
                  HeadersVisibility="Column" SelectionUnit="FullRow">
            <DataGrid.Columns>
                <DataGridTextColumn EditingElementStyle="{StaticResource GridEditBox}" Header="{x:Static res:Resources.FileTypes_Name}" Width="160" Binding="{Binding Name}" />
                <DataGridTextColumn EditingElementStyle="{StaticResource GridEditBox}" Header="{x:Static res:Resources.FileTypes_Extensions}" Width="*" Binding="{Binding Extensions}" FontFamily="Consolas" />
                <DataGridTextColumn EditingElementStyle="{StaticResource GridEditBox}" Header="{x:Static res:Resources.FileTypes_Group}" Width="150" Binding="{Binding Group}" />
            </DataGrid.Columns>
        </DataGrid>
        <Border Grid.Row="2" Padding="20,12"
                Background="{DynamicResource LayerBrush}"
                BorderBrush="{DynamicResource DividerStrokeColorDefaultBrush}"
                BorderThickness="0,1,0,0">
            <Grid>
                <TextBlock VerticalAlignment="Center" Foreground="{DynamicResource SystemFillColorCriticalBrush}"
                           TextWrapping="Wrap" Margin="0,0,220,0" Text="{Binding Error}" />
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button MinWidth="96" Content="{x:Static res:Resources.Dialog_Cancel}" IsCancel="True" Click="Cancel_Click" />
                    <Button MinWidth="96" Margin="8,0,0,0" Style="{DynamicResource AccentButtonStyle}"
                            Content="{x:Static res:Resources.Editor_Save}" Click="Save_Click" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</controls:ChromeWindow>
