<UserControl x:Class="Pusula.Wpf.SearchPickBox"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:DesignKit.Controls;assembly=DesignKit.Wpf"
             xmlns:local="clr-namespace:Pusula.Wpf"
             x:Name="Root">
    <!-- Aramalı seçim kutusu: düğmede seçili değer; açılınca yazarak süzülen liste ve listede yoksa "+ Ekle". -->
    <UserControl.Resources>
        <local:InverseBooleanConverter x:Key="InverseBool" />
    </UserControl.Resources>
    <Grid>
        <ToggleButton x:Name="Button" HorizontalContentAlignment="Stretch" Padding="11,5"
                      Style="{DynamicResource DropToggleStyle}"
                      IsHitTestVisible="{Binding IsOpen, ElementName=DropPopup, Converter={StaticResource InverseBool}}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="ShownText" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                <local:AppIcon Grid.Column="1" Margin="8,0,0,0" Glyph="{x:Static local:AppIcons.ChevronDown}" FontSize="10" VerticalAlignment="Center" Foreground="{DynamicResource TextSecondaryBrush}" />
            </Grid>
        </ToggleButton>
        <Popup x:Name="DropPopup" PlacementTarget="{Binding ElementName=Button}" Placement="Bottom" VerticalOffset="4" StaysOpen="False" AllowsTransparency="True"
               IsOpen="{Binding IsChecked, ElementName=Button, Mode=TwoWay}" Opened="Drop_Opened">
            <Border x:Name="DropBorder" Padding="6" CornerRadius="{DynamicResource OverlayCornerRadius}" BorderThickness="1"
                    Background="{DynamicResource SolidBackgroundFillColorTertiaryBrush}" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}">
                <StackPanel>
                    <TextBox x:Name="Search" TextChanged="Search_TextChanged" PreviewKeyDown="Search_PreviewKeyDown" />
                    <ScrollViewer Margin="0,4,0,0" MaxHeight="260" VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <ItemsControl x:Name="List" Focusable="False">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Button Padding="8,5" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Style="{DynamicResource SubtleButtonStyle}"
                                                Tag="{Binding}" Click="Item_Click">
                                            <TextBlock Text="{Binding}" TextTrimming="CharacterEllipsis" />
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <Button x:Name="AddButton" Padding="8,5" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Style="{DynamicResource SubtleButtonStyle}"
                                    Click="Add_Click" Visibility="Collapsed">
                                <StackPanel Orientation="Horizontal">
                                    <local:AppIcon Glyph="{x:Static local:AppIcons.Add}" FontSize="11" VerticalAlignment="Center" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" />
                                    <TextBlock x:Name="AddLabel" Margin="6,0,0,0" VerticalAlignment="Center" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" />
                                </StackPanel>
                            </Button>
                            <Button x:Name="ClearButton" Padding="8,5" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Style="{DynamicResource SubtleButtonStyle}"
                                    Click="Clear_Click">
                                <TextBlock x:Name="ClearText" Foreground="{DynamicResource TextTertiaryBrush}" />
                            </Button>
                        </StackPanel>
                    </ScrollViewer>
                </StackPanel>
            </Border>
        </Popup>
    </Grid>
</UserControl>
