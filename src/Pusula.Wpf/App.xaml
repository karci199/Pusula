<Application x:Class="Pusula.Wpf.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             StartupUri="MainWindow.xaml">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <!-- Pusula'ya özgü varsayılan renkler; seçilen tema (Themes.cs) bunları ezer. -->
                <ResourceDictionary>
                    <SolidColorBrush x:Key="Pusula.ProjectIconBrush" Color="#E8B04B" />
                </ResourceDictionary>
                <ResourceDictionary Source="pack://application:,,,/DesignKit.Wpf;component/DesignKit.xaml" />
                <ResourceDictionary Source="pack://application:,,,/DesignKit.Wpf;component/Themes/Fluent/Fluent.Dark.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Application.Resources>
</Application>
