<Application x:Class="Pusula.Wpf.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             StartupUri="MainWindow.xaml">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/DesignKit.Wpf;component/DesignKit.xaml" />
                <ResourceDictionary Source="pack://application:,,,/DesignKit.Wpf;component/Themes/Fluent/Fluent.Dark.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <!-- Pusula'ya özgü tür renkleri (koyu tema için). Stok DesignKit'in AccentBrush'ını kullanır. -->
            <SolidColorBrush x:Key="Pusula.ProjectIconBrush" Color="#E8B04B" />
        </ResourceDictionary>
    </Application.Resources>
</Application>
