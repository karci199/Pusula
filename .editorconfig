root = true

# BOM'lu UTF-8, CRLF
[*]
charset = utf-8-bom
end_of_line = crlf
insert_final_newline = true
indent_style = space
indent_size = 4

[*.{csproj,props,xml,json,resx,manifest}]
indent_size = 2

[*.cs]
# Allman parantez, her dalda {}
csharp_new_line_before_open_brace = all
csharp_prefer_braces = true:warning
