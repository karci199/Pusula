<Project>

  <!--
    Pusula çözümündeki tüm projelerin ortak MSBuild ayarları.
    Framework, dil, platform ve sürüm tek yerden yönetilir; .csproj dosyaları yalnızca
    kendilerine özgü olanı taşır.
  -->
  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>

    <Platforms>x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>
    <Prefer32Bit>false</Prefer32Bit>

    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <Deterministic>true</Deterministic>
    <NeutralLanguage>tr-TR</NeutralLanguage>

    <Company>Pusula</Company>
    <Product>Pusula</Product>
    <Authors>Pusula</Authors>
    <Version>0.1.0</Version>
  </PropertyGroup>

  <!-- Repoya kopyalanmış derlenmiş bağımlılıklar (NuGet restore gerekmez). -->
  <PropertyGroup>
    <DependenciesDir>$(MSBuildThisFileDirectory)Dependencies\</DependenciesDir>
  </PropertyGroup>

  <!--
    .NET Framework 4.8 başvuru derlemeleri: makinede kurulu "targeting pack"e güvenilmez (her bilgisayarda yok).
    Paket Dependencies\NuGet altından gelir (nuget.config yalnız o klasörü kaynak sayar); internet gerekmez.
  -->
  <PropertyGroup>
    <AutomaticallyUseReferenceAssemblyPackages>false</AutomaticallyUseReferenceAssemblyPackages>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies.net48" Version="1.0.3" PrivateAssets="all" />
  </ItemGroup>

</Project>
