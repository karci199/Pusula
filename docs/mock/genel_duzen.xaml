<Border xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="1280" Background="{DynamicResource SurfaceBaseBrush}" Padding="24,20" TextElement.FontFamily="Segoe UI"
        TextElement.Foreground="{DynamicResource TextPrimaryBrush}" TextElement.FontSize="13">
    <Border.Resources>
        <Style x:Key="Cap" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11.5" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource TextTertiaryBrush}" />
            <Setter Property="Margin" Value="0,0,0,8" />
        </Style>
        <Style x:Key="OldBox" TargetType="Border">
            <Setter Property="Height" Value="32" />
            <Setter Property="Width" Value="150" />
            <Setter Property="Margin" Value="0,0,8,0" />
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Background" Value="{DynamicResource ControlFillColorDefaultBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource ControlStrokeColorDefaultBrush}" />
        </Style>
        <Style x:Key="Pill" TargetType="Border">
            <Setter Property="Height" Value="30" />
            <Setter Property="Margin" Value="0,0,8,0" />
            <Setter Property="Padding" Value="12,0" />
            <Setter Property="CornerRadius" Value="15" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Background" Value="{DynamicResource ControlFillColorDefaultBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource ControlStrokeColorDefaultBrush}" />
        </Style>
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource LayerBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource CardStrokeColorDefaultBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="Padding" Value="16,12" />
        </Style>
    </Border.Resources>

    <StackPanel>
        <!-- 1. Süzgeç çubuğu -->
        <TextBlock Style="{StaticResource Cap}" Text="1 · SÜZGEÇ ÇUBUĞU (DOĞRULAMALAR, ARAÇ LİSTESİ, KAYITLAR AYNI)" />
        <Grid Margin="0,0,0,22">
            <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="24" /><ColumnDefinition /></Grid.ColumnDefinitions>
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Margin="0,0,0,8" Foreground="{DynamicResource TextTertiaryBrush}" Text="Bugün: etiket dışarıda, kutular farklı genişlikte" />
                    <StackPanel Orientation="Horizontal">
                        <TextBlock VerticalAlignment="Center" Margin="0,0,6,0" Foreground="{DynamicResource TextTertiaryBrush}" Text="Bağ" />
                        <Border Style="{StaticResource OldBox}" Width="120"><TextBlock Margin="10,0" VerticalAlignment="Center" Text="Hepsi" /></Border>
                        <TextBlock VerticalAlignment="Center" Margin="0,0,6,0" Foreground="{DynamicResource TextTertiaryBrush}" Text="Durum" />
                        <Border Style="{StaticResource OldBox}" Width="120"><TextBlock Margin="10,0" VerticalAlignment="Center" Text="Hepsi" /></Border>
                        <TextBlock VerticalAlignment="Center" Margin="0,0,6,0" Foreground="{DynamicResource TextTertiaryBrush}" Text="Sırala" />
                        <Border Style="{StaticResource OldBox}" Width="100"><TextBlock Margin="10,0" VerticalAlignment="Center" Text="Sıra no" /></Border>
                    </StackPanel>
                </StackPanel>
            </Border>
            <Border Grid.Column="2" Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Margin="0,0,0,8" Foreground="{DynamicResource TextTertiaryBrush}" Text="Öneri: etiket kutunun içinde, seçili olan mavi; adlar netleşir" />
                    <StackPanel Orientation="Horizontal">
                        <Border Style="{StaticResource Pill}"><StackPanel Orientation="Horizontal" VerticalAlignment="Center"><TextBlock Foreground="{DynamicResource TextTertiaryBrush}" Text="Plan / rapor: " /><TextBlock Text="hepsi" /><TextBlock Margin="8,0,0,0" FontSize="10" VerticalAlignment="Center" Text="⌄" /></StackPanel></Border>
                        <Border Style="{StaticResource Pill}" BorderBrush="{DynamicResource AccentFillColorDefaultBrush}"><StackPanel Orientation="Horizontal" VerticalAlignment="Center"><TextBlock Foreground="{DynamicResource TextTertiaryBrush}" Text="Durum: " /><TextBlock Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" Text="Kaldı" /><TextBlock Margin="8,0,0,0" FontSize="10" VerticalAlignment="Center" Text="✕" /></StackPanel></Border>
                        <Border Style="{StaticResource Pill}"><StackPanel Orientation="Horizontal" VerticalAlignment="Center"><TextBlock Foreground="{DynamicResource TextTertiaryBrush}" Text="Sıra: " /><TextBlock Text="TG no" /><TextBlock Margin="8,0,0,0" FontSize="10" VerticalAlignment="Center" Text="⌄" /></StackPanel></Border>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>

        <!-- 2. Sol liste başlıkları -->
        <TextBlock Style="{StaticResource Cap}" Text="2 · SOL LİSTE: PROJELER VE ENVANTER AYNI BİÇİM BAŞLIK" />
        <Grid Margin="0,0,0,22">
            <Grid.ColumnDefinitions><ColumnDefinition Width="300" /><ColumnDefinition Width="24" /><ColumnDefinition Width="300" /><ColumnDefinition /></Grid.ColumnDefinitions>
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Margin="0,0,0,8" Foreground="{DynamicResource TextTertiaryBrush}" Text="Bugün" />
                    <TextBlock FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}" Text="Projeler" />
                    <TextBlock Margin="12,6,0,0" Text="›  7000_MILKON" />
                    <TextBlock Margin="12,6,0,0" Text="›  8000_DENEME" />
                    <TextBlock Margin="0,12,0,0" Text="⌄  ▥  Envanter" />
                    <TextBlock Margin="28,6,0,0" Text="Kablajlar  8" />
                </StackPanel>
            </Border>
            <Border Grid.Column="2" Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Margin="0,0,0,8" Foreground="{DynamicResource TextTertiaryBrush}" Text="Öneri" />
                    <DockPanel><TextBlock DockPanel.Dock="Right" Foreground="{DynamicResource TextTertiaryBrush}" Text="+  ⇅  ˄" /><TextBlock FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}" Text="Projeler" /></DockPanel>
                    <TextBlock Margin="12,6,0,0" Text="›  7000_MILKON" />
                    <TextBlock Margin="12,6,0,0" Text="›  8000_DENEME" />
                    <DockPanel Margin="0,12,0,0"><TextBlock DockPanel.Dock="Right" Foreground="{DynamicResource TextTertiaryBrush}" Text="+" /><TextBlock FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}" Text="Test yardımcı araçları" /></DockPanel>
                    <TextBlock Margin="12,6,0,0" Text="Kablajlar  8" />
                    <TextBlock Margin="12,6,0,0" Text="Mekanik jigler  4" />
                </StackPanel>
            </Border>
        </Grid>

        <!-- 3. Ana sayfa boşken -->
        <TextBlock Style="{StaticResource Cap}" Text="3 · ANA SAYFA: BU HAFTA OLAY YOKSA BOŞ ALAN YERİNE ÖZET" />
        <Border Style="{StaticResource Card}" Margin="0,0,0,18">
            <StackPanel>
                <TextBlock Foreground="{DynamicResource TextSecondaryBrush}" Text="Bu hafta olay yok · son olay 12.11.2026 (AB-7000-0003, Kalibrasyon) · Hepsi'ni göster" />
                <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                    <Border Style="{StaticResource Card}" Margin="0,0,10,0" Width="200"><StackPanel><TextBlock FontSize="22" FontWeight="SemiBold" Foreground="{DynamicResource SystemFillColorCriticalBrush}" Text="1" /><TextBlock Foreground="{DynamicResource TextSecondaryBrush}" Text="Geciken iş" /></StackPanel></Border>
                    <Border Style="{StaticResource Card}" Margin="0,0,10,0" Width="200"><StackPanel><TextBlock FontSize="22" FontWeight="SemiBold" Text="11" /><TextBlock Foreground="{DynamicResource TextSecondaryBrush}" Text="Açık iş" /></StackPanel></Border>
                    <Border Style="{StaticResource Card}" Margin="0,0,10,0" Width="200"><StackPanel><TextBlock FontSize="22" FontWeight="SemiBold" Foreground="{DynamicResource SystemFillColorCautionBrush}" Text="2" /><TextBlock Foreground="{DynamicResource TextSecondaryBrush}" Text="Değişiklik bekleyen doküman" /></StackPanel></Border>
                    <Border Style="{StaticResource Card}" Width="300"><StackPanel><TextBlock FontWeight="SemiBold" Text="Son açılanlar" /><TextBlock Margin="0,4,0,0" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" Text="AB-7000-0003 · JT-7000-0101 · 7000_MILKON" /></StackPanel></Border>
                </StackPanel>
            </StackPanel>
        </Border>

        <Border Padding="14,10" CornerRadius="8" Background="{DynamicResource SubtleFillColorSecondaryBrush}">
            <TextBlock TextWrapping="Wrap" FontSize="12" LineHeight="19" Foreground="{DynamicResource TextSecondaryBrush}"
                       Text="Ayrıca (görsel değil, küçük): araç sayfasında Özellikler kartı Süreç'in üstüne; bütün çipler (seri no, bileşen, etiket) tek biçim; boş kartlar (Dosyalar: Belgeler boş) gizlenir. Renk ve boşluklar DesignKit token'larıyla; yeni kontrol yok." />
        </Border>
    </StackPanel>
</Border>
