<Border xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="1180" Background="{DynamicResource SurfaceBaseBrush}" Padding="24,20" TextElement.FontFamily="Segoe UI"
        TextElement.Foreground="{DynamicResource TextPrimaryBrush}" TextElement.FontSize="13">
    <Border.Resources>
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource LayerBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource CardStrokeColorDefaultBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="16,12,16,14" />
        </Style>
        <Style x:Key="Cap" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11.5" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource TextTertiaryBrush}" />
            <Setter Property="Margin" Value="0,0,0,8" />
        </Style>
        <Style x:Key="Title" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
            <Setter Property="Margin" Value="0,0,0,10" />
        </Style>
        <Style x:Key="Big" TargetType="TextBlock">
            <Setter Property="FontSize" Value="26" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style x:Key="Row" TargetType="DockPanel">
            <Setter Property="Margin" Value="0,0,0,6" />
        </Style>
        <Style x:Key="Num" TargetType="TextBlock">
            <Setter Property="DockPanel.Dock" Value="Right" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
    </Border.Resources>

    <StackPanel>
        <!-- A: proje / ana sayfa -->
        <TextBlock Style="{StaticResource Cap}" Text="A · PROJE SAYFASI (ANA SAYFADA AYNISI, BÜTÜN PROJELER) — EN GENEL SAYILAR" />
        <Grid Margin="0,0,0,22">
            <Grid.ColumnDefinitions>
                <ColumnDefinition /><ColumnDefinition Width="12" /><ColumnDefinition /><ColumnDefinition Width="12" /><ColumnDefinition />
            </Grid.ColumnDefinitions>
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <DockPanel Margin="0,0,0,10"><TextBlock Style="{StaticResource Big}" DockPanel.Dock="Right" Text="4" /><TextBlock Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" Text="Stoklar" /></DockPanel>
                    <DockPanel Style="{StaticResource Row}"><TextBlock Style="{StaticResource Num}" Text="1" /><TextBlock Text="Hazırlık" /></DockPanel>
                    <DockPanel Style="{StaticResource Row}"><TextBlock Style="{StaticResource Num}" Text="2" /><TextBlock Text="Testte" /></DockPanel>
                    <DockPanel Style="{StaticResource Row}"><TextBlock Style="{StaticResource Num}" Text="1" /><TextBlock Text="Tamamlandı" /></DockPanel>
                </StackPanel>
            </Border>
            <Border Grid.Column="2" Style="{StaticResource Card}">
                <StackPanel>
                    <DockPanel Margin="0,0,0,10"><TextBlock Style="{StaticResource Big}" DockPanel.Dock="Right" Text="12" /><TextBlock Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" Text="Test yardımcı araçları" /></DockPanel>
                    <DockPanel Style="{StaticResource Row}"><TextBlock Style="{StaticResource Num}" Text="5" /><TextBlock Text="Kablaj" /></DockPanel>
                    <DockPanel Style="{StaticResource Row}"><TextBlock Style="{StaticResource Num}" Text="3" /><TextBlock Text="Mekanik jig" /></DockPanel>
                    <DockPanel Style="{StaticResource Row}"><TextBlock Style="{StaticResource Num}" Text="1" /><TextBlock Text="Yazılım" /></DockPanel>
                    <DockPanel Style="{StaticResource Row}"><TextBlock Style="{StaticResource Num}" Text="2" /><TextBlock Text="Cihaz" /></DockPanel>
                    <DockPanel Style="{StaticResource Row}"><TextBlock Style="{StaticResource Num}" Text="1" /><TextBlock Text="Diğer" /></DockPanel>
                </StackPanel>
            </Border>
            <Border Grid.Column="4" Style="{StaticResource Card}">
                <StackPanel>
                    <DockPanel Margin="0,0,0,10"><TextBlock Style="{StaticResource Big}" DockPanel.Dock="Right" Text="9" /><TextBlock Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" Text="Açık iş" /></DockPanel>
                    <DockPanel Style="{StaticResource Row}"><TextBlock Style="{StaticResource Num}" Foreground="{DynamicResource SystemFillColorCriticalBrush}" Text="1" /><TextBlock Text="Geciken" /></DockPanel>
                    <DockPanel Style="{StaticResource Row}"><TextBlock Style="{StaticResource Num}" Text="2" /><TextBlock Text="Açık sorun" /></DockPanel>
                    <DockPanel Style="{StaticResource Row}"><TextBlock Style="{StaticResource Num}" Text="3" /><TextBlock Text="Bekleyen talep" /></DockPanel>
                </StackPanel>
            </Border>
        </Grid>

        <!-- B: stok sayfası, Doğrulamalar sekmesinin üstü -->
        <TextBlock Style="{StaticResource Cap}" Text="B · STOK SAYFASI → DOĞRULAMALAR SEKMESİNİN ÜSTÜNDE TEK SATIR (yalnız o stok)" />
        <Border Style="{StaticResource Card}" Margin="0,0,0,22">
            <StackPanel Orientation="Horizontal">
                <TextBlock VerticalAlignment="Center" Foreground="{DynamicResource TextSecondaryBrush}" Text="AB-7000-0003 · 112 gereksinim" Margin="0,0,24,0" />
                <TextBlock VerticalAlignment="Center" Margin="0,0,20,0"><Run Foreground="{DynamicResource SystemFillColorSuccessBrush}" FontWeight="SemiBold" Text="74 geçti" /><Run Foreground="{DynamicResource TextTertiaryBrush}" Text="  %66" /></TextBlock>
                <TextBlock VerticalAlignment="Center" Margin="0,0,20,0" Foreground="{DynamicResource SystemFillColorCriticalBrush}" FontWeight="SemiBold" Text="3 kaldı" />
                <TextBlock VerticalAlignment="Center" Margin="0,0,20,0" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" FontWeight="SemiBold" Text="20 sürüyor" />
                <TextBlock VerticalAlignment="Center" Margin="0,0,32,0" Foreground="{DynamicResource TextSecondaryBrush}" FontWeight="SemiBold" Text="15 bekliyor" />
                <TextBlock VerticalAlignment="Center" Margin="0,0,16,0" Foreground="{DynamicResource SystemFillColorCautionBrush}" Text="4 plansız gereksinim" />
                <TextBlock VerticalAlignment="Center" Foreground="{DynamicResource SystemFillColorCautionBrush}" Text="9 raporsuz plan" />
            </StackPanel>
        </Border>

        <Border Padding="14,10" CornerRadius="8" Background="{DynamicResource SubtleFillColorSecondaryBrush}">
            <TextBlock TextWrapping="Wrap" FontSize="12" LineHeight="19" Foreground="{DynamicResource TextSecondaryBrush}">
                <Run FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" Text="A: " /><Run Text="proje sayfasında yeni sekme yerine Günlük'ün üstünde ya da Kayıtlar sekmesinde üç kart; sayıya tıklayınca Kayıtlar o süzgeçle açılır. Doğrulama sayısı burada yok." /><LineBreak />
                <Run FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" Text="B: " /><Run Text="doğrulama sayıları yalnız stokun kendi sayfasında; sayıya tıklayınca tablo o durumla süzülür. Grafik, haftalık rapor, Excel'e aktar yok (sonra eklenebilir)." />
            </TextBlock>
        </Border>
    </StackPanel>
</Border>
