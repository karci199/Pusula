<Border xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="1500" Height="760" Background="{DynamicResource SurfaceBaseBrush}" TextElement.FontFamily="Segoe UI"
        TextElement.Foreground="{DynamicResource TextPrimaryBrush}" TextElement.FontSize="13">
    <Border.Resources>
        <Style x:Key="Node" TargetType="DockPanel">
            <Setter Property="Height" Value="32" />
            <Setter Property="Margin" Value="8,0" />
        </Style>
        <Style x:Key="Count" TargetType="TextBlock">
            <Setter Property="DockPanel.Dock" Value="Right" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="0,0,8,0" />
            <Setter Property="Foreground" Value="{DynamicResource TextTertiaryBrush}" />
        </Style>
        <Style x:Key="Box" TargetType="Border">
            <Setter Property="Height" Value="32" />
            <Setter Property="Margin" Value="0,0,10,0" />
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Background" Value="{DynamicResource ControlFillColorDefaultBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource ControlStrokeColorDefaultBrush}" />
        </Style>
        <Style x:Key="Head" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{DynamicResource TextTertiaryBrush}" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style x:Key="Cell" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        </Style>
    </Border.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="300" />
            <ColumnDefinition />
        </Grid.ColumnDefinitions>

        <!-- Sol: yalnız yerler; türlerin altı açılmaz -->
        <Border Background="{DynamicResource LayerBrush}" BorderBrush="{DynamicResource DividerStrokeColorDefaultBrush}" BorderThickness="0,0,1,0" Padding="0,14,0,0">
            <StackPanel>
                <DockPanel Style="{StaticResource Node}"><TextBlock VerticalAlignment="Center" Margin="10,0" Text="⌂   Ana sayfa" /></DockPanel>
                <TextBlock Margin="18,12,0,6" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" Text="Projeler" />
                <Border Style="{StaticResource Box}" Margin="12,0,12,8"><TextBlock Margin="10,0" VerticalAlignment="Center" Foreground="{DynamicResource TextTertiaryBrush}" Text="Ara: numara, ad…" /></Border>
                <DockPanel Style="{StaticResource Node}"><TextBlock VerticalAlignment="Center" Margin="10,0" Text="⌄   7000_MILKON" /></DockPanel>
                <DockPanel Style="{StaticResource Node}"><TextBlock VerticalAlignment="Center" Margin="40,0,0,0" Text="AB-7000-0001" /></DockPanel>
                <DockPanel Style="{StaticResource Node}"><TextBlock VerticalAlignment="Center" Margin="40,0,0,0" Text="AB-7000-0002" /></DockPanel>
                <DockPanel Style="{StaticResource Node}"><TextBlock VerticalAlignment="Center" Margin="40,0,0,0" Text="AB-7000-0003" /></DockPanel>
                <DockPanel Style="{StaticResource Node}"><TextBlock VerticalAlignment="Center" Margin="10,0" Text="›   8000_DENEME" /></DockPanel>
                <Border Height="1" Margin="14,10" Background="{DynamicResource DividerStrokeColorDefaultBrush}" />
                <DockPanel Style="{StaticResource Node}"><TextBlock VerticalAlignment="Center" Margin="10,0" Text="Envanter" /></DockPanel>
                <Border CornerRadius="6" Margin="8,0" Background="{DynamicResource SubtleFillColorSecondaryBrush}">
                    <DockPanel Height="32">
                        <TextBlock Style="{StaticResource Count}" Text="12" />
                        <TextBlock VerticalAlignment="Center" Margin="32,0,0,0" FontWeight="SemiBold" Text="Kablajlar" />
                    </DockPanel>
                </Border>
                <DockPanel Style="{StaticResource Node}"><TextBlock Style="{StaticResource Count}" Text="8" /><TextBlock VerticalAlignment="Center" Margin="32,0,0,0" Text="Mekanik jigler" /></DockPanel>
                <DockPanel Style="{StaticResource Node}"><TextBlock Style="{StaticResource Count}" Text="3" /><TextBlock VerticalAlignment="Center" Margin="32,0,0,0" Text="Yazılımlar" /></DockPanel>
                <DockPanel Style="{StaticResource Node}"><TextBlock Style="{StaticResource Count}" Text="2" /><TextBlock VerticalAlignment="Center" Margin="32,0,0,0" Text="Cihazlar" /></DockPanel>
                <DockPanel Style="{StaticResource Node}"><TextBlock Style="{StaticResource Count}" Text="1" /><TextBlock VerticalAlignment="Center" Margin="32,0,0,0" Text="Diğer araçlar" /></DockPanel>
                <TextBlock Margin="20,18,16,0" TextWrapping="Wrap" FontSize="11.5" Foreground="{DynamicResource TextTertiaryBrush}"
                           Text="Türlerin altı açılmaz; araçlar sağdaki listede." />
            </StackPanel>
        </Border>

        <!-- Sağ: türün listesi -->
        <StackPanel Grid.Column="1" Margin="32,22,32,0">
            <DockPanel>
                <Border DockPanel.Dock="Right" Height="32" Padding="14,0" CornerRadius="4" Background="{DynamicResource AccentFillColorDefaultBrush}">
                    <TextBlock VerticalAlignment="Center" Foreground="{DynamicResource TextOnAccentFillColorPrimaryBrush}" Text="+ Kablaj" />
                </Border>
                <StackPanel>
                    <TextBlock FontSize="24" FontWeight="SemiBold" Text="Kablajlar" />
                    <TextBlock Margin="0,2,0,0" Foreground="{DynamicResource TextTertiaryBrush}" Text="12 kayıt · 9 stoka bağlı · 3 genel" />
                </StackPanel>
            </DockPanel>

            <!-- Süzgeçler -->
            <StackPanel Orientation="Horizontal" Margin="0,18,0,12">
                <Border Style="{StaticResource Box}" Width="220"><TextBlock Margin="10,0" VerticalAlignment="Center" Foreground="{DynamicResource TextTertiaryBrush}" Text="Ara: numara, ad, not…" /></Border>
                <TextBlock Margin="4,0,8,0" VerticalAlignment="Center" FontSize="12.5" Foreground="{DynamicResource TextTertiaryBrush}" Text="Proje" />
                <Border Style="{StaticResource Box}" Width="150"><DockPanel Margin="10,0"><TextBlock DockPanel.Dock="Right" VerticalAlignment="Center" FontSize="10" Text="⌄" /><TextBlock VerticalAlignment="Center" Text="Hepsi" /></DockPanel></Border>
                <TextBlock Margin="4,0,8,0" VerticalAlignment="Center" FontSize="12.5" Foreground="{DynamicResource TextTertiaryBrush}" Text="Stok" />
                <Border Style="{StaticResource Box}" Width="150"><DockPanel Margin="10,0"><TextBlock DockPanel.Dock="Right" VerticalAlignment="Center" FontSize="10" Text="⌄" /><TextBlock VerticalAlignment="Center" Text="Hepsi" /></DockPanel></Border>
                <TextBlock Margin="4,0,8,0" VerticalAlignment="Center" FontSize="12.5" Foreground="{DynamicResource TextTertiaryBrush}" Text="Alt tür" />
                <Border Style="{StaticResource Box}" Width="130"><DockPanel Margin="10,0"><TextBlock DockPanel.Dock="Right" VerticalAlignment="Center" FontSize="10" Text="⌄" /><TextBlock VerticalAlignment="Center" Text="RF" /></DockPanel></Border>
                <TextBlock Margin="4,0,8,0" VerticalAlignment="Center" FontSize="12.5" Foreground="{DynamicResource TextTertiaryBrush}" Text="Durum" />
                <Border Style="{StaticResource Box}" Width="130"><DockPanel Margin="10,0"><TextBlock DockPanel.Dock="Right" VerticalAlignment="Center" FontSize="10" Text="⌄" /><TextBlock VerticalAlignment="Center" Text="Hepsi" /></DockPanel></Border>
                <TextBlock Margin="6,0,0,0" VerticalAlignment="Center" FontSize="12.5" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" Text="Temizle" />
            </StackPanel>

            <!-- Tablo -->
            <Border Background="{DynamicResource LayerBrush}" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="10" Padding="14,6">
                <StackPanel>
                    <Grid Height="34">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="130" /><ColumnDefinition /><ColumnDefinition Width="90" /><ColumnDefinition Width="170" /><ColumnDefinition Width="130" /><ColumnDefinition Width="110" /></Grid.ColumnDefinitions>
                        <TextBlock Style="{StaticResource Head}" Text="Numara" />
                        <TextBlock Grid.Column="1" Style="{StaticResource Head}" Text="Ad" />
                        <TextBlock Grid.Column="2" Style="{StaticResource Head}" Text="Alt tür" />
                        <TextBlock Grid.Column="3" Style="{StaticResource Head}" Text="Bağlı olduğu" />
                        <TextBlock Grid.Column="4" Style="{StaticResource Head}" Text="Yer" />
                        <TextBlock Grid.Column="5" Style="{StaticResource Head}" Text="Durum" />
                    </Grid>
                    <Border Height="1" Background="{DynamicResource DividerStrokeColorDefaultBrush}" />
                    <Grid Height="40">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="130" /><ColumnDefinition /><ColumnDefinition Width="90" /><ColumnDefinition Width="170" /><ColumnDefinition Width="130" /><ColumnDefinition Width="110" /></Grid.ColumnDefinitions>
                        <TextBlock Style="{StaticResource Cell}" FontWeight="SemiBold" Text="JT-7000-0101" />
                        <TextBlock Grid.Column="1" Style="{StaticResource Cell}" Text="SMA–N faz kararlı kablo 1,5 m" />
                        <TextBlock Grid.Column="2" Style="{StaticResource Cell}" Text="RF" />
                        <TextBlock Grid.Column="3" Style="{StaticResource Cell}" Text="AB-7000-0003" />
                        <TextBlock Grid.Column="4" Style="{StaticResource Cell}" Foreground="{DynamicResource TextSecondaryBrush}" Text="SATIMO dolabı" />
                        <TextBlock Grid.Column="5" Style="{StaticResource Cell}" Foreground="{DynamicResource SystemFillColorSuccessBrush}" Text="Kullanımda" />
                    </Grid>
                    <Grid Height="40">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="130" /><ColumnDefinition /><ColumnDefinition Width="90" /><ColumnDefinition Width="170" /><ColumnDefinition Width="130" /><ColumnDefinition Width="110" /></Grid.ColumnDefinitions>
                        <TextBlock Style="{StaticResource Cell}" FontWeight="SemiBold" Text="JT-7000-0102" />
                        <TextBlock Grid.Column="1" Style="{StaticResource Cell}" Text="SMA–SMA ekranlı kablo 0,5 m" />
                        <TextBlock Grid.Column="2" Style="{StaticResource Cell}" Text="RF" />
                        <TextBlock Grid.Column="3" Style="{StaticResource Cell}" Text="AB-7000-0003" />
                        <TextBlock Grid.Column="4" Style="{StaticResource Cell}" Foreground="{DynamicResource TextSecondaryBrush}" Text="Lab 2" />
                        <TextBlock Grid.Column="5" Style="{StaticResource Cell}" Foreground="{DynamicResource SystemFillColorCautionBrush}" Text="Tamirde" />
                    </Grid>
                    <Grid Height="40">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="130" /><ColumnDefinition /><ColumnDefinition Width="90" /><ColumnDefinition Width="170" /><ColumnDefinition Width="130" /><ColumnDefinition Width="110" /></Grid.ColumnDefinitions>
                        <TextBlock Style="{StaticResource Cell}" FontWeight="SemiBold" Text="JT-8000-0011" />
                        <TextBlock Grid.Column="1" Style="{StaticResource Cell}" Text="N–N düşük kayıplı kablo 3 m" />
                        <TextBlock Grid.Column="2" Style="{StaticResource Cell}" Text="RF" />
                        <TextBlock Grid.Column="3" Style="{StaticResource Cell}" Text="AB-8000-0002" />
                        <TextBlock Grid.Column="4" Style="{StaticResource Cell}" Foreground="{DynamicResource TextSecondaryBrush}" Text="Lab 1" />
                        <TextBlock Grid.Column="5" Style="{StaticResource Cell}" Foreground="{DynamicResource SystemFillColorSuccessBrush}" Text="Kullanımda" />
                    </Grid>
                    <Grid Height="40">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="130" /><ColumnDefinition /><ColumnDefinition Width="90" /><ColumnDefinition Width="170" /><ColumnDefinition Width="130" /><ColumnDefinition Width="110" /></Grid.ColumnDefinitions>
                        <TextBlock Style="{StaticResource Cell}" FontWeight="SemiBold" Text="JT-0000-0004" />
                        <TextBlock Grid.Column="1" Style="{StaticResource Cell}" Text="Referans kablo seti (genel)" />
                        <TextBlock Grid.Column="2" Style="{StaticResource Cell}" Text="RF" />
                        <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
                            <Border Padding="7,1" CornerRadius="8" Background="{DynamicResource SubtleFillColorSecondaryBrush}"><TextBlock FontSize="12" Text="Genel" /></Border>
                            <TextBlock Margin="6,0,0,0" FontSize="12" Foreground="{DynamicResource TextTertiaryBrush}" Text="7000, 8000" />
                        </StackPanel>
                        <TextBlock Grid.Column="4" Style="{StaticResource Cell}" Foreground="{DynamicResource TextSecondaryBrush}" Text="Depo" />
                        <TextBlock Grid.Column="5" Style="{StaticResource Cell}" Foreground="{DynamicResource SystemFillColorSuccessBrush}" Text="Kullanımda" />
                    </Grid>
                </StackPanel>
            </Border>
            <TextBlock Margin="2,10,0,0" FontSize="12" Foreground="{DynamicResource TextTertiaryBrush}" Text="4 / 12 kayıt · satıra tıklayınca aracın sayfası açılır; geri dönünce liste aynı süzgeçle gelir" />
        </StackPanel>
    </Grid>
</Border>
