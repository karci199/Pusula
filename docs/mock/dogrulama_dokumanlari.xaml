<Border xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="1280" Background="{DynamicResource SurfaceBaseBrush}" Padding="24,20" TextElement.FontFamily="Segoe UI"
        TextElement.Foreground="{DynamicResource TextPrimaryBrush}" TextElement.FontSize="13">
    <Border.Resources>
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource LayerBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource CardStrokeColorDefaultBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="10" />
        </Style>
        <Style x:Key="Cap" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11.5" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource TextTertiaryBrush}" />
            <Setter Property="Margin" Value="0,0,0,8" />
        </Style>
        <Style x:Key="Doc" TargetType="Border">
            <Setter Property="Margin" Value="0,0,10,0" />
            <Setter Property="Padding" Value="12,7" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="BorderBrush" Value="{DynamicResource ControlStrokeColorDefaultBrush}" />
            <Setter Property="Background" Value="{DynamicResource ControlFillColorDefaultBrush}" />
        </Style>
        <Style x:Key="Cell" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="10,0,0,0" />
        </Style>
        <Style x:Key="Chip" TargetType="Border">
            <Setter Property="HorizontalAlignment" Value="Left" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Padding" Value="8,2" />
            <Setter Property="CornerRadius" Value="9" />
            <Setter Property="Margin" Value="10,0,0,0" />
        </Style>
    </Border.Resources>

    <StackPanel>
        <TextBlock Style="{StaticResource Cap}" Text="STOK SAYFASI → DOĞRULAMALAR · AB-7000-0003" />

        <!-- Dokümanlar şeridi: bu stok için tanımlı olanlar; her birinin durumu Hazırlanmadı · Taslak · Aktarıldı -->
        <Border Style="{StaticResource Card}" Padding="14,10" Margin="0,0,0,12">
            <DockPanel>
                <TextBlock DockPanel.Dock="Left" VerticalAlignment="Center" Margin="0,0,16,0" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}" Text="Dokümanlar" />
                <TextBlock DockPanel.Dock="Right" VerticalAlignment="Center" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" Text="+ Doküman" />
                <StackPanel Orientation="Horizontal">
                    <Border Style="{StaticResource Doc}">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="8" Height="8" VerticalAlignment="Center" Fill="{DynamicResource SystemFillColorSuccessBrush}" />
                            <TextBlock Margin="8,0,0,0" FontWeight="SemiBold" Text="261" />
                            <TextBlock Margin="6,0,0,0" Foreground="{DynamicResource TextSecondaryBrush}" Text="Üretim test dokümanı" />
                            <TextBlock Margin="12,0,0,0" Foreground="{DynamicResource SystemFillColorSuccessBrush}" Text="Aktarıldı · 20.11" />
                            <TextBlock Margin="8,0,0,0" FontSize="10" VerticalAlignment="Center" Foreground="{DynamicResource TextTertiaryBrush}" Text="▾" />
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource Doc}">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="8" Height="8" VerticalAlignment="Center" Fill="{DynamicResource SystemFillColorCautionBrush}" />
                            <TextBlock Margin="8,0,0,0" FontWeight="SemiBold" Text="Test planı" />
                            <TextBlock Margin="12,0,0,0" Foreground="{DynamicResource SystemFillColorCautionBrush}" Text="Taslak" />
                            <TextBlock Margin="8,0,0,0" FontSize="10" VerticalAlignment="Center" Foreground="{DynamicResource TextTertiaryBrush}" Text="▾" />
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource Doc}">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="8" Height="8" VerticalAlignment="Center" Fill="{DynamicResource TextTertiaryBrush}" />
                            <TextBlock Margin="8,0,0,0" FontWeight="SemiBold" Text="Test raporu" />
                            <TextBlock Margin="12,0,0,0" Foreground="{DynamicResource TextTertiaryBrush}" Text="Hazırlanmadı" />
                            <TextBlock Margin="8,0,0,0" FontSize="10" VerticalAlignment="Center" Foreground="{DynamicResource TextTertiaryBrush}" Text="▾" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Tablo (kısaltılmış): Doğrulama sütunu = plan bağı ya da 261 -->
        <Border Style="{StaticResource Card}" Padding="12,8">
            <StackPanel>
                <Grid Margin="0,0,0,6" TextElement.Foreground="{DynamicResource TextTertiaryBrush}" TextElement.FontSize="12">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="14" /><ColumnDefinition Width="100" /><ColumnDefinition /><ColumnDefinition Width="170" /><ColumnDefinition Width="130" /></Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="1" Text="TG no" />
                    <TextBlock Grid.Column="2" Style="{StaticResource Cell}" Text="Gereksinim" />
                    <TextBlock Grid.Column="3" Style="{StaticResource Cell}" Text="Doğrulama" />
                    <TextBlock Grid.Column="4" Style="{StaticResource Cell}" Text="Durum" />
                </Grid>
                <!-- Test planıyla -->
                <Grid Height="38">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="14" /><ColumnDefinition Width="100" /><ColumnDefinition /><ColumnDefinition Width="170" /><ColumnDefinition Width="130" /></Grid.ColumnDefinitions>
                    <Rectangle Width="3" Margin="0,8" HorizontalAlignment="Left" Fill="{DynamicResource SystemFillColorSuccessBrush}" />
                    <TextBlock Grid.Column="1" VerticalAlignment="Center" FontWeight="SemiBold" Text="TSD-0040" />
                    <TextBlock Grid.Column="2" Style="{StaticResource Cell}" Text="Besleme gerilimi 18–32 V aralığında çalışmalı" />
                    <TextBlock Grid.Column="3" Style="{StaticResource Cell}" Text="TP-01" />
                    <TextBlock Grid.Column="4" Style="{StaticResource Cell}" Foreground="{DynamicResource SystemFillColorSuccessBrush}" Text="Geçti" />
                </Grid>
                <!-- 261 ile, 261 aktarıldı: sarı yok -->
                <Grid Height="38">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="14" /><ColumnDefinition Width="100" /><ColumnDefinition /><ColumnDefinition Width="170" /><ColumnDefinition Width="130" /></Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="1" VerticalAlignment="Center" FontWeight="SemiBold" Text="TSD-0041" />
                    <TextBlock Grid.Column="2" Style="{StaticResource Cell}" Text="Etiket ve işaretleme üretim dokümanına uygun" />
                    <Border Grid.Column="3" Style="{StaticResource Chip}" Background="{DynamicResource SystemFillColorSuccessBackgroundBrush}">
                        <TextBlock FontSize="12" Foreground="{DynamicResource SystemFillColorSuccessBrush}" Text="261 · aktarıldı" />
                    </Border>
                    <TextBlock Grid.Column="4" Style="{StaticResource Cell}" Foreground="{DynamicResource TextSecondaryBrush}" Text="—" />
                </Grid>
                <!-- Plansız: sarı (bugünkü gibi) -->
                <Grid Height="38">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="14" /><ColumnDefinition Width="100" /><ColumnDefinition /><ColumnDefinition Width="170" /><ColumnDefinition Width="130" /></Grid.ColumnDefinitions>
                    <Rectangle Width="3" Margin="0,8" HorizontalAlignment="Left" Fill="{DynamicResource SystemFillColorCautionBrush}" />
                    <TextBlock Grid.Column="1" VerticalAlignment="Center" FontWeight="SemiBold" Text="TSD-0042" />
                    <TextBlock Grid.Column="2" Style="{StaticResource Cell}" Text="Ağırlık 1,2 kg'ı geçmemeli" />
                    <TextBlock Grid.Column="3" Style="{StaticResource Cell}" Foreground="{DynamicResource SystemFillColorCautionBrush}" Text="plan yok" />
                    <TextBlock Grid.Column="4" Style="{StaticResource Cell}" Foreground="{DynamicResource TextSecondaryBrush}" Text="Bekliyor" />
                </Grid>
            </StackPanel>
        </Border>

        <TextBlock Style="{StaticResource Cap}" Margin="0,18,0,8" Text="AYNI MADDE, 261 HENÜZ TASLAKKEN" />
        <Border Style="{StaticResource Card}" Padding="12,4">
            <Grid Height="38">
                <Grid.ColumnDefinitions><ColumnDefinition Width="14" /><ColumnDefinition Width="100" /><ColumnDefinition /><ColumnDefinition Width="170" /><ColumnDefinition Width="130" /></Grid.ColumnDefinitions>
                <Rectangle Width="3" Margin="0,8" HorizontalAlignment="Left" Fill="{DynamicResource SystemFillColorCautionBrush}" />
                <TextBlock Grid.Column="1" VerticalAlignment="Center" FontWeight="SemiBold" Text="TSD-0041" />
                <TextBlock Grid.Column="2" Style="{StaticResource Cell}" Text="Etiket ve işaretleme üretim dokümanına uygun" />
                <Border Grid.Column="3" Style="{StaticResource Chip}" Background="{DynamicResource SystemFillColorCautionBackgroundBrush}">
                    <TextBlock FontSize="12" Foreground="{DynamicResource SystemFillColorCautionBrush}" Text="261 · taslak" />
                </Border>
                <TextBlock Grid.Column="4" Style="{StaticResource Cell}" Foreground="{DynamicResource TextSecondaryBrush}" Text="—" />
            </Grid>
        </Border>

        <Border Margin="0,18,0,0" Padding="14,10" CornerRadius="8" Background="{DynamicResource SubtleFillColorSecondaryBrush}">
            <TextBlock TextWrapping="Wrap" FontSize="12" LineHeight="19" Foreground="{DynamicResource TextSecondaryBrush}">
                <Run FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" Text="Kurallar: " />
                <Run Text="Dokümanlar stokta tanımlanır (her birimde test planı / raporu yok; yalnız eklenenler görünür). Durum: Hazırlanmadı · Taslak · Aktarıldı (+ tarih); revizyon tutulmaz, zaman çizelgesinden yazılır. Gereksinimde doğrulama: test planı (bugünkü gibi) ya da 261. 261'li madde plan / rapor istemez; 261 aktarılana kadar sarı, aktarılınca sarıdan çıkar. 261 'Geçti' sayılmaz; özet ve yüzde yalnız test planlı maddeleri sayar." />
            </TextBlock>
        </Border>
    </StackPanel>
</Border>
