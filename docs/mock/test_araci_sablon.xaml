<Border xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="1180" Background="{DynamicResource SurfaceBaseBrush}" Padding="24,20" TextElement.FontFamily="Segoe UI"
        TextElement.Foreground="{DynamicResource TextPrimaryBrush}" TextElement.FontSize="13">
    <Border.Resources>
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource LayerBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource CardStrokeColorDefaultBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="16,12,16,14" />
            <Setter Property="Margin" Value="0,0,0,12" />
        </Style>
        <Style x:Key="NewCard" TargetType="Border" BasedOn="{StaticResource Card}">
            <Setter Property="BorderBrush" Value="{DynamicResource AccentTextFillColorPrimaryBrush}" />
            <Setter Property="BorderThickness" Value="1.5" />
        </Style>
        <Style x:Key="CardTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style x:Key="Key" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{DynamicResource TextTertiaryBrush}" />
        </Style>
        <Style x:Key="Dim" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
        <Style x:Key="Btn" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource ControlFillColorDefaultBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource ControlStrokeColorDefaultBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="5" />
            <Setter Property="Padding" Value="10,3" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style x:Key="Chip" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="Padding" Value="9,1,9,2" />
            <Setter Property="Margin" Value="0,0,6,0" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style x:Key="Thumb" TargetType="Border">
            <Setter Property="Height" Value="56" />
            <Setter Property="CornerRadius" Value="5" />
            <Setter Property="Background" Value="#2E3440" />
            <Setter Property="BorderThickness" Value="2" />
            <Setter Property="BorderBrush" Value="Transparent" />
        </Style>
        <Style x:Key="ThumbText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Foreground" Value="#9AA3B2" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style x:Key="ThumbNo" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Margin" Value="0,4,0,0" />
            <Setter Property="HorizontalAlignment" Value="Center" />
        </Style>
        <Style x:Key="EvDate" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Foreground" Value="{DynamicResource TextTertiaryBrush}" />
        </Style>
        <Style x:Key="Dot" TargetType="Ellipse">
            <Setter Property="Width" Value="11" />
            <Setter Property="Height" Value="11" />
            <Setter Property="HorizontalAlignment" Value="Left" />
            <Setter Property="VerticalAlignment" Value="Top" />
            <Setter Property="Margin" Value="-21,6,0,0" />
        </Style>
    </Border.Resources>

    <StackPanel>
        <TextBlock FontSize="11.5" FontWeight="SemiBold" Foreground="{DynamicResource TextTertiaryBrush}" Margin="0,0,0,12" Text="{{CAPTION}}" />

        <!-- Başlık -->
        <Grid Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="44" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Viewbox Width="30" Height="30" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="0,5,0,0">
                <Canvas Width="16" Height="16">
                    <Path Data="{{ICON}}" Stroke="{{COLOR}}" StrokeThickness="1.3" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                </Canvas>
            </Viewbox>
            <StackPanel Grid.Column="1">
                <StackPanel Orientation="Horizontal">
                    <TextBlock FontSize="26" FontWeight="SemiBold" Text="{{NUMBER}}" />
                    <TextBlock FontSize="18" Margin="12,0,0,3" VerticalAlignment="Bottom" Foreground="{DynamicResource TextSecondaryBrush}" Text="{{NAME}}" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,3,0,0">
                    <TextBlock Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" Text="{{PARENT}}" />
                    <TextBlock Margin="7,0" Foreground="{DynamicResource TextTertiaryBrush}" Text="›" />
                    <TextBlock Foreground="{DynamicResource TextSecondaryBrush}" Text="{{KIND}}" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,9,0,0">
                    <Border CornerRadius="11" BorderThickness="1" BorderBrush="{DynamicResource AccentTextFillColorPrimaryBrush}" Padding="10,1,8,2" VerticalAlignment="Center">
                        <TextBlock FontSize="12" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}"><Run Text="{{STATUS}}" /><Run Text="  ⌄" /></TextBlock>
                    </Border>
                    <TextBlock Margin="9,0,14,0" Style="{StaticResource EvDate}" Text="{{SINCE}}" />
                    {{HEADCHIPS}}
                </StackPanel>
            </StackPanel>
            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Top" Margin="0,4,0,0">
                <Border Style="{StaticResource Btn}"><TextBlock Text="Klasör" /></Border>
                <TextBlock Margin="14,0,4,0" FontSize="16" VerticalAlignment="Center" Text="⋯" />
            </StackPanel>
        </Grid>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="480" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- SOL -->
            <StackPanel>
                {{MEDIA}}

                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource CardTitle}" Margin="0,0,0,8" Text="Süreç" />
                        <UniformGrid Columns="2">
                            {{PROCESS}}
                        </UniformGrid>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <DockPanel Margin="0,0,0,8">
                            <Border DockPanel.Dock="Right" Style="{StaticResource Btn}" Padding="8,1"><TextBlock FontSize="12" Text="+  Stoka bağla" /></Border>
                            <TextBlock Style="{StaticResource CardTitle}"><Run Text="Kullanan stoklar" /><Run Foreground="{DynamicResource TextTertiaryBrush}" Text="{{USERS_COUNT}}" /></TextBlock>
                        </DockPanel>
                        {{USERS}}
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource CardTitle}" Margin="0,0,0,8" Text="{{FIELDS_TITLE}}" />
                        <UniformGrid Columns="2">
                            {{FIELDS}}
                        </UniformGrid>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Card}" Margin="0">
                    <StackPanel>
                        <TextBlock Style="{StaticResource CardTitle}" Margin="0,0,0,8" Text="Dosyalar" />
                        <WrapPanel>
                            {{FILES}}
                        </WrapPanel>
                    </StackPanel>
                </Border>
            </StackPanel>

            <!-- SAĞ -->
            <StackPanel Grid.Column="2">
                <Border Style="{StaticResource NewCard}">
                    <StackPanel>
                        <DockPanel Margin="0,0,0,10">
                            <Border DockPanel.Dock="Right" Style="{StaticResource Btn}" Padding="8,1"><TextBlock FontSize="12" Text="MD" /></Border>
                            <TextBlock Style="{StaticResource CardTitle}"><Run Text="Not" /><Run Foreground="{DynamicResource TextTertiaryBrush}" Text="{{NOTE_FILE}}" /></TextBlock>
                        </DockPanel>
                        {{NOTE}}
                        <TextBlock Margin="0,10,0,0" FontSize="11.5" Foreground="{DynamicResource TextTertiaryBrush}"
                                   Text="Notun gövdesi; YAML ve ## Günlük burada gösterilmez. Değiştirmek için MD." />
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource NewCard}" Margin="0">
                    <StackPanel>
                        <DockPanel Margin="0,0,0,10">
                            <Border DockPanel.Dock="Right" Style="{StaticResource Btn}" Padding="8,1"><TextBlock FontSize="12" Text="+  Olay" /></Border>
                            <TextBlock Style="{StaticResource CardTitle}"><Run Text="Olaylar" /><Run Foreground="{DynamicResource TextTertiaryBrush}" Text="{{EVENTS_COUNT}}" /></TextBlock>
                        </DockPanel>
                        <WrapPanel Margin="0,0,0,14">
                            <Border Style="{StaticResource Chip}" Background="{DynamicResource AccentFillColorDefaultBrush}"><TextBlock FontSize="12" Foreground="{DynamicResource TextOnAccentFillColorPrimaryBrush}" Text="Hepsi" /></Border>
                            {{FILTERS}}
                        </WrapPanel>
                        <Grid>
                            <Rectangle Width="2" HorizontalAlignment="Left" Margin="4,8,0,8" Fill="{{RAIL}}" />
                            <StackPanel Margin="21,0,0,0">
                                {{EVENTS}}
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>
            </StackPanel>
        </Grid>

        <Border Margin="0,16,0,0" Padding="14,10" CornerRadius="8" Background="{DynamicResource SubtleFillColorSecondaryBrush}">
            <TextBlock TextWrapping="Wrap" FontSize="12" LineHeight="19" Foreground="{DynamicResource TextSecondaryBrush}">
                {{RULES}}
            </TextBlock>
        </Border>
    </StackPanel>
</Border>
